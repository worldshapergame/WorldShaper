# WSauthor: worldshaper
# A small bright thing in a large dark room, which is the frame every part of the post stack
# is judged on at once.
#
# The sun is not this test. Its disc in this renderer sits about six times the sky around it,
# and six times anything is not a source that glares -- it is just a bright pixel. A lamp at
# emit=200 is radiance 39 against walls near 0.02, which is eleven stops in one picture, and
# that is the range a real interior actually has.
#
# What each part of the stack has to get right here:
#   exposure   -- the frame is mostly dark, so a linear mean would expose for the lamp and
#                 render the room black. A log mean should expose for the room.
#   tone map   -- the lamp is far over white. Reinhard per channel keeps it its own colour
#                 for ever; a filmic curve takes it to white through its own hue.
#   glare      -- a source eleven stops over its surroundings is the case bloom exists for.
#   fireflies  -- a small bright emitter found by an unlucky bounce is where fireflies come
#                 from. The walls opposite the lamp are where they show.

metre 32
bounds -3.6 -0.4 -5.6   3.6 3.6 5.6

material plaster   rgb=222,218,210 rough=235
material floorwood rgb=148,110,70  rough=185
material lampglass rgb=255,244,214 emit=200
material lamphood  rgb=64,62,60    rough=160 metal=120
material chrome    rgb=232,232,238 rough=8   metal=250
material redpost   rgb=178,56,50   rough=200

# A sealed box. No window, no sky: the lamp is the only light in the scene, so nothing here is
# lit by anything that was not measured.
let gl_shell  = box -3.2 -0.4 -5.2   3.2 3.2 5.2
let gl_void   = box -3.0  0.0 -5.0   3.0 3.0 5.0
let gl_room   = difference { gl_shell gl_void }

# The lamp: a small glowing box under a dark hood, hung off the ceiling. Small on purpose --
# a large source washes the room evenly and hides everything this scene is for.
let gl_hood   = box -0.55 2.62 -0.55   0.55 2.98 0.55
let gl_bulb   = box -0.40 2.50 -0.40   0.40 2.64 0.40

# Something to catch it, at two roughnesses and one saturated colour, so the tone curve's
# handling of a bright saturated highlight has somewhere to show.
let gl_ball   = sphere -1.3 0.8 -1.2 r=0.8
let gl_post   = cylinder 1.5 1.1 -1.6 r=0.2 h=2.2 axis=y
let gl_deck   = box -3.0 0.0 -5.0   3.0 0.02 5.0

let gl_all    = union { gl_room gl_hood gl_bulb gl_ball gl_post }

paint plaster
paint floorwood where=gl_deck below=0.02
paint lamphood  where=gl_hood below=0.02
paint lampglass where=gl_bulb below=0.02
paint chrome    where=gl_ball below=0.02
paint redpost   where=gl_post below=0.02

solid gl_all
