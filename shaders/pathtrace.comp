#include "pt_material.glsl"
#include "pt_normals.glsl"

// How much of a shadow ray survives one voxel of this stuff, and zero for anything it cannot
// pass. Answers the marcher's WS_VOXEL_TRANSMIT.
//
// Grey rather than coloured, because a shadow entry in the face cache is one float: it records
// how much of the sun a face can see, not what colour it sees it in. So a green pane dims the
// shadow it casts without tinting it. Tinting it means widening that entry to three floats,
// which is a change to the cache and not to this.
float voxel_shadow_transmit(uint type_id) {
    Material m = material_of(type_id);
    // Solid is not the same as opaque to light. A voxel of marble stops a ray you can see
    // through and passes a fifth of the sun, which is why the lip of a moulding glows and why a
    // marble screen casts a soft shadow rather than the same hard black one a brick wall does.
    // Anything with translucency 0 — which is every material written before this — answers 0
    // here exactly as it always did.
    if (m.opacity >= 0.996) return voxel_transmit(m);
    const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);
    // What the surface itself keeps out, then what a voxel's thickness of the stuff absorbs.
    return mix(1.0, dot(m.albedo, kLuma), m.opacity) * exp(-dot(m.absorb, kLuma));
}

// How much of the sun reaches a point, rather than whether anything is in the way.
//
// A window takes some of the light and passes the rest, and until the marcher could say so a
// glazed opening cast the same hard black shadow a bricked-up one does.
float sun_transmission(vec3 origin, vec3 dir) {
    // Full detail, and no feedback: a shadow ray must not drag streaming towards wherever it
    // happened to point.
    g_march_through_glass = true;
    g_march_transmittance = 1.0;
    Hit hit = march(origin, dir, 0.0, 0.0, false);
    g_march_through_glass = false;
    // A hit is a ray that was stopped, whether by opaque matter or by having nothing left worth
    // carrying. Only a ray that reached the sky transmitted anything.
    return hit.hit ? 0.0 : g_march_transmittance;
}

// Direct sun at a point, sampled rather than waited for. Without this the sun is found only
// when a bounce happens to land inside its half-degree disc, which is almost never ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â the
// difference between converging in seconds and in an hour.
//
// Deliberately per pixel and never cached: its shadow edges are sharp, and one value shared
// across a whole face would smear them.
// A direction inside the sun's disc, so its shadows have a penumbra. A point light casts an
// edge with none at all, which is the single most obvious way a render looks synthetic.
// Stratified across the pixels of the face as well, and for the same reason. A face's shadow is
// the fraction of its pixels' rays that got through, so what matters is that they sample the
// sun's disc evenly between them rather than each drawing at random — the difference between a
// penumbra that resolves and one that stays grainy.
vec3 sun_sample_at(vec2 u) {
    float cos_max = trace.sun.w;
    float cos_theta = mix(cos_max, 1.0, u.x);
    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    float phi = 2.0 * kPi * u.y;

    vec3 n = trace.sun.xyz;
    vec3 up = (abs(n.z) < 0.999) ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * (sin_theta * cos(phi)) + bitangent * (sin_theta * sin(phi)) +
                     n * cos_theta);
}

vec3 sun_sample(inout uint state) {
    return sun_sample_at(vec2(rand(state), rand(state)));
}

// Sun light given how much of the sun this face can see. Splitting visibility out is what
// lets the expensive half ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â the shadow ray ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â be traced once per face and shared, while the
// cheap half, which depends on the viewing angle, stays per pixel.
vec3 sun_light(vec3 normal, vec3 view, Material m, float visibility) {
    if (visibility <= 0.0) return vec3(0.0);
    // Every lobe of it lives in pt_material.glsl. What a surface does with light is the
    // material's business; the sun is only one direction to ask it about, and asking here rather
    // than answering here is what let an anisotropic highlight, a clearcoat and a sheen arrive
    // without this file changing at all.
    //
    // sun_radiance() and not trace.sun_colour: the constant is what the sun is worth at the
    // reference hour, and the function is what is left of it after the air it came through. That
    // is what stops a dusk frame being a red sky over a scene lit at full noon strength, and what
    // stops a sun a degree below the horizon lighting every upward face in the world.
    return surface_response(m, normal, -view, trace.sun.xyz) * sun_radiance() * visibility;
}

// Everything a face knows: how much of the sun it can see, and the light arriving from
// everywhere else. Both come from the same entry and the same sample count.
struct FaceLight {
    float visibility;
    vec3 indirect;
    uint count;
    // How far this entry's mean is likely to be wrong, as a fraction of itself. Measured from
    // the samples rather than assumed from their number, which is the whole point: a face
    // looking at a blank wall and a face looking at a window through a doorway need wildly
    // different amounts of work, and a sample count cannot tell them apart.
    float error;
    bool known;
};

// The second moment lives in sum.w, which costs nothing because an irradiance entry has never
// used it — that channel carries the sun's visibility, and visibility lives in its own kind of
// entry. So the table stays exactly 32 bytes a slot and 256 MB in total.
//
// Its own fixed-point scale, and a much coarser one. A squared luminance can reach a few
// thousand where a linear one reaches sixty, and at the linear scale five hundred of them
// overflow a 32-bit word — which would not look like an error, it would look like a face
// deciding at random that it had converged.
const float kSquareScale = 256.0;

// A floor under the error estimate, so that a face reading pure black still has a tolerance and
// does not refuse every neighbour by dividing by nothing.
const float kEdgeFloor = 0.02;

float face_luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// How many levels up to look when this one knows nothing yet.
//
// All the way to the top rather than three: the nearest ancestor that knows anything is worth
// having, and climbing invents nothing, because a parent is a real measurement of a larger
// piece of the same place. Where the place is dark the parent is dark, so a sealed room stays
// black.
//
// It was raised to chase a one-pixel dark seam along horizontal edges Ã¢â‚¬â€ 430 pixels on a single
// scanline of the test scene Ã¢â‚¬â€ where a pixel lands on a face no other pixel stands on. That is
// not what causes it: the seam went to 423, so those pixels' ancestors are unknown too. Since
// the normal axis is deliberately not quantised, a voxel that is off by one *along the normal*
// is a different face at every level, and climbing cannot reunite it. Left raised because it is
// the better fallback regardless; the seam is still there and still unexplained.
const uint kParentLevels = 7u;

void contribute(uint slot, vec3 value, uint window) {
    if (slot == 0xFFFFFFFFu) return;

    // A sliding window, not a total. Once an entry holds a window's worth of samples it is
    // halved, so it averages roughly the last kFaceWindow contributions and forgets what came
    // before at the same rate.
    //
    // This is what lets an edit *not* wipe the table. Clearing the whole cache whenever
    // anything was placed meant every voxel put down relit the entire scene at once Ã¢â‚¬â€ which
    // is the smearing: not a gradual settle but the whole room changing while you build. A
    // window means a face notices the wall you just put next to it within a few frames, on
    // its own, and nothing else in the world flinches.
    //
    // Exactly one thread halves, and it claims that right with a compare-and-swap.
    //
    // Letting every thread that sees a full entry halve it was written here once, with a
    // comment calling the race harmless. It is the opposite of harmless. A thousand pixels
    // stand on one face in the same dispatch; they all read the same count, they all subtract
    // half of it, and the sums are *unsigned*, so they wrap to four billion. On screen that is
    // a saturated cyan or red square, and because a cache does not wash out it stays there and
    // more of them appear while you stand still.
    //
    // With the swap, only the thread that moved count from N to N/2 subtracts anything. It
    // then subtracts half of a sum it read *after* winning, and sums only ever grow in
    // between, so the subtraction can never take one below zero.
    uint count = faces.items[slot].count;
    if (count >= window) {
        if (atomicCompSwap(faces.items[slot].count, count, count - count / 2u) == count) {
            uvec4 sum = faces.items[slot].sum;
            atomicAdd(faces.items[slot].sum.x, uint(-int(sum.x / 2u)));
            atomicAdd(faces.items[slot].sum.y, uint(-int(sum.y / 2u)));
            atomicAdd(faces.items[slot].sum.z, uint(-int(sum.z / 2u)));
            atomicAdd(faces.items[slot].sum.w, uint(-int(sum.w / 2u)));
        }
    }
    atomicAdd(faces.items[slot].sum.x, uint(value.r * kFixedScale));
    atomicAdd(faces.items[slot].sum.y, uint(value.g * kFixedScale));
    atomicAdd(faces.items[slot].sum.z, uint(value.b * kFixedScale));
    // And the square of it, which is what lets the entry say how well it knows itself rather
    // than only how often it has been asked.
    float lum = face_luminance(value);
    atomicAdd(faces.items[slot].sum.w, uint(lum * lum * kSquareScale));
    atomicAdd(faces.items[slot].count, 1u);
}

// How many shadow samples a face wants before the pixels on it stop tracing for it. Far fewer
// than indirect needs: this is a yes-or-no answer sampled over half a degree of sky, so a
// hundred of them already resolve the penumbra to better than the eye can see.
// Set from the quality controller; see trace.quality.

// A shadow entry uses the same slot layout and only the w channel. Kept in the same table
// rather than a second one, because the two share an eviction policy, a probe strategy and a
// budget, and splitting the storage would mean maintaining all three twice.
// How short the shadow window becomes while an edit is settling.
//
// This is the whole of why a new voxel cast no shadow until you walked up to it.
//
// An entry is a mean over its last kFaceWindow samples. A patch of ground that has been lit
// for a while holds five hundred samples all saying "lit", so when something is built beside
// it the new dark samples have to outvote all of them — several hundred measurements before
// the mean moves, and several hundred more before it arrives. A face right under the camera is
// covered by dozens of pixels and gathers those in a moment; a face further off is covered by
// one, and never gets there. Walking closer is what supplies the votes, which is exactly what
// it looked like: the shadow fading in as you approach and staying once it had.
//
// It is also why placing voxels *on* the shadow worked. Those faces are new. They have no
// history to outvote, so they read dark from their first sample.
//
// So for the couple of seconds after an edit the window is short: the mean tracks the last few
// dozen samples instead of the last five hundred, and the truth wins immediately at any
// distance. Then it lengthens again, because a long window is what keeps a settled scene
// quiet.
const uint kEditWindow = 4u;

// Is this face somewhere the last edit could have changed the light of?
//
// Its own bounds grown by how far a shadow it casts can fall, which the CPU worked out in
// 64-bit and handed over relative to the camera chunk. Outside it nothing can have changed, so
// nothing outside is touched — that is the whole difference between a new shadow appearing and
// the entire scene shifting at once, which is what a global "look again" did and what the
// smearing while building actually was.
bool in_edited_region(ivec3 voxel) {
    if (push.edit_min.w == 0) return false;
    ivec3 local = voxel - push.camera_chunk.xyz * kChunkEdge;
    return all(greaterThanEqual(local, push.edit_min.xyz)) &&
           all(lessThanEqual(local, push.edit_max.xyz));
}

void contribute_shadow(uint slot, float visibility, uint window) {
    if (slot == 0xFFFFFFFFu) return;
    uint count = faces.items[slot].count;
    if (count >= window) {
        if (atomicCompSwap(faces.items[slot].count, count, count - count / 2u) == count) {
            atomicAdd(faces.items[slot].sum.w, uint(-int(faces.items[slot].sum.w / 2u)));
        }
    }
    atomicAdd(faces.items[slot].sum.w, uint(visibility * kFixedScale));
    atomicAdd(faces.items[slot].count, 1u);
}

// A coarser shadow entry to lean on while a voxel face has too few samples of its own, and
// how many of its own it needs before it stops leaning.
//
// Per-voxel-face shadow is right where a face covers pixels, and hopeless where it does not:
// on a floor stretching to the horizon a face is smaller than a pixel, gathers a single
// yes-or-no sample, and the distance dissolves into salt and pepper. Measured on a 400 m
// floor with the camera moving, that was 9.03 speckle against 0.54.
//
// So the same rule indirect already follows: a face with nothing to say defers to the larger
// piece of surface it belongs to, and takes over as it learns. Near surfaces reach the
// threshold in a frame or two and are crisp per voxel; distant ones never do and stay smooth.
// Both levels are fixed in world space, so neither the shape nor the blend depends on where
// the camera is standing â€” which is what made the old distance-chosen level draw wedges.
const uint kShadowParentLevel = 6u;
const uint kShadowSeed = 24u;

float read_shadow(uint slot) {
    if (slot == 0xFFFFFFFFu) return 0.0;
    uint count = faces.items[slot].count;
    if (count == 0u) return 0.0;
    return clamp(float(faces.items[slot].sum.w) / (kFixedScale * float(count)), 0.0, 1.0);
}


FaceLight read_face(uint slot);

// A face nobody has looked at before has no history, and one sample is noise. Its parent
// covers eight times the volume, has been gathering samples from everything around it, and is
// a far better first guess than a single ray.
//
// This is what makes walking up to a surface not shimmer: the coarse node was being filled
// while it was still far away, so arriving close inherits that instead of starting over. Every
// pixel contributes to its own level *and* its parent, so the parent is always there to
// inherit from Ã¢â‚¬â€ including the first time anything looks this way.
FaceLight read_face(uint slot) {
    FaceLight light;
    light.visibility = 0.0;
    light.indirect = vec3(0.0);
    light.count = 0u;
    light.error = 1e3;
    light.known = false;
    if (slot == 0xFFFFFFFFu) return light;

    // The sum read twice, STRADDLING the count, and the smaller taken.
    //
    // An entry that reaches its window is halved: count first, because the compare-and-swap on it
    // is what claims the right to halve, and the sum a moment later. A reader landing between the
    // two divides a FULL sum by a HALVED count and sees exactly twice the light that is there. It
    // is one frame, but with half a million entries some face is always halving, so there are
    // always some of them, and they are bright dots on a settled surface — which is the artefact
    // this is, not a real firefly.
    //
    // Reading the sum either side of the count and keeping the smaller cannot over-state: if the
    // halving happened before the count was read, the second sum is halved too and the pair
    // agrees; if it happened after, the smaller sum is the halved one against a full count, which
    // reads dark for one frame. Never bright. Two extra loads and no atomics.
    uvec4 sum_before = faces.items[slot].sum;
    uint count = faces.items[slot].count;
    if (count == 0u) return light;
    uvec4 sum_after = faces.items[slot].sum;
    uvec4 sum = min(sum_before, sum_after);

    float inv = 1.0 / (kFixedScale * float(count));
    // Clamped on the way out, as a backstop rather than a correction. Every contribution is
    // clamped to 64 going in, so a mean above that is arithmetic having gone wrong rather than
    // a bright surface Ã¢â‚¬â€ and a wrong entry in a cache does not fade, it persists and spreads.
    // Visibility lives in its own entry now; this one holds irradiance only.
    light.indirect = min(vec3(sum.xyz) * inv, vec3(64.0));
    light.count = count;

    // How far the mean is likely to be out, as a fraction of itself.
    //
    // The samples' own spread, divided by the root of how many there were — the standard error
    // of a mean, which is the only honest statement a running average can make about itself.
    // A face whose bounces all come back alike knows its answer after a few dozen; one that
    // sees a bright window through a doorway and a dark wall either side of it does not know it
    // after a thousand, and the two are indistinguishable by sample count.
    float mean_luminance = face_luminance(light.indirect);
    float mean_square = float(sum.w) / (kSquareScale * float(count));
    float variance = max(mean_square - mean_luminance * mean_luminance, 0.0);
    light.error = sqrt(variance / float(count)) / (mean_luminance + kEdgeFloor);

    light.known = true;
    return light;
}

// How many samples of its own a node needs before it stops leaning on its parent.
const uint kSeedSamples = 160u;

// ---- filtering in face space ---------------------------------------------------------
//
// Every pixel standing on one voxel face reads one value, so the noise that survives is
// face-shaped: patches three centimetres across, each holding an estimate slightly different
// from the one beside it. Blotches, not speckle.
//
// A screen-space filter is the wrong tool for that, and the picture said so — it came out
// painterly. It works in the wrong unit. A face is a hundred pixels across when you stand at it
// and a fraction of one across the field, so no radius in pixels is ever the right size: narrow
// enough to keep detail near to, and it cannot reach across a face; wide enough to cross a face
// far away, and near to it smears everything into everything.
//
// A face has neighbours of its own, and they are exact. The key is built from the node, so the
// face one step along the surface is the same key with one coordinate moved — no search, no
// screen, and no way to blur into something that is merely adjacent from where the camera
// happens to be standing. Averaging a face with the four beside it is a filter over the surface
// itself. Geometry cannot leak across it, because a neighbour that is not there is simply not
// read, and a wall's edge is where its faces stop.
//
// It is an a-trous wavelet filter, which is the standard answer for a path tracer and is
// usually run over the screen. Over the face lattice it is strictly better, because the two
// things that make the screen-space version awkward both disappear:
//
//   the edge test    a screen filter has to guess from depth and normal whether two pixels are
//                    the same surface, and guesses wrong at silhouettes. Here it is not a guess.
//                    The key holds the normal axis at full resolution, so a neighbour key is by
//                    construction a face on the same plane, facing the same way, one step along.
//                    Two surfaces cannot be confused because they do not share keys, and a
//                    wall's edge needs no test: past it, the neighbour simply is not there.
//
//   the radius       in pixels the right radius is unknowable, because a face is a hundred
//                    pixels across close to and a fraction of one across a field. In faces it is
//                    exactly one face, at every distance, forever.
//
// And what is filtered is *light*, never colour. The cache holds irradiance -- what arrives at
// the face -- and the voxel's own colour is multiplied in afterwards, at shading. So a wall's
// checkerboard cannot be smoothed by this no matter how wide it reaches: the filter never sees
// it. That is what buys smooth gradients without turning stone to porridge, and it is a property
// of where the filter sits rather than a threshold anyone has to tune.
//
// Three rings, at one, two and four faces, with the radius shrinking as a face gains samples: a
// face that knows nothing reaches furthest, a settled one is not touched at all. So a still
// scene pays nothing and converges sharp, which is the behaviour a filter over an accumulating
// estimate should have.
const uint kFaceSettled = 512u;
const int kFaceRings = 3;

const uint kMaxFaceLevel = 12u;

// How many levels of ancestor every sample is also written to, and it must cover every level the
// composite can reach down for.
//
// A level nobody writes to reads back as unknown, and an unknown level contributes nothing to the
// composite — so the answer falls back on the fine, noisy one, which is exactly what the whole
// scheme exists to avoid. The failure is silent: the picture simply stays speckled and every
// constant looks innocent. Measured while this was being built, going from four ancestors to three
// doubled the speckle at sixty-four frames, from 61.6 to 116.5, with nothing else changed.
//
// Six, because a starved face on busy geometry walks a long way up before it finds anything that
// knows its own answer. Each level costs one more set of atomics on an entry shared by four times
// as many faces, so the traffic per level falls as fast as the sharing rises.
const uint kAncestorWrites = 6u;

// Samples at which a face has earned its own voxel back.
const float kSharpSamples = 256.0;

// How curved the surface is under this pixel, from how far its real normal has turned away from
// the axis of the face it belongs to. Nought on a flat wall, rising round a column or a vault.
//
// This is what makes the coarse levels aware of the shape rather than merely of the place. A
// coarse entry pools every face within a block that shares an AXIS, and on a curved surface those
// faces are looking in genuinely different directions and receiving genuinely different light — so
// pooling them returns the curve's average and the curve shades flat. Damping the coarse levels
// where the surface turns keeps the gradient: a column stays round, a barrel vault keeps its
// falloff, and a flat wall, where the signal is nought, is unaffected and keeps all its pooling.
//
// `shading_normal` already separates a curve from a corner — see the note at the top of
// pt_normals.glsl — so what arrives here is the curve and not the staircase of a voxel edge.
float surface_curve(vec3 smooth_normal, ivec3 face) {
    return clamp(1.0 - dot(smooth_normal, normalize(vec3(face))), 0.0, 1.0);
}

// How hard the marcher worked to get here, against how far it came. One is ordinary.
float shape_complexity(float t, uint steps) {
    float expected = 4.0 + max(t, 0.0) * 0.06;
    return clamp(float(steps) / expected - 1.0, 0.0, 1.0);
}

// How much of the fine end survives on the most complicated geometry there is. Never nought: a
// carved surface still knows its own light better than the wall behind it does.
const float kShapeTrust = 0.35;

// How much of a coarse level survives, per level, where the surface is fully turned away from its
// own axis. A curve holds on to its own measurements rather than borrowing the block's average.
const float kCurveHolds = 0.45;


// How many standard errors apart two faces have to be before they count as genuinely different
// light rather than the same light measured twice.
//
// This is the whole of the edge stopping, and it is a statistical test rather than a threshold
// on brightness. A face's mean has a standard error that shrinks as its samples grow, so two
// noisy neighbours are indistinguishable and blend freely, while two well-measured ones a long
// way apart stay apart. A shadow edge therefore sharpens on its own as it is measured, instead
// of being either permanently soft or permanently stepped.
const float kEdgeSigmas = 4.0;


// How far to reach, given how much a face already knows.
int face_rings(uint count) {
    if (count >= kFaceSettled) return 0;
    if (count >= 256u) return 1;
    if (count >= 64u) return 2;
    return kFaceRings;
}

// The two axes across a face, which are the two the normal is not.
void face_tangents(ivec3 normal, out ivec3 a, out ivec3 b) {
    if (normal.x != 0)      { a = ivec3(0, 1, 0); b = ivec3(0, 0, 1); }
    else if (normal.y != 0) { a = ivec3(1, 0, 0); b = ivec3(0, 0, 1); }
    else                    { a = ivec3(1, 0, 0); b = ivec3(0, 1, 0); }
}

// One tap of the a-trous kernel: `ring` faces out across the surface, in one of eight directions.
// The node size doubles with the level, so a step is one face at whatever level is being read.
//
// Eight and not four. The first four are the cross — up, down, left, right — and the second four
// are the diagonals, which cost one more tap each and roughly halve what a ring leaves behind: a
// cross of four samples is a poor estimator of a neighbourhood and a ring of eight is a
// respectable one. This is where the noise a coarser cache used to hide is dealt with instead,
// and the difference is that a filter can be stopped at an edge — a shared cache entry cannot,
// which is why it came back as squares on a wall.
const int kFaceTaps = 8;

ivec3 face_step(ivec3 a, ivec3 b, int which, uint level, int ring) {
    int size = (1 << level) << ring;
    if (which < 4) {
        ivec3 axis = ((which & 1) == 0) ? a : b;
        return axis * (((which & 2) == 0) ? size : -size);
    }
    // The corners of the ring.
    int corner = which - 4;
    return a * (((corner & 1) == 0) ? size : -size) +
           b * (((corner & 2) == 0) ? size : -size);
}

// How far a ray has to leave a surface by before it is clear of it, in voxels.
//
// Two things set it, and only one of them is geometry.
//
// A summary cell is a metre or more across, and leaving one by a hundredth of a voxel lands the
// ray straight back inside the block it just left -- so every shadow ray reported occluded and
// every bounce found the same surface again, and distant chunks came out uniformly black. Levels
// 5 and up carry their tier, so the cell size is known: a tier's cells are 2^tier metres, which
// is 32 << tier voxels.
//
// The other is arithmetic. The point is rebuilt as origin + dir * t, and t is a single-precision
// number accumulated over a long walk, so its error grows with distance. Past a hundred metres
// or so that error is larger than a hundredth of a voxel and the rebuilt point lands *below* the
// surface it came from. The shadow ray starts inside the ground, reports occluded, and the face
// records that it cannot see the sun -- so open ground with nothing above it goes pitch black,
// at distance only, while the same ground is lit close to. Measured on the test platform at a
// hundred and twenty metres: four shadow rays in five said occluded, and the entries holding
// that answer were present and full, which is why it looked like a caching problem and was not.
//
// So the offset is relative to how far the ray has come, with the old constant as its floor. It
// stays well under a voxel at any distance the marcher resolves, so it cannot step through thin
// geometry.
const float kSurfaceRelative = 1.0e-4;

float surface_offset(int level, float t) {
    float base = (level < 5) ? 0.01 : float(32u << uint(level - 5)) * 0.75;
    return max(base, t * kSurfaceRelative);
}

// Reads a node at a *fractional* level, blending the two it falls between.
//
// The level is picked from distance and is part of the key, so a whole-number level means a
// surface swaps to a different entry Ã¢â‚¬â€ with its own separate history Ã¢â‚¬â€ the moment you cross a
// distance boundary. Walking towards a wall made its brightness step, and because each entry
// keeps its own long average the step did not settle, it smeared. Blending is the same
// continuous-detail rule the marcher already uses for geometry, applied to light.
// Irradiance, filtered across the surface it belongs to.
//
// Samples add rather than opinions being mixed, so this is the mean of everything the
// neighbourhood has measured: a face with almost nothing of its own is given a usable answer
// without the answer being invented, and one with plenty barely moves.
FaceLight gather_face(ivec3 voxel, ivec3 normal, uint level, uint frame, FaceLight self) {
    int rings = face_rings(self.known ? self.count : 0u);
    if (rings == 0) return self;

    ivec3 ta, tb;
    face_tangents(normal, ta, tb);

    float lum_self = self.known ? face_luminance(self.indirect) : 0.0;
    // The standard error of a mean: how far this face's answer is expected to be wrong by, which
    // falls as the square root of its samples. A face with nothing gets a wide tolerance and
    // takes whatever its neighbours say; a face with hundreds gets a narrow one and keeps its
    // own. Nothing here is a brightness threshold — it is all in units of its own uncertainty.
    float error_self = self.known
                           ? (lum_self + kEdgeFloor) * inversesqrt(float(max(self.count, 1u)))
                           : 1e3;

    vec3 sum = self.known ? self.indirect * float(self.count) : vec3(0.0);
    float weight = self.known ? float(self.count) : 0.0;

    for (int ring = 0; ring < rings; ++ring) {
        // Halving with distance, which is the a-trous kernel: the far taps cover ground the near
        // ones cannot and are trusted less for it.
        float falloff = 1.0 / float(1 << ring);
        for (int i = 0; i < kFaceTaps; ++i) {
            uint lo, hi;
            face_key(voxel + face_step(ta, tb, i, level, ring), normal, level, kFaceIndirect,
                     lo, hi);
            FaceLight side = read_face(face_slot(lo, hi, false, frame));
            if (!side.known) continue;

            float lum_side = face_luminance(side.indirect);
            float error_side = (lum_side + kEdgeFloor) * inversesqrt(float(side.count));
            float tolerance = kEdgeSigmas * (error_self + error_side);
            // Two faces that differ by less than their own uncertainty are the same light
            // measured twice, and averaging them is free accuracy. Two that differ by far more
            // are a real boundary — the edge of a shadow, the turn into a doorway — and this
            // falls away fast enough to leave it alone.
            float agreement = exp(-abs(lum_side - lum_self) / max(tolerance, 1e-4));

            float w = float(side.count) * falloff * agreement;
            sum += side.indirect * w;
            weight += w;
        }
    }
    if (weight <= 0.0) return self;

    FaceLight pooled;
    pooled.indirect = sum / weight;
    pooled.visibility = self.visibility;
    // What the answer now stands on, which is the neighbourhood's worth rather than this face's.
    // A face backed by well-measured neighbours genuinely does know enough to stop leaning on a
    // coarse ancestor, and saying so is what keeps the blocky fallback off the screen.
    pooled.count = uint(weight);
    // Pooling with the neighbours is itself a reduction in uncertainty, by the root of how many
    // samples now stand behind the answer against how many this face had alone.
    pooled.error = self.known ? self.error * sqrt(float(max(self.count, 1u)) / max(weight, 1.0))
                              : 1.0;
    pooled.known = true;
    return pooled;
}

// The sun's visibility, filtered the same way and with the right statistics for it.
//
// Visibility is a fraction of rays that got through, so its uncertainty is binomial rather than
// proportional: sqrt(v(1-v)/n). That matters, because it is exactly zero when a face is fully
// lit or fully shadowed however few samples it has. A face in open sun and its neighbour in open
// sun agree perfectly and blend at no cost; a face on the edge, where v is near a half and the
// error is largest, blends most — which is where a penumbra belongs. So the softness appears
// where the answer is genuinely uncertain and nowhere else, and it tightens by itself as the
// rays accumulate rather than being a fixed blur anyone chose.
const uint kShadowSettled = 256u;

float gather_shadow(ivec3 voxel, ivec3 normal, uint frame, uint own_count, float own) {
    int rings = face_rings(own_count >= kShadowSettled ? kFaceSettled : own_count);
    if (rings == 0) return own;

    ivec3 ta, tb;
    face_tangents(normal, ta, tb);

    float error_self = (own_count > 0u)
                           ? sqrt(max(own * (1.0 - own), 0.0) / float(own_count)) + kEdgeFloor
                           : 1e3;

    float sum = own * float(own_count);
    float weight = float(own_count);

    for (int ring = 0; ring < rings; ++ring) {
        float falloff = 1.0 / float(1 << ring);
        for (int i = 0; i < 4; ++i) {
            uint lo, hi;
            face_key(voxel + face_step(ta, tb, i, kShadowLevel, ring), normal, kShadowLevel,
                     kFaceShadow, lo, hi);
            uint slot = face_slot(lo, hi, false, frame);
            if (slot == 0xFFFFFFFFu) continue;
            uint count = faces.items[slot].count;
            if (count == 0u) continue;

            float side = read_shadow(slot);
            float error_side = sqrt(max(side * (1.0 - side), 0.0) / float(count)) + kEdgeFloor;
            float tolerance = kEdgeSigmas * (error_self + error_side);
            float agreement = exp(-abs(side - own) / max(tolerance, 1e-4));

            float w = float(count) * falloff * agreement;
            sum += side * w;
            weight += w;
        }
    }
    return (weight > 0.0) ? sum / weight : own;
}

// ---- carrying history forward, in face space ------------------------------------------
//
// A screen-space path tracer reprojects because its history is stored per pixel and pixels
// move. None of that applies here and none of it is wanted: a face is its own address in the
// world, so its history is found by *key*. Turning the camera, walking sideways, looking away
// for a minute and back — none of it loses anything, and there is no projection to get wrong,
// no disocclusion to detect, and no smear to leave behind. That much the cache already did.
//
// What genuinely does change under a face is its *level*. Detail is picked from distance, and
// the level is part of the key, so walking towards a wall makes every face on it hand over to a
// finer entry — a different key, with no history at all. That is the one place in this renderer
// where a body of accumulated light exists, is still valid, and is about to be dropped. It is
// the exact situation reprojection exists for, in the one axis where it applies.
//
// So it is carried, at the moment the finer entry comes into existence, from the coarser one
// covering the same place. And unlike a screen-space reprojection this needs no validation
// whatsoever: the parent is not an estimate of where the surface probably was, it *is* the same
// piece of world, one level up. There is nothing to be wrong about.
//
// It arrives worth a modest number of samples, so it settles the face immediately and is then
// outvoted within a fraction of a second by measurements at the face's own size. That is what
// stops the coarse ancestor being *shown*: before this, a fresh face had nothing of its own and
// was read straight from a node six levels up — a block sixty-four voxels across, which is
// precisely the chunky shadow that kept reappearing whenever the camera turned or came in from
// far away. Now the coarse value seeds the fine entry and is refined there, instead of standing
// in for it on screen.
const uint kInheritSamples = 12u;

void seed_face(uint slot, ivec3 voxel, ivec3 normal, uint level, uint frame) {
    if (slot == 0xFFFFFFFFu) return;
    if (faces.items[slot].count != 0u) return;   // it already has a history of its own

    // The nearest ancestor that knows anything. One level up is usually enough, because every
    // sample contributes to its parent as well, so the parent is populated by construction.
    FaceLight from;
    from.known = false;
    for (uint up = 1u; up < kParentLevels && level + up <= 6u; ++up) {
        uint plo, phi;
        face_key(voxel, normal, level + up, kFaceIndirect, plo, phi);
        from = read_face(face_slot(plo, phi, false, frame));
        if (from.known) break;
    }
    if (!from.known) return;

    // Exactly one thread seeds it. The compare-and-swap is the claim: whoever moves the count
    // off zero owns the right to add the samples that go with it, and everyone else leaves it
    // alone. Without that, every pixel standing on a face seeds it at once and the entry starts
    // life holding its inheritance a hundred times over.
    if (atomicCompSwap(faces.items[slot].count, 0u, kInheritSamples) != 0u) return;
    vec3 carried = from.indirect * float(kInheritSamples) * kFixedScale;
    atomicAdd(faces.items[slot].sum.x, uint(carried.r));
    atomicAdd(faces.items[slot].sum.y, uint(carried.g));
    atomicAdd(faces.items[slot].sum.z, uint(carried.b));
}

// The same for the sun, from the one ancestor its entries keep.
void seed_shadow(uint slot, ivec3 voxel, ivec3 normal, uint frame) {
    if (slot == 0xFFFFFFFFu) return;
    if (faces.items[slot].count != 0u) return;

    uint plo, phi;
    face_key(voxel, normal, kShadowParentLevel, kFaceShadow, plo, phi);
    uint parent = face_slot(plo, phi, false, frame);
    if (parent == 0xFFFFFFFFu || faces.items[parent].count == 0u) return;
    float carried = read_shadow(parent);

    if (atomicCompSwap(faces.items[slot].count, 0u, kInheritSamples) != 0u) return;
    atomicAdd(faces.items[slot].sum.w, uint(carried * float(kInheritSamples) * kFixedScale));
}

// ---- next-event estimation ------------------------------------------------------------
//
// A lamp is a voxel like any other, so until now it was found the only way anything is found:
// by a bounce happening to point at it. For the sun that would be hopeless, which is why the sun
// has always been sampled directly — and for a lamp in a room it is very nearly as hopeless. A
// three-centimetre lamp across a room covers a millionth of the hemisphere, so a face needs a
// million bounces before it learns the lamp is there, and until then the room is lit by whatever
// bounces happened to get lucky. That is the noise indoors.
//
// So a lamp gets asked directly, exactly as the sun does.
//
// This has been attempted once before and it put the lights out. The cause was not the idea but
// the bookkeeping: emission found by a bounce was suppressed whenever any lamp existed, while
// the direct sampling only covered the nearest handful — so light from every lamp past the
// eighth, and from every sunlit surface, simply vanished. What follows is arranged so that
// cannot happen. The two strategies *partition* the light rather than overlapping it: direct
// sampling owns emitters and nothing else, bounces own everything that is not an emitter, and
// each is divided by the probability of having been chosen. Nothing is counted twice and
// nothing is dropped.
//
// And the partition is only taken when it can be owned completely. A truncated lamp list would
// bring back precisely the original bug, so a full list turns the whole thing off instead.
const uint kNeeCandidates = 8u;

// How often a diffuse sample asks a lamp rather than bouncing.
//
// Not a constant, and a constant is what made the first version worse rather than better. Half
// the rays spent asking about lamps is right for a room lit by one, and badly wrong for a sunlit
// field with decorative lights on it — there the lamps contribute almost nothing and half the
// budget goes to measuring it, while the sky and sun that carry the actual light get half as
// many rays as before. Measured: the platform's noise went from 0.93 to 1.01 doing exactly that.
//
// So the split follows the light. The candidate draw already estimates what the lamps would
// deliver, and it costs no rays, so it can be made before the choice rather than after it; set
// against the sun and sky the same face is receiving, it gives the share of the light lamps are
// actually responsible for. A face in a dark room asks lamps nearly always, a face in open sun
// almost never, and neither has to be told which it is.
// The floor is low on purpose. It exists only to keep the division by it finite — it is not a
// minimum amount of attention lamps deserve, and treating it as one costs real noise. If the
// lamps are half a per cent of the light reaching a face, then half a per cent of its rays is
// exactly the right share; a floor of one in twenty spent forty times that on measuring almost
// nothing, and the outdoor scenes went from 0.934 speckle to 0.976 paying for it.
const float kNeeMinChance = 0.005;
const float kNeeMaxChance = 0.50;

// ---- what a reservoir would be here, and why there is not one ---------------------------
//
// The draw below is resampled importance sampling and it stops there: eight candidates drawn
// uniformly, one kept, and everything the draw learned thrown away at the end of the pixel.
// ReSTIR's answer is a reservoir — keep the chosen sample together with the weight of everything
// it beat, so it can be combined with a neighbour's and with its own from last frame, and the
// effective candidate count climbs into the hundreds. It was built here, measured, and taken out
// again. What it did and why is written down because it is the obvious thing to reach for, and
// the next person will reach for it.
//
// A reservoir is per pixel in every renderer that has one, because a pixel is the only address
// those renderers have. This one caches per voxel face, and a face is the better address: it is in
// the world, it does not move when the eye does, and hundreds of pixels stand on it at once — so a
// face-keyed reservoir gathers in one frame the candidate count a per-pixel one needs a hundred
// frames of temporal reuse to reach. Spatial and temporal reuse even stop being two things: a face
// under the camera fills its window from many pixels in a frame, one across the hall fills it from
// one pixel over a hundred frames, and neither has to be arranged.
//
// The trouble is what a reservoir *is*. It holds one chosen sample, and everybody who reads it
// shades from that same sample. Per pixel that is fine, because neighbouring pixels hold different
// samples and the picture averages them. Per face it is not, because a face's answer is *already*
// the average of its pixels' samples, and that average is where the whole of this renderer's
// variance reduction comes from. Five hundred pixels all shooting at the one lamp the reservoir
// chose measure that lamp five hundred times and every other lamp nought times; if it is behind a
// wall they all come back black together and the face records that there is no light here, which
// is the one thing a face must never be taught wrongly, because a cache does not wash out. Sharing
// the sample trades five hundred independent measurements for one, and the sharing is the only
// reason the face cache works at all.
//
// So what was built kept the reservoir as the face's *proposal* and never as its sample. One lamp
// per face held a seat, won by an exponential-race reservoir living in a single word of a face
// entry — twenty-two bits of clock and ten of lamp index, settled by one atomicMax because a
// maximum is the one selection rule a thousand threads can run at once without a lock, and decayed
// by one doubling per window so that no incumbent could hold the seat for ever. That lamp was
// offered to every pixel as a ninth candidate on top of the eight uniform ones, and every pixel
// still ran its own resampling over the nine and kept its own answer, so nothing was shared but
// the shortlist. The seat could then be decided by the one thing an unshaded score can never know
// — a lamp that came back dark did not compete for it and gave it up at once if it held it —
// because a proposal is corrected by the balance heuristic whatever it proposes and stays unbiased
// even when it is chosen adversarially.
//
// It is correct, and it does not pay, and the reason is the part worth keeping. Under the balance
// heuristic a lamp proposed deterministically carries weight p/(1 + C/N) where a uniformly drawn
// one carries p*N/C, so a seat contributes to the estimator exactly the share of the unshaded
// total that its own lamp is worth — no more, however certain the face is about it. What it
// removes is the *variance* of whether that share was drawn at all. Where one lamp is most of what
// a surface receives, that is nearly all of the variance and the seat is worth a great deal; where
// a face sees five sconces of similar brightness it is a fifth of it. And the visibility the seat
// had learned buys nothing, because the balance heuristic reweights by the unshaded density and
// hands the knowledge straight back. Visibility pays only if it enters the target function itself,
// and the target has to be recomputable from a lamp index at the moment the sample is weighted,
// which a learned per-face-per-lamp visibility is not without a cache of its own.
//
// Measured in clips/many_lamps.clip — a sealed hall, thirty-six sconces, partitions cutting the
// sight lines so a face sees five of them — interleaved against its own control over several
// rounds, because other work in this tree moves the baseline between one measurement and the next:
// speckle 5.11 to 5.25 at the corner view and 6.35 to 6.66 standing close to a wall, so two to
// five per cent *worse*, with mean brightness unmoved to a tenth of a per cent. Against that it
// costs a fifth kind of face entry and a fifth eight-probe claim through a quarter of a gigabyte
// on every pixel that asks a lamp, and this file already records what happens when that table
// saturates. Correct, cheap to write, and not worth its claim.
//
// What would be worth it is the thing the seat kept bumping into. The sun's visibility is cached
// per face and a lamp's is not, and that asymmetry is where the noise in a lamp-lit room actually
// lives: thirty of those thirty-six lamps are behind a wall and every draw pays for them. A
// visibility term keyed by (node, normal, lamp) at a coarse level, floored well above zero so that
// no lamp can ever be extinguished by a wrong entry, folded into the target function rather than
// into the proposal, is the change that would make fifty sconces converge like one. It is a new
// kind of entry with a population of its own to budget for, which is why it is written down here
// rather than done.

// What one lamp would deliver to this face with nothing in the way: the target function the draw
// scores by. The score and the density the kept sample is divided by have to be this same
// expression, or the sample is not drawn from the distribution it is corrected by.
float light_target(uint index, vec3 from, vec3 normal, out vec3 centre, out float radius) {
    LightSource lamp = lights.items[index];
    // The list is in absolute world voxels; the shader stands in its camera chunk.
    centre = vec3(float(lamp.x), float(lamp.y), float(lamp.z)) + 0.5 -
             vec3(push.camera_chunk.xyz) * float(kChunkEdge);
    // A cluster of voxels, treated as the sphere that *contains* it rather than the one of the
    // same volume. The difference is not cosmetic. Direct sampling owns emitters outright, so a
    // cone too narrow to cover the lamp does not merely sample it badly — the light from the
    // parts outside the cone is owned by nobody and goes out. An equal-volume sphere covers about
    // half a cube, and the room measured thirteen per cent too dark against a long reference run
    // because of it. Erring the other way costs nothing but noise: a direction that overshoots
    // the lamp finds a wall and honestly reports nought.
    //
    // A sphere is what the record can describe, and it is the one thing left that a large fitting
    // is genuinely badly served by. A fitting is a box of emissive voxels; where it is longer than
    // it is wide, world/light_list.hpp inflates this count until the sphere covers that box, so
    // the cone drawn round it is mostly empty air and most rays aimed into it miss. That is honest
    // and it is noisy, and no arrangement of what is stored here can fix it: it needs the box.
    // Three more numbers on LightSource — the fitting's half-extent — and this becomes the solid
    // angle of a box rather than of the sphere that swallows it, which is where a metre-wide
    // lantern's penumbra would come from.
    radius = max(0.87 * pow(float(max(lamp.voxels, 1u)), 1.0 / 3.0), 0.87);

    vec3 to = centre - from;
    float distance_sq = max(dot(to, to), 1e-4);
    float cos_surface = dot(to * inversesqrt(distance_sq), normal);
    if (cos_surface <= 0.0) return 0.0;   // behind the face

    // The solid angle the lamp's sphere actually covers, rather than r^2/d^2 standing in for it.
    //
    // The two agree to a fraction of a per cent once the lamp is more than a couple of radii away
    // — the factor of two is what makes them agree there — and part company close to, where the
    // proxy has to be clamped at one or it runs away. Clamped, it says a lamp an arm's length from
    // a wall is worth no more than the same lamp across the room, when the truth is that it covers
    // half that wall's sky, so the draw stops preferring the lamp that lights a surface at exactly
    // the distance where it lights it most.
    //
    // It is a better importance function and it does not show: measured against the proxy in
    // clips/many_lamps.clip, including a view standing an arm's length from a sconce, the two are
    // identical to a tenth of a per cent in mean brightness and half a per cent in speckle, which
    // is inside the spread between runs of one build. This is here on the argument and not on the
    // number, and the number is written down so that nobody measures it again expecting one.
    float sin_max_sq = min(radius * radius / distance_sq, 1.0);
    float solid = 2.0 * (1.0 - sqrt(1.0 - sin_max_sq));
    return face_luminance(vec3(lamp.red, lamp.green, lamp.blue)) * cos_surface * solid;
}

struct LightPick {
    vec3 dir;
    float inv_pdf;   // 1 / p(dir), in solid angle
    float estimate;  // luminance the lamps would deliver here with nothing in the way
    bool valid;
};

// Resampled importance sampling, and it is not a refinement here — it is the difference between
// this helping and hurting. The test scene holds eighty-four lamps. Picking one uniformly makes
// about one sample in eighty-four useful and gives it eighty-four times the weight, which is
// unbiased and far noisier than doing nothing at all. So a handful of candidates are drawn, each
// scored by the light it would deliver if nothing were in the way, and one is kept in proportion
// to that score. The estimator is corrected by the total weight the draw saw, which keeps it
// unbiased while concentrating the samples on the lamps that actually matter to this face.
//
// Each candidate is divided by the density of the proposal that produced it, rather than the
// whole draw being scaled by light_count/candidates at the end. Those are the same number while
// every candidate is drawn uniformly, which is the case today — but writing it this way is what
// lets a candidate arrive from somewhere other than the uniform draw without the correction
// having to be rederived. It is the balance heuristic's denominator, waiting for a second
// proposal; see the note above on why there is not one yet.
LightPick pick_light(vec3 from, vec3 normal, uint light_count, inout uint state) {
    LightPick pick;
    pick.dir = normal;
    pick.inv_pdf = 0.0;
    pick.estimate = 0.0;
    pick.valid = false;

    uint candidates = min(light_count, kNeeCandidates);
    float uniform_density = float(candidates) / float(light_count);

    float weight_sum = 0.0;
    float chosen_target = 0.0;
    vec3 chosen_centre = vec3(0.0);
    float chosen_radius = 0.87;

    for (uint i = 0u; i < candidates; ++i) {
        uint index = min(uint(rand(state) * float(light_count)), light_count - 1u);

        vec3 centre;
        float radius;
        float target = light_target(index, from, normal, centre, radius);
        if (target <= 0.0) continue;

        float w = target / uniform_density;

        weight_sum += w;
        if (rand(state) * weight_sum <= w) {
            chosen_target = target;
            chosen_centre = centre;
            chosen_radius = radius;
        }
    }
    // What every lamp in the list would deliver here, unshaded: the total weight the draw saw,
    // each candidate already carrying the reciprocal of the density that produced it. This is the
    // number the strategy split is decided by.
    pick.estimate = weight_sum;
    if (chosen_target <= 0.0) return pick;

    // A direction inside the cone the lamp covers, which is what gives it a real solid-angle
    // density rather than the degenerate one a point light would have.
    // No floor under the distance, where there used to be one of a whole voxel, and the ratio of
    // radius to distance is allowed to reach one where it used to stop a ten-thousandth short.
    //
    // Both were holes in the same invariant rather than anything visible. A cone narrower than the
    // lamp does not merely sample it badly: the part left outside is owned by nobody, because
    // direct sampling owns emitters and the bounce is forbidden them. Floored, a point closer to
    // the lamp's centre than one voxel was given a sixty-degree cone round a lamp filling its sky;
    // stopped short of one, a point inside the lamp's own sphere got 89.2 degrees where it wanted
    // 90. Neither case arises in any scene here that could be measured — every view tried came out
    // identical to a tenth of a per cent — and both are a hole in a rule the rest of this file
    // leans on, which is reason enough to close them.
    vec3 to = chosen_centre - from;
    float distance_sq = max(dot(to, to), 1e-6);
    vec3 towards = to * inversesqrt(distance_sq);
    float sin_max_sq = clamp(chosen_radius * chosen_radius / distance_sq, 0.0, 1.0);
    float cos_max = sqrt(1.0 - sin_max_sq);

    // Drawn independently, and not stratified across the pixels of the face the way the sun's disc
    // is. That asymmetry looks wrong and is not, and it was measured both ways before it was left
    // alone.
    //
    // The sun works because every pixel samples the *same* sun: a cell of the disc handed out by
    // pixel position means the same thing to all of them, so the pixels covering a face sweep the
    // whole disc between them and its penumbra resolves. Lamps are drawn, and neighbouring pixels
    // routinely draw different ones — a shared cell index is then a cell of different cones, which
    // covers nothing evenly and only correlates the draw. Measured in clips/many_lamps.clip:
    // stratified, the view down a hall of small distant sconces cost one per cent of speckle and
    // the view standing beside a fitting returned about half a per cent, so it is a wash. Gating
    // it on the kept lamp being more than half of the draw's weight — which is when the neighbours
    // have probably kept the same one — moved neither number: 5.09 to 5.13 at the corner and 6.55
    // to 6.50 close to, against a spread of 0.3 per cent between runs of one build.
    //
    // So it is left independent, which is the cheaper of two equals. What a large fitting's
    // penumbra actually wants is the sampling below to know the shape of the fitting rather than
    // the sphere round it; see the note on LightSource extents.
    vec2 u = vec2(rand(state), rand(state));
    float cos_theta = mix(cos_max, 1.0, u.x);
    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    float phi = 2.0 * kPi * u.y;

    vec3 up = (abs(towards.z) < 0.999) ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, towards));
    vec3 bitangent = cross(towards, tangent);
    pick.dir = normalize(tangent * (cos(phi) * sin_theta) + bitangent * (sin(phi) * sin_theta) +
                         towards * cos_theta);

    float pdf_direction = 1.0 / (2.0 * kPi * max(1.0 - cos_max, 1e-6));
    // The resampling correction: the kept candidate stands in for every one the draw saw, so its
    // density is scaled by the total weight against its own. The uniform density over the whole
    // list is already inside weight_sum, carried there by the balance heuristic.
    pick.inv_pdf = (weight_sum / chosen_target) / pdf_direction;
    pick.valid = dot(pick.dir, normal) > 0.0;
    return pick;
}

// The light here, composed from every level that knows anything, finest first.
//
// # Detail is an overlay, not a rung
//
// There is no level of detail here and nothing swaps. Every level of the pyramid over this face is
// a measurement of the same light across a different sized piece of the same surface, and they are
// composited the way layers are: the finest level lays down as much of the answer as it can
// support, whatever it cannot support passes through, and the next level down catches it. What
// reaches the bottom is a piece of surface a hundred voxels across that has been measured tens of
// thousands of times and is therefore never in doubt.
//
// So the fine answer always wins where it exists, the coarse answer is only ever what shows
// through where nothing finer has been measured, and both are visible at once in the same pixel in
// whatever proportion each has earned. There is no boundary between blocky lighting and detailed
// lighting because they are not two things — a pixel is some of each, continuously, and the
// proportion moves every frame as samples arrive.
//
// # What makes it blocky, and none of it is a setting
//
// RESOLUTION decides where the walk starts: the base level is the footprint in voxels under a
// pixel, so rendering smaller starts the composite further up the pyramid and the light is
// blockier. Continuously, with no rungs and no limit.
//
// RAY INFORMATION decides how far down the walk goes, and it needs no term of its own — a level
// that has been measured twice can support almost none of the answer and passes almost all of it
// on, which IS the fallback. A face that has never been seen shows its ancestor; the same face a
// second later shows itself.
//
// SHAPE decides how much the finest levels are trusted to begin with. Complicated geometry is
// where the fine answer is dearest — a hundred tiny faces each starved — and least visible,
// because the shape is already busy. A flat wall keeps its detail; a carved cornice lets more
// through.
//
// # Why it costs about what the old two-level blend cost
//
// The walk stops as soon as the answer is covered, so a settled face reads one level and leaves.
// Only the starved ones climb, and they are the ones that would have been noise.
FaceLight read_face_pyramid(ivec3 voxel, ivec3 normal, float base, float complexity,
                            float curve, uint frame) {
    uint start = uint(clamp(floor(base), 0.0, float(kMaxFaceLevel)));

    // The finest level fades out as the base crosses into the next one, so walking towards a wall
    // hands over smoothly instead of stepping. This is the only place the fractional part is used
    // and it is the whole of the distance continuity.
    float first_share = 1.0 - fract(clamp(base, 0.0, float(kMaxFaceLevel)));

    // How much of the fine end is trusted at all. Busy geometry lets more through to the coarse
    // levels; a flat surface keeps what it has measured.
    float fine_trust = mix(1.0, kShapeTrust, clamp(complexity, 0.0, 1.0));

    // What each level above the first keeps, compounding as the walk climbs. On a flat surface
    // this is one and the pyramid behaves exactly as before; on a curve it falls away, so the
    // answer stays near the levels small enough to still be following the shape.
    float coarse_keep = 1.0 - kCurveHolds * clamp(curve, 0.0, 1.0);

    vec3 light = vec3(0.0);
    float visible = 0.0;
    float carried = 0.0;      // how much of the answer has been laid down
    float remaining = 1.0;    // and how much is still showing through
    uint samples = 0u;
    float error = 1.0;
    bool any = false;

    for (uint l = start; l <= kMaxFaceLevel; ++l) {
        uint lo, hi;
        face_key(voxel, normal, l, kFaceIndirect, lo, hi);
        FaceLight entry = read_face(face_slot(lo, hi, false, frame));

        // Only the finest level is filtered across its neighbours. The coarse ones are already an
        // average over hundreds of faces and filtering them again buys nothing for real cost.
        if (l == start) entry = gather_face(voxel, normal, l, frame, entry);
        if (!entry.known) continue;

        // What this level can support: how close it is to knowing its own answer.
        float cover = clamp(float(entry.count) / kSharpSamples, 0.0, 1.0);
        if (l == start) cover *= first_share * fine_trust;
        else {
            cover *= pow(coarse_keep, float(l - start));
            if (l == start + 1u) cover *= fine_trust;
        }

        float take = remaining * cover;
        if (take <= 0.0) continue;

        light += entry.indirect * take;
        visible += entry.visibility * take;
        samples += entry.count;
        error = any ? min(error, entry.error) : entry.error;
        carried += take;
        remaining -= take;
        any = true;
        if (remaining < 0.002) break;
    }

    FaceLight out_light;
    out_light.known = any && carried > 0.0;
    if (!out_light.known) {
        out_light.visibility = 0.0;
        out_light.indirect = vec3(0.0);
        out_light.count = 0u;
        out_light.error = 1e3;
        return out_light;
    }
    // Normalised by what was actually laid down. If even the coarsest level was thin, the answer
    // is still the best available average of everything that had anything to say.
    out_light.indirect = light / carried;
    out_light.visibility = visible / carried;
    out_light.count = samples;
    out_light.error = error;
    return out_light;
}

FaceLight read_face_seeded(ivec3 voxel, ivec3 normal, uint level, uint frame) {
    uint lo, hi;
    face_key(voxel, normal, level, kFaceIndirect, lo, hi);
    FaceLight self = gather_face(voxel, normal, level, frame,
                                 read_face(face_slot(lo, hi, false, frame)));
    if (self.known && self.count >= kSeedSamples) return self;

    // Find the nearest ancestor that knows anything.
    FaceLight parent;
    parent.known = false;
    for (uint up = 1u; up < kParentLevels && level + up <= 6u; ++up) {
        uint plo, phi;
        face_key(voxel, normal, level + up, kFaceIndirect, plo, phi);
        parent = read_face(face_slot(plo, phi, false, frame));
        if (parent.known) break;
    }
    if (!parent.known) return self;
    if (!self.known) return parent;

    // Blend rather than switch. A node with three samples of its own is mostly noise and
    // should mostly show its parent; by the time it has a few dozen it should be showing
    // itself. Switching at a threshold instead puts a visible seam wherever the threshold
    // falls, which on a wall lit from one side is a line across it.
    float weight = float(self.count) / float(kSeedSamples);
    FaceLight blended;
    blended.visibility = mix(parent.visibility, self.visibility, weight);
    blended.indirect = mix(parent.indirect, self.indirect, weight);
    blended.count = self.count;
    blended.known = true;
    return blended;
}

// How blocky the light is, as a continuous number of levels above what the pixel resolves.
//
// Not a level-of-detail ladder. There are no rungs and nothing swaps: the level is a real number,
// the two integer levels either side of it are both read, and the answer is mixed between them.
// Three things push it up, and each is a different reason the fine answer is not worth having.
//
// RESOLUTION. Already the whole of the base level, and it always was: the footprint is
// `t * pixel_angle` where the angle is the field of view over the render HEIGHT, so halving the
// resolution doubles the voxels under a pixel and coarsens the light by one level on its own.
// Rendering small is therefore blockier than rendering large, continuously and with no limit,
// which is what a lower setting should mean.
//
// RAY INFORMATION. A face that has been measured once cannot say anything a face measured a
// hundred times cannot say better, and the larger piece of surface it belongs to HAS been measured
// a hundred times, because it is a hundred faces. So a starved face reads from its parent and
// sharpens towards its own voxel as it learns. This is the term that makes a moving camera clean:
// what a player sees while turning is entirely faces that have just come into view, and those now
// come in smooth and coarse instead of sharp and wrong.
//
// SHAPE. The marcher's own step count says how complicated the geometry here is, relative to how
// far the ray had to travel. Complex geometry is exactly where the fine answer is both dearest —
// a hundred tiny faces each starved of samples — and least visible, because the shape itself is
// already busy. A flat wall keeps its detail; a carved cornice shares.
//
// There is no ceiling on the sum beyond the one arithmetic imposes: `voxel >> level` stops meaning
// anything past thirty-one, and a level of twelve already shares four thousand voxels along a
// surface, which is larger than any room in the building.

// The node size a pixel can resolve at this distance, as a power of two. The geometry is
// still marched at full voxel detail - this only decides how coarsely faces are *shared*.
float cache_level_exact(float t) {
    float pixel_angle = 2.0 * push.lens.x / float(push.resolution.y);
    float footprint = max(t * pixel_angle, 1.0);
    return clamp(log2(footprint), 0.0, float(kMaxFaceLevel));
}

uint cache_level(float t) {
    float pixel_angle = 2.0 * push.lens.x / float(push.resolution.y);
    float footprint = max(t * pixel_angle, 1.0);
    // Capped at 6, and raising it makes things worse, which is worth writing down because the
    // opposite is the intuition. The level is part of the key, so allowing more of them splits
    // distant surfaces across level 7, 8, 9 and 10 entries instead of pooling them in one -
    // and adjacent pixels either side of a distance boundary then look up different keys.
    // Measured: raising the cap to 10 took uncached surface pixels from 3,661 to 18,392.
    return uint(clamp(floor(log2(footprint)), 0.0, 6.0));
}


// The Fresnel weight this surface gives its reflection, at this viewing angle.
vec3 specular_weight(vec3 normal, vec3 view, Material m) {
    float n_dot_v = max(dot(normal, view), 1e-4);
    vec3 f0 = mix(vec3(0.04), m.albedo, m.metallic);
    return f0 + (vec3(1.0) - f0) * pow(1.0 - n_dot_v, 5.0);
}

// What a surface sends back along one particular direction, straight from its bin.
//
// The lean form of the lookup, for the far end of a bounce, where the material's lobe has
// already been decided by the ray that got there.
FaceLight radiance_along(ivec3 voxel, ivec3 normal_i, vec3 dir, float roughness, uint frame) {
    uint lo, hi;
    face_key(voxel, normal_i, kRadianceLevel,
             kFaceRadiance | (direction_bin(dir, bin_split(roughness)) << 4u), lo, hi);
    return read_face(face_slot(lo, hi, false, frame));
}

// How much of this surface's reflection may come out of the cache at all.
//
// One at the blurry end, nought at the sharp end, and a ramp between. A mirror gets none of it:
// what a cache holds is an average over a lobe, and a mirror has no lobe.
float cache_share(Material m) {
    return smoothstep(kSpecularSharp, kSpecularBlurry, m.roughness);
}

// Specular with no ray of its own: whatever earlier frames measured going the way this pixel
// is looking. Zero when nothing has looked that way yet, which lasts a frame or two, and is
// never an invention.
vec3 specular_from_cache(ivec3 voxel, ivec3 normal_i, vec3 normal, vec3 dir, Material m,
                         uint frame, inout uint state) {
    // Matched to the gate on the sampling side: a surface that never contributes a bin has no
    // bin to read, and looking anyway is a probe through a quarter of a gigabyte for nothing.
    if (m.metallic <= 0.1 && m.roughness >= 0.4) return vec3(0.0);

    float share = cache_share(m);
    if (share <= 0.0) return vec3(0.0);   // sharp enough to be traced instead

    vec3 spec_dir = reflect(dir, ggx_half(normal, m.roughness, state));
    if (dot(spec_dir, normal) <= 0.0) return vec3(0.0);

    uint lo, hi;
    face_key(voxel, normal_i, kRadianceLevel,
             kFaceRadiance | (direction_bin(spec_dir, bin_split(m.roughness)) << 4u), lo, hi);
    FaceLight stored = read_face(face_slot(lo, hi, false, frame));

    // A bin with one sample in it is not an estimate, it is that sample — and a sample is
    // clamped at 64, so a single path that found something bright shades one pixel many times
    // brighter than its neighbours and leaves a white speck. The diffuse cache learned this
    // the same way, as scattered stars across otherwise dark walls. A few samples cost a
    // fraction of a second of waiting and are worth more than the speck they prevent.
    if (!stored.known || stored.count < kRadianceMinSamples) return vec3(0.0);
    return specular_weight(normal, -dir, m) * stored.indirect * share;
}

// How many samples a face needs before the pixels standing on it stop tracing for it.
const uint kFaceTarget = 192u;

// How well a face has to know itself before its pixels stop tracing for it: the mean within
// about a twentieth of itself, which is finer than an eight-bit screen can show.
const float kErrorTarget = 0.03;

// And how many samples it must have before that judgement is worth anything. The spread of a
// handful is mostly noise about the spread, and a face that happened to draw three similar
// samples would otherwise declare itself finished on the strength of a coincidence.
const uint kErrorMinSamples = 96u;

// What fraction of the screen may trace past the primary ray in any one frame: one pixel in
// this many, rotating so every pixel gets its turn.
//
// Standing still this changes nothing Ã¢â‚¬â€ the faces are already converged and nobody is
// tracing. It bounds the transient. Arrive somewhere new and every face in front of you is
// cold at once, so without this every pixel traces a shadow ray and a bounce in the same
// dispatch, and each of those can march the width of the world. That spike is what a
// driver's watchdog kills, and a killed dispatch is a lost device, which is the crash.
//
// The same reasoning as the streaming budget: work that must happen is spread over frames
// rather than allowed to arrive all at once. Four frames is a sixteenth of a second.
// Set from the quality controller; see trace.quality.

// Anything not finite would poison the average for every sample after it, and one bad pixel
// would never wash out.
vec3 clamp_finite(vec3 v) {
    return (any(isnan(v)) || any(isinf(v))) ? vec3(0.0) : v;
}

// What a summary block radiates: the sun with no shadow test, and the sky as ambient.
//
// Used by the primary ray and by a bounce that lands on one, and it has to be both. A
// summary block is geometry that was never streamed, so it has no faces and never will Ã¢â‚¬â€
// nothing contributes to them, so a lookup there returns "unknown" for ever.
//
// A bounce landing on one used to read that entry, find nothing, and return zero. Zero is
// not "no answer yet", it is *black*, and it was then contributed to the face the bounce
// started from and counted like any other sample. So the near face converged to black on the
// strength of light that was never measured Ã¢â‚¬â€ and because a cache does not wash out, it
// stayed. That is distant chunks going black: not the distant geometry being drawn wrong,
// but the near surfaces that bounce off it being told the world is unlit.
vec3 summary_radiance(vec3 normal, Material m) {
    float n_dot_l = max(dot(normal, trace.sun.xyz), 0.0);
    return m.emission + m.albedo * (sun_radiance() * n_dot_l / kPi +
                                    sky_radiance(normal) * 0.5);
}

// Debug view 6: why a pixel came out the colour it did, judged on the value that actually
// shaded it.
//
//   red     the material's own albedo is black, so no light could show on it
//   blue    nothing known about this face, so the pixel is running on its own samples
//   yellow  a face that is known and holds nothing Ã¢â‚¬â€ the one that renders black
//   cyan    no sun here; indirect is all the light there is
//   grey    lit normally
//
// It has to be called at the point of shading, and once per path. Placed anywhere earlier it
// probes the table before this frame has contributed to it, so every face reads empty and the
// view says "unknown" everywhere Ã¢â‚¬â€ which is what it said, and it was the diagnostic that was
// wrong rather than the renderer.
vec3 why_dark(Material m, FaceLight light) {
    float albedo_max = max(m.albedo.r, max(m.albedo.g, m.albedo.b));
    float light_max = max(light.indirect.r, max(light.indirect.g, light.indirect.b));
    if (albedo_max < 0.01) return vec3(1.0, 0.0, 0.0);
    if (!light.known) return vec3(0.0, 0.0, 1.0);
    if (light_max < 0.001 && light.visibility < 0.001) return vec3(1.0, 1.0, 0.0);
    if (light.visibility < 0.001) return vec3(0.0, 1.0, 1.0);
    return vec3(0.35);
}

// How many samples the per-pixel average looks back over before it starts forgetting.
//
// A running mean over every sample since the last reset keeps its early samples for ever, and
// early samples are the least trustworthy ones: they were taken while the geometry in front of
// the camera was still arriving. Anything wrong about them is diluted and never removed.
//
// The same sliding window the face cache uses, for the same reason. Long enough that a still
// camera converges smoothly, short enough that the picture is of the world as it is now.
const float kAccumWindow = 1024.0;

#include "pt_media.glsl"
#include "ui.glsl"
#include "pt_post.glsl"

void main() {
    ivec2 pixel = min(ivec2(gl_GlobalInvocationID.xy), ivec2(push.resolution.xy) - 1);

    uint sample_index = trace.control.x;
    uint state = (uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + sample_index * 26699u) | 1u;

    // Which ray stands for this pixel, jitter and aperture and all. It lives in pt_post.glsl
    // because a lens is not transport: it decides what to ask, not what happens to the answer,
    // which is the same question exposure and the tone curve are answering. It is a pinhole
    // while push.lens.w is zero, which is what the parameter block is value-initialised to.
    float aspect = float(push.resolution.x) / float(push.resolution.y);
    vec3 origin, dir;
    camera_ray(pixel, state, aspect, origin, dir);

    vec3 radiance = vec3(0.0);
    float primary_t = push.lens.y;   // kept for the preview's depth test

    // Both halves of the light go through the face, and each is split so that only the
    // expensive part is shared.
    //
    // For the sun that is the shadow ray: whether a face can see the sun is a property of the
    // face, so it is traced once and reused, while the part that depends on where you are
    // standing is recomputed per pixel from it. A voxel face is three centimetres, so quantising
    // shadow to it costs almost nothing and removes a ray from every pixel of every frame.
    //
    // For everything else it is the whole bounce.
    // The primary ray, allowed to pass through what it can see through.
    //
    // A pane of glass is not a stopping point, and until now it was: the record carried an
    // opacity and an index of refraction that nothing read, so every window in the world was an
    // opaque wall painted the colour of glass.
    //
    // This is a *loop* around one march and not several marches in a row, and that distinction
    // is the only reason it can exist at all. march is enormous and GLSL has no calls, so every
    // mention of it is another inlined copy, and this shader already carries three — primary,
    // shadow, bounce — with a fourth past what the driver will take. A loop mentions it once.
    // The cost is runtime rather than code size, and runtime is bounded by the segment count and
    // by the fact that almost nothing in a world is transparent.
    //
    // At each transparent surface the ray splits by Fresnel. The reflected part is not traced —
    // that would be the fourth march again — it is read from the radiance cache, which is what
    // that cache is for. The transmitted part carries on, bent by the index, dimmed by
    // absorption over however far it travels inside the glass.
    Hit hit;
    {
        vec3 ray_origin = origin;
        vec3 ray_dir = dir;
        bool inside = false;         // travelling through a medium rather than through air
        vec3 medium_absorb = vec3(0.0);
        float first_t = 0.0;

        // The one segment after a scatter into a translucent solid is marched with the marcher
        // told to pass through what it meets, which is the machinery a shadow ray already uses
        // to get through glass. That is the whole trick, and it is forced: march cannot BEGIN
        // inside solid matter — it answers a hit at zero distance with a normal facing the ray,
        // deliberately, because a camera buried in a wall has no better answer — so a ray that
        // is to cross a slab must start outside it and be let through, rather than start inside
        // it and be let out.
        bool passing = false;
        vec3 kept_origin = vec3(0.0);
        vec3 kept_dir = vec3(0.0);
        vec3 kept_throughput = vec3(1.0);
        Hit kept_hit;
        kept_hit.hit = false;

        for (uint segment = 0u; segment < kGlassSegments; ++segment) {
            g_march_through_glass = passing;
            g_march_transmittance = 1.0;
            hit = march(ray_origin, ray_dir, 0.0, 0.0, true);
            g_march_through_glass = false;
            if (passing) {
                passing = false;
                if (g_march_transmittance <= kMinTransmittance * 4.0) {
                    // It went in and did not come out. That is not a black pixel: it is what an
                    // ordinary diffuse surface already describes, light entering the stone and
                    // leaving the way it came. So the path shades the face it entered, exactly
                    // as it would have had it never gone in — which is what keeps a marble WALL
                    // no darker than the same stone opaque while its thin edges are brighter.
                    ray_origin = kept_origin;
                    ray_dir = kept_dir;
                    g_throughput = kept_throughput;
                    hit = kept_hit;
                    break;
                }
                g_throughput *= g_march_transmittance;
            }
            if (!hit.hit) {
                // Out into the sky. Whatever it passed through still tints it.
                if (inside) g_throughput *= exp(-medium_absorb * kGlassEscape);
                break;
            }
            if (segment == 0u) first_t = hit.t;
            // Absorption applies over the distance just travelled, and only when that distance
            // was spent inside something.
            if (inside) g_throughput *= exp(-medium_absorb * hit.t);

            Material clear = (hit.level == 0) ? material_of(hit.type_id)
                                              : material_from_colour(hit.colour);
            vec3 face = vec3(hit.normal);
            vec3 point = ray_origin + ray_dir * hit.t;
            // The interface, from the ray's side of it. Entering when the face points back at
            // the ray, leaving when it points along it.
            bool entering = dot(ray_dir, face) < 0.0;

            // Solid to a ray that insists on travelling in a straight line — and a translucent
            // solid is not a wall to one that will forget where it was going. See scatter_into
            // in pt_material.glsl. It costs no march: this loop already has one.
            if (clear.opacity >= 0.996) {
                vec3 scattered;
                if (!entering || !scatter_into(clear, ray_dir, face, state, scattered)) {
                    break;   // stops here: this is the surface to shade
                }
                kept_origin = ray_origin;
                kept_dir = ray_dir;
                kept_throughput = g_throughput;
                kept_hit = hit;
                // The colour light picks up from having been inside the stuff. The marcher's
                // transmittance is one float and carries how MUCH survived; this is what colour
                // it is, and it belongs at the way in for the same reason a pane of glass tints
                // what passes rather than what it reflects.
                g_throughput *= clear.albedo;
                ray_origin = point + face * kGlassStep;   // just OUTSIDE, pointing in
                ray_dir = scattered;
                passing = true;
                hit.hit = false;
                continue;
            }
            vec3 n = entering ? face : -face;
            float eta = entering ? (1.0 / max(clear.index, 1.0)) : max(clear.index, 1.0);

            // Fresnel, from the index rather than from a metal's albedo: at a glancing angle a
            // window is a mirror, and that is most of what makes glass look like glass.
            float f0 = (clear.index - 1.0) / (clear.index + 1.0);
            f0 *= f0;
            float cos_in = clamp(dot(-ray_dir, n), 0.0, 1.0);
            float fresnel = f0 + (1.0 - f0) * pow(1.0 - cos_in, 5.0);

            vec3 bent = refract(ray_dir, n, eta);
            // Total internal reflection: refract returns zero and there is nothing to transmit.
            if (dot(bent, bent) < 1e-6) fresnel = 1.0;

            // What the surface reflects, read rather than traced.
            if (fresnel > 0.002) {
                vec3 mirror_dir = reflect(ray_dir, n);
                ivec3 face_voxel = ivec3(floor(point - face * 0.5)) +
                                   push.camera_chunk.xyz * kChunkEdge;
                FaceLight seen = radiance_along(face_voxel, hit.normal, mirror_dir,
                                                clear.roughness, trace.control.z);
                vec3 reflected = (seen.known && seen.count >= kRadianceMinSamples)
                                     ? seen.indirect
                                     : sky_radiance(mirror_dir);
                g_prefix += g_throughput * fresnel * min(reflected, vec3(8.0));
            }

            // And what gets through. The tint is the glass's own colour: a pane is not a hole.
            g_throughput *= (1.0 - fresnel) * mix(vec3(1.0), clear.albedo, clear.opacity);
            if (max(g_throughput.r, max(g_throughput.g, g_throughput.b)) < 0.004) break;

            if (fresnel >= 1.0) break;   // nothing transmitted; shade the glass itself

            // Step past the interface and carry on. Entering a medium starts its absorption
            // running; leaving it stops.
            inside = entering;
            medium_absorb = entering ? clear.absorb : vec3(0.0);
            ray_origin = point + bent * kGlassStep;
            ray_dir = bent;
            hit.hit = false;   // so a loop that runs out reads as "saw nothing"
        }
        // Everything below shades the surface the ray finally reached, seen from the direction it
        // was travelling when it got there — which after a pane of glass is the bent direction
        // from a point inside the room, not the eye's. Handing it the eye's ray would put the
        // specular highlight of a window on the wall behind it.
        origin = ray_origin;
        dir = ray_dir;
        primary_t = first_t;
    }

    if (!hit.hit) {
        // sky_view and not sky_radiance, and this is the only call site in the file that may be.
        //
        // The two differ by the things that are bright and small: the moon's disc and the stars.
        // Those belong to the eye and must never reach the light path, because an irradiance
        // entry pools five hundred samples and a point six hundred times brighter than the sky
        // around it is caught by one or two of them -- so one face in a few hundred settles at
        // twice its neighbours and stays there, a cache not being the sort of thing that washes
        // out. Every other call below is a cache or a reflection and keeps sky_radiance.
        radiance = sky_view(dir);
    } else {
        primary_t = hit.t;
        vec3 point = origin + dir * hit.t;
        // The voxel the face belongs to, worked out from the face that was hit and never from
        // the shading normal. Everything keyed to a face has to agree on which voxel that is,
        // and a shading normal leaning up to 54.7 degrees off its face moves point - normal*0.5
        // as much as four tenths of a voxel sideways -- so on a curve a large fraction of pixels
        // would name the voxel next door, which is a cache keyed on where the normal happened to
        // point rather than on the face. That fault is the one the architecture note is about
        // and it was latent here from the day shading_normal stopped returning the face.
        ivec3 hit_voxel =
            ivec3(floor(point - vec3(hit.normal) * 0.5)) + push.camera_chunk.xyz * kChunkEdge;
        Material m = (hit.level == 0) ? material_of(hit.type_id)
                                      : material_from_colour(hit.colour);
        // The shape the voxels approximate -- see pt_normals.glsl for why a face and a normal
        // are not the same thing, and why a polished sphere in a voxel world reflects in exactly
        // six directions until they are told apart -- then roughened by a hash on the voxel, so
        // the surface has a microstructure the geometry does not. See perturb_normal.
        vec3 normal = perturb_normal(shading_normal(hit_voxel, hit.normal, point, hit.level),
                                     hit_voxel, hit.normal, m);
        vec3 from = point + normal * surface_offset(hit.level, hit.t);

        radiance = m.emission;

        // Debug view 7: what the primary ray actually hit, and how coarse it was.
        //
        //   green    a real voxel (level 0)
        //   blue     a summary block, brightening with the tier it came from
        //   red      hit something whose albedo is black, whatever its level
        //
        // Every previous account of "distant chunks are black" has had to guess whether the
        // geometry was summary or real, and twice the guess was wrong. This answers it.
        if (push.resolution.z == 7u) {
            vec3 mark;
            float albedo_max = max(m.albedo.r, max(m.albedo.g, m.albedo.b));
            if (albedo_max < 0.02) mark = vec3(1.0, 0.0, 0.0);
            else if (hit.level >= 5) mark = vec3(0.0, 0.15, 0.35 + 0.1 * float(hit.level - 5));
            else mark = vec3(0.0, 0.8, 0.0);
            imageStore(out_colour, pixel, vec4(mark, 1.0));
            return;
        }

        // A summary hit is a stand-in for geometry that has not been streamed, and it gets
        // shaded rather than traced.
        //
        // Tracing it is both wrong and ruinously expensive. Wrong, because the shadow and
        // bounce rays are cast against a world that is only there in outline Ã¢â‚¬â€ they mostly hit
        // the same coarse block they started on and report everything occluded, which is the
        // distant chunks coming out black. Expensive, because these are exactly the pixels
        // with nothing resident, so every one of them pays for four full-length marches: at
        // 400x225 that was enough to trip the driver's watchdog and lose the device outright.
        //
        // The sun without a shadow test and the sky as ambient. Both are honest at this range:
        // the block is kilometres away and a fraction of a pixel, and a shadow it cannot
        // resolve is not a shadow anyone can see.
        if (hit.level >= 5) {
            radiance = clamp_finite(summary_radiance(normal, m));
            write_pixel(pixel, sample_index, radiance, primary_t, aspect);
            return;
        }

        ivec3 voxel = hit_voxel;
        uint level = cache_level(hit.t);
        uint lo, hi;
        face_key(voxel, hit.normal, level, kFaceIndirect, lo, hi);
        uint slot = face_slot(lo, hi, true, trace.control.z);
        seed_face(slot, voxel, hit.normal, level, trace.control.z);

        // Whether this pixel does any work at all beyond the primary ray.
        //
        // This is where the saving actually lands. A face covered by a thousand pixels reaches
        // a good estimate within a frame or two, and after that every one of those pixels was
        // still tracing a shadow ray and a bounce to tell it what it already knew. Once a face
        // has enough samples they stop, and a converged surface costs one ray per pixel ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â the
        // primary ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â however many lights and bounces it is standing under.
        //
        // A small fraction keep going regardless, so a face is never frozen: light that moves,
        // or a neighbour that changed, still works its way in.
        // Spend rays where the answer is still uncertain, rather than where the count is low.
        //
        // A fixed target treats every face alike, and faces are not alike. One looking at a
        // blank wall a metre away has the same answer from every direction and is done in a few
        // dozen samples; one seeing a bright window through a doorway, with dark wall either
        // side of it, is not done after a thousand. Counting samples cannot tell those apart, so
        // it kept tracing the first long after it had converged and stopped tracing the second
        // while it was still visibly wrong.
        //
        // The entry now knows how far its own mean is likely to be out, so that is the question
        // asked. Below the target it is left alone entirely, which hands its share of the ray
        // budget to the faces that still need it.
        // Anything the last edit could have changed the light of re-measures at once: it stops
        // being allowed to call itself settled, and its entries average over the last handful of
        // samples rather than the last five hundred, so the truth wins in a few frames instead
        // of having to outvote a history of a world that no longer exists.
        bool edited = in_edited_region(voxel);
        uint edit_window = edited ? kEditWindow : kFaceWindow;

        FaceLight own = read_face(slot);
        uint have = own.count;
        bool turn = ((uint(pixel.x) * 3u + uint(pixel.y) * 5u + trace.control.z) %
                     max(trace.quality.x, 1u)) == 0u;
        // Not before a minimum, because the spread of a handful of samples is itself mostly
        // noise, and a face that got three similar ones by chance would declare itself finished.
        bool settled = own.known && own.count >= kErrorMinSamples && own.error < kErrorTarget;
        bool refine = (!settled || edited || (rand(state) < 0.02)) && turn;

        // Adaptive sampling is asked here per face, and not per pixel, and that is a decision
        // rather than an omission — so it is written down where the omission would be noticed.
        //
        // Every path tracer that measures variance measures it per pixel, because the estimate it
        // is refining lives per pixel. Here it does not. A pixel's value is a *read* of face
        // state, plus at most one traced ray, and its noise is its face's noise: a thousand
        // pixels standing on one face all show the same number and are all wrong by the same
        // amount at the same time. Measuring that a thousand times over, one ray each, would be a
        // thousand worse estimates of the quantity the face already estimates well — the face has
        // the statistics because the face has the samples.
        //
        // And there would be nothing to do with the answer. "This pixel is noisy, give it more
        // rays" needs somewhere to put them, and a pixel is one invocation with one primary ray;
        // more samples for it means another loop around the whole march, which costs what the
        // architecture cannot spend. What it can spend is a ray on the face, which is what the
        // stride and the error target already decide.
        //
        // The one quantity in this shader that genuinely is per pixel is a sharp reflection,
        // because it is a property of where the eye is and not of the world. It is exempted from
        // both the stride and the settled test immediately below — every such pixel traces every
        // frame, which is already the most a pixel can be given. There is nothing above it for an
        // adaptive rule to reach.
        //
        // A sharp reflection is never settled, however many samples its face has.
        //
        // The stride and the settled test are both about the *face*: they ask whether this patch
        // of world has been measured enough, and once it has, its pixels stop tracing and read
        // the answer. That is right for everything that is a property of the world, and a
        // reflection is not one — it changes when the eye moves and the face has no way to know
        // that it did. So a mirror lit by a converged face reads a converged average of the
        // twenty-four directions the world went in, and shows a smear that pops from block to
        // block as the level changes underneath it.
        //
        // Sharply reflective surfaces therefore trace every frame, for every pixel, ignoring
        // both the stride and the settled test. It is not a fourth march: the bounce that pixel
        // was going to spend on the diffuse lobe is spent on the specular one instead, and on a
        // metal the diffuse lobe is worth almost nothing — albedo times one minus metallic.
        //
        // Bounded by roughness rather than by a stride, which is what keeps it affordable: only
        // the genuinely shiny qualify, and a world of stone has very little of it.
        bool sharply_reflective =
            (m.metallic > 0.1 || m.roughness < 0.30) && m.roughness < kSpecularBlurry;
        if (sharply_reflective) refine = true;

        // The shadow entry: its own key, at a fixed level, decided on its own terms.
        //
        // It is claimed and refined separately from the indirect one because the two converge
        // at completely different rates. A shadow sample is one ray with a yes-or-no answer and
        // a hundred of them are plenty; indirect is a whole hemisphere and wants thousands. Tied
        // together, whichever needed more work kept the other tracing, and whichever needed less
        // stopped it early.
        uint shadow_lo, shadow_hi;
        face_key(voxel, hit.normal, kShadowLevel, kFaceShadow, shadow_lo, shadow_hi);
        uint shadow_slot = face_slot(shadow_lo, shadow_hi, true, trace.control.z);
        seed_shadow(shadow_slot, voxel, hit.normal, trace.control.z);
        uint shadow_have = (shadow_slot != 0xFFFFFFFFu) ? faces.items[shadow_slot].count : 0u;

        // Traced when the entry is still thin, or on the small fraction that keep going so a
        // face is never frozen. Sunless faces never trace at all: the answer is already known.
        bool faces_sun = dot(normal, trace.sun.xyz) > 0.0;
        // Traced when the entry is thin, when an edit has just asked everything to look
        // again, or on the small trickle that keeps a face from freezing. The middle case is
        // what makes a newly placed voxel cast a shadow at any distance: a converged face two
        // hundred metres away is covered by less than a pixel, and a two per cent trickle of
        // less than a pixel never re-measures anything.
        bool trace_shadow = faces_sun && ((shadow_have < trace.quality.y) ||
                                          (trace.quality.z != 0u) || (rand(state) < 0.02));

        // Debug view 5: whether the table could hold this face at all. Red is a pixel the
        // table refused a slot; green is a face it holds.
        if (push.resolution.z == 5u) {
            // Red: the table refused this face's irradiance entry. Yellow: it took that but
            // refused the shadow entry, which is the case worth seeing — shadow is keyed per
            // voxel at level zero while irradiance coarsens with distance, so there are vastly
            // more of them and they are the ones that run out first.
            // Red: the table refused this face's irradiance entry. Yellow: it took that and
            // refused the shadow entry, which is worth separating because shadow is keyed per
            // voxel while irradiance coarsens with distance, so there are far more of them.
            vec3 mark = (slot == 0xFFFFFFFFu)          ? vec3(1.0, 0.0, 0.0)
                        : (shadow_slot == 0xFFFFFFFFu) ? vec3(1.0, 1.0, 0.0)
                                                       : vec3(0.0, 0.7, 0.0);
            imageStore(out_colour, pixel, vec4(mark, 1.0));
            return;
        }
        // A pixel that is not tracing this frame has no bounce to report on.
        if (push.resolution.z == 8u && !refine) {
            imageStore(out_colour, pixel, vec4(1.0, 0.0, 0.0, 1.0));
            return;
        }

        // ---- the sun, on its own entry ------------------------------------------------
        //
        // Resolved before and independently of everything below. A pixel that is doing no
        // other work still keeps the shadow honest, and one that is refining indirect does not
        // drag the shadow along with it.
        //
        // Read back after contributing, so this pixel's own sample is in the average it
        // shades with. That is what turns a yes-or-no shadow ray into a soft edge: many pixels
        // standing on one voxel face, each sampling a different point on the sun's disc, and
        // the face holding the mean of them. Per pixel and unshared, the same rays are
        // salt-and-pepper.
        float visibility = 0.0;
        if (faces_sun) {
            uint parent_lo, parent_hi;
            face_key(voxel, hit.normal, kShadowParentLevel, kFaceShadow, parent_lo, parent_hi);
            uint parent_slot = face_slot(parent_lo, parent_hi, true, trace.control.z);

            if (trace_shadow) {
                float measured = sun_transmission(
                    from, sun_sample_at(stratified_pair(pixel, trace.control.z, 1u, state)));
                contribute_shadow(shadow_slot, measured, edit_window);
                contribute_shadow(parent_slot, measured, edit_window);
            }

            uint own_count = (shadow_slot != 0xFFFFFFFFu) ? faces.items[shadow_slot].count : 0u;
            float own = gather_shadow(voxel, hit.normal, trace.control.z, own_count,
                                      read_shadow(shadow_slot));
            if (own_count >= kShadowSeed) {
                visibility = own;
            } else {
                uint parent_count = (parent_slot != 0xFFFFFFFFu) ? faces.items[parent_slot].count : 0u;
                float parent = read_shadow(parent_slot);
                if (parent_count == 0u)   visibility = own;
                else if (own_count == 0u) visibility = parent;
                else visibility = mix(parent, own, float(own_count) / float(kShadowSeed));
            }
        }

        // Debug view 9: the sun term on its own, with no albedo and no texture over it.
        //
        // Every measurement of shadow quality taken against the shaded image was really a
        // measurement of the ground's per-voxel colour, which varies far more than the shadow
        // does and drowns it. This is the quantity being complained about, by itself.
        if (push.resolution.z == 9u) {
            imageStore(out_colour, pixel, vec4(vec3(visibility), 1.0));
            return;
        }

        vec3 incoming = vec3(0.0);

        if (!refine) {
            FaceLight known = read_face_pyramid(voxel, hit.normal, cache_level_exact(hit.t),
                                               shape_complexity(hit.t, hit.steps),
                                               surface_curve(normal, hit.normal),
                                               trace.control.z);
            if (push.resolution.z == 6u) {
                imageStore(out_colour, pixel, vec4(why_dark(m, known), 1.0));
                return;
            }
            // Nothing known yet shades as its own emission and no more. Standing in for it
            // with sky was tried and is wrong: a sealed box has no sky in it, and inventing a
            // floor of light there makes a room with no way in glow. Waiting is honest, and at
            // this stride the wait is a few frames.
            radiance += sun_light(normal, dir, m, visibility) +
                        m.albedo * (1.0 - m.metallic) * known.indirect +
                        specular_from_cache(voxel, hit.normal, normal, dir, m,
                                            trace.control.z, state);
            radiance = clamp_finite(radiance);
            write_pixel(pixel, sample_index, radiance, primary_t, aspect);
            return;
        }

        // Whether this path found out anything real, or merely failed to find out anything.
        //
        // The distinction is the whole of it. Zero light and no answer are the same number and
        // must not be the same sample: a sample means "I looked, and this is what is there",
        // and averaging a non-answer in teaches the face that the world is dark. Two surfaces
        // facing each other then each teach the other, and a cache does not wash out.
        //
        // The sky, a summary block, an emitter and a face that is already known are all real
        // answers, so light still bootstraps from anything open to the sky and spreads inward a
        // bounce per frame. A sealed box has none of them, contributes nothing, and stays black
        // Ã¢â‚¬â€ which is correct, and is what makes it black for the right reason rather than by
        // accident.
        bool measured = true;

        // The bounce reports what it could not find, where the shadow ray deliberately does
        // not. They are not the same case. A shadow ray is a yes-or-no about one direction and
        // must not drag streaming wherever it happens to point; a bounce is where all indirect
        // light comes from, and geometry it lands on is geometry the picture depends on.
        //
        // Left silent, a surface only ever touched by bounces never streams, so it stays a
        // summary block, and a summary block answers nothing Ã¢â‚¬â€ so the light there never
        // arrives and the room stays dark for want of asking. Inside a closed box a sixth of
        // all bounces were landing on unstreamed walls that nothing had ever requested.
        // Which lobe this bounce is for â€” and it is a choice, not an addition.
        //
        // The obvious way to get indirect specular is a second bounce ray beside the diffuse
        // one. That was written, and it lost the device on every scene tried. Bisected: not
        // the cache, not the claiming, not the cost. Striding it down to one pixel in sixteen
        // did not help, and that is the tell â€” a runtime cost responds to being run less
        // often, and this did not. The problem is *static*. march is enormous and GLSL has no
        // calls, so every mention of it is another inlined copy; the shader already carried
        // three, for the primary, the shadow and the bounce, and a fourth is past what the
        // driver will take. Wrapping the same code in `if (false)` made it compile away and
        // the crash vanish, which is what proved it.
        //
        // So the bounce picks a lobe instead. One ray, sampled from the cosine lobe or the GGX
        // lobe in proportion to Fresnel, and its result goes to whichever cache it belongs to:
        // irradiance for diffuse, the direction bin for specular. Each cache averages only its
        // own kind of sample, so each stays an unbiased estimate of its own quantity, and
        // neither needs the other's weighting.
        // Only surfaces that will actually show a reflection take specular samples.
        //
        // Every specular bounce claims a direction bin, and a bin is a table entry. Taking
        // them on matte dielectrics — a base reflectance of 0.04, which is a four per cent
        // term nobody can see — filled the table with entries that would never be read, on
        // top of the four each face already claims. The table saturating is not merely a
        // waste: a claim is eight probes scattered through a quarter of a gigabyte, and once
        // most of them miss, the pass runs long enough for the driver's watchdog to take the
        // device. Measured: the room scene died at frame 1050 with this ungated, and does not
        // with it.
        bool reflective = m.metallic > 0.1 || m.roughness < 0.4;
        vec3 fresnel = specular_weight(normal, -dir, m);
        float spec_chance = reflective
            ? clamp(max(fresnel.r, max(fresnel.g, fresnel.b)), 0.05, 0.9)
            : 0.0;
        bool spec_bounce = rand(state) < spec_chance;

        vec3 bounce_dir =
            spec_bounce
                ? reflect(dir, ggx_half(normal, m.roughness, state))
                : cosine_hemisphere_at(normal,
                                       stratified_pair(pixel, trace.control.z, 2u, state));
        // A GGX sample can point into the surface; that carries no light and there is no
        // second ray to spend, so it becomes a diffuse sample rather than a wasted one.
        if (spec_bounce && dot(bounce_dir, normal) <= 0.0) {
            spec_bounce = false;
            bounce_dir = cosine_hemisphere(normal, state);
        }
        // And below the FACE, which is a second and different test now that the two are not the
        // same vector. The shading normal leans off the face it is made of by up to 54.7 degrees,
        // so a lobe built around it can point under the face itself; that ray starts underground,
        // hits the surface it just left, and comes back black — a curve losing the indirect light
        // a flat wall keeps. The face decides where a ray may go; the shading normal only decides
        // what it is worth.
        if (dot(bounce_dir, vec3(hit.normal)) <= 0.0) {
            spec_bounce = false;
            bounce_dir = cosine_hemisphere(vec3(hit.normal), state);
        }

        // ---- ask a lamp, or bounce ----------------------------------------------------
        //
        // One ray, either way. A second ray for the lamp would be a fourth inlined march and the
        // device does not survive a fourth, so this chooses instead — the same trick the lobe
        // above uses, and the reason both are divided by the chance of having been chosen.
        //
        // Only when the list is complete. A truncated one cannot own emitters, because the ones
        // past the end would be owned by nobody and would go out; then the bounce keeps them,
        // exactly as before this existed.
        uint light_count = min(trace.quality.w, kMaxLights);
        bool lights_complete = light_count > 0u && light_count < kMaxLights;
        float nee_chance = 0.0;
        bool nee = false;
        float nee_inv_pdf = 0.0;

        if (!spec_bounce && lights_complete) {
            // The draw first, because it costs no rays and it is what says how much the lamps
            // are worth here. Then the split, from the lamps' share of everything this face is
            // receiving: the sun it can see, the sky above it, and the lamps around it.
            LightPick pick = pick_light(from, normal, light_count, state);
            float from_sun = face_luminance(sun_radiance()) *
                             max(dot(normal, trace.sun.xyz), 0.0) * visibility;
            float from_sky = face_luminance(sky_radiance(normal));
            nee_chance = clamp(pick.estimate / (pick.estimate + from_sun + from_sky + 1e-4),
                               kNeeMinChance, kNeeMaxChance);
            // Never zero, and that is not a detail: which strategy owns emitters has to be
            // settled before the draw rather than by it.
            //
            // Zeroing the chance when a draw happened to turn up nothing handed emitters back to
            // the bounce for exactly those samples, while direct sampling was still counting the
            // ones it did find — so a lamp was counted twice whenever the dice came up empty,
            // and the total moved with how often that happened. Small here, about a per cent
            // against a long reference, and invisible until something changed how often draws
            // come up empty.
            //
            // A draw that finds nothing is not a reason to change the rules. It is an estimate
            // of zero, which the floor lets through at its own small weight, and the draws that
            // do find something carry the answer.

            // Committed once the coin lands, whatever the draw turned up. A draw that found no
            // candidate in front of the face is not a failure to be backed out of — it is that
            // draw's answer, and it is zero. Falling back to a bounce would make the two
            // strategies' probabilities no longer the ones everything below divides by, and the
            // estimate would drift by however often the fallback fired.
            if (nee_chance > 0.0 && rand(state) < nee_chance) {
                nee = true;
                spec_bounce = false;
                if (pick.valid) {
                    nee_inv_pdf = pick.inv_pdf;
                    bounce_dir = pick.dir;
                }
            }
        }

        uint rad_slot = 0xFFFFFFFFu;
        if (spec_bounce) {
            uint rad_lo, rad_hi;
            face_key(voxel, hit.normal, kRadianceLevel,
                     kFaceRadiance | (direction_bin(bounce_dir, bin_split(m.roughness)) << 4u),
                     rad_lo, rad_hi);
            rad_slot = face_slot(rad_lo, rad_hi, true, trace.control.z);
        }

        // ---- how long a path is, and why nothing rolls a die to end it -----------------
        //
        // There is no Russian roulette anywhere in this file. That is the right answer here and
        // not an oversight, and this is where someone will come looking for it.
        //
        // Roulette exists to end a path that would otherwise go on for ever: past some depth a
        // path carries so little that continuing is not worth a ray, and killing it outright
        // biases the picture, so it is killed at random and the survivors are scaled up to pay
        // for the dead. Every word of that assumes there is a continuation to kill.
        //
        // A path here is exactly one segment long. The ray below marches once, and whatever it
        // lands on is *read* — the far face's own sun and its own indirect, from the cache —
        // rather than traced onward. Depth is unbounded, but it is unbounded in *frames* and not
        // in rays: light gains a bounce per frame and keeps it, because each frame's estimate is
        // stored where the next frame's bounce will find it. There is no tail. Roulette applied
        // to this would delete the one segment that exists and pay for it with variance, saving
        // nothing, because by the time throughput is known the march has already happened.
        //
        // What roulette *is* — a coin, a single continuation instead of several, and a division
        // by the chance of having taken it — is already here twice, under other names. The lobe
        // choice above spends one ray on the diffuse or the specular branch and divides by
        // spec_chance; the lamp choice spends it on an emitter or a bounce and divides by
        // nee_chance. Those are roulette between strategies rather than roulette against depth,
        // and they are where the technique earns its keep in a renderer with three marches in it.
        //
        // The day march becomes something a ray can re-enter — a loop around the bounce, the way
        // the glass segments are a loop around the primary — roulette against throughput becomes
        // the right way to bound that loop, and the survival chance is the throughput itself,
        // clamped to one, with the survivor divided by it. Until then there is nothing to bound.
        Hit second = march(from, bounce_dir, 0.0, 0.0, true);
        if (nee) {
            // Direct sampling owns emitters and nothing else. Whatever the ray reached, only its
            // emission counts here; if it reached a wall, or the lamp with something in the way,
            // the answer is nought — and nought is a real answer, measured, which is why this
            // still contributes. A face learning that a direction is dark is a face that stops
            // guessing about it.
            vec3 emitted = vec3(0.0);
            if (second.hit && second.level == 0) {
                Material lamp = material_of(second.type_id);
                emitted = lamp.emission;
            }
            // The estimator for the same quantity the bounce estimates: the cosine-weighted mean
            // radiance over the hemisphere, divided by pi. The bounce gets this for free by
            // sampling proportionally to the cosine; sampling a lamp instead has to put it back
            // by hand, along with the density it was drawn from and the chance of having come
            // this way at all.
            incoming = emitted * (dot(bounce_dir, normal) * nee_inv_pdf / (kPi * nee_chance));
            measured = true;
        } else if (!second.hit) {
            incoming = sky_radiance(bounce_dir) / (1.0 - nee_chance);
        } else {
            vec3 n2 = vec3(second.normal);
            vec3 p2 = from + bounce_dir * second.t;
            vec3 from2 = p2 + n2 * surface_offset(second.level, hit.t + second.t);
            Material m2 = (second.level == 0) ? material_of(second.type_id)
                                              : material_from_colour(second.colour);

            if (second.level >= 5) {
                // A summary block is fine to *draw* and useless to *measure light from*.
                //
                // It stands in for geometry that has not been streamed, and nothing about it
                // says whether that geometry is a hillside in the sun or the far wall of the
                // room you are standing in. Shading it as sunlit was tried, and it lights the
                // inside of a sealed box: bounces land on the box's own unstreamed walls and
                // come back carrying daylight, so a room with no way in glows. Measured at 90
                // of 255 mean brightness inside a closed box, and forcing this term to black
                // took it to 1.
                //
                // So it answers nothing. A surface that can see the sky still has plenty of
                // bounces that reach it, and those are real.
                incoming = vec3(0.0);
                measured = false;
            } else {
                // The far end reads its own face rather than tracing on. This is what makes
                // the bounce count unbounded for nothing: what is read there already contains
                // its own sun and its own indirect from earlier frames, so light gains a
                // bounce per frame and keeps it. If that face is not in the table yet its
                // light is simply missing this frame and arrives once it is.
                ivec3 voxel2 = ivec3(floor(p2 - n2 * 0.5)) + push.camera_chunk.xyz * kChunkEdge;
                FaceLight far = read_face_seeded(voxel2, second.normal,
                                                 cache_level(hit.t + second.t),
                                                 trace.control.z);

                // Emitters belong to the direct sampling while it is running, and to the bounce
                // when it is not. Never to both — that is the double count that would make every
                // lamp in the world twice as bright.
                vec3 emitted = (nee_chance > 0.0) ? vec3(0.0) : m2.emission;
                if (far.known) {
                    incoming = emitted + sun_light(n2, bounce_dir, m2, far.visibility) +
                               m2.albedo * (1.0 - m2.metallic) * far.indirect;

                    // A mirror at the far end reflects as well, and this is the whole of how a
                    // hall of mirrors is built here.
                    //
                    // The term above is diffuse: albedo times one minus metallic, which for a
                    // polished metal is nearly nothing. So a mirror facing a mirror came back
                    // black, and two reflective surfaces in front of one another showed each
                    // other an empty room.
                    //
                    // The reflection cannot be traced onward — that would be a fourth inlined
                    // march and the device does not survive a fourth — so it is *read*, the same
                    // way the diffuse term is: the far face's own bin, for the direction the
                    // reflection continues in. What is in that bin was measured by whichever
                    // pixels were looking that way in earlier frames, and it already contains
                    // whatever *they* read from the surface beyond.
                    //
                    // So the depth is not two. Each frame carries the answer one reflection
                    // further, and it stays, exactly as diffuse light gains a bounce per frame
                    // and keeps it. Two mirrors facing each other converge on the infinite
                    // series over a handful of frames rather than being cut off at a fixed
                    // depth — and they converge rather than diverge because every step is
                    // multiplied by a Fresnel weight below one.
                    if (m2.metallic > 0.1 || m2.roughness < 0.4) {
                        vec3 onward = reflect(bounce_dir, n2);
                        FaceLight beyond =
                            radiance_along(voxel2, second.normal, onward, m2.roughness,
                                           trace.control.z);
                        if (beyond.known && beyond.count >= kRadianceMinSamples) {
                            incoming += specular_weight(n2, -bounce_dir, m2) * beyond.indirect;
                        }
                    }
                } else {
                    // Nothing known there yet. Its own light is still a real measurement, so
                    // an emitter is seen immediately; the rest of what that surface reflects
                    // is simply not known this frame.
                    incoming = emitted;
                    measured = (nee_chance > 0.0)
                                   ? false
                                   : any(greaterThan(m2.emission, vec3(0.0)));
                }
                // The other half of choosing: this ray only happens when the coin did not land
                // on the lamp, so what it finds stands for all the times it was not traced.
                incoming /= (1.0 - nee_chance);
            }
        }

        // Debug view 8: what the bounce found, which is where indirect light comes from and
        // therefore where a wrong answer about indirect light must come from too.
        //
        //   cyan     open sky
        //   blue     a summary block: unstreamed geometry, so no answer
        //   green    a real surface whose face is known
        //   yellow   a real surface nothing knows about yet
        //   red      the pixel did not trace this frame
        if (push.resolution.z == 8u) {
            vec3 mark;
            if (!second.hit) mark = vec3(0.0, 1.0, 1.0);
            else if (second.level >= 5) mark = vec3(0.0, 0.0, 1.0);
            else mark = measured ? vec3(0.0, 0.8, 0.0) : vec3(1.0, 1.0, 0.0);
            imageStore(out_colour, pixel, vec4(mark, 1.0));
            return;
        }

        // Contribute. Clamped, because a single path that finds the sun through a gap carries
        // a spike ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â in a per-pixel average that is a firefly which washes out, and in a cache
        // it persists and one face wears it for thousands of frames.
        // Raised from 8 once direct light sampling existed to be measured against. A lamp's
        // radiance is about forty, so a bounce that landed on one had five sixths of it thrown
        // away, and a room lit by lamps settled at a permanently wrong answer rather than a
        // noisy right one: the tower interior held 139 where a long run with the clamp opened
        // gives 203. Sixteen per cent of that room's light was being clipped and nothing in the
        // picture said so, because a uniformly dim room looks like a dim room.
        //
        // It costs nothing where the old value was already enough. Every outdoor scene measured
        // identical to the decimal -- sun radiance is about three and sky about one, so neither
        // was ever near the limit. The clamp still catches exactly what it was put there for.
        vec3 clamped = min(incoming, vec3(64.0));
        // To whichever cache this sample is a measurement of. A specular sample says what
        // arrives from one direction and belongs in that direction's bin; a diffuse one says
        // what arrives from the hemisphere and belongs in the face's irradiance. Mixing them
        // would make each wrong in a different way.
        if (measured && spec_bounce) {
            // A short memory, not the face's. See kRadianceWindow: a bin is a property of a face
            // *and a direction*, and a five-hundred-frame average of it is an average of every
            // view anybody has ever had of that face.
            contribute(rad_slot, clamped, min(edit_window, kRadianceWindow));
        } else if (measured) {
            contribute(slot, clamped, edit_window);

            // And to the ancestors, so that every level the composite can reach for has something
            // in it. One parent was enough while a read never went more than one level above the
            // pixel; the composite walks as far up as it needs to find an answer worth having.
            // See kAncestorWrites.
            for (uint up = 1u; up <= kAncestorWrites; ++up) {
                uint plo, phi;
                face_key(voxel, hit.normal, min(level + up, kMaxFaceLevel), kFaceIndirect,
                         plo, phi);
                contribute(face_slot(plo, phi, true, trace.control.z), clamped, edit_window);
            }
        }

        // Then shade from the face, which now includes every other pixel standing on it this
        // frame. A face the table could not hold falls back to this pixel's own samples: noisy,
        // and *correct*, where before it fell back to nothing at all ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â which in shadow, where
        // indirect is the only light there is, drew pure black.
        FaceLight here = read_face_seeded(voxel, hit.normal, level, trace.control.z);
        if (here.known && here.count >= kSeedSamples) {
            here = read_face_pyramid(voxel, hit.normal, cache_level_exact(hit.t),
                                     shape_complexity(hit.t, hit.steps),
                                     surface_curve(normal, hit.normal), trace.control.z);
        }
        if (!here.known && !spec_bounce) {
            here.indirect = incoming;
        }
        if (push.resolution.z == 6u) {
            imageStore(out_colour, pixel, vec4(why_dark(m, here), 1.0));
            return;
        }
        // The reflection this pixel is about to show.
        //
        // If this pixel traced a specular ray of its own, that ray is the answer and it is used
        // as one — not put in the cache and read back as an average over a lobe and a block of
        // faces. A reflection is the one quantity in this shader that is a property of where the
        // eye is, and a cache is a promise that something is a property of the world. Averaging
        // a mirror over twenty-four directions and eight voxels is how a mirror becomes a grid.
        //
        // It still goes into the bin as well, above, because the pixels that did not get to
        // trace this frame have to read something — and what they read is now only weighted in
        // where roughness makes it honest.
        vec3 reflection;
        if (spec_bounce && measured) {
            // Not divided by the chance of having taken this lobe, and that is worth being sure
            // about. The division belongs to the *cache* contributions, where one ray stands in
            // for all the rays that were not taken. Here the ray is not standing in for
            // anything: it was traced, it is this pixel's reflection, and the diffuse term
            // beside it comes from the face cache rather than from a ray this one displaced.
            // Dividing anyway makes a barely-reflective surface blaze.
            //
            // Not clamped a second time, where it used to be held at 8. That clamp was here to
            // stop a one-sample white speck on a surface accumulating one sample a frame, and
            // that is now the outlier test's job in pt_post.glsl — which does it better, because
            // its bound grows with how much the pixel already knows instead of being a number
            // chosen once. Eight was also demonstrably below a real sun glint on chrome, so it
            // was throwing away the one thing a mirror is for. The other clamp, the 64 feeding
            // contribute(), stays: that guards a *cache* entry with a five-hundred-sample window
            // and a wrong entry there does not wash out.
            vec3 traced = specular_weight(normal, -dir, m) * clamped;
            // Mixed with the cache by the same ramp the cache is weighted by, so a surface whose
            // roughness varies from voxel to voxel — which is every surface here — has no seam
            // running through it where one term hands over to the other.
            reflection = mix(traced,
                             specular_from_cache(voxel, hit.normal, normal, dir, m,
                                                 trace.control.z, state),
                             cache_share(m));
        } else {
            reflection = specular_from_cache(voxel, hit.normal, normal, dir, m,
                                             trace.control.z, state);
        }

        radiance += sun_light(normal, dir, m, visibility) +
                    m.albedo * (1.0 - m.metallic) * here.indirect + reflection;
    }
    // The air between here and there is charged in write_pixel, which is the only place every
    // path that produces a pixel goes through. Charging it here reached a quarter of them.
    write_pixel(pixel, sample_index, clamp_finite(radiance), primary_t, aspect);
}
