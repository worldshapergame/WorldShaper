#version 450
// Reference path tracer.
//
// Not the shipping renderer and not trying to be: it has no frame budget, no denoiser, and
// converges over seconds while the camera is still. It exists so a material can be judged
// under real light before it is authored, and so the approximations in the real-time pipeline
// have something to be checked against. An approximation with no ground truth is a guess.
//
// It asks the world exactly the same question primary visibility does, through the same
// traversal in world.glsl, at full voxel detail on every bounce ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â no coarse levels, because a
// filtered colour is a lie about what a surface is and lies compound over bounces.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Radiance summed over every sample so far, and the count in .w. Kept in full float: at a few
// thousand samples an 8-bit buffer would have quantised away the very differences between
// materials this exists to show.
layout(binding = 0, rgba32f) uniform image2D accum;
layout(binding = 1, rgba8) uniform writeonly image2D out_colour;

#include "world.glsl"

// The voxel type table, so a hit becomes a material. Same records the real-time pipeline
// shades from, so what is seen here is what those materials actually are.
layout(std430, binding = 14) readonly buffer Types { uvec2 items[]; } types;
layout(std430, binding = 15) readonly buffer Visuals { uvec4 items[]; } visuals;

// The clipboard's held clip, for drawing its ghosts. Same buffer resolve binds; the tracer
// gives it a number of its own.
layout(std430, binding = 16) readonly buffer ClipCells { uint items[]; } clip;

// ---------------------------------------------------------------------------------------
// The face cache.
//
// Light is computed once per voxel face and shared by every pixel that can see it. That is
// the whole optimisation, and it is worth more than any screen-space trick for two reasons:
//
//   A face is usually covered by many pixels, so one traced sample serves all of them.
//   A face is in the *world*, so turning the camera does not throw the work away. Screen-space
//   accumulation loses everything the moment you look elsewhere and has to re-converge; this
//   is still there when you look back.
//
// Only *indirect* light is cached. Direct sun is cheap, has hard shadow edges that a shared
// per-face value would smear, and is already sampled exactly per pixel. Indirect is the part
// that is expensive and smooth, which is exactly the part worth sharing.
//
// Irradiance is stored rather than outgoing colour, so the cache is independent of the
// material: a face's albedo is applied when it is read. One entry then stays correct if the
// material is repainted, which for a game about repainting things is not a small thing.
struct FaceEntry {
    uint key_lo;      // 0 means the slot has never been claimed
    uint key_hi;
    uint count;       // samples accumulated
    uint last_frame;  // for eviction; a table that never evicts is a table that fills
    uvec4 sum;        // xyz irradiance in fixed point, w the sun's visibility
};

layout(std430, binding = 17) buffer FaceCache { FaceEntry items[]; } faces;

// Fixed point, because atomically adding floats needs an extension that is not core and this
// has to run everywhere. 4096 steps per unit is finer than the eye on any display, and the
// count is capped well before the sum could wrap.
const float kFixedScale = 4096.0;
// How many contributions an entry averages over before it starts forgetting. Long enough to
// be smooth, short enough that a face follows the world being built around it.
const uint kFaceWindow = 512u;

// Eight, not four. A short probe is right Ã¢â‚¬â€ spending longer looking is worse than tracing the
// sample uncached Ã¢â‚¬â€ but four was short enough that a noticeable fraction of faces never got a
// slot at all, and every one of them rendered pitch black in shadow.
const uint kFaceProbes = 8u;

// How long a face may go unseen before its slot can be taken. Several seconds at any frame
// rate: a face just off screen has to survive turning round and back, which is the entire
// reason for caching in world space rather than on the screen.
const uint kFaceColdFrames = 600u;

uint hash_u32(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// A face is a voxel and one of its six sides, in absolute world voxels so the key does not
// move when the camera does.
void face_key(ivec3 voxel, ivec3 normal, uint level, out uint lo, out uint hi) {
    uint face = (normal.x != 0) ? ((normal.x > 0) ? 0u : 1u)
              : (normal.y != 0) ? ((normal.y > 0) ? 2u : 3u)
                                : ((normal.z > 0) ? 4u : 5u);

    // Keyed by (node, level, face), not by (voxel, face).
    //
    // The level is what stops the table drowning at distance. A pixel far away covers many
    // voxels, so neighbouring pixels land on different faces, and the number of distinct faces
    // in view grows without bound while each is seen by about one pixel — every entry is
    // expensive to fill and useless once filled. Measured on the test scene: near surfaces were
    // fully cached and 18.5% of surface pixels missed entirely, all of them towards the
    // horizon, and they rendered as patches of noise against a smooth foreground.
    //
    // Sharing one entry per node at the size the pixel can actually resolve fixes both ends:
    // the count stops growing, and it costs nothing visible, because a node smaller than a
    // pixel is exactly the thing whose detail cannot be seen anyway. It is the same rule the
    // marcher already follows for geometry.
    voxel >>= int(level);

    // Mixed one axis at a time, rather than XORing three multiplications together.
    //
    // That looks fine and behaves badly on exactly this input: voxel coordinates are a dense
    // lattice, and XOR of products over a lattice leaves whole planes of faces landing in the
    // same few buckets. Faces that then failed to find a slot were drawn with no indirect
    // light at all, which in shadow is pure black Ã¢â‚¬â€ scattered black voxels through every
    // shadowed surface, which is what this looked like.
    uint h = 0x811C9DC5u;
    h = hash_u32(h ^ uint(voxel.x));
    h = hash_u32(h ^ uint(voxel.y));
    h = hash_u32(h ^ uint(voxel.z));
    h = hash_u32(h ^ level);
    lo = hash_u32(h ^ face);
    hi = hash_u32(lo ^ 0x9E3779B9u);
    // Zero is the "never claimed" marker, so the key must never be zero.
    if (lo == 0u) lo = 1u;
}

// The slot this face lives in, or 0xFFFFFFFF when the table is too crowded here to place it.
// A short probe and then give up: spending longer looking is worse than tracing the sample
// uncached, and an unbounded probe on a full table is a hang.
uint face_slot(uint lo, uint hi, bool claim, uint frame) {
    uint capacity = uint(faces.items.length());
    uint base = lo % capacity;

    uint coldest = 0xFFFFFFFFu;
    uint coldest_frame = 0xFFFFFFFFu;

    for (uint probe = 0u; probe < kFaceProbes; ++probe) {
        uint slot = (base + probe) % capacity;
        uint found = faces.items[slot].key_lo;
        if (found == lo && faces.items[slot].key_hi == hi) {
            faces.items[slot].last_frame = frame;
            return slot;
        }
        if (found == 0u) {
            if (!claim) return 0xFFFFFFFFu;
            uint previous = atomicCompSwap(faces.items[slot].key_lo, 0u, lo);
            if (previous == 0u) {
                faces.items[slot].key_hi = hi;
                faces.items[slot].last_frame = frame;
                return slot;
            }
            if (previous == lo && faces.items[slot].key_hi == hi) {
                faces.items[slot].last_frame = frame;
                return slot;
            }
        }
        uint used = faces.items[slot].last_frame;
        if (used < coldest_frame) {
            coldest_frame = used;
            coldest = slot;
        }
    }
    if (!claim) return 0xFFFFFFFFu;

    // Nothing free. Take the coldest of the slots looked at, if it has genuinely gone cold.
    //
    // Without this the table only ever fills: a slot is claimed the first time a face is seen
    // and never given up, so walking around a world steadily consumes it until every new face
    // fails to place and falls back to per-pixel sampling. That does not look black any more —
    // it looks like patches of the world that are noisy while everything around them is
    // smooth, which is what this turned into once the black was fixed.
    //
    // "Cold" is deliberately several seconds: a face just off screen must survive turning
    // round, which is the entire reason for caching in world space.
    if (coldest != 0xFFFFFFFFu && (frame - coldest_frame) > kFaceColdFrames) {
        uint previous = atomicExchange(faces.items[coldest].key_lo, lo);
        if (previous != lo) {
            faces.items[coldest].key_hi = hi;
            faces.items[coldest].count = 0u;
            faces.items[coldest].sum = uvec4(0u);
        }
        faces.items[coldest].last_frame = frame;
        return coldest;
    }
    return 0xFFFFFFFFu;
}

vec3 unpack_rgb(uint packed) {
    return vec3(float(packed & 0xFFu), float((packed >> 8u) & 0xFFu),
                float((packed >> 16u) & 0xFFu)) / 255.0;
}

#include "preview.glsl"

layout(push_constant) uniform Trace {
    vec4 sun;          // xyz direction *towards* the sun, w cosine of its angular radius
    vec4 sun_colour;   // rgb radiance
    uvec4 control;     // x sample index, y bounce limit, z frame counter, w unused
} trace;

const float kPi = 3.14159265359;

// ---------------------------------------------------------------------------------------
// Sampling
//
// One stream per pixel per sample, hashed rather than stored. A stored state would need a
// buffer the size of the screen and would serialise nothing useful.
uint pcg(inout uint state) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand(inout uint state) { return float(pcg(state)) * (1.0 / 4294967296.0); }

// Cosine-weighted hemisphere around n. Cosine-weighted because the diffuse BRDF is divided by
// exactly that cosine, so the two cancel and the estimator is just the albedo ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â the lowest
// variance a diffuse bounce can have without knowing where the light is.
vec3 cosine_hemisphere(vec3 n, inout uint state) {
    float u1 = rand(state);
    float u2 = rand(state);
    float r = sqrt(u1);
    float phi = 2.0 * kPi * u2;

    vec3 up = (abs(n.z) < 0.999) ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * (r * cos(phi)) + bitangent * (r * sin(phi)) +
                     n * sqrt(max(0.0, 1.0 - u1)));
}

// GGX half-vector sample, for the specular lobe.
vec3 ggx_half(vec3 n, float roughness, inout uint state) {
    float a = max(roughness * roughness, 1e-3);
    float u1 = rand(state);
    float u2 = rand(state);
    float cos_theta = sqrt((1.0 - u1) / (1.0 + (a * a - 1.0) * u1));
    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    float phi = 2.0 * kPi * u2;

    vec3 up = (abs(n.z) < 0.999) ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * (sin_theta * cos(phi)) + bitangent * (sin_theta * sin(phi)) +
                     n * cos_theta);
}

float ggx_smith(float n_dot_v, float n_dot_l, float roughness) {
    float a = max(roughness * roughness, 1e-3);
    float k = a * 0.5;
    float gv = n_dot_v / (n_dot_v * (1.0 - k) + k);
    float gl = n_dot_l / (n_dot_l * (1.0 - k) + k);
    return gv * gl;
}

// ---------------------------------------------------------------------------------------
// Light and materials

vec3 sky_radiance(vec3 dir) {
    float up = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 horizon = vec3(0.62, 0.68, 0.78);
    vec3 zenith = vec3(0.18, 0.32, 0.62);
    vec3 ground = vec3(0.16, 0.15, 0.14);
    // Scaled well below the sun. Those colours were written to be looked at directly, and
    // used unchanged as *radiance* they light the whole hemisphere at nearly the brightness of
    // the sun itself ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â every surface gets the same flat fill from every direction, shadows
    // stop reading, and the result is the grey wash a first attempt at this always produces.
    // Real daylight has the sun an order of magnitude above the sky it shares the frame with.
    vec3 base = ((dir.y < 0.0) ? mix(ground, horizon, up * 2.0)
                               : mix(horizon, zenith, up * 2.0 - 1.0)) * 0.25;
    // The sun's own disc, so a mirror reflects something rather than a flat gradient.
    if (dot(dir, trace.sun.xyz) > trace.sun.w) return base + trace.sun_colour.rgb;
    return base;
}

struct Material {
    vec3 albedo;
    float roughness;
    float metallic;
    vec3 emission;
};

Material material_of(uint type_id) {
    Material m;
    m.albedo = vec3(0.5);
    m.roughness = 0.5;
    m.metallic = 0.0;
    m.emission = vec3(0.0);

    uint visual_id = types.items[type_id].x;
    uvec4 v = visuals.items[visual_id];

    // Byte layout of VisualRecord (world/voxel_type.hpp): rgb + opacity, then roughness,
    // metallic, ior, emissive, then absorption and translucency, then the emissive tint.
    m.albedo = vec3(float(v.x & 0xFFu), float((v.x >> 8u) & 0xFFu),
                    float((v.x >> 16u) & 0xFFu)) / 255.0;
    m.roughness = float(v.y & 0xFFu) / 255.0;
    m.metallic = float((v.y >> 8u) & 0xFFu) / 255.0;

    float emissive = float((v.y >> 24u) & 0xFFu) / 255.0;
    if (emissive > 0.0) {
        uint tint = v.w & 0xFFFFu;   // RGB565
        vec3 colour = vec3(float((tint >> 11u) & 0x1Fu) / 31.0,
                           float((tint >> 5u) & 0x3Fu) / 63.0, float(tint & 0x1Fu) / 31.0);
        // Squared so the byte spans a useful range: a torch and a furnace are not one step
        // apart on a linear scale.
        m.emission = colour * (emissive * emissive * 64.0);
    }
    return m;
}

// Albedo is all a coarse hit gives, so treat it as a rough dielectric. Only reachable when a
// ray leaves the streamed region entirely; primary and bounce rays both run at level 0.
Material material_from_colour(uint packed) {
    Material m;
    m.albedo = vec3(float(packed & 0xFFu), float((packed >> 8u) & 0xFFu),
                    float((packed >> 16u) & 0xFFu)) / 255.0;
    m.roughness = 0.8;
    m.metallic = 0.0;
    m.emission = vec3(0.0);
    return m;
}

bool occluded(vec3 origin, vec3 dir) {
    // Full detail, and no feedback: a shadow ray must not drag streaming towards wherever it
    // happened to point.
    Hit hit = march(origin, dir, 0.0, 0.0, false);
    return hit.hit;
}

// Direct sun at a point, sampled rather than waited for. Without this the sun is found only
// when a bounce happens to land inside its half-degree disc, which is almost never Ã¢â‚¬â€ the
// difference between converging in seconds and in an hour.
//
// Deliberately per pixel and never cached: its shadow edges are sharp, and one value shared
// across a whole face would smear them.
// A direction inside the sun's disc, so its shadows have a penumbra. A point light casts an
// edge with none at all, which is the single most obvious way a render looks synthetic.
vec3 sun_sample(inout uint state) {
    float cos_max = trace.sun.w;
    float u1 = rand(state);
    float u2 = rand(state);
    float cos_theta = mix(cos_max, 1.0, u1);
    float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    float phi = 2.0 * kPi * u2;

    vec3 n = trace.sun.xyz;
    vec3 up = (abs(n.z) < 0.999) ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * (sin_theta * cos(phi)) + bitangent * (sin_theta * sin(phi)) +
                     n * cos_theta);
}

// Sun light given how much of the sun this face can see. Splitting visibility out is what
// lets the expensive half Ã¢â‚¬â€ the shadow ray Ã¢â‚¬â€ be traced once per face and shared, while the
// cheap half, which depends on the viewing angle, stays per pixel.
vec3 sun_light(vec3 normal, vec3 view, Material m, float visibility) {
    float n_dot_l = dot(normal, trace.sun.xyz);
    if (n_dot_l <= 0.0 || visibility <= 0.0) return vec3(0.0);

    vec3 diffuse = m.albedo * (1.0 - m.metallic) / kPi;

    vec3 h = normalize(trace.sun.xyz - view);
    float n_dot_v = max(dot(normal, -view), 1e-4);
    float n_dot_h = max(dot(normal, h), 0.0);
    float v_dot_h = max(dot(-view, h), 1e-4);
    float a = max(m.roughness * m.roughness, 1e-3);
    float d = a * a / max(kPi * pow(n_dot_h * n_dot_h * (a * a - 1.0) + 1.0, 2.0), 1e-6);
    float g = ggx_smith(n_dot_v, n_dot_l, m.roughness);
    vec3 f0 = mix(vec3(0.04), m.albedo, m.metallic);
    vec3 f = f0 + (vec3(1.0) - f0) * pow(1.0 - v_dot_h, 5.0);
    vec3 specular = d * g * f / max(4.0 * n_dot_v * n_dot_l, 1e-4);

    return (diffuse + specular) * trace.sun_colour.rgb * n_dot_l * visibility;
}

// Everything a face knows: how much of the sun it can see, and the light arriving from
// everywhere else. Both come from the same entry and the same sample count.
struct FaceLight {
    float visibility;
    vec3 indirect;
    uint count;
    bool known;
};

// How many levels up to look when this one knows nothing yet.
const uint kParentLevels = 3u;

void contribute(uint slot, vec3 value, float visibility) {
    if (slot == 0xFFFFFFFFu) return;

    // A sliding window, not a total. Once an entry holds a window's worth of samples it is
    // halved, so it averages roughly the last kFaceWindow contributions and forgets what came
    // before at the same rate.
    //
    // This is what lets an edit *not* wipe the table. Clearing the whole cache whenever
    // anything was placed meant every voxel put down relit the entire scene at once — which
    // is the smearing: not a gradual settle but the whole room changing while you build. A
    // window means a face notices the wall you just put next to it within a few frames, on
    // its own, and nothing else in the world flinches.
    //
    // Exactly one thread halves, and it claims that right with a compare-and-swap.
    //
    // Letting every thread that sees a full entry halve it was written here once, with a
    // comment calling the race harmless. It is the opposite of harmless. A thousand pixels
    // stand on one face in the same dispatch; they all read the same count, they all subtract
    // half of it, and the sums are *unsigned*, so they wrap to four billion. On screen that is
    // a saturated cyan or red square, and because a cache does not wash out it stays there and
    // more of them appear while you stand still.
    //
    // With the swap, only the thread that moved count from N to N/2 subtracts anything. It
    // then subtracts half of a sum it read *after* winning, and sums only ever grow in
    // between, so the subtraction can never take one below zero.
    uint count = faces.items[slot].count;
    if (count >= kFaceWindow) {
        if (atomicCompSwap(faces.items[slot].count, count, count - count / 2u) == count) {
            uvec4 sum = faces.items[slot].sum;
            atomicAdd(faces.items[slot].sum.x, uint(-int(sum.x / 2u)));
            atomicAdd(faces.items[slot].sum.y, uint(-int(sum.y / 2u)));
            atomicAdd(faces.items[slot].sum.z, uint(-int(sum.z / 2u)));
            atomicAdd(faces.items[slot].sum.w, uint(-int(sum.w / 2u)));
        }
    }
    atomicAdd(faces.items[slot].sum.x, uint(value.r * kFixedScale));
    atomicAdd(faces.items[slot].sum.y, uint(value.g * kFixedScale));
    atomicAdd(faces.items[slot].sum.z, uint(value.b * kFixedScale));
    atomicAdd(faces.items[slot].sum.w, uint(visibility * kFixedScale));
    atomicAdd(faces.items[slot].count, 1u);
}

FaceLight read_face(uint slot);

// A face nobody has looked at before has no history, and one sample is noise. Its parent
// covers eight times the volume, has been gathering samples from everything around it, and is
// a far better first guess than a single ray.
//
// This is what makes walking up to a surface not shimmer: the coarse node was being filled
// while it was still far away, so arriving close inherits that instead of starting over. Every
// pixel contributes to its own level *and* its parent, so the parent is always there to
// inherit from — including the first time anything looks this way.
FaceLight read_face(uint slot) {
    FaceLight light;
    light.visibility = 0.0;
    light.indirect = vec3(0.0);
    light.count = 0u;
    light.known = false;
    if (slot == 0xFFFFFFFFu) return light;

    uint count = faces.items[slot].count;
    if (count == 0u) return light;

    uvec4 sum = faces.items[slot].sum;
    float inv = 1.0 / (kFixedScale * float(count));
    // Clamped on the way out, as a backstop rather than a correction. Every contribution is
    // clamped to 8 going in, so a mean above that is arithmetic having gone wrong rather than
    // a bright surface — and a wrong entry in a cache does not fade, it persists and spreads.
    light.visibility = clamp(float(sum.w) * inv, 0.0, 1.0);
    light.indirect = min(vec3(sum.xyz) * inv, vec3(8.0));
    light.count = count;
    light.known = true;
    return light;
}

// How many samples of its own a node needs before it stops leaning on its parent.
const uint kSeedSamples = 48u;

// How far a ray has to leave a surface by, in voxels, before it is clear of it.
//
// A voxel wants a hundredth of a voxel and nothing more. A *summary* cell is a metre or more
// across, and leaving one by a hundredth of a voxel lands the ray straight back inside the
// block it just left — so every shadow ray reported occluded and every bounce found the same
// surface again. Distant chunks, which are exactly the ones drawn from summaries, came out
// uniformly black.
//
// Levels 5 and up are summary hits and carry their tier, so the cell size is known: a tier's
// block is 2^tier chunks and its cells are 2^tier metres, which is 32 << tier voxels.
float surface_offset(int level) {
    if (level < 5) return 0.01;
    return float(32u << uint(level - 5)) * 0.75;
}

// Reads a node at a *fractional* level, blending the two it falls between.
//
// The level is picked from distance and is part of the key, so a whole-number level means a
// surface swaps to a different entry — with its own separate history — the moment you cross a
// distance boundary. Walking towards a wall made its brightness step, and because each entry
// keeps its own long average the step did not settle, it smeared. Blending is the same
// continuous-detail rule the marcher already uses for geometry, applied to light.
FaceLight read_face_blended(ivec3 voxel, ivec3 normal, float level, uint frame) {
    uint l0 = uint(floor(level));
    uint l1 = min(l0 + 1u, 6u);
    float f = level - float(l0);

    uint lo0, hi0, lo1, hi1;
    face_key(voxel, normal, l0, lo0, hi0);
    face_key(voxel, normal, l1, lo1, hi1);
    FaceLight a = read_face(face_slot(lo0, hi0, false, frame));
    FaceLight b = read_face(face_slot(lo1, hi1, false, frame));

    if (!a.known) return b;
    if (!b.known) return a;

    FaceLight out_light;
    out_light.visibility = mix(a.visibility, b.visibility, f);
    out_light.indirect = mix(a.indirect, b.indirect, f);
    out_light.count = min(a.count, b.count);
    out_light.known = true;
    return out_light;
}

FaceLight read_face_seeded(ivec3 voxel, ivec3 normal, uint level, uint frame) {
    uint lo, hi;
    face_key(voxel, normal, level, lo, hi);
    FaceLight self = read_face(face_slot(lo, hi, false, frame));
    if (self.known && self.count >= kSeedSamples) return self;

    // Find the nearest ancestor that knows anything.
    FaceLight parent;
    parent.known = false;
    for (uint up = 1u; up < kParentLevels && level + up <= 6u; ++up) {
        uint plo, phi;
        face_key(voxel, normal, level + up, plo, phi);
        parent = read_face(face_slot(plo, phi, false, frame));
        if (parent.known) break;
    }
    if (!parent.known) return self;
    if (!self.known) return parent;

    // Blend rather than switch. A node with three samples of its own is mostly noise and
    // should mostly show its parent; by the time it has a few dozen it should be showing
    // itself. Switching at a threshold instead puts a visible seam wherever the threshold
    // falls, which on a wall lit from one side is a line across it.
    float weight = float(self.count) / float(kSeedSamples);
    FaceLight blended;
    blended.visibility = mix(parent.visibility, self.visibility, weight);
    blended.indirect = mix(parent.indirect, self.indirect, weight);
    blended.count = self.count;
    blended.known = true;
    return blended;
}

// The node size a pixel can resolve at this distance, as a power of two. The geometry is
// still marched at full voxel detail - this only decides how coarsely faces are *shared*.
float cache_level_exact(float t) {
    float pixel_angle = 2.0 * push.lens.x / float(push.resolution.y);
    float footprint = max(t * pixel_angle, 1.0);
    return clamp(log2(footprint), 0.0, 6.0);
}

uint cache_level(float t) {
    float pixel_angle = 2.0 * push.lens.x / float(push.resolution.y);
    float footprint = max(t * pixel_angle, 1.0);
    // Capped at 6, and raising it makes things worse, which is worth writing down because the
    // opposite is the intuition. The level is part of the key, so allowing more of them splits
    // distant surfaces across level 7, 8, 9 and 10 entries instead of pooling them in one -
    // and adjacent pixels either side of a distance boundary then look up different keys.
    // Measured: raising the cap to 10 took uncached surface pixels from 3,661 to 18,392.
    return uint(clamp(floor(log2(footprint)), 0.0, 6.0));
}

// How many samples a face needs before the pixels standing on it stop tracing for it.
const uint kFaceTarget = 192u;

// Anything not finite would poison the average for every sample after it, and one bad pixel
// would never wash out.
vec3 clamp_finite(vec3 v) {
    return (any(isnan(v)) || any(isinf(v))) ? vec3(0.0) : v;
}

void write_pixel(ivec2 pixel, uint sample_index, vec3 radiance, float primary_t, float aspect) {
    vec4 total = (sample_index == 0u) ? vec4(0.0) : imageLoad(accum, pixel);
    total.rgb += radiance;
    total.w += 1.0;
    imageStore(accum, pixel, total);

    vec3 mean = total.rgb / max(total.w, 1.0);

    // Reinhard with a shoulder, and gamma. Deliberately plain: the point is to see what the
    // material does, not what a grading curve does to it. The physical post stack is Stage 9.
    vec3 mapped = pow(clamp(mean / (mean + vec3(1.0)), 0.0, 1.0), vec3(1.0 / 2.2));

    // The tools, over the top, exactly as the real-time pipeline draws them. After tone mapping
    // and outside the accumulation, because a preview is interface rather than light: it must
    // not be averaged in, must not converge, and must not be dimmed by an exposure curve.
    // Unjittered, so an outline is a line rather than a smeared band.
    vec2 uv = (vec2(pixel) + 0.5) / vec2(push.resolution) * 2.0 - 1.0;
    vec3 straight = normalize(push.forward.xyz + push.right.xyz * uv.x * push.lens.x * aspect -
                              push.up.xyz * uv.y * push.lens.x);
    mapped = draw_preview(mapped, push.origin.xyz, straight, primary_t);

    imageStore(out_colour, pixel, vec4(mapped, 1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(push.resolution.x) || pixel.y >= int(push.resolution.y)) return;

    uint sample_index = trace.control.x;
    uint state = (uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + sample_index * 26699u) | 1u;

    // Jitter inside the pixel, which is the whole of the anti-aliasing: with enough samples
    // the average over the pixel's area is the correct answer, and no edge filter is needed.
    vec2 jitter = vec2(rand(state), rand(state));
    vec2 uv = (vec2(pixel) + jitter) / vec2(push.resolution) * 2.0 - 1.0;
    float aspect = float(push.resolution.x) / float(push.resolution.y);
    vec3 dir = normalize(push.forward.xyz + push.right.xyz * uv.x * push.lens.x * aspect -
                         push.up.xyz * uv.y * push.lens.x);
    vec3 origin = push.origin.xyz;

    vec3 radiance = vec3(0.0);
    float primary_t = push.lens.y;   // kept for the preview's depth test

    // Both halves of the light go through the face, and each is split so that only the
    // expensive part is shared.
    //
    // For the sun that is the shadow ray: whether a face can see the sun is a property of the
    // face, so it is traced once and reused, while the part that depends on where you are
    // standing is recomputed per pixel from it. A voxel face is three centimetres, so quantising
    // shadow to it costs almost nothing and removes a ray from every pixel of every frame.
    //
    // For everything else it is the whole bounce.
    Hit hit = march(origin, dir, 0.0, 0.0, true);
    if (!hit.hit) {
        radiance = sky_radiance(dir);
    } else {
        primary_t = hit.t;
        vec3 normal = vec3(hit.normal);
        vec3 point = origin + dir * hit.t;
        vec3 from = point + normal * surface_offset(hit.level);
        Material m = (hit.level == 0) ? material_of(hit.type_id)
                                      : material_from_colour(hit.colour);

        radiance = m.emission;

        // A summary hit is a stand-in for geometry that has not been streamed, and it gets
        // shaded rather than traced.
        //
        // Tracing it is both wrong and ruinously expensive. Wrong, because the shadow and
        // bounce rays are cast against a world that is only there in outline — they mostly hit
        // the same coarse block they started on and report everything occluded, which is the
        // distant chunks coming out black. Expensive, because these are exactly the pixels
        // with nothing resident, so every one of them pays for four full-length marches: at
        // 400x225 that was enough to trip the driver's watchdog and lose the device outright.
        //
        // The sun without a shadow test and the sky as ambient. Both are honest at this range:
        // the block is kilometres away and a fraction of a pixel, and a shadow it cannot
        // resolve is not a shadow anyone can see.
        if (hit.level >= 5) {
            float n_dot_l = max(dot(normal, trace.sun.xyz), 0.0);
            radiance += m.albedo * (trace.sun_colour.rgb * n_dot_l / kPi +
                                    sky_radiance(normal) * 0.5);
            radiance = clamp_finite(radiance);
            write_pixel(pixel, sample_index, radiance, primary_t, aspect);
            return;
        }

        ivec3 voxel = ivec3(floor(point - normal * 0.5)) + push.camera_chunk.xyz * kChunkEdge;
        uint level = cache_level(hit.t);
        uint lo, hi;
        face_key(voxel, hit.normal, level, lo, hi);
        uint slot = face_slot(lo, hi, true, trace.control.z);

        // Whether this pixel does any work at all beyond the primary ray.
        //
        // This is where the saving actually lands. A face covered by a thousand pixels reaches
        // a good estimate within a frame or two, and after that every one of those pixels was
        // still tracing a shadow ray and a bounce to tell it what it already knew. Once a face
        // has enough samples they stop, and a converged surface costs one ray per pixel â€” the
        // primary â€” however many lights and bounces it is standing under.
        //
        // A small fraction keep going regardless, so a face is never frozen: light that moves,
        // or a neighbour that changed, still works its way in.
        uint have = (slot != 0xFFFFFFFFu) ? faces.items[slot].count : 0u;
        bool refine = (have < kFaceTarget) || (rand(state) < 0.02);

        float visibility = 0.0;
        vec3 incoming = vec3(0.0);

        if (!refine) {
            FaceLight known = read_face_blended(voxel, hit.normal, cache_level_exact(hit.t),
                                                trace.control.z);
            radiance += sun_light(normal, dir, m, known.visibility) +
                        m.albedo * (1.0 - m.metallic) * known.indirect;
            radiance = clamp_finite(radiance);
            write_pixel(pixel, sample_index, radiance, primary_t, aspect);
            return;
        }

        if (dot(normal, trace.sun.xyz) > 0.0) {
            visibility = occluded(from, sun_sample(state)) ? 0.0 : 1.0;
        }

        vec3 bounce_dir = cosine_hemisphere(normal, state);
        Hit second = march(from, bounce_dir, 0.0, 0.0, false);
        if (!second.hit) {
            incoming = sky_radiance(bounce_dir);
        } else {
            vec3 n2 = vec3(second.normal);
            vec3 p2 = from + bounce_dir * second.t;
            vec3 from2 = p2 + n2 * surface_offset(second.level);
            Material m2 = (second.level == 0) ? material_of(second.type_id)
                                              : material_from_colour(second.colour);

            // The far end reads its own face rather than tracing on. This is what makes the
            // bounce count unbounded for nothing: what is read there already contains its own
            // sun and its own indirect from earlier frames, so light gains a bounce per frame
            // and keeps it. If that face is not in the table yet its light is simply missing
            // this frame and arrives once it is.
            ivec3 voxel2 = ivec3(floor(p2 - n2 * 0.5)) + push.camera_chunk.xyz * kChunkEdge;
            uint lo2, hi2;
            face_key(voxel2, second.normal, cache_level(hit.t + second.t), lo2, hi2);
            FaceLight far = read_face_seeded(voxel2, second.normal,
                                             cache_level(hit.t + second.t), trace.control.z);

            incoming = m2.emission + sun_light(n2, bounce_dir, m2, far.visibility) +
                       m2.albedo * (1.0 - m2.metallic) * far.indirect;
        }

        // Contribute. Clamped, because a single path that finds the sun through a gap carries
        // a spike â€” in a per-pixel average that is a firefly which washes out, and in a cache
        // it persists and one face wears it for thousands of frames.
        vec3 clamped = min(incoming, vec3(8.0));
        contribute(slot, clamped, visibility);

        // And to the parent node. One extra set of atomics buys a node one level up that is
        // always populated — which is what a face being looked at for the first time inherits
        // from, instead of a single noisy ray.
        uint plo, phi;
        face_key(voxel, hit.normal, min(level + 1u, 6u), plo, phi);
        contribute(face_slot(plo, phi, true, trace.control.z), clamped, visibility);

        // Then shade from the face, which now includes every other pixel standing on it this
        // frame. A face the table could not hold falls back to this pixel's own samples: noisy,
        // and *correct*, where before it fell back to nothing at all â€” which in shadow, where
        // indirect is the only light there is, drew pure black.
        // Debug view 5: where the cache is actually working. Red is a pixel that had to fall
        // back to its own samples because no slot could be found; green is a face the table
        // holds. This class of fault has now been reported twice — once as black voxels, once
        // as patches of noise — and both times it had to be deduced from a photograph. It is
        // cheaper to be able to look at it.
        if (push.resolution.z == 5u) {
            vec3 mark = (slot == 0xFFFFFFFFu) ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.7, 0.0);
            imageStore(out_colour, pixel, vec4(mark, 1.0));
            return;
        }

        // Debug view 6: why a pixel came out dark, rather than another guess at it.
        //
        //   red     the material's own albedo is black, so no light could show on it
        //   blue    no cache entry, so no indirect light at all
        //   yellow  an entry, holding nothing
        //   cyan    the sun is not visible and indirect is all there is
        //   grey    lit normally
        //
        // Distant chunks have come out black twice now, for two different reasons, and both
        // times the cause had to be inferred from a photograph. This makes the render say it.
        if (push.resolution.z == 6u) {
            FaceLight probe = read_face_seeded(voxel, hit.normal, level, trace.control.z);
            float albedo_max = max(m.albedo.r, max(m.albedo.g, m.albedo.b));
            float light_max = max(probe.indirect.r, max(probe.indirect.g, probe.indirect.b));
            vec3 mark;
            if (albedo_max < 0.01) mark = vec3(1.0, 0.0, 0.0);
            else if (!probe.known) mark = vec3(0.0, 0.0, 1.0);
            else if (light_max < 0.001 && probe.visibility < 0.001) mark = vec3(1.0, 1.0, 0.0);
            else if (probe.visibility < 0.001) mark = vec3(0.0, 1.0, 1.0);
            else mark = vec3(0.35);
            imageStore(out_colour, pixel, vec4(mark, 1.0));
            return;
        }

        FaceLight here = read_face_seeded(voxel, hit.normal, level, trace.control.z);
        if (here.known && here.count >= kSeedSamples) {
            here = read_face_blended(voxel, hit.normal, cache_level_exact(hit.t), trace.control.z);
        }
        if (!here.known) {
            here.visibility = visibility;
            here.indirect = incoming;
        }
        radiance += sun_light(normal, dir, m, here.visibility) +
                    m.albedo * (1.0 - m.metallic) * here.indirect;
    }
    write_pixel(pixel, sample_index, clamp_finite(radiance), primary_t, aspect);
}
