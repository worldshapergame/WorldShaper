#version 450
// One invocation per face, and the whole reason this stage exists.
//
// Light is worked out here, on the surface, instead of on the screen. A face does not care how
// many pixels are looking at it, so the cost of lighting stops being a function of resolution:
// the same building at 4K shades exactly the faces it shades at 800p (documentation/21 §6).
//
// # One writer
//
// Exactly one invocation owns each face (D191). Everything the per-pixel tracer does to survive a
// thousand pixels writing one face in the same dispatch -- the halving compare-and-swap, the
// read-the-sum-twice-and-take-the-minimum, the empty-then-publish key ordering, the eight-probe
// coldest-slot eviction -- exists because the wrong thing owns the write. None of it is here, and
// none of it was removed: it was never needed.
//
// # What it does so far
//
// The sun, and only the sun. One shadow ray per face per frame, accumulated into a visibility
// fraction so the penumbra resolves over samples rather than over pixels. Bounce, sky and lamps
// are R3c; the directional bins that make a mirror are R4.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#include "node.glsl"

// The face store and its accessors come from node.glsl, alongside the tree the shadow ray
// marches -- one declaration, so the pass that writes light and the pass that reads it cannot
// drift apart about the layout.

// ---- the sky, for the rays that reach it (R9) --------------------------------------------------
//
// A gathering ray that escapes has found the sky, and what it is worth has to be the same number the
// composite draws, or indirect light arrives with a colour the frame does not have. So this pass
// evaluates `pt_sky.glsl` -- the same file, not a second model.
//
// It wants three things the marcher's own declarations do not provide, and all three are shims
// rather than copies: `kPi`, `hash_u32` (which is `node_hash_mix` under the name pt_sky knows), and
// a `trace` with the sun in it. The real `trace` is a push block the composite and the cloud pass
// share, and a stage may declare only one push block -- this one already has `NodeConstants` -- so
// the two fields pt_sky actually reads are carried there and copied into a struct of that name at
// the top of main(). Everything else in the real block is clouds, fog and quality, which the sky
// functions never touch.
const float kPi = 3.14159265358979;
uint hash_u32(uint x) { return node_hash_mix(x); }
struct SkyTrace {
    vec4 sun;
    vec4 sun_colour;
};
SkyTrace trace;
#include "pt_sky.glsl"
#include "face_terms.glsl"

// The outward normal of one of the six faces, in the order node_face_coverage uses so that a
// direction never has to be translated between the two.
ivec3 face_normal(uint face) {
    if (face == 0u) return ivec3(1, 0, 0);
    if (face == 1u) return ivec3(-1, 0, 0);
    if (face == 2u) return ivec3(0, 1, 0);
    if (face == 3u) return ivec3(0, -1, 0);
    if (face == 4u) return ivec3(0, 0, 1);
    return ivec3(0, 0, -1);
}

// A point just off the face, at `at` over the sampled span in [-1, 1] on each of the face's two
// axes. Every ray this pass casts leaves from one of these, and they all use this function so that
// the position a sample is TAKEN at and the position the gradient is FITTED against cannot drift
// apart -- which they would, silently, and would read as a tilt on a flat wall.
//
// # The middle half of the face, not all of it, and this is a leak fix rather than a taste
//
// A voxel grid lets a ray through the shared EDGE of two solid cells: the DDA crosses both
// boundaries on the same step and lands in the empty cell diagonally beyond. Sampling right up to
// the edge of a face puts ray after ray on exactly that line, and indoors -- where the only correct
// answer is full shadow -- about five per cent of them came out the other side. That reads as
// banding across a wall that should be uniformly dark, which is what it was reported as.
//
// Half costs sub-voxel penumbra within a face and costs it where it is worth least: at level 0 the
// face IS a voxel, and the shadow detail wanted there is per voxel, which the store already gives.
// The sun's angular radius still softens the edge, and that is the term that carries a penumbra at
// any distance.
//
// The node's own coordinate is its voxel coordinate shifted by its level, so `corner` reverses
// exactly the shift the marcher applied when it reported the face -- and the last term lands half a
// cell along the normal, which is the face rather than the middle of the cell behind it.
vec3 face_point(vec3 corner, vec3 across, vec3 down, ivec3 normal, float size, vec2 at) {
    const float span = size * 0.5;
    const vec3 on_face = corner + vec3(size * 0.5) +
                         across * (at.x * 0.5 * span) +
                         down * (at.y * 0.5 * span);
    return on_face + vec3(normal) * (size * 0.5 + 0.03125);
}

// Inherit the ambient term of the coarse face standing over this one, so a face that has just been
// claimed is roughly right on the frame it appears instead of reading as fully unoccluded until its
// own rays arrive.
//
// This is D308-D311's stand-in, applied to the other half of the ambient integral. A face with no
// samples reads as open sky, and indoors that is not a cautious answer -- it is the worst answer
// available, and it is the one the composite showed for as long as it took a new surface to gather
// rays. The face three levels up is already claimed by the same host code that claims this one, is
// converged long before its children are found because five hundred and twelve of them share it,
// and covers exactly this face. It is the best prior available and it costs one hash.
//
// It is a PRIOR and not an answer: `kSkySeedSamples` of it, against a first burst of `kSkyBurst`,
// so the face's own measurements outvote it immediately. R9d measured a stand-in as about a tenth
// off and sharpening, which is the error being accepted here.
//
// The ancestor's words may be written by another invocation in this same dispatch, and nothing
// orders the two. What that can cost is one frame of a prior that is one burst stale, on a quantity
// that is a prior in the first place -- so it is read plainly rather than guarded.
// The two axes the samples are spread along, as INDICES into a node coordinate, chosen the same way
// `across` and `down` are chosen from the normal. One place, because the position a sample is taken
// at, the position the gradient is fitted against and the position it is prolonged to all have to
// agree, and three copies of "which axis is u" is three chances for one of them to be the other.
ivec2 face_axes(uint dir) {
    if (dir < 2u) return ivec2(1, 2);   // +-x: across is y, down is z
    if (dir < 4u) return ivec2(0, 2);   // +-y: across is x, down is z
    return ivec2(0, 1);                 // +-z: across is x, down is y
}

// ---- R5a: a face's light, blended with its coplanar neighbours' ---------------------------------
//
// Every light term in this renderer is a per-face Monte Carlo estimate and until now NOTHING
// filtered across faces. That is the class the reported *fine grid on flat surfaces* belongs to
// (D539 eliminated eight specific causes and found no ninth), and it is what the ambient term's
// face-to-face roughness has always been. A per-face estimator with a few hundred samples disagrees
// with its neighbour by its own standard error, and on a flat wall that disagreement is the only
// thing there is to see.
//
// # Why the neighbours need no edge-stopping weight, which is the whole reason this is cheap
//
// An a-trous denoiser over a screen spends most of its arithmetic deciding which neighbours belong
// to the same surface: normals, depths, mesh ids, and a heuristic per term. Here the question does
// not arise. A face is keyed by (node, level, direction), so a neighbour at the same level and the
// same direction, one step along one of the two axes the normal is NOT along, is **coplanar and
// contiguous by construction** — same plane, same orientation, adjacent. There is no geometric edge
// to stop at, because a change of plane is a change of key and the lookup simply misses.
//
// So the weights are a plain 3x3 tent — 4 for this face, 2 for an edge neighbour, 1 for a corner —
// times how well measured that neighbour is. The kernel is three voxels wide, which at the leaf is
// **9.4 cm**; that is far below anything the eye reads as a lighting edge and far above the spacing
// of the noise.
//
// # What is filtered, and what deliberately is not
//
// The two answers of the ONE UNBOUNDED RAY — `open_sky` and the bounce — and the LAMPS. Those three
// are chosen from a photograph of every term on its own rather than from an argument, which is the
// only way this question can be asked: at the enclosed camera the lamp term reads a speckle of 23.0
// of 255 and the near field 6.0, and at the close camera the far field reads 90.3 against the near
// field's 36.6. The far field and the bounce are the slowest estimator here, one sample every
// `face_stride` frames after the eager phase, and the bounce is a radiance with no bound to average
// against — which is why it needed `kBounceBelieve` in the composite in the first place (D535: "one
// ray landing on a sunlit sill returns something twenty times what the wall around it returns"). The
// lamp is the same shape one door along: `pick_light` keeps ONE fitting per face per frame in
// proportion to what it would deliver and divides by the density that chose it, so a face's estimate
// is a few hundred samples of a distribution over every emitter in the building, and indoors that is
// the whole of the light.
//
// The SUN is not filtered and must not be by this: a shadow edge is a real high-frequency feature
// and it lives in `counters`, which the host mirrors. The NEAR field is not either — measured on
// this building it is the smoothest term there is, because it takes sixteen bounded rays a frame
// rather than one of anything.
//
// # How a face that has just appeared gets a converged answer
//
// The weight of a tap is its spatial weight times its own sample count, capped at `kBounceMin`. A
// face with four samples standing among converged neighbours therefore contributes a four-hundredth
// of what they do, and reads very nearly their answer — which is the other half of the report this
// stage exists for, that a surface the camera has just revealed is visibly coarser than the wall
// around it for about seventeen seconds. `face_light_seed` already does this DOWN the tree from an
// ancestor; this is the same idea sideways, and it needs no extra rays either.
//
// The effective count written beside the answer is the weighted mean of the taps' counts, not their
// sum. A sum would be the right combination for independent estimates of ONE quantity; these are
// estimates of neighbouring quantities, so the mean is the conservative reading and it is what the
// composite believes the bounce in proportion to.
//
// # Two properties this arrangement has by construction rather than by care
//
// It reads words 0-11 and writes words 12-15, so it can never filter its own output — an a-trous
// step that reads what it writes is applied again on every visit and blurs without bound. And with
// no neighbours at all it writes exactly this face's own values, so a lone face, a face at a corner
// and a face whose neighbours are at another level are all unchanged rather than darkened.
//
// The neighbours' words may be written by another invocation of this same dispatch and nothing
// orders the two. That is the same race `face_light_seed` above accepts and for the same reason:
// what it can cost is one visit of staleness on a quantity that moves over hundreds of frames.
const float kDenoiseCentre = 4.0;
const float kDenoiseEdge = 2.0;
const float kDenoiseCorner = 1.0;

// ---- and the one tap that must not be allowed to speak for the other eight ---------------------
//
// **Reported from playing, and reported precisely enough to be a diagnosis: "the speckles have the
// size of 3x3 voxel faces, where the central pixel is properly coloured".** That is this kernel.
//
// The failure is what a mean does with a heavy tail. A bounce sample is a RADIANCE with no bound to
// average against — D535's own example is a ray landing on a sunlit sill returning twenty times what
// the wall around it returns — and `kBounceMemory`'s incremental mean starts AT the first sample, so
// a face with one far ray holds that ray. On settled geometry that face is one voxel of wrongness
// nobody sees, and the sample-count weighting below buries it: a one-sample face contributes
// 2/6000ths of a converged neighbour's answer.
//
// The case it does not bury is the one a player is in when they turn round. A newly revealed patch is
// ALL new: every tap holds one or two samples, so every weight is comparable, and one wild value gets
// a whole ninth of each of its eight neighbours. Its own face averages the outlier away and comes out
// right — which is exactly the reported shape, a correct centre inside a wrong ring. Before this
// filter existed that face was a single wrong voxel; the filter turned one bad face into nine.
//
// **The comment above this one was right about geometry and wrong to generalise from it.** A
// coplanar neighbour needs no plane test, no normal test and no depth test — that much stands. It
// does not follow that it needs no test at all, because a flat plane can carry a real lighting
// discontinuity across it: the edge of a shadow, the line where an alcove stops shading, the last
// voxel a sconce reaches. Blending across one of those is not denoising, it is a bias, and in a dark
// room the bias is the whole signal.
//
// So each neighbour is weighted by how much it AGREES with this face, and the strength of that test
// rises with how well this face knows its own answer:
//
//   - a face with almost no samples does not trust itself, accepts its neighbours whole, and reads
//     very nearly their answer. That is the borrowing this stage exists for and it is untouched;
//   - a face that has measured itself for hundreds of samples trusts itself, and a neighbour four
//     times brighter is a neighbour on the other side of something rather than the same wall
//     measured better. It contributes almost nothing.
//
// Without that scaling the two halves fight: an unconditional edge test forbids a new face from
// borrowing (which is most of what R5a bought), and no edge test at all smears every lit face into
// a ring of eight that should have been dark (which is what was reported).
//
// The agreement term is a plain ratio of luminances, one when they match and falling towards nought
// as they diverge, with a floor so that black beside black is agreement rather than a division. It
// is not the exponential of a variance estimate that a screen-space denoiser would use, because
// there is no variance estimate here and inventing one would be a second thing to be wrong about.
//
// `--denoise-edge N` sweeps the sharpness and **0 is the control arm**, which is the filter exactly
// as it was when the 3x3 was reported. A trade nobody can sweep is one somebody guesses at, and this
// one has a real cost on the other side: test too hard and neighbouring faces stop helping each
// other at all, which is R5a switched off by the back door.
const float kDenoiseEdgeSharp = 2.0;
// Negative is the sentinel for "the shader's own figure" rather than nought, so that `0` reads as
// what it says -- no edge test at all -- instead of as "unset". A dial whose control arm is spelled
// one greater than it means is a wrong measurement waiting to happen.
float denoise_edge_sharp() { return push.tone.y >= 0.0 ? push.tone.y : kDenoiseEdgeSharp; }

float denoise_luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// How much a tap agrees with the face doing the filtering, in [0, 1]. `known` is how far this face
// trusts its own answer, and at nought this returns one for everything.
float denoise_agree(vec3 value, vec3 centre, float known) {
    const float sharp = denoise_edge_sharp();
    if (known <= 0.0 || sharp <= 0.0) return 1.0;
    const float a = denoise_luminance(value);
    const float b = denoise_luminance(centre);
    // A floor rather than an epsilon: two faces that are both nearly black agree, and without it
    // the ratio of two tiny numbers is noise deciding the weight.
    const float floor_lum = 1e-3;
    const float ratio = (min(a, b) + floor_lum) / (max(a, b) + floor_lum);
    return mix(1.0, pow(ratio, sharp), clamp(known, 0.0, 1.0));
}

// One tap. Adds nothing at all when there is no face there, which is what makes the kernel shrink
// gracefully at a corner instead of pulling the answer towards nought.
// Two weight sums and not one, because the two estimators have their own sample counts and they run
// out at different times. A face whose far field has finished and whose lamp term was reopened by a
// light-list version bump has hundreds of one and eight of the other, and a shared weight would let
// whichever is further along decide how much of the other to take from that neighbour.
// `centre_*` are what this face holds and `known` is how far it trusts that. The centre tap passes
// `known = 0`, which makes every agreement term one and leaves it weighing exactly what it always
// did.
void face_denoise_tap(ivec3 node, uint level, uint dir, float spatial, inout float weight,
                      inout float spatial_used, inout float sky, inout vec3 bounce,
                      inout float counted, inout float lamp_weight, inout vec3 lamp,
                      vec3 centre_bounce, vec3 centre_lamp, float known) {
    const uint found = node_face_lookup(node, level, dir);
    if (found == kNoFace || found == kFaceTombstone) return;
    const uint at = found * kFaceLightWords;
    if (at + kFaceLightWords - 1u >= face_light.words.length()) return;

    // The lamps, as a mean: the record keeps a SUM over its own count, because unlike the sun and the
    // sky a lamp's answer is not a fraction in [0, 1] and has no bound to scale against.
    const uint lamp_n = face_light.words[at + 8u] & 0xFFFFu;
    if (lamp_n > 0u) {
        const vec3 value = vec3(uintBitsToFloat(face_light.words[at + 5u]),
                                uintBitsToFloat(face_light.words[at + 6u]),
                                uintBitsToFloat(face_light.words[at + 7u])) / float(lamp_n);
        const float lw = spatial * float(min(lamp_n, kLampConverged)) *
                         denoise_agree(value, centre_lamp, known);
        lamp_weight += lw;
        lamp += lw * value;
    }

    const uint far_n = (face_light.words[at] >> 16) & 0xFFFFu;
    if (far_n == 0u) return;
    const vec3 value = vec3(uintBitsToFloat(face_light.words[at + 9u]),
                            uintBitsToFloat(face_light.words[at + 10u]),
                            uintBitsToFloat(face_light.words[at + 11u]));
    // The far field rides the bounce's agreement, because they are one ray's two answers and a
    // neighbour that is not measuring this face's light is not measuring its sky either.
    const float w = spatial * float(min(far_n, kBounceMin)) *
                    denoise_agree(value, centre_bounce, known);
    weight += w;
    spatial_used += spatial;
    counted += w;
    sky += w * (float(face_light.words[at + 4u]) / float(far_n));
    bounce += w * value;
}

void face_denoise(uint light_at, ivec3 node, uint level, uint dir) {
    const uint far_n = (face_light.words[light_at] >> 16) & 0xFFFFu;
    // Nothing measured here yet. Leave the filtered count at nought, which is what tells the
    // composite to read the raw record exactly as it did before this existed — the same discipline
    // every other term in this pass follows, that an absent measurement reads as the picture the
    // renderer already had rather than as black.
    if (far_n == 0u) {
        face_light.words[light_at + kFaceFilteredSky] = 0u;
        return;
    }

    float weight = 0.0;
    float spatial_used = 0.0;
    float sky = 0.0;
    float counted = 0.0;
    float lamp_weight = 0.0;
    vec3 bounce = vec3(0.0);
    vec3 lamp = vec3(0.0);
    // This face first and on its own terms, because what it holds is what the eight around it are
    // then weighed against. `known` is nought here, so the centre weighs exactly what it always did.
    face_denoise_tap(node, level, dir, kDenoiseCentre, weight, spatial_used, sky, bounce, counted,
                     lamp_weight, lamp, vec3(0.0), vec3(0.0), 0.0);
    const vec3 centre_bounce = weight > 0.0 ? bounce / weight : vec3(0.0);
    const vec3 centre_lamp = lamp_weight > 0.0 ? lamp / lamp_weight : vec3(0.0);
    // How far this face trusts its own answer, and it is the same count the composite believes the
    // bounce in proportion to (`kBounceBelieve` = 32). A face at nought samples takes its neighbours
    // whole; a face past thirty-two weighs them against itself. Nothing new is stored to know it.
    const float known = clamp(float(far_n) / 32.0, 0.0, 1.0);

    // The two axes the normal is not along, from the one function that answers that question. Three
    // copies of "which axis is u" is three chances for one of them to be the other.
    if (probe_denoise()) {
        const ivec2 axes = face_axes(dir);
        ivec3 du = ivec3(0);
        ivec3 dv = ivec3(0);
        du[axes.x] = 1;
        dv[axes.y] = 1;
        face_denoise_tap(node - du, level, dir, kDenoiseEdge, weight, spatial_used, sky, bounce,
                         counted, lamp_weight, lamp, centre_bounce, centre_lamp, known);
        face_denoise_tap(node + du, level, dir, kDenoiseEdge, weight, spatial_used, sky, bounce,
                         counted, lamp_weight, lamp, centre_bounce, centre_lamp, known);
        face_denoise_tap(node - dv, level, dir, kDenoiseEdge, weight, spatial_used, sky, bounce,
                         counted, lamp_weight, lamp, centre_bounce, centre_lamp, known);
        face_denoise_tap(node + dv, level, dir, kDenoiseEdge, weight, spatial_used, sky, bounce,
                         counted, lamp_weight, lamp, centre_bounce, centre_lamp, known);
        face_denoise_tap(node - du - dv, level, dir, kDenoiseCorner, weight, spatial_used, sky,
                         bounce, counted, lamp_weight, lamp, centre_bounce, centre_lamp, known);
        face_denoise_tap(node - du + dv, level, dir, kDenoiseCorner, weight, spatial_used, sky,
                         bounce, counted, lamp_weight, lamp, centre_bounce, centre_lamp, known);
        face_denoise_tap(node + du - dv, level, dir, kDenoiseCorner, weight, spatial_used, sky,
                         bounce, counted, lamp_weight, lamp, centre_bounce, centre_lamp, known);
        face_denoise_tap(node + du + dv, level, dir, kDenoiseCorner, weight, spatial_used, sky,
                         bounce, counted, lamp_weight, lamp, centre_bounce, centre_lamp, known);
    }
    if (weight <= 0.0 || spatial_used <= 0.0) {
        face_light.words[light_at + kFaceFilteredSky] = 0u;
        return;
    }

    // The lamps, written as a mean with their most extreme tap trimmed. Nought weight is a scene
    // with no emitters reaching this neighbourhood at all, and nought is the right answer there
    // rather than a fallback -- the raw record says the same thing.
    const vec3 lamp_f = lamp_weight > 0.0 ? lamp / lamp_weight : vec3(0.0);
    face_light.words[light_at + kFaceFilteredLamp] = floatBitsToUint(lamp_f.r);
    face_light.words[light_at + kFaceFilteredLamp + 1u] = floatBitsToUint(lamp_f.g);
    face_light.words[light_at + kFaceFilteredLamp + 2u] = floatBitsToUint(lamp_f.b);

    const float inv = 1.0 / weight;
    // `open_sky` is a fraction in [0, 1] and is combined plainly: it has no tail to trim, because
    // there is no value a tap could hold that is four times what its neighbours hold and still
    // inside the range.
    const float sky_f = clamp(sky * inv, 0.0, 1.0);
    const vec3 bounce_f = bounce * inv;
    // How well measured the answer is: the weighted mean of the taps' own counts. Clamped into
    // sixteen bits, which is the same width `far_n` itself is stored in.
    const uint count = min(uint(counted / spatial_used + 0.5), 0xFFFFu);
    // Nought is the sentinel for "not filtered yet", so a real answer must never write it. A face
    // with a measurement has at least one sample by construction of the branch above.
    face_light.words[light_at + kFaceFilteredSky] =
        max(count, 1u) | (uint(sky_f * 65535.0 + 0.5) << 16);
    face_light.words[light_at + kFaceFilteredBounce] = floatBitsToUint(bounce_f.r);
    face_light.words[light_at + kFaceFilteredBounce + 1u] = floatBitsToUint(bounce_f.g);
    face_light.words[light_at + kFaceFilteredBounce + 2u] = floatBitsToUint(bounce_f.b);
}

// ---- R9f's fold: a coarse face is what the four faces under it measured ------------------------
//
// A coarse face has always measured itself, with its own rays, at its own scale. That is an answer
// and R9d measured it as about a tenth too bright; what it cannot be is as good as its children's,
// because a ray leaving a face four voxels across marches with a footprint four voxels wide and
// never sees the window reveal, the cornice or the step that its children can see.
//
// # It is a PULL, and that is the whole of why this sub-step waited
//
// §8 R9f: D191's *one invocation owns each face* is the property that removed the halving
// compare-and-swap, the read-twice-take-the-minimum and the eight-probe eviction from this pass,
// and 512 children pushing into one parent is exactly the arrangement it removed. So the parent
// reads its children instead: four lookups, on the frame it was going to be visited anyway, one
// writer, no atomics, and no ordering between invocations to depend on.
//
// FOUR, not 512. A face of a node at level L is covered by exactly four faces of its children at
// level L-1 pointing the same way -- the 2x2 across the two axes the normal is not along, with the
// third index pinned to the side the face is on. The whole pyramid is therefore folded one level
// per visit, and a level-3 stand-in over a level-0 face is right three visits after its children
// are, which on a settled camera is three frames.
//
// # What it does NOT do
//
// It does not fold the LAMPS. A lamp term is an irradiance at a point, `pick_light` chose one
// fitting for the child from the child's own position, and averaging four of those is not what a
// coarse face receives -- it is four samples of a different integral. The coarse face keeps its own
// lamp measurement, which is taken at its own centre and is the right one.
//
// And it does not fold a child that has not settled. A child with four samples is noise, and noise
// averaged four ways is noise one level coarser and structured at the parent's scale -- which is
// D387's measurement and the reason `face_light_seed` refuses a thin ancestor too.
// **Once per face, and the first version of this folded on every visit.** That rewrites the sun
// counters, a low sample count reads as "not settled", and `face_work_of` never holds an unsettled
// face back -- so every coarse face in the store re-entered the queue every frame for ever and the
// faces pass went **4.29 to 7.79 ms** on a 4.40 budget while the picture got better. A change that
// improves the answer and doubles the pass is not a win, and the tell was that the cost appeared in
// the pass table rather than in a convergence figure, which is the reverse of trap 20's usual shape.
// **Three attempts to make this cheaper, all measured, none of them worked, and they are here so
// nobody repeats them.** The cost is about +2.8 ms at the close camera standing still and it did
// not move for: not writing the sun counters (which fixed a different fault and is kept); not
// stamping a folded stand-in into the off-screen class, which cannot need rays once its answer
// comes from its children; and folding one visit in eight, phased on the slot, which cost MORE
// (7.5 against 6.4) and won less (36.3% against 41.8%). The third is the useful one: a rate that
// low stops tracking children which are still converging, and whatever the cost is, it is not
// proportional to how often this runs.
bool face_fold(uint slot, uint light_at, ivec3 node, uint level, uint dir) {
    if (level == 0u || !probe_fold()) return false;


    const ivec2 axes = face_axes(dir);
    const int normal_axis = int(dir >> 1u);
    // The child on the same side of the parent as the face: +x is the far child, -x the near one.
    const int fixed_at = ((dir & 1u) == 0u) ? 1 : 0;

    uint taken = 0u;
    float near_sum = 0.0, far_sum = 0.0;
    vec3 bounce_sum = vec3(0.0);
    uint near_seen = 0u, far_seen = 0u;

    for (int a = 0; a < 2; ++a) {
        for (int b = 0; b < 2; ++b) {
            ivec3 child = node * 2;
            child[normal_axis] += fixed_at;
            child[axes.x] += a;
            child[axes.y] += b;
            const uint at = node_face_lookup(child, level - 1u, dir);
            if (at == kNoFace || at == kFaceTombstone || at >= faces.items.length()) continue;
            const uint words = at * kFaceLightWords;
            if (words + kFaceLightWords - 1u >= face_light.words.length()) continue;

            if (face_samples_of(faces.items[at].counters) < kFaceSettled) continue;
            ++taken;

            const uint counts = face_light.words[words];
            const uint child_near = counts & 0xFFFFu;
            const uint child_far = (counts >> 16) & 0xFFFFu;
            if (child_near >= kFaceSettled) {
                near_sum += float(face_light.words[words + 1u]) / (float(child_near) * 255.0);
                ++near_seen;
            }
            if (child_far > 0u) {
                far_sum += float(face_light.words[words + 4u]) / float(child_far);
                bounce_sum += vec3(uintBitsToFloat(face_light.words[words + 9u]),
                                   uintBitsToFloat(face_light.words[words + 10u]),
                                   uintBitsToFloat(face_light.words[words + 11u]));
                ++far_seen;
            }
        }
    }
    // Nothing under it that has finished. Its own rays are the answer, exactly as before, and this
    // is the ordinary case for a face at the edge of what the camera has ever seen.
    if (taken == 0u) return false;

    // **The sun counters are NOT folded, and that is the whole of what this change cost twice.**
    //
    // Writing them is what a first version did, and it rewrites the face's SAMPLE COUNT -- which is
    // what `face_work_of` reads to decide whether a face has settled, and an unsettled face is never
    // held back. So every coarse face in the store re-entered the queue every frame for ever and the
    // faces pass went 4.29 to 7.79 ms on a 4.40 budget. Gating the fold to happen once fixed the
    // cost and threw away the win with it (the bounce went back from 42.1% to 31.1% of rays landing
    // lit), because what makes the fold worth anything is that it keeps up as the children converge.
    //
    // Folding only the LIGHT words is both: they are read by the composite and by a gathering ray
    // and by nothing that schedules work, so the parent goes on measuring its own sun at its own
    // scale -- which is the right answer for a shadow anyway -- and its sky and bounce come from
    // the four faces under it, refreshed every visit.
    //
    // The count the folded terms are written at: well past `kFaceSettled`, so the composite and a
    // gathering ray believe them outright, and well short of `kSkyConverged`, so this face's own
    // ambient rays go on refining afterwards and the fold is a prior rather than a full stop.
    const uint keep = kFaceSettled * 8u;
    uint counts = face_light.words[light_at];
    if (near_seen > 0u) {
        const float mean = near_sum / float(near_seen);
        face_light.words[light_at + 1u] = uint(mean * float(keep) * 255.0 + 0.5);
        // The gradients are the children's own fits over their own extents and do not rescale to
        // the parent's by averaging. Dropped rather than guessed at: a flat parent is the honest
        // answer and `face_light_seed` already carries the argument for why a borrowed tilt is
        // worse than none.
        face_light.words[light_at + 2u] = 0u;
        face_light.words[light_at + 3u] = 0u;
        counts = (counts & 0xFFFF0000u) | (keep & 0xFFFFu);
    }
    if (far_seen > 0u) {
        const float open = far_sum / float(far_seen);
        face_light.words[light_at + 4u] = uint(open * float(keep) + 0.5);
        const vec3 bounce = bounce_sum / float(far_seen);
        face_light.words[light_at + 9u] = floatBitsToUint(bounce.r);
        face_light.words[light_at + 10u] = floatBitsToUint(bounce.g);
        face_light.words[light_at + 11u] = floatBitsToUint(bounce.b);
        counts = (counts & 0xFFFFu) | ((keep & 0xFFFFu) << 16);
    }
    face_light.words[light_at] = counts;
    return true;
}

void face_light_seed(uint light_at, ivec3 node, uint level, uint dir) {
    // The NEAREST ancestor that has something to say, not the one three levels up.
    //
    // Three levels was the right distance for a stand-in, which is a face claimed for a region the
    // store has never seen: five hundred and twelve fine faces share one, so the request lattice
    // cannot miss it (D308-D311). It is the wrong distance for INHERITANCE, where the case that
    // matters is a face that has just been subdivided out of the one immediately above it -- and
    // that one covers the same place, has already converged, and is worth sixteen times what the
    // one three levels up is worth.
    const bool prolong = node_push.prolong != 0u;
    int step = prolong ? 1 : kFaceAncestorStep;
    uint anc = kNoFace;
    uint anc_at = 0u;
    uint anc_near = 0u;
    for (; step <= kFaceAncestorStep; ++step) {
        const uint at_level = level + uint(step);
        const uint found = node_face_lookup(node >> step, at_level, dir);
        if (found == kNoFace) continue;
        const uint words_at = found * kFaceLightWords;
        if (words_at + kFaceLightWords - 1u >= face_light.words.length()) continue;
        // Seeding from four rays of noise is not a prior; it is the noise arriving one level
        // coarser.
        const uint near_n = face_light.words[words_at] & 0xFFFFu;
        if (near_n < kSkySeedMin) continue;
        anc = found;
        anc_at = words_at;
        anc_near = near_n;
        break;
    }
    if (anc == kNoFace) return;

    // How much of the ancestor's answer is worth taking, and where in it this face sits.
    //
    // A quarter per level of separation: one level up is nearly the whole thing, three levels up is
    // the old stand-in. See kSkyProlong.
    const uint shift = uint(2 * (step - 1));
    const uint near_seed =
        prolong ? min(anc_near, max(kSkyProlong >> shift, kSkySeedSamples)) : kSkySeedSamples;

    // Where this face's centre falls in the ancestor's own sampled coordinates.
    //
    // The ancestor spreads its samples over the MIDDLE HALF of itself (see face_point), so its
    // `at` runs over [-1, 1] across half its extent -- one unit is a quarter of the ancestor. A
    // child of a parent one level up therefore sits at exactly +-1, which is the edge of the fit's
    // own domain; further-removed children sit outside it and are clamped, because extrapolating a
    // linear fit past the data it was fitted to is how a corner invents a tilt.
    const ivec2 axes = face_axes(dir);
    const int within_mask = (1 << step) - 1;
    const ivec3 within = node & ivec3(within_mask);
    const float span = exp2(float(2 - step));
    const float u_c = clamp((float(within[axes.x]) + 0.5) * span - 2.0, -1.0, 1.0);
    const float w_c = clamp((float(within[axes.y]) + 0.5) * span - 2.0, -1.0, 1.0);

    const float inv = 1.0 / (float(anc_near) * 255.0);
    const float mean_p = float(face_light.words[anc_at + 1u]) * inv;
    const float cu_p = float(int(face_light.words[anc_at + 2u])) * inv;
    const float cw_p = float(int(face_light.words[anc_at + 3u])) * inv;

    // Believed only as far as it clears its own error, which is the same shrinkage resolve.comp
    // applies when it READS a gradient (D386, D387). Without it a parent's noise arrives in every
    // one of its children as a tilt they all agree about, which is worse than noise because it is
    // structured -- and structured at the scale of the parent, which is exactly the blockiness this
    // whole term exists to remove.
    const float noise_power = 1.0 / (3.0 * float(anc_near));
    const float keep_u = (cu_p * cu_p) / (cu_p * cu_p + noise_power);
    const float keep_w = (cw_p * cw_p) / (cw_p * cw_p + noise_power);
    const float mean_c =
        prolong ? clamp(mean_p + 3.0 * (cu_p * keep_u * u_c + cw_p * keep_w * w_c), 0.0, 1.0)
                : mean_p;

    // And the gradient RESCALED, not copied. A coefficient against a coordinate is meaningless
    // without the coordinate's range: this face's `at` unit is a quarter of ITS extent, which is
    // half the ancestor's unit per level of separation.
    const float extent_scale = prolong ? exp2(-float(step)) : 0.0;
    const float cu_c = cu_p * keep_u * extent_scale;
    const float cw_c = cw_p * keep_w * extent_scale;

    const float seed_f = float(near_seed);
    face_light.words[light_at + 1u] = uint(mean_c * 255.0 * seed_f + 0.5);
    face_light.words[light_at + 2u] = uint(int(round(cu_c * 255.0 * seed_f)));
    face_light.words[light_at + 3u] = uint(int(round(cw_c * 255.0 * seed_f)));

    // The FAR field, which needs no prolongation because it has no gradient: it is one number for
    // the whole face, and how much sky a place can see does not change when you halve the patch you
    // are asking about. Seeded at kSkyFarMin so its own variance test decides on the next visit
    // whether it is finished -- which for a sealed room or an open roof it is, after one ray.
    const uint anc_far = (face_light.words[anc_at] >> 16) & 0xFFFFu;
    const bool far_worth = anc_far >= kSkySeedMin;
    const uint far_seed =
        far_worth ? (prolong ? min(anc_far, kSkyFarMin) : kSkySeedSamples) : 0u;
    face_light.words[light_at] = (near_seed & 0xFFFFu) | ((far_seed & 0xFFFFu) << 16);
    face_light.words[light_at + 4u] =
        far_worth ? (face_light.words[anc_at + 4u] * far_seed + anc_far / 2u) / anc_far : 0u;

    // And the BOUNCE, on the same count and by the same argument the lamps are seeded on: a face
    // with no bounce samples reads BLACK, and indoors — where the bounce is most of the light there
    // is — a newly revealed surface starting at black is the same flash R9d removed for the sun,
    // arriving through the fourth door. The mean transfers across the change of scale for the reason
    // it does for the lamps: light arriving from across a room is very nearly the same over a face
    // and over the ones that share its ancestor.
    // Copied rather than rescaled, because it is a MEAN: the ancestor's answer is what this face
    // should start from, and the count beside it is how far to believe it. The lamps a few lines
    // below are still a sum and are still scaled, which is why the two look different here. See
    // kBounceMemory.
    if (far_worth) {
        for (uint w = 9u; w < 12u; ++w) {
            face_light.words[light_at + w] = face_light.words[anc_at + w];
        }
    }

    // And the lamps, which need it more than the ambient term does.
    //
    // A face with no ambient samples reads as fully unoccluded, which is too BRIGHT; a face with no
    // lamp samples reads as unlit, which in a room lit by nothing but lamps is black. Newly
    // revealed geometry going black for the handful of frames it takes to converge is the same
    // flash R9d removed for the sun, arriving through the third door.
    //
    // The mean transfers across the change of scale where the gradient could not: irradiance from a
    // fitting eight metres away is very nearly the same over a face and over the ones that share
    // this ancestor, which is exactly the claim the stand-in already makes for the sun's visibility.
    // Stamped with the CURRENT version, because what is being inherited is a measurement of the
    // list as it stands now.
    const uint anc_lamp = face_light.words[anc_at + 8u];
    const uint anc_lamp_n = anc_lamp & 0xFFFFu;
    if (anc_lamp_n >= kLampSeedMin &&
        ((anc_lamp >> 16) & 0xFFFFu) == (node_push.light_version & 0xFFFFu)) {
        const uint lamp_seed =
            prolong ? min(anc_lamp_n, max(kLampProlong >> shift, kLampSeedSamples))
                    : kLampSeedSamples;
        const float scale = float(lamp_seed) / float(anc_lamp_n);
        face_light.words[light_at + 5u] =
            floatBitsToUint(uintBitsToFloat(face_light.words[anc_at + 5u]) * scale);
        face_light.words[light_at + 6u] =
            floatBitsToUint(uintBitsToFloat(face_light.words[anc_at + 6u]) * scale);
        face_light.words[light_at + 7u] =
            floatBitsToUint(uintBitsToFloat(face_light.words[anc_at + 7u]) * scale);
        face_light.words[light_at + 8u] =
            lamp_seed | ((node_push.light_version & 0xFFFFu) << 16);
    }
}

// Everything an ambient ray needs that is a property of the FACE rather than of the ray, worked out
// once. It exists so that the two places a ray is cast from -- the bounded burst and the single
// unbounded far ray -- can share one body without sharing one loop, which measured 0.4 ms.
//
// Held in named globals rather than handed to `sky_cast` as a struct by value, which would be
// twenty-six floats the compiler has to keep somewhere across a full march -- the shape of trap
// that node.glsl's descent stack documents from the other side. It was measured rather than
// assumed, and the honest result is that it changed nothing here (2.164 ms against 2.118, inside
// the run-to-run spread): this compiler was already scalarising it. Kept because the register form
// cannot regress and the struct form can.
vec3 g_sky_corner;
vec3 g_sky_across;
vec3 g_sky_down;
vec3 g_sky_side;
vec3 g_sky_other;
vec3 g_sky_chunk_origin;
ivec3 g_sky_normal;
float g_sky_size;
float g_sky_pixel_angle;
vec4 g_sky_rotation;
// R9a: this ray is allowed to name the face it lands on, so the store learns about a surface no
// pixel is looking at. Set for the one unbounded ray and only on the frames this face is due, which
// is what keeps it off the feedback buffer's neck -- see node_face_request.
bool g_sky_report_face;
// R9: this ray is the unbounded one, so what it found is worth reading. Off for the bounded burst,
// whose miss means "I stopped looking" rather than "there is nothing there".
bool g_sky_gather;

// What the surface a gathering ray landed on is giving off. R9's whole point, in three functions
// because R9f gave it a second place to look.
//
// The ray has already stopped on a face, and that face is keyed exactly as the store keys it — the
// marcher produced both keys with the same arithmetic in the same place, so the lookup cannot be
// about a different face than the one that was hit. What comes back is the light that face has
// measured for itself: its sun visibility, its sky visibility, its near field and its lamps. That is
// the whole of the mechanism, and it is why this is affordable: the answer was computed once, on the
// surface, by the pass this ray is running in, and reading it costs one hash probe.
//
// `bounce_face_ready` is whether a record has an answer, `bounce_face_light` is that answer read for
// a given hit, and `bounce_radiance` below is the search: the surface's own face, then the coarse
// faces standing over it, then nought.
//
// Whether a slot has an answer worth reading, which is two questions and both are rules.
//
// It has to BE a face -- the store may not have claimed one here, or the off-screen cap may have
// declined it -- and it has to have measured something. A face with no samples reads as fully
// sunlit in the composite's fallback, and carrying that into a bounce would light a room out of a
// placeholder.
bool bounce_face_ready(uint slot) {
    if (slot == kNoFace || slot == kFaceTombstone) return false;
    if (slot >= faces.items.length()) return false;
    if (face_samples_of(faces.items[slot].counters) < kFaceSettled) return false;
    const uint at = slot * kFaceLightWords;
    return at + kFaceLightWords - 1u < face_light.words.length();
}

// What one face is giving off, read for a ray that landed on `hit`.
//
// The SLOT and the HIT are separate arguments on purpose, and that separation is R9f. The terms --
// sun visibility, sky, near field, lamps, bounce -- come from whichever record has them, which may
// be the coarse face standing over this surface rather than the surface's own. The albedo and the
// normal come from the hit, which is the surface actually struck. So a stand-in lends its
// measurement of the LIGHT and never its idea of what is there, which is the same division R9d
// already draws for the composite: the coarse face is a measurement of a place, not of a material.
vec3 bounce_face_light(uint slot, NodeHit hit, uint material) {
    const uint counters = faces.items[slot].counters;
    const uint samples = face_samples_of(counters);
    const uint at = slot * kFaceLightWords;

    // The albedo, from the folded colour the marcher carries. Not the interned table's exact voxel
    // colour, which this pass has no binding for -- see the level-0 branch of node_march, where the
    // brick's average is written beside the type id for exactly this reader. Twenty-five centimetres
    // of average is the right resolution for light arriving FROM a surface.
    const vec3 albedo = vec3(float(hit.colour & 0xFFu),
                             float((hit.colour >> 8) & 0xFFu),
                             float((hit.colour >> 16) & 0xFFu)) / 255.0;

    // Its sun, which is a fraction of the disc it can see, times the cosine at ITS normal.
    const vec3 normal = vec3(face_normal(hit.face_dir));
    const float visible = float(face_lit_of(counters)) / float(samples);
    const float lambert = max(dot(normal, node_push.sun.xyz), 0.0) * visible;

    // Its sky and its near field, gated on having been measured, exactly as the composite gates
    // them. An unmeasured far field reads as fully open, which indoors is the worst answer there is
    // -- and here it would arrive as a wall in a sealed room bouncing daylight.
    const uint counts = face_light.words[at];
    const uint near_n = counts & 0xFFFFu;
    const uint far_n = (counts >> 16) & 0xFFFFu;
    float open_sky = 0.0;
    float unoccluded = 1.0;
    if (far_n > 0u) open_sky = float(face_light.words[at + 4u]) / float(far_n);
    if (near_n >= kFaceSettled) {
        const float mean = float(face_light.words[at + 1u]) / (float(near_n) * 255.0);
        unoccluded = 1.0 - clamp(mean, 0.0, 1.0);
    }

    // Its lamps, as irradiance, which is the space the sun and the sky are already in.
    vec3 lamp = vec3(0.0);
    const uint lamp_n = face_light.words[at + 8u] & 0xFFFFu;
    if (lamp_n > 0u) {
        lamp = vec3(uintBitsToFloat(face_light.words[at + 5u]),
                    uintBitsToFloat(face_light.words[at + 6u]),
                    uintBitsToFloat(face_light.words[at + 7u])) / float(lamp_n);
    }

    // And its own bounce, which makes this multi-bounce for nothing.
    //
    // A face's stored bounce is what IT gathered, so reading it here is the second bounce, and the
    // face it read from carried the third, and so on: the series is a progressive radiosity solve
    // spread over frames, and it converges for the same reason radiosity does -- every step is
    // multiplied by an albedo under one. What it costs is nothing at all, because the number is in
    // the record already being read.
    // Read as it is stored: a running MEAN with a memory, not a sum over `far_n`. See kBounceMemory.
    vec3 bounce = vec3(0.0);
    if (far_n > 0u) {
        bounce = vec3(uintBitsToFloat(face_light.words[at + 9u]),
                      uintBitsToFloat(face_light.words[at + 10u]),
                      uintBitsToFloat(face_light.words[at + 11u]));
    }

    const vec3 direct = face_direct_irradiance(sun_radiance(), lambert, sky_radiance(normal),
                                               face_sky_visibility(open_sky, unoccluded), lamp);
    // ...and how much of that albedo is DIFFUSE, which is the half of R4c's energy split that both
    // readers have to agree about (R4c, and see face_diffuse_share).
    //
    // A metal reflects almost nothing diffusely, so a bronze door gives the room a quarter of what
    // it used to. What this ray does NOT pick up is the other half — what the door reflects in the
    // gathering ray's own direction — because that is a second lookup into a block this face may
    // not hold, on the hottest path in the pass. **So a mirror still does not light the room.** It
    // errs dark, which is the direction this renderer is required to err in, and it is what R4c's
    // remaining half owes: the composite has the lobe and the bounce does not.
    const vec3 diffuse = (material & kFaceMaterialKnown) != 0u
                             ? albedo * face_diffuse_share(face_material_metal(material))
                             : albedo;
    return face_outgoing_radiance(diffuse, direct, bounce, kPi);
}

vec3 bounce_radiance(NodeHit hit) {
    const uint slot = node_face_lookup(hit.face_node, hit.face_level, hit.face_dir);
    // This ray is INTEGRATING that face, so the face is worth measuring. R9b, and it is stamped
    // before the readiness test rather than after it, because the case this exists for is exactly the
    // one that fails it: a face the store holds and nothing has ever lit. That was 229,413 records
    // and 12.4% of every gathering ray in the frame. See `node_face_gathered` in node.glsl.
    node_face_gathered(slot);
    // What the surface is made of, read from the surface's OWN slot and not from whatever record
    // ends up answering for the light. That is R9f's division said once more: a stand-in lends its
    // measurement of a place and never its idea of what is there, and a coarse face has no material
    // at all -- so a fine face standing under one keeps its own metalness while borrowing its
    // ancestor's light. R4c.
    const bool has_slot =
        slot != kNoFace && slot != kFaceTombstone && slot < face_material.words.length();
    const uint material = has_slot ? face_material.words[slot] : 0u;
    if (bounce_face_ready(slot)) {
        probe_add(3u);
        return bounce_face_light(slot, hit, material);
    }

    // The surface's own face has nothing to say. R9f: read the coarse one standing over it.
    //
    // # Why this is not the same as giving up
    //
    // Before this, a gathering ray that landed on a face the store had not claimed, or had given up,
    // returned NOUGHT -- and nought is black. That errs dark, which is the direction this renderer
    // is required to err in, and it is why the rule was left alone through R9a. What R9f changes is
    // that there is usually an answer available: the coarse face over this surface is claimed by the
    // same report that claims the fine one, is settled long before its children are found because
    // five hundred and twelve share it, and is now KEPT after they are given up. A room the camera
    // has walked away from has no fine faces left in the store and has its whole coarse pyramid.
    //
    // # Why the coarseness is bounded by the ray and not by a constant
    //
    // The walk starts at the level the MARCHER stopped at, which the ray's own footprint chose, so
    // "three levels up" is three levels up from whatever detail this ray was entitled to. A surface
    // an arm's length away is read at 25 cm and one across the valley at whatever its footprint was
    // already at -- which is §8 R9's second risk answered by construction rather than by a rule:
    // "the fold must never be read at a level coarser than the distance justifies".
    //
    // # What it costs when there is nothing
    //
    // Three hash probes on a ray that found nothing, which is the case that was already free. The
    // probes stop at the first ancestor with an answer, and indoors that is nearly always the first.
    const uint missing = (slot == kNoFace || slot == kFaceTombstone ||
                          slot >= faces.items.length()) ? 4u : 5u;
    for (int step = 1; step <= kFaceAncestorStep; ++step) {
        const uint at_level = hit.face_level + uint(step);
        const uint anc = node_face_lookup(hit.face_node >> step, at_level, hit.face_dir);
        // The stand-in is being read too, and by the same rule it is worth its own rays. R9f keeps
        // these records alive past their cold window and says in as many words that a coarse face
        // "measures itself with its own rays at its own scale" -- and until now none of them ever
        // did: `the coarse pyramid on the card` reported 21,790 stand-ins with nought of them read by
        // a pixel and nought with a finished ambient term. They are the records everything else is
        // rebuilt from when a camera comes back to a room, so they are the last ones that should be
        // empty.
        // A stand-in is worth its own rays only while it has to measure itself. Once R9f's fold is
        // in it does not: its sky and its bounce are the average of the four faces under it,
        // refreshed every visit, and stamping it here would put twenty-two thousand records into
        // the off-screen class's shading budget to re-derive by ray what they are already being
        // handed. Measured: that is the whole of the fold's cost -- the faces pass reads **6.46 ms
        // against 3.66** with the stamp and lands back inside its budget without it, for the same
        // 41.7% of gathering rays finding a lit face.
        if (!probe_fold()) node_face_gathered(anc);
        if (!bounce_face_ready(anc)) continue;
        probe_add(missing);
        probe_add(6u);
        return probe_coarse_bounce() ? bounce_face_light(anc, hit, material) : vec3(0.0);
    }
    probe_add(missing);
    return vec3(0.0);
}

// What one ambient ray found.
struct SkySample {
    vec2 at;         // where on the face it left from, over the sampled span in [-1, 1]
    vec3 dir;        // which way it went, in world space. Only R4c's bins need it, and they need
                     // it because a lobe is a distribution over exactly this.
    float contact;   // the near field: one at the surface, nought at kContactMetres and beyond
    bool sky;        // it reached open sky. Only ever asked of an unbounded ray -- a bounded one
                     // that runs out of length returns this too and it means "I stopped looking"
    bool unknown;    // stopped by a cell the world says is occupied and the pool has not built
    // What the ray FOUND, in radiance: the sky where it escaped and the surface's own outgoing
    // light where it landed. Filled only for the unbounded ray -- a bounded one that stops at a
    // metre has not answered this question, and treating "I stopped looking" as "there is nothing
    // there" is trap 7 written into the ambient integral. R9.
    vec3 radiance;
};

// One ambient ray, cosine-weighted about the normal -- the weighting the integral carries, so every
// ray counts the same and the average IS the answer. Malley's method: a disc sampled uniformly and
// lifted onto the hemisphere.
//
// `max_t` is the whole difference between the two callers. `occlude_unknown` is on for the same
// reason the sun ray has it on: a cell the world says is occupied and the pool has not built is
// matter, and letting an ambient ray through it would make a sealed room read as open sky exactly
// as it did for shadows (D302, D324).
SkySample sky_cast(uint index, float max_t) {
    // One four-dimensional stratified point: where on the face the ray leaves from, and which way.
    // See node_r4 for why that is one sequence in four dimensions rather than two in two.
    const vec4 r = node_r4(index, g_sky_rotation);

    SkySample s;
    s.at = r.xy * 2.0 - 1.0;
    const float radius = sqrt(r.z);
    const float around = r.w * 6.28318530718;
    // The ray's component along the normal, which Malley's method already has in hand.
    const float rise_cos = sqrt(max(1.0 - r.z, 0.0));
    const vec3 dir = normalize(g_sky_side * (radius * cos(around)) +
                               g_sky_other * (radius * sin(around)) +
                               vec3(g_sky_normal) * rise_cos);
    s.dir = dir;
    const vec3 origin = face_point(g_sky_corner, g_sky_across, g_sky_down, g_sky_normal,
                                   g_sky_size, s.at) - g_sky_chunk_origin;

    const NodeHit hit =
        node_march(origin, dir, g_sky_pixel_angle, 0.0, false, false, false, false, true, max_t);

    s.unknown = hit.hit && hit.unknown;
    s.sky = !hit.hit;

    // What this direction is worth, which only the UNBOUNDED ray may ask.
    //
    // `g_sky_gather` is on for that ray alone. A near ray is bounded at a metre and its miss means
    // "I stopped looking", so asking it what it found would report open sky through a wall — the
    // same conflation the two sample counts exist to keep apart, arriving in the radiance instead of
    // in the count. A ray stopped by a cell the pool has not built is left at nought and holds the
    // face short of convergence through `measured_ignorance`, because ignorance is a fact about the
    // tree and not about the light.
    s.radiance = vec3(0.0);
    if (g_sky_gather) {
        probe_add(1u);
        if (s.unknown) {
            // Stopped by a cell the world claims and the pool has not built. It gets nothing, and
            // whether it SHOULD is the rest of R9f and is deliberately not decided here -- what is
            // added is the count and the level it happened at, which is what that decision wants
            // and what R10's open item has never had.
            //
            // Not "could a coarse face have answered", which is the number that would price the
            // change, and the reason is a fact about the marcher worth more than the number:
            // **an ignorance stop carries no face key at all**. `node_face_hit` is called at the
            // leaf hit and nowhere else, so `face_level` is kNoFaceLevel here and there is nothing
            // to walk up from. Any rule that reads light where the pool has not built has to change
            // the marcher first, and that is a bigger change than this one.
            probe_add(7u);
            probe_add(kLightProbeLevels + uint(clamp(hit.level, 0, 14)));
        } else if (!hit.hit) {
            probe_add(2u);
            s.radiance = sky_radiance(dir);
        } else {
            s.radiance = bounce_radiance(hit);
        }
    }

    // The face this ray landed on, named to the host so the store holds it. R9a.
    //
    // Three conditions, and each of them is the rule rather than a guard. It must have LANDED on
    // something: a ray that reached the sky or ran out of length has nothing to name, and naming
    // everything it crossed is what D292 exists to forbid. It must have landed on matter and not on
    // IGNORANCE: an unbuilt cell has no surface, and a face claimed there stands for a shape nobody
    // has built -- "nothing here" and "I could not see it" must not become one answer (trap 7). And
    // the caller decides whether this ray is one of the ones asking, because the throttle is per
    // gathering face and there is no slot here to stamp.
    if (g_sky_report_face && hit.hit && !hit.unknown && hit.face_level != kNoFaceLevel) {
        node_face_request(hit.face_node, hit.face_level, hit.face_dir);
    }

    // The near field. What carries the shape of a room is HOW FAR the ray got, not whether it
    // escaped: a ray that dies 5 cm away in the corner of an alcove and one that crosses the room
    // before hitting the far wall are both "not sky" and are not remotely the same occlusion. In
    // metres, so a coarse face at 200 m and a voxel face at arm's length darken over the same
    // physical span and a dolly-in shows no transition.
    //
    // ...but a hit that has not risen clear of this face's OWN plane is this face's own wall, and
    // counting it is the classic self-occlusion bug arriving through the near field. A
    // cosine-weighted ray leaving a flat wall cannot geometrically hit that wall -- the hemisphere
    // is on the outside of it. What it can do is graze: at a shallow angle it travels many voxels
    // sideways while rising almost nothing, and the DDA lets it clip the shared edge of two cells in
    // the surface layer, the same leak face_point describes from the other side. That returns a hit
    // a few centimetres away, `contact` reads nearly one, and the face goes dark. Which faces got
    // unlucky depended on their sample positions, so a FLAT WALL came out as a patchwork of blocks:
    // measured on the facade at 0.75 m, the near field ran 129 to 246 of 255 with a standard
    // deviation of 13 across a surface whose correct answer is one number.
    //
    // Three quarters of a voxel is well under anything that occludes a measurable part of the
    // hemisphere and well over the grazing clip, and a real occluder in a crease stands proud of the
    // plane by design -- a ray that reaches the far wall of an alcove has risen metres by then.
    const float rise = hit.t * rise_cos;
    const bool grazed_own_plane = hit.hit && rise < 0.75;
    const float reach_m = (hit.hit && !grazed_own_plane) ? hit.t / kVoxelsPerMetreF : 1e9;
    s.contact = clamp(1.0 - reach_m / kContactMetres, 0.0, 1.0);
    return s;
}

// One sample into the near field's running mean and its two first moments.
//
// `s.at` is uniform on [-1, 1] over the sampled span, so the Legendre basis is orthogonal under it
// and each coefficient is an independent running mean of the sample weighted by a polynomial. No
// normal equations, no least squares, no second pass, and no extra rays.
void sky_accumulate(SkySample s, inout uint near_n, inout uint near_sum, inout int grad_u,
                    inout int grad_w) {
    near_n += 1u;
    near_sum += uint(s.contact * 255.0 + 0.5);
    grad_u += int(round(s.contact * s.at.x * 255.0));
    grad_w += int(round(s.contact * s.at.y * 255.0));
}

// ---- R4c: one gathering sample, spread over the outgoing bins ----------------------------------
//
// **This casts no rays.** The face already sends one unbounded cosine-weighted ray a visit and
// already asks it what it found -- that is R9's `s.radiance`, and it is what the bounce is a mean
// of. All this does is stop throwing the DIRECTION away: the same sample, weighted into each of the
// sixteen outgoing bins by how much a lobe pointing that way would have taken from it.
//
// So R4c's cost is not rays and is not passes. It is sixteen multiply-adds on the faces that hold a
// block, on the frames they take their far ray, and it stops when the far field converges.
//
// # What a bin holds, and why it is a weighted mean rather than a sum
//
// The prefiltered environment: the average radiance arriving from the cone the lobe about this
// bin's direction gathers from. In symbols, bin j is
//
//     L_j = sum over samples of D(h_j) * L  /  sum over samples of D(h_j)
//
// where h_j is the half vector between the sample's direction and bin j's. The cosine and the
// sampling density cancel exactly, because the ray is drawn cosine-weighted and the lobe integral
// carries the same cosine -- which is why this is a plain ratio and not an estimator with a
// division by a pdf in it.
//
// A NORMALISED weighted mean rather than the unnormalised estimator is what keeps this free of the
// firefly problem the bounce beside it needed `kBounceBelieve` for. A ratio of two sums is bounded
// by the largest sample whatever the weights do; the estimator is not, and one ray landing on a
// sunlit sill would put twenty times the wall's radiance into a bin with nothing to divide it by.
//
// # The kernel is widened to the bin and that is the whole variance argument
//
// Weighting by the material's own alpha would give gilt, whose lobe is 3.6 degrees across, a kernel
// far narrower than the 20.4 degrees one bin covers -- so nearly every sample would land in the
// tail of every bin and a bin would be decided by the one or two rays that happened to fall near
// its centre. That is noise, and it would read as a reflection that fizzes.
//
// Widening the kernel to the bin spends the same rays on an answer that is smooth and exactly one
// bin blurry, which is the honest reading of what sixteen bins can say about a mirror. It is the
// same trade `face_lobe_bin_alpha` states from the other side, and it is why this term needs no
// clamp, no outlier test and no belief ramp.
// One sample into one bin, as a running mean weighted by how much that bin's kernel wanted it.
//
// The same forgetting the bounce does, and for the same reason: the room is still filling with
// light while the early samples are taken, so a mean over everything since the face was claimed is
// partly a measurement of a darker room. It also keeps the step above what an rgb9e5 mantissa can
// represent -- an update smaller than a five-hundredth of the value rounds back to where it was,
// which is D293's fault arriving in a different format.
void face_lobe_add(uint block, uint bin, uint bins, float w, vec3 radiance) {
    if (!(w > 0.0)) return;
    const uint at = face_lobe_bin_at(block, bin);
    const uint weight_at = face_lobe_weight_at(block, bin, bins);
    if (weight_at >= face_lobe.words.length()) return;
    const float had = min(uintBitsToFloat(face_lobe.words[weight_at]), float(kBounceMemory));
    const vec3 was = face_unpack_rgb9e5(face_lobe.words[at]);
    const float now = had + w;
    face_lobe.words[at] = face_pack_rgb9e5(was + (radiance - was) * (w / now));
    face_lobe.words[weight_at] = floatBitsToUint(now);
}

void face_lobe_accumulate(uint block, uint bins, uint side, vec3 dir, vec3 radiance) {
    // The face's own frame, which is the one `face_lobe_at` and the composite both work in.
    const vec3 normal = vec3(g_sky_normal);
    const float alpha = max(face_lobe_alpha_of(bins), kFaceAlphaMin);

    // **Normalised across the bins, so one sample is worth one sample.**
    //
    // The weights used to be the kernel itself, which is a density and integrates to one over
    // SOLID ANGLE rather than over sixteen numbers -- so what a cosine sample was worth to a bin
    // depended on how many bins there were, and it had to be commensurate with the lobe ray below,
    // which is worth exactly one. Two estimators of one quantity whose weights are in different
    // units is the shape of fault D420 is about, one array along: whichever is measured in the
    // larger unit quietly decides the answer.
    //
    // Two passes over sixty-four bins, RECOMPUTING the weight rather than keeping it. Sixty-four
    // floats held across the second loop is sixty-four registers on a pass whose occupancy is what
    // it is short of, and the arithmetic is a dot product and a divide -- see the note above
    // `g_sky_corner`, which is this trade measured from the other side.
    float total = 0.0;
    for (uint bin = 0u; bin < bins; ++bin) {
        const vec3 towards = face_lobe_direction(face_lobe_centre_of(bin, side), normal, g_sky_side,
                                                 g_sky_other);
        total += face_ggx_d(max(dot(normal, normalize(towards + dir)), 0.0), alpha);
    }
    if (!(total > 0.0)) return;
    const float inv = 1.0 / total;
    for (uint bin = 0u; bin < bins; ++bin) {
        const vec3 towards = face_lobe_direction(face_lobe_centre_of(bin, side), normal, g_sky_side,
                                                 g_sky_other);
        face_lobe_add(block, bin, bins,
                      face_ggx_d(max(dot(normal, normalize(towards + dir)), 0.0), alpha) * inv,
                      radiance);
    }
}

// ---- R4b: the ray a lobe casts for itself ------------------------------------------------------
//
// **This is the ray D592 said was missing, and it is what makes a reflection possible at all.**
//
// The far ray is cosine-weighted about the normal, because that is the distribution the ambient
// integral and the bounce both need. A reflection is read at a GRAZING angle -- the mirror
// direction of an eye looking along a wall or across water -- and the cosine density there is 0.17
// of its peak. So the bins a visible reflection comes out of were the emptiest ones a face had,
// and no amount of bin count or memory could fix that: it is where the rays go.
//
// This ray goes where the bin is. It picks one bin, aims into the cone that bin gathers from, and
// what it finds is that bin's answer. Round-robin by sample index, so the sixty-four are served
// evenly rather than by a random walk that leaves gaps for hundreds of frames.
//
// # What it costs, and why it stops
//
// It is an UNBOUNDED march, which is the expensive kind, and it is spent only on faces that hold a
// block -- 22,158 of the 416,143 a pixel is reading at the close camera, one in nineteen. A face
// takes `kLobeBurst` a visit until every bin has `kLobeSamples`, which is about fifty visits, and
// then casts nothing for the rest of its life. The burst is large for D394's reason: what this pass
// spends on an unconverged face is mostly the face and not the ray, and three ways of metering a
// burst were built and all three made the transient worse.
//
// # The estimator, which is the standard prefiltered environment and not something new
//
// A half vector is drawn from the bin's own kernel about the normal, the bin's direction is
// reflected about it to get an incoming direction, and the sample is weighted by the cosine at the
// surface. That is Karis's split-sum prefilter with the view direction taken as the BIN rather than
// as the normal -- and taking it as the bin instead of as the normal is the whole of what puts
// samples in the grazing bins.
void lobe_cast(uint block, uint bin, uint bins, uint side, uint index, float pixel_angle,
               vec3 corner, vec3 across, vec3 down, float size, vec3 chunk_origin) {
    const vec3 normal = vec3(g_sky_normal);
    const vec3 towards = face_lobe_direction(face_lobe_centre_of(bin, side), normal, g_sky_side,
                                             g_sky_other);
    const vec4 r = node_r4(index, g_sky_rotation);
    // In the face's own frame, because the visible-normal sample is defined there.
    const vec3 local = vec3(dot(towards, g_sky_side), dot(towards, g_sky_other),
                            max(dot(towards, normal), 1e-4));
    const vec3 half_local =
        face_lobe_visible_normal(local, max(face_lobe_alpha_of(bins), kFaceAlphaMin), r.zw);
    const vec3 half_vector =
        g_sky_side * half_local.x + g_sky_other * half_local.y + normal * half_local.z;
    const vec3 dir = normalize(2.0 * dot(towards, half_vector) * half_vector - towards);
    const float cosine = dot(dir, normal);
    // Under the surface. Rare now that the half vector is drawn from the visible distribution --
    // that is the whole point of it -- but it still happens at the very rim, and such a sample
    // carries no information about this bin. Dropped rather than counted as black, which is trap 7
    // in an estimator: "nothing came back" and "I did not look" are different answers.
    if (cosine <= 0.0) return;

    const vec2 at = r.xy * 2.0 - 1.0;
    const vec3 origin =
        face_point(corner, across, down, g_sky_normal, size, at) - chunk_origin;
    const NodeHit hit =
        node_march(origin, dir, pixel_angle, 0.0, false, false, false, false, true, kNodeUnbounded);

    probe_add(1u);
    probe_add(kProbeLobeRays);
    vec3 radiance = vec3(0.0);
    if (!hit.hit) {
        probe_add(2u);
        radiance = sky_radiance(dir);
    } else if (hit.unknown) {
        // Stopped by a cell the world claims and the pool has not built. It is a measurement of the
        // tree rather than of the light, and counting it as black would put a dark patch in a
        // reflection that stays there for ever -- so the sample is dropped and the bin comes back
        // for another. The same rule the ambient burst follows for the same reason.
        probe_add(7u);
        return;
    } else {
        radiance = bounce_radiance(hit);
    }
    face_lobe_add(block, bin, bins, cosine, radiance);
}

// ---- R5: a lobe blended with the lobes of the faces around it ----------------------------------
//
// **Reported by looking at `--debug-mode 23`: the metal is mottled face to face.** Thirty-six bins
// at twenty-four samples is a per-bin estimate of a RADIANCE, so each face's answer disagrees with
// its neighbour's by its own standard error — and on a flat bronze door that disagreement is the
// only thing there is to see. It is frozen rather than crawling, because the burst converges and
// stops, so it reads as grain rather than as noise; that makes it less urgent and no less wrong.
//
// This is the fourth term to want `face_denoise`'s idea and it needs no rays. A neighbour at the
// same level and the same direction, one step along one of the two axes the normal is NOT along, is
// **coplanar and contiguous by construction** — same plane, same orientation, adjacent — so there
// is no edge to stop at and no normal, depth or mesh test to pay for. A change of plane is a change
// of key and the lookup simply misses.
//
// # Why bin by bin rather than as one filter, and why it is free of the edge test the others need
//
// The three terms `face_denoise` blends are single numbers, and blending them across a real
// lighting discontinuity — the edge of a shadow, the last voxel a sconce reaches — is a bias, which
// is why it weighs a neighbour by how much it AGREES. A lobe has no such hazard: bin j of two
// coplanar neighbours is what the same cone looks like from two points a voxel apart, and the only
// way those differ materially is parallax at a metre's range, which is what a reflection of
// something very close would be. So this blends bin against the SAME bin, plainly.
//
// # Once, and that is the whole of what keeps it bounded
//
// Every other filter in this renderer reads one set of words and writes another, because a filter
// that reads what it writes is applied again on every visit and blurs without bound until a wall is
// one colour. There is no room for a second copy here — a second thirty-six bins a block is another
// 38.9 MB — so this runs **exactly once per lobe, on the visit it converges**, marked in the
// block's own header. A neighbour that converges later reads a blend of blends, which is about one
// and a half applications over a patch rather than an unbounded number, and it stops there because
// nothing runs it again. An edit forgets the block, so the whole thing is measured and blended
// again from nothing, which is the same discipline the rest of the record follows.
void face_lobe_denoise(uint block, uint bins, ivec3 node, uint level, uint dir) {
    const ivec2 axes = face_axes(dir);
    ivec3 du = ivec3(0);
    ivec3 dv = ivec3(0);
    du[axes.x] = 1;
    dv[axes.y] = 1;

    // The eight neighbours resolved ONCE into blocks, rather than per bin. Eight face lookups and
    // eight probes against thirty-six times that, which is the difference between this costing
    // nothing and costing more than the rays it is cleaning up after.
    uint at[8];
    float trust[8];
    // NOT `const`: `du` and `dv` come from the face's direction at run time, and a const array in
    // GLSL wants a constant initialiser.
    ivec3 steps[8] = ivec3[8](-du, du, -dv, dv, -du - dv, -du + dv, du - dv, du + dv);
    float spatial[8] =
        float[8](kDenoiseEdge, kDenoiseEdge, kDenoiseEdge, kDenoiseEdge,
                 kDenoiseCorner, kDenoiseCorner, kDenoiseCorner, kDenoiseCorner);
    for (uint i = 0u; i < 8u; ++i) {
        at[i] = kNoLobe;
        trust[i] = 0.0;
        const uint found = node_face_lookup(node + steps[i], level, dir);
        if (found == kNoFace || found == kFaceTombstone || found >= faces.items.length()) continue;
        const uint block_at = node_face_lobe_find(found);
        if (block_at == kNoLobe) continue;
        // ...and only a neighbour of the SAME size. Two lobes cut into different numbers of
        // directions do not have a bin j in common, and blending them would be reading one
        // surface's answer for a cone the other never measured. A polished face beside a rough one
        // simply keeps its own, which is the honest thing and is rare -- a size class follows the
        // material, and neighbouring faces are nearly always the same material.
        if (face_lobe_bins_of(face_lobe.words[face_lobe_state_at(block_at)]) != bins) continue;
        // Weighted by how far along the neighbour's own burst is, capped at converged. A face two
        // visits into its measurement is noise, and noise averaged nine ways is noise one scale
        // coarser -- which is D387's measurement and the same reason `face_light_seed` refuses a
        // thin ancestor.
        const float count = float(face_lobe.words[face_lobe_count_at(block_at)]);
        if (count <= 0.0) continue;
        at[i] = block_at;
        trust[i] = spatial[i] * min(count / float(bins * kLobeSamples), 1.0);
    }

    for (uint bin = 0u; bin < bins; ++bin) {
        const uint mine = face_lobe_bin_at(block, bin);
        float weight = kDenoiseCentre;
        vec3 blended = face_unpack_rgb9e5(face_lobe.words[mine]) * kDenoiseCentre;
        for (uint i = 0u; i < 8u; ++i) {
            if (at[i] == kNoLobe) continue;
            // A bin the neighbour has not reached yet adds nothing at all, which is what makes the
            // kernel shrink gracefully instead of pulling the answer towards nought. Its weight is
            // stored beside it and is nought exactly when no ray has landed in it.
            const uint neighbour = face_lobe_weight_at(at[i], bin, bins);
            if (!(uintBitsToFloat(face_lobe.words[neighbour]) > 0.0)) continue;
            weight += trust[i];
            blended += trust[i] * face_unpack_rgb9e5(face_lobe.words[face_lobe_bin_at(at[i], bin)]);
        }
        if (weight > 0.0) face_lobe.words[mine] = face_pack_rgb9e5(blended / weight);
    }
    face_lobe.words[face_lobe_state_at(block)] |= kLobeFiltered;
}

// ---- lamps (R3c) ---------------------------------------------------------------------------
//
// Next-event estimation, moved off the pixel and onto the face. The path tracer aims at the sun and
// that is why sunlight is clean; emissive voxels had no equivalent in the real-time path at all, so
// a room lit by lamps was lit by a constant. This is the same estimator `pick_light` runs in
// shaders/pathtrace.comp, with one difference that is the whole point of the stage: it runs once
// per FACE rather than once per pixel per bounce, so a lamp-lit hall costs the same at 4K as at
// 800p, and the samples ACCUMULATE instead of being thrown away when the frame ends.
//
// What a face stores is IRRADIANCE -- radiance times the cosine, integrated over the lamps -- so
// the composite multiplies by albedo/pi exactly as it does for the sun and the sky, and the three
// terms are in one space rather than three plausible ones.

// The draw's own random stream. Kept in a global for the same reason the ambient ray's face
// constants are: it is threaded through a candidate loop and an accept test, and passing it as an
// inout parameter through both puts it in memory on compilers that will not promote it.
uint g_lamp_state;
float lamp_rand() {
    g_lamp_state = node_hash_mix(g_lamp_state);
    return float(g_lamp_state & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

// The same weights face_luminance uses in the path tracer, so the two rank the same lamp the same
// way. A ranking that disagreed with the reference's would make the two renderers noisy in
// different places and the comparison meaningless.
float lamp_luminance(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// What one lamp would deliver to this point with nothing in the way: the target the draw scores by.
// The score and the density the kept sample is divided by have to be this same expression, or the
// sample is not drawn from the distribution it is corrected by.
float lamp_target(uint index, vec3 from, vec3 normal, out vec3 centre, out float radius,
                  out vec3 radiance) {
    const LightSource lamp = lights.items[index];
    // The list is in absolute world voxels; this pass stands in the camera's chunk.
    centre = vec3(float(lamp.x), float(lamp.y), float(lamp.z)) + 0.5 - g_sky_chunk_origin;
    radiance = vec3(lamp.red, lamp.green, lamp.blue);
    // The sphere that CONTAINS the fitting, not the one of the same volume. Direct sampling owns
    // emitters outright, so a cone too narrow to cover the lamp does not merely sample it badly --
    // the light from the parts left outside is owned by nobody and goes out. The path tracer
    // measured a room thirteen per cent too dark from exactly this, and light_list.hpp inflates
    // `voxels` until the sphere covers the fitting's box for the same reason.
    radius = max(0.87 * pow(float(max(lamp.voxels, 1u)), 1.0 / 3.0), 0.87);

    const vec3 to = centre - from;
    const float distance_sq = max(dot(to, to), 1e-4);
    const float cos_surface = dot(to * inversesqrt(distance_sq), normal);
    if (cos_surface <= 0.0) return 0.0;   // behind the face

    // The solid angle the sphere actually covers, rather than r^2/d^2 standing in for it. The two
    // agree once the lamp is a couple of radii away and part company close to, where the proxy has
    // to be clamped at one and then says a lamp an arm's length from a wall is worth no more than
    // the same lamp across the room.
    const float sin_max_sq = min(radius * radius / distance_sq, 1.0);
    const float solid = 2.0 * (1.0 - sqrt(1.0 - sin_max_sq));
    return lamp_luminance(radiance) * cos_surface * solid;
}

// Can the box the host has just announced have moved this face's lamp light at all?
//
// It can only do so by standing between the face and a fitting. A lamp's contribution is radiance
// times visibility; the fittings have not moved and the radiance has not changed, so a face whose
// every lamp path misses the edited box is holding exactly the answer it held before, and throwing
// that answer away is pure loss.
//
// # Why this is worth a loop over the emitter list
//
// The face pass reopened the lamp term over the whole sixteen-metre box an edit is announced for --
// the SUN's reach, because a placed block casts a long shadow. Lamps do not work like that: they
// are point sources in a room, and a block placed across the hall shadows almost nothing. Measured
// on the enclosed camera with one edit a second: `lamps on the card: 0 of 121,013 live faces cast
// no more rays at all` -- not one face in the room held a settled lamp term for the whole run --
// and 43% of the frame changed between two consecutive frames, against 2.9% never edited. Per face,
// so it reads as squares, and every frame, so it flickers. That is the reported bug.
//
// R9g's rule is that a face NEVER loops over lights, and it is not broken here. That rule is about
// the per-SAMPLE cost -- it is what makes a hall of a thousand fittings cost a face what a hall of
// one costs, on every frame, for ever. This loop runs on the single frame an edit is announced, for
// the faces inside that edit's box, and it is what stops the same edit reopening a hundred thousand
// converged faces. Bounded twice over: at kLampEditProbe fittings, past which the answer is the old
// conservative one, so the cost of an edit is bounded whatever the scene holds.
//
// The box tested is the EDIT, not the sixteen metres it was announced for: `edit_min` arrives grown
// by kEditShadowReach, and shrinking it back is what the near field already does.
bool lamp_path_crosses_edit(vec3 from) {
    const uint count = min(node_push.light_count, kMaxLights);
    if (count == 0u) return false;
    if (count > kLampEditProbe) return true;   // too many to ask; keep the old answer

    const vec3 lo = vec3(push.edit_min.xyz) + vec3(float(kEditShadowReach)) - g_sky_chunk_origin;
    const vec3 hi = vec3(push.edit_max.xyz) - vec3(float(kEditShadowReach)) - g_sky_chunk_origin;

    for (uint i = 0u; i < count; ++i) {
        const LightSource lamp = lights.items[i];
        const vec3 centre =
            vec3(float(lamp.x), float(lamp.y), float(lamp.z)) + 0.5 - g_sky_chunk_origin;
        const vec3 to = centre - from;

        // The slab test, over the segment rather than the ray: an occluder past the fitting is not
        // between anything. Grown by the margin the sample itself is allowed to wander over the
        // face, so a box that only just misses the centre line is not called a miss.
        float t0 = 0.0;
        float t1 = 1.0;
        bool crosses = true;
        for (uint axis = 0u; axis < 3u; ++axis) {
            const float d = to[axis];
            const float low = lo[axis] - g_sky_size - from[axis];
            const float high = hi[axis] + g_sky_size - from[axis];
            if (abs(d) < 1e-6) {
                if (low > 0.0 || high < 0.0) { crosses = false; break; }
                continue;
            }
            const float inv = 1.0 / d;
            const float a = min(low * inv, high * inv);
            const float b = max(low * inv, high * inv);
            t0 = max(t0, a);
            t1 = min(t1, b);
            if (t0 > t1) { crosses = false; break; }
        }
        if (crosses) return true;
    }
    return false;
}

// One lamp sample: irradiance arriving at this face from one fitting chosen in proportion to what
// it would deliver, corrected by the density that chose it, and multiplied by whether the ray got
// there. `unknown` says the ray was stopped by a cell the world claims and the pool has not built,
// which is a measurement of the tree rather than of the light -- see the hold in main().
vec3 lamp_cast(uint index, out bool unknown, out vec3 to_lamp) {
    unknown = false;
    to_lamp = vec3(0.0);
    if (node_push.light_count == 0u) return vec3(0.0);

    // Where on the face, and which way inside the cone, from one four-dimensional stratified
    // sequence -- the same argument node_r4 sets out for the ambient ray. The lamp CHOICE is drawn
    // from plain noise instead: it is a discrete resample over a list whose order means nothing, so
    // there is no low-discrepancy structure for a sequence to exploit.
    const vec4 r = node_r4(index, g_sky_rotation);
    const vec2 at = r.xy * 2.0 - 1.0;
    const vec3 from = face_point(g_sky_corner, g_sky_across, g_sky_down, g_sky_normal, g_sky_size,
                                 at) - g_sky_chunk_origin;
    const vec3 normal = vec3(g_sky_normal);

    const uint count = min(node_push.light_count, kMaxLights);
    const uint candidates = min(count, kLampCandidates);
    const float uniform_density = float(candidates) / float(count);

    float weight_sum = 0.0;
    float chosen_target = 0.0;
    vec3 chosen_centre = vec3(0.0);
    vec3 chosen_radiance = vec3(0.0);
    float chosen_radius = 0.87;

    for (uint i = 0u; i < candidates; ++i) {
        const uint pick = min(uint(lamp_rand() * float(count)), count - 1u);
        vec3 centre;
        vec3 radiance;
        float radius;
        const float target = lamp_target(pick, from, normal, centre, radius, radiance);
        if (target <= 0.0) continue;

        // Each candidate divided by the density of the proposal that produced it, rather than the
        // whole draw scaled at the end. Identical while every candidate is drawn uniformly, which
        // is the case today -- written this way so a second proposal can arrive without the
        // correction having to be rederived.
        const float w = target / uniform_density;
        weight_sum += w;
        if (lamp_rand() * weight_sum <= w) {
            chosen_target = target;
            chosen_centre = centre;
            chosen_radius = radius;
            chosen_radiance = radiance;
        }
    }
    if (chosen_target <= 0.0) return vec3(0.0);

    const vec3 to = chosen_centre - from;
    const float distance_sq = max(dot(to, to), 1e-6);
    const float distance = sqrt(distance_sq);
    const vec3 towards = to / distance;
    const float sin_max_sq = clamp(chosen_radius * chosen_radius / distance_sq, 0.0, 1.0);
    const float cos_max = sqrt(1.0 - sin_max_sq);

    const float cos_theta = mix(cos_max, 1.0, r.z);
    const float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    const float phi = r.w * 6.28318530718;
    const vec3 up = (abs(towards.z) < 0.999) ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    const vec3 tangent = normalize(cross(up, towards));
    const vec3 bitangent = cross(towards, tangent);
    const vec3 dir = normalize(tangent * (cos(phi) * sin_theta) +
                               bitangent * (sin(phi) * sin_theta) + towards * cos_theta);

    const float cos_surface = dot(dir, normal);
    if (cos_surface <= 0.0) return vec3(0.0);
    // Which way this sample went, for the dominant direction the specular highlight is drawn along.
    // Handed back rather than accumulated here, because a sample that is then occluded delivers
    // nothing and must not pull the mean towards a fitting this face cannot see.
    to_lamp = dir;

    // The resampling correction: the kept candidate stands in for every one the draw saw, so its
    // density is scaled by the total weight against its own. The uniform density over the whole
    // list is already inside weight_sum.
    const float pdf_direction = 1.0 / (6.28318530718 * max(1.0 - cos_max, 1e-6));
    const float inv_pdf = (weight_sum / chosen_target) / pdf_direction;

    // Stopped short of the fitting, or every sample would be occluded by the thing it is sampling.
    // `report` and the two used-reports are off for the reason D292 gives and R9h widens: no light
    // path may cause streaming. `occlude_unknown` is on for the reason D302 and D324 give: a cell
    // the world says is occupied and the pool has not built is matter, and letting a lamp ray
    // through it lights a sealed room through its own walls.
    const float reach = max(distance - chosen_radius - kLampSurfaceMargin, 0.0);
    if (reach <= 0.0) return chosen_radiance * (cos_surface * inv_pdf);   // standing inside it

    const NodeHit hit =
        node_march(from, dir, g_sky_pixel_angle, 0.0, false, false, false, false, true, reach);
    if (hit.hit) {
        unknown = hit.unknown;
        return vec3(0.0);
    }
    return chosen_radiance * (cos_surface * inv_pdf);
}

void main() {
    // The sky's own inputs, before anything can ask it a question. A global in GLSL may only be
    // initialised from a constant expression, so this is an assignment rather than an initialiser --
    // and it has to be the first statement in the pass, because `sky_radiance` is reached from
    // `sky_cast` and from `bounce_radiance` and neither is in a position to check.
    trace.sun = node_push.sun;
    trace.sun_colour = node_push.sun_colour;

    // `face_first` is nought for the store and the provisional base for the card's own faces, which
    // are dispatched separately because they sit in the tail of the same array rather than after the
    // watermark -- and a dispatch spanning the gap would be a million invocations returning at once.
    //
    // ...and for the store's own dispatch the index is into the COMPACTED list rather than into
    // the store, so every workgroup this launches is full. See face_worklist.comp.
    uint slot;
    if (node_push.from_worklist != 0u) {
        if (gl_GlobalInvocationID.x >= face_work.count) return;
        slot = face_work.slots[gl_GlobalInvocationID.x];
    } else {
        slot = node_push.face_first + gl_GlobalInvocationID.x;
    }
    if (slot >= node_push.face_count) return;

    // A card-claimed face is only worth a ray on the frame it was claimed.
    //
    // Its record keeps kFaceLive set for ever, so without this every provisional bucket ever used
    // would be traced again every frame for the rest of the run -- thirty-two thousand rays a frame
    // spent on stand-ins nothing is looking at any more. The mark says which frame it was claimed
    // in, and that is the whole of the test.
    //
    // The same test says whether this slot is one of the card's, which the ambient term needs
    // further down for a different reason: a record that is rewritten every frame cannot
    // accumulate, so nothing that accumulates may be spent on it. The store's own dispatch never
    // reaches these slots -- its count stops at the watermark, well below the provisional base --
    // so the comparison is exact rather than a proxy for the dispatch.
    const bool provisional_face =
        node_push.provisional_base != 0u && slot >= node_push.provisional_base;
    if (provisional_face) {
        const uint mark = provisional.marks[slot - node_push.provisional_base];
        if ((mark >> 24) != (node_push.frame & 0xFFu)) return;
    }

    Face face = faces.items[slot];
    const uint level = face_level_of(face.packed);
    // A free slot, asked by the marker bit rather than by the word being nought.
    //
    // "Nought means empty" held while the finest face was a brick. A single-voxel face pointing
    // +x with no flags packs to exactly nought, so one live face in six was skipped here: never
    // shaded, never settled, and the composite showed full sun on it for ever. See kFaceLive.
    if (!face_live_of(face.packed)) return;

    // Whether this face is due a ray this frame, and everything else that can be decided from the
    // record alone -- worked out by `face_work_of` in node.glsl, which is also what
    // `face_worklist.comp` decides the compacted dispatch with.
    //
    // One function rather than one predicate copied twice, and that is not tidiness: if the
    // worklist were ever the stricter of the two, a face would silently stop being lit and nothing
    // anywhere would say so.
    //
    // This USED to argue that selection belongs here rather than in a compaction pass of its own,
    // because what costs is the march and not the record. That was true while most of the store was
    // working. Once light stopped at what a pixel had read it stopped being true: 220,000 faces of
    // work spread over 772,000 invocations is eighteen busy lanes in a workgroup of sixty-four, and
    // a workgroup runs for as long as its slowest lane.
    //
    // A face that has not settled is never held back, so a surface that has just come into view
    // converges in a few frames however large the store is. Only the refresh rate of settled
    // faces falls, which is the right thing to give up: they are watching a sun that has not
    // moved. See kFacesPerFrame in src/app/main.cpp.
    // ...unless the player has just edited near it, in which case it goes to the front of the
    // queue and stays there for as long as the edit window lasts.
    //
    // A settled face is refreshed one frame in `face_stride`, which is three at the enclosed camera
    // and seven at 4K -- so the ray that would NOTICE an edit is up to seven frames away, on top of
    // however long the answer then takes to move. `face_accumulate` fixes the second half; this is
    // the first. The region is the edit's own bounds grown by the reach of a shadow, worked out on
    // the host and already in the parameter block, because the path tracer has needed exactly this
    // box since long before the face store existed.
    //
    // What it costs is bounded by the box: those faces are shaded every frame instead of one frame
    // in three, for the hundred and twenty frames the window is open, and nothing outside it is
    // disturbed at all.
    const FaceWork work = face_work_of(slot, face, provisional_face);
    // The same test against a box shrunk to the reach of the NEAR field, which is the only part of
    // the ambient term an edit at that distance can have moved. See kEditAmbientReach.
    const bool near_edit = work.near_edit;
    const bool near_edit_contact = work.near_edit_contact;

    // The world changed under this face on this exact frame, and the host said so rather than
    // leaving it to be inferred.
    //
    // `face_accumulate` throws a history away only when a sample contradicts a UNANIMOUS one, which
    // is the right conservative test for a sample that might be noise and no test at all for a face
    // that was still mid-transition when the next edit landed. Delete a roof and the terrace under
    // it starts climbing from black towards white; undo before it arrives and it is unanimous about
    // nothing, so it keeps averaging and takes hundreds of frames to come back. Measured: fully
    // shadowed faces flat at ~42,000 against 105,848 for the same camera never edited.
    //
    // edit_min.w == 2 is the one frame the edited region opened on. Faces inside it drop to
    // `kFaceEditSeed` samples at the ratio they held, which is exact rather than a guess and leaves
    // D319's rule alone for the case it was written for. What it costs is that a face inside the box
    // whose light did NOT change re-converges too -- a handful of frames, on faces that are being
    // shaded every frame anyway.
    //
    // It used to drop to NOUGHT, and that is what a player was seeing as the room turning to blocks
    // and flashing on every edit: a face with no samples is not answerable, so the composite reads
    // the coarse face three levels above it, and indoors that stand-in is inside the same box and
    // has been zeroed by the same line. See kFaceEditSeed for the whole of it.
    const bool edit_reset = work.edit_reset;
    const uint counters = work.counters;   // already reseeded by face_work_of when edit_reset
    if (edit_reset) faces.items[slot].counters = counters;

    // ---- if the camera cannot see it, it is not lit -------------------------------------------
    //
    // Two different questions, and separating them is what makes an edit affordable:
    //
    //   `may_cast`  -- is this face worth a RAY. No, if no pixel has read it recently: the
    //                  measurement would be of light nothing is going to look at, and it can be
    //                  made when the face is next seen, at no cost to any picture.
    //   the return below -- is there anything at all to do. Only when nothing has been announced.
    //
    // An edit reopens every face within `kEditShadowReach`, which is sixteen metres and indoors is
    // most of the store, and it does so whether or not those faces are on screen -- it has to, or a
    // wall deleted behind your back keeps its old shadow. Before this, "reopen" also meant "burst
    // now", and a player carving while flying paid a **75 ms** face pass on every edit frame. The
    // reset itself is a handful of word writes and is kept exactly as it was; only the rays wait.
    const bool may_cast = work.may_cast;
    //
    // The rule the whole rewrite was asked for under, arriving in the one pass that was still
    // ignoring it. The store holds a face for six hundred frames after anything last asked for it,
    // and every one of those faces was casting its full burst every frame: measured on the flight,
    // 763,800 live faces with 281,244 of them still bursting, against a frame that reads a fraction
    // of that. Most of a moving frame was light for surfaces nobody was looking at.
    //
    // The stamp is exact and it is this frame's: `visibility.comp` writes it for every face a
    // pixel resolves to, there is a barrier between that pass and this one, and `kFaceSeenWindow`
    // is the small amount of hysteresis a grazing face needs. Nothing about RESIDENCY changes --
    // the face keeps its slot, its key and its accumulated answer, so the composite reads exactly
    // what it read before and a face coming back into view carries on from where it stopped rather
    // than starting again. What stops is the rays.
    //
    // # The two exceptions, and they are what makes this exact rather than nearly right
    //
    // A skipped face must never miss an announcement, because an announcement is the only thing
    // that can tell it its answer is now wrong. Both of them are one-frame flags from the host and
    // both are read from the push block, so testing them costs no memory at all:
    //
    //   `edit_min.w == 2` -- the frame an edited region opens (D373). Faces inside the box start
    //   again from nothing whether or not anybody can see them, or a wall deleted behind your back
    //   would still be casting its ambient occlusion when you turned round.
    //
    //   `light_reset` -- the frame the emitter list changed (D403). A converged face compares the
    //   version its own samples were taken under, and it can only do that on a frame it runs.
    //
    // Anything else that can invalidate a face reaches it through one of those two, so there is no
    // third case to miss and no need for a "has it just come back" test on the way in.
    if (!may_cast && !edit_reset && node_push.light_reset == 0u) return;

    // How many faces the OFF-SCREEN class actually shaded this frame. R9b's budget, counted rather
    // than predicted.
    //
    // The host divides a population by a budget and hands down a stride; that arithmetic is a
    // PREDICTION, and trap 15's whole lesson is that a prediction and a measurement look identical
    // in a log. This is the measurement, and it is here because the cost of this class turned out not
    // to respond to its own budget: eight times fewer faces shaded moved the faces pass 3.48 ms to
    // 3.06, where it should have moved it most of the way back to the control's 1.76. Three
    // explanations were tried and priced and none of them fits (see the decision log), so the next
    // person gets the count instead of the fourth guess.
    if (work.off_screen) probe_add(8u);

    const uint samples = work.samples;
    // Whether the SUN is due a ray this frame. The ambient term used to be gated by this same test
    // and no longer is, and that is a third of why it converges.
    //
    // The stride is a budget on the sun's ray, which is unbounded and is the expensive thing in
    // this pass. An ambient near ray is bounded at a metre and costs a fraction of one, so pricing
    // it at the sun's rate held the term that carries every crease in the building down to the rate
    // of the term that is watching a sun which has not moved. A face that is not due still returns
    // immediately once its ambient term has converged, which is the ordinary case and is the same
    // thirty-two bytes read it was before.
    const bool sun_due = work.sun_due;

    // Nothing at all is owed to this face this frame: the sun is not due and the ambient term is
    // finished. Out here, before anything is fetched.
    //
    // The flag is in the record that has already been read, and the point of that is measured
    // rather than assumed -- see kFaceAmbientDone. Asking the face light instead cost 0.38 ms a
    // frame in scattered loads on a store of half a million faces that had no work to do.
    const bool ambient_idle = work.ambient_idle;

    // And the same question for the lamps, with one extra term that is the whole of "instantly".
    //
    // A converged lamp face is silent, and a silent face cannot notice that a lamp has been placed,
    // deleted or dimmed -- it never reaches the word that would tell it. So the HOST says so, on
    // the one frame the emitter list changes, exactly as it says so for an edit (`edit_min.w == 2`,
    // D373). `light_reset` reopens every face in the store for that frame; each then compares the
    // version its own samples were taken under against the current one and decides for itself. The
    // flag is the gate and the stamp is the decision, which is the arrangement D373's general
    // lesson calls for: an accumulator that infers "the world changed" from its own samples cannot
    // see a change that arrives before the last one finished.
    const bool lamp_idle = work.lamp_idle;

    // Nothing owed at all this frame: the sun is not due and the ambient term has finished. Out
    // here, before anything is fetched. The flag is in the record that has already been read, and
    // the point of that is measured rather than assumed -- see kFaceAmbientIdle.
    //
    // # There is no throttle here, and three of them were built and measured first
    //
    // The obvious worry is a population that starts measuring all at once -- a camera turned round,
    // a region streaming in, a chisel -- so the obvious answer is to meter the burst. Three ways of
    // metering it were built, and all three made the transient WORSE, because they all extend the
    // time a face spends in the state that costs:
    //
    //   fewer rays each, budget divided by the population   3.17 ms at cut+240 (against 1.21)
    //   whole burst, one face in N per frame                5.61 ms  -- and it wrecks coherence:
    //                                                       four bursting lanes in a workgroup of
    //                                                       sixty-four, the other sixty waiting
    //   whole burst, one WORKGROUP in N per frame           3.80 ms  -- coherent, still slower to
    //                                                       get out of the expensive state
    //   no metering at all                                  1.21 ms, everything converged
    //
    // The measurement underneath all three: what this pass spends on an unconverged face is mostly
    // the FACE, not the ray. Ninety thousand faces at thirty-two rays and two hundred and forty
    // thousand at two cost about the same. So the cheapest thing to do with a face that has to
    // measure is to let it measure, all at once, and be finished with it -- and the peak that
    // leaves is one second of 3.18 ms against 1.14, once, after the screen has completely turned
    // over. Metering that peak costs three times as much spread over eight times as long.
    if (!sun_due && ambient_idle && lamp_idle) return;

    const uint direction = face_dir_of(face.packed);
    const ivec3 normal = face_normal(direction);

    // Back-facing to the sun is nought without tracing anything, which is most of a building: a
    // cube has six faces and the sun reaches at most three of them.
    //
    // It no longer returns here, though, because the ambient ray below is owed to EVERY face and a
    // wall in shade needs it most: the whole point of R10 is that a surface which cannot see the
    // sun is currently lit by the entire sky dome regardless of what stands in front of it.
    const float facing = dot(vec3(normal), node_push.sun.xyz);
    const bool sun_possible = facing > 0.0;
    if (!sun_possible && sun_due && may_cast) {
        // Counted as a ray that did not reach the sun, which is what it is. The fraction then
        // falls as the samples come in rather than snapping to nought, and this is the same
        // arithmetic a lit face does with one term different.
        faces.items[slot].counters = face_accumulate(counters, false);
    }

    // A point ON the face, somewhere different every frame.
    //
    // The node's own coordinate is its voxel coordinate shifted by its level, so this reverses
    // exactly the shift the marcher applied when it reported the face -- and lands half a cell
    // along the normal, which is the face rather than the middle of the cell behind it.
    //
    // Somewhere different, because a face is not a point. Always tracing from the centre makes
    // every sample of a face identical, so the fraction can only ever be nought or one and the
    // shadow edge lands on face boundaries: at the leaf level that is a 25 cm staircase across a
    // flat terrace, which is what the first picture with shadows in it showed. Spreading the
    // samples over the face makes the fraction mean what it says -- how much of this face the sun
    // reaches -- and the edge then resolves WITHIN a face, over frames, at no extra cost per
    // frame. That is the whole claim of §6: the penumbra costs the face a few samples instead of
    // costing every pixel looking at it a ray of its own, for ever.
    const float size = float(1 << level);
    const vec3 corner = vec3(ivec3(face.x, face.y, face.z)) * size;

    const uint seed = node_hash_mix(slot * 0x9E3779B9u + node_push.frame);
    const vec2 jitter = vec2(float(seed & 0xFFFFu), float((seed >> 16) & 0xFFFFu)) / 65536.0;

    // The two axes across the face, which are the two the normal is not along.
    const vec3 across = abs(normal.x) != 0 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    const vec3 down = abs(normal.z) != 0 ? vec3(0, 1, 0) : vec3(0, 0, 1);

    // Where the camera's chunk puts the origin, so the march works in the same space the primary
    // ray did rather than in absolute voxels, which lose precision a long way out (D156).
    const vec3 chunk_origin = vec3(push.camera_chunk.xyz * 256);
    const vec3 origin = face_point(corner, across, down, normal, size,
                                   (jitter - 0.5) * 2.0) - chunk_origin;

    // One ray at the sun. `report` and the two used-reports are off: a shadow ray must not drag
    // streaming towards whatever it happens to cross, which is the rule the old tracer already
    // follows and the reason a structure built at a distance never cast a shadow until somebody
    // walked up to it. `stand_in` is off for the reason node_march sets out at length: an unbuilt
    // cell is not an occluder.
    //
    // The ray widens with distance, at the same rate a pixel does. Asking for full voxel detail
    // along its whole length -- which a zero angle does, since the footprint then floors at one
    // voxel for ever -- asks the tree for detail a kilometre away that nothing on screen has any
    // reason to have built, so the ray spends its steps in cells the pool has only outlined. A
    // shadow does not need to know the shape of what casts it to the centimetre from 300 m.
    // And the sun is a disc, not a point. node_push.sun.w is the cosine of its angular radius,
    // the same figure the path tracer is given, so the two agree about how soft an edge is rather
    // than both being plausible. Without it every sample of a face asks the same question and a
    // contact shadow has an edge one voxel wide at any distance from what casts it.
    // How fast this pass's rays widen with distance, which is one pixel's angle.
    //
    // Tying a face's light to the SCREEN looks like a fault — §6's claim is that lighting stops
    // scaling with resolution, and a face is meant to be lit once however many pixels are looking at
    // it. It was tried as a fixed reference (`2 * lens.x / 1440`) against a reported grid on flat
    // surfaces, and it changed **nothing**: the step between neighbouring voxel faces on the rotunda
    // floor read 5.08 of 255 against 5.09, and measured properly — every shot resampled to one size
    // first — the grid is the same size at 800p, 1080p and 1440p anyway (5.09 / 5.28 / 4.89). It is
    // not carried, because it costs the smaller window a finer ray and buys nothing measurable. The
    // reasoning was sound and the answer was still no, which is D417's shape exactly.
    const float pixel_angle = 2.0 * push.lens.x / float(push.resolution.y);
    if (sun_possible && sun_due && may_cast) {
        const uint cone_seed = node_hash_mix(seed ^ 0x85EBCA6Bu);
        const vec2 disc = vec2(float(cone_seed & 0xFFFFu), float((cone_seed >> 16) & 0xFFFFu)) /
                          65536.0;
        const float cos_theta = mix(node_push.sun.w, 1.0, disc.x);
        const float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
        const float phi = disc.y * 6.28318530718;

        const vec3 towards = normalize(node_push.sun.xyz);
        const vec3 tangent = normalize(abs(towards.y) < 0.9 ? cross(towards, vec3(0, 1, 0))
                                                            : cross(towards, vec3(1, 0, 0)));
        const vec3 bitangent = cross(towards, tangent);
        const vec3 dir = normalize(towards * cos_theta +
                                   tangent * (sin_theta * cos(phi)) +
                                   bitangent * (sin_theta * sin(phi)));

        NodeHit hit = node_march(origin, dir, pixel_angle, 0.0, false, false, false, false, true,
                                 kNodeUnbounded);

        // The penumbra resolves over samples on the FACE, which is what takes it off the pixel: a
        // soft edge costs the face a few frames instead of costing every pixel that looks at it a
        // ray of its own, every frame, for ever.
        faces.items[slot].counters = face_accumulate(counters, !hit.hit);

        // How far the ray got before it gave up, for the rays that reached nothing. `photons` is
        // GPU-owned and unwritten until the photon pass exists, so this borrows it rather than
        // widening the record. A ray that "reached the sun" after running out of its step budget is
        // indistinguishable, in the visibility alone, from one that reached it through open air --
        // and indoors, where the only correct answer is full shadow, that difference is the whole
        // question.
        if (!hit.hit) faces.items[slot].photons = max(faces.items[slot].photons, hit.steps);

        // And whether what stopped it was matter or ignorance. Bit 31, beside the step count,
        // because "this face is in shadow" and "this face is in shadow because the pool has not
        // built what is above it" are the same picture and only the second is a bug.
        // ...and at what LEVEL it stopped, in bits 24-27. A ray stopped by an unbuilt brick has
        // lost 25 cm of sky; one stopped by a shed 512 m subtree has lost a quarter of the county,
        // and the counter cannot tell them apart without this.
        if (hit.hit && hit.unknown) {
            faces.items[slot].photons =
                (faces.items[slot].photons & 0x00FFFFFFu) | 0x80000000u |
                ((uint(hit.level) & 0xFu) << 24);
        } else if (hit.hit) {
            // The step count and the level, and NOT the flag bits above them. This used to be
            // `&= 0x00FFFFFF`, which also cleared bits 28-30 -- the two ambient flags and now the
            // lamp one -- every time a sun ray was stopped by ordinary matter, which indoors is
            // every face on every frame the sun is due. It did not show while the ambient section
            // below re-derived and re-set both of its flags on the same visit, and it would have
            // shown the moment anything set a flag here that was not re-derived a few lines later.
            // Clearing what this line is about and nothing else is what makes that unrepresentable.
            faces.items[slot].photons &= ~(0x80000000u | 0x0F000000u);
        }
    }

    // The face's own frame, worked out once for every ray this pass casts at anything.
    //
    // It used to be set immediately before the ambient burst, which was the only thing that read
    // it. The lamps need the same six numbers -- where the face is, which way it points, how big it
    // is and where the camera's chunk puts the origin -- and computing them twice is two chances
    // for the position a sample is TAKEN at to drift from the position the gradient is FITTED
    // against, which is the drift face_point exists to make impossible.
    const vec3 up = vec3(normal);
    g_sky_corner = corner;
    g_sky_across = across;
    g_sky_down = down;
    // The two axes across the face, from the one function that answers that question -- R4c's bins
    // are indexed in this frame and the composite derives it from the same place, so it cannot be
    // one frame here and another there.
    face_lobe_frame(up, g_sky_side, g_sky_other);
    g_sky_chunk_origin = chunk_origin;
    g_sky_normal = normal;
    g_sky_size = size;
    g_sky_pixel_angle = pixel_angle;

    // ---- lamps (R3c) --------------------------------------------------------------------------
    //
    // Emissive fittings, aimed at from the face rather than found by a bounce that happens to land
    // on one. Before this the real-time path had no lamp light at all: a torch lit nothing, and
    // `kIndirectFloor` in the composite stood in for every light in the building at once.
    //
    // Three things make it constant-cost, and all three are R9g's:
    //
    // - a face NEVER loops over lights. It scores kLampCandidates of them and keeps one, so a hall
    //   with a thousand fittings costs a face exactly what a hall with one costs;
    // - the answer accumulates on the face, so it costs frames rather than pixels, and stops
    //   entirely at kLampConverged;
    // - occlusion is one ray, bounded at the distance to the fitting it was aimed at, so a lamp
    //   across the room is not a ray across the world.
    //
    // It is deliberately NOT gated by `sun_due`. The stride is a budget on the sun's unbounded ray;
    // a lamp ray stops at the lamp, and pricing a bounded ray at an unbounded one's rate is what
    // held the ambient term back for three stages (kSkyBurst).
    const uint light_at = slot * kFaceLightWords;
    // Bounded, because the host and this shader agree about `kFaceLightWords` by comment alone.
    // When they disagreed -- a binary where the host had allocated one word a slot while this wrote
    // two -- the face pass wrote past the end of its own buffer and into whatever the allocator had
    // placed next, which was the node pool. A stride mismatch is now a write that does not happen
    // instead of a corruption somewhere else in the frame (D332).
    if (light_at + kFaceLightWords - 1u >= face_light.words.length()) return;

    // ---- what an edit or a re-claimed slot throws away ----------------------------------------
    //
    // One place for all three terms, and it has to be one place because it runs BEFORE any of them
    // and `face_light_seed` writes to all three. It used to sit inside the ambient section, which
    // was the only reader; leaving it there and adding the lamps below it would have seeded a face
    // after it had already cast its first burst of rays into the record the seed then overwrote.
    //
    // A slot the store has just handed out carries whatever the face before it left here, because
    // this array is never uploaded and so is never cleared by a claim the way `counters` is. The
    // host zeroes `counters` when it claims, so a sample count of nought is exactly "this slot is
    // new" -- read before the sun wrote to it, above.
    if (edit_reset) {
        // An edit throws away only what the edit can have changed, and the terms have very
        // different reaches. The ambient FAR field goes, over the whole sixteen metres: opening a
        // roof really does change how much sky a floor across the room can see, and it costs one
        // ray a visit to put right. The ambient NEAR field is a falloff over one metre and is blind
        // past it, so it survives unless the edit was within `kEditAmbientReach`.
        //
        // That distinction is the difference between placing a single voxel costing a handful of
        // faces their thirty-two-ray burst and costing every face within sixteen metres of it one.
        //
        // Neither half is thrown away, for the reason kFaceEditSeed sets out for the sun: a count of
        // nought is not a cautious answer here either. An ambient record with no samples reads as
        // fully unoccluded and a far field with none reads as open sky, so wiping them lit every
        // crease in the room white for the frames it took to measure them again -- on every edit.
        // Both keep their mean and drop to kFaceEditSeed, which the next burst outvotes at once.
        const uint seed = node_push.edit_seed;
        // ...and what the face is MADE of, which is a third reach again: a material can only have
        // changed where the geometry did, so the near box governs it and the shadow's sixteen
        // metres do not. A voxel repainted under a face keeps its slot and its key, so nothing
        // else here would ever notice. R4a.
        if (near_edit_contact) {
            node_face_material_forget(slot);
            // ...and the block of outgoing bins with it, on the same reach and for the same reason:
            // a lobe is a measurement of what this surface reflects, and if the surface changed it
            // is a measurement of something that is no longer there. R4c.
            node_face_lobe_forget(slot);
        }
        uint near_n = face_light.words[light_at] & 0xFFFFu;
        uint far_n = (face_light.words[light_at] >> 16) & 0xFFFFu;
        if (near_edit_contact && near_n > seed) {
            const float scale = float(seed) / float(near_n);
            face_light.words[light_at + 1u] =
                uint(float(face_light.words[light_at + 1u]) * scale + 0.5);
            // Signed: a corner's gradient is negative on one side of the face, and the bit pattern
            // is what carries it. Scaled through int, not through the unsigned word.
            face_light.words[light_at + 2u] =
                uint(int(round(float(int(face_light.words[light_at + 2u])) * scale)));
            face_light.words[light_at + 3u] =
                uint(int(round(float(int(face_light.words[light_at + 3u])) * scale)));
            near_n = seed;
        }
        if (far_n > seed) {
            face_light.words[light_at + 4u] =
                (face_light.words[light_at + 4u] * seed + far_n / 2u) / far_n;
            // ...and the bounce is LEFT ALONE, because it is a mean and not a sum.
            //
            // The rule is the one kFaceEditSeed states for the sun and the lamps — keep the mean,
            // drop the confidence — and which of the two words a term is stored in decides what that
            // sentence means in code. `far_open` above is a count out of `far_n`, so keeping its mean
            // is scaling it. Words 9 to 11 already ARE the mean (kBounceMemory), so keeping it is
            // touching nothing, and scaling them here would divide the answer by `far_n / seed` and
            // read as a face going several times DARKER on every edit, in the term that lights the
            // whole interior. That line was correct while the bounce was a sum, and the shape of the
            // fault is that a rule written about a quantity outlives the representation it was
            // written for.
            far_n = seed;
        }
        face_light.words[light_at] = (near_n & 0xFFFFu) | ((far_n & 0xFFFFu) << 16);
        // ...and it is measuring again, so it is neither finished nor idle.
        faces.items[slot].photons &= ~(kFaceAmbientDone | kFaceAmbientIdle);

        // The LAMPS keep their mean and lose their confidence -- but only where the edit can have
        // reached them, which for a lamp is not the sun's sixteen metres.
        //
        // A face's lamp light changes only if the moved geometry stands between it and a fitting,
        // so that is what is asked, once, on this frame: `lamp_path_crosses_edit`. Without it every
        // edit reopened the lamp term of every face in the room, the estimator restarted from eight
        // samples on all of them, and a player building anything watched the whole interior turn to
        // per-face squares and flicker for the sixty-four frames it takes to reach kLampConverged
        // -- then did it again on the next edit. Measured: `0 of 121,013 live faces cast no more
        // rays at all`, and 43% of the frame changing between two consecutive frames.
        //
        // Inside kEditAmbientReach it is reopened regardless: there the geometry under the face has
        // genuinely moved, the face's own position on the world has changed, and the box test is
        // beside the point.
        const bool lamp_edit =
            near_edit_contact ||
            (node_push.lamp_edit_scope == 0u) ||
            lamp_path_crosses_edit(face_point(corner, across, down, normal, size, vec2(0.0)) -
                                   chunk_origin);
        if (lamp_edit) {
            // Confidence dropped to kLampSeedSamples, for the reason that constant sets out:
            // throwing the mean away is exact and it flashes, and the next burst outvotes a prior
            // of eight on the very next frame.
            const uint had = face_light.words[light_at + 8u] & 0xFFFFu;
            const uint keep = min(had, kLampSeedSamples);
            if (had > keep) {
                const float scale = float(keep) / float(had);
                for (uint w = 5u; w < 8u; ++w) {
                    face_light.words[light_at + w] =
                        floatBitsToUint(uintBitsToFloat(face_light.words[light_at + w]) * scale);
                }
            }
            face_light.words[light_at + 8u] = keep | ((node_push.light_version & 0xFFFFu) << 16);
            faces.items[slot].photons &= ~kFaceLampIdle;
        }
    } else if (samples == 0u) {
        for (uint w = 0u; w < kFaceLightWords; ++w) face_light.words[light_at + w] = 0u;
        faces.items[slot].photons &= ~kFaceLampIdle;
        // ...and the same sentence about the same hazard, one array along: what this slot is MADE
        // of was worked out by whatever face held it before, and nothing uploads over that either.
        node_face_material_forget(slot);
        // ...and the block of bins the slot's last occupant was holding, which is the same hazard
        // once more and the one place it would be visible: a slot handed to a new face would find
        // its own number in a header and read the previous face's reflection off it. R4c.
        node_face_lobe_forget(slot);
        // ...and then start from the coarse face standing over this one rather than from nothing,
        // which is what makes a newly revealed surface right on the frame it appears. Not for a
        // stand-in itself -- it IS the coarse face, and the one three levels above it is six levels
        // above the geometry and is almost never claimed.
        if (!provisional_face) {
            face_light_seed(light_at, ivec3(face.x, face.y, face.z), level, direction);
        }
    }

    // ---- what this face is made of (R4a) ------------------------------------------------------
    //
    // Resolved once per face and kept, so this is one load on every visit after the first. See the
    // FaceMaterial binding in node.glsl for the word and for why the card has to ask rather than be
    // told, and note that a face over a brick the pool has not built resolves to nought and asks
    // again next visit rather than recording itself as matte.
    //
    // What reads it is R4c, immediately below, and the composite -- which turns the same two bytes
    // into a diffuse share, a specular colour and a lobe width. Debug view 21 draws it.
    const uint material = node_face_material(slot, ivec3(face.x, face.y, face.z), level);

    // ---- and the block of outgoing bins it reflects into (R4c) --------------------------------
    //
    // Asked on every visit rather than remembered, because the answer can change without this face
    // doing anything: a block is HELD and not owned, so a face that has been off screen long enough
    // to go cold finds somebody else in its header and takes another. The common case is two loads
    // and a stamp -- see `node_face_lobe` in node.glsl.
    //
    // It is here, above the ambient block's four early returns, for the same reason `face_denoise`
    // is: a converged face still has to keep its block alive, and a claim placed below any of those
    // returns would let every settled metal in the building go cold and lose its reflection while a
    // pixel was looking straight at it.
    //
    // A stand-in the card claimed for itself never gets one. Its record is rewritten on every frame
    // it is needed, so it cannot accumulate anything -- which is the same sentence the lamp burst
    // and the ambient burst above both carry, and a lobe is the slowest accumulator here.
    const uint lobe = provisional_face ? kNoLobe : node_face_lobe(slot, material, node_push.frame);
    // The size this block was given, which decides every index into it from here down.
    const uint lobe_state = lobe == kNoLobe ? 0u : face_lobe.words[face_lobe_state_at(lobe)];
    const uint lobe_bins = face_lobe_bins_of(lobe_state);
    const uint lobe_side = face_lobe_side_of(lobe_state);
    // A big block asks fewer samples of each of its bins, so a face's whole life costs the same
    // 1,152 rays either way. See kLobeBigSamples.
    const uint lobe_target =
        lobe_bins * ((lobe_state & kLobeBig) != 0u ? kLobeBigSamples : kLobeSamples);

    // ---- R4b: the rays that lobe casts for itself ---------------------------------------------
    //
    // The one thing D592 measured as missing. Everything above fills the bins out of the far ray,
    // which is cosine-weighted about the normal -- and a reflection is read at a grazing angle,
    // where that density is a sixth of its peak. These rays go where the bins are.
    //
    // Gated on `may_cast` like every other ray in this pass: a face nobody is looking at measures
    // nothing, and takes its burst on the frame a pixel next reads it. NOT gated on `sun_due`,
    // because this is a bounded population that converges and stops, and pricing it at the sun's
    // rate would make it take five times as long to get out of the state that costs (kSkyBurst has
    // the same argument for the ambient burst, and D394 is the measurement under it).
    if (lobe != kNoLobe && may_cast && node_push.bounce != 0u && probe_lobe_ray()) {
        const uint count_at = face_lobe_count_at(lobe);
        const uint taken = face_lobe.words[count_at];
        if (taken < lobe_target) {
            probe_add(kProbeLobeBursting);
            // The face's frame is already set, above the lamps, by the one function that answers
            // that question -- so the bins are indexed here in exactly the frame the composite
            // reads them in. Only the ROTATION belongs to this term: it indexes its own sequence
            // over its own count, and sharing one with the lamps or the ambient burst throws the
            // stratification of both away (see node_r4).
            const uint rot = node_hash_mix(slot * 0x9E3779B9u ^ 0x1B873593u);
            const uint rot2 = node_hash_mix(rot ^ 0xCC9E2D51u);
            g_sky_rotation = vec4(float(rot & 0xFFFFu), float((rot >> 16) & 0xFFFFu),
                                  float(rot2 & 0xFFFFu), float((rot2 >> 16) & 0xFFFFu)) / 65536.0;
            // Round-robin over the bins by sample index, so all sixty-four are served evenly. A
            // random bin per ray leaves gaps that last hundreds of frames and shows as a reflection
            // with holes in it that fill in one patch at a time.
            for (uint i = 0u; i < kLobeBurst; ++i) {
                const uint index = taken + i;
                lobe_cast(lobe, index % lobe_bins, lobe_bins, lobe_side, index / lobe_bins,
                          pixel_angle, corner, across, down, size, chunk_origin);
            }
            face_lobe.words[count_at] = taken + kLobeBurst;
        } else if (probe_denoise() &&
                   (face_lobe.words[face_lobe_state_at(lobe)] & kLobeFiltered) == 0u) {
            // ---- R5: and on the one visit after it finishes, it compares notes ----------------
            //
            // On the visit AFTER the burst rather than on the last visit of it, so that the bins
            // being blended are the ones this face finished with. It is one visit of latency on a
            // quantity that has stopped moving.
            //
            // Under `--no-face-denoise` with the rest of the cross-face filter, because it is the
            // same idea about the same geometry and a dial that switched one on and the other off
            // would be two names for one question.
            face_lobe_denoise(lobe, lobe_bins, ivec3(face.x, face.y, face.z), level, direction);
        }
    }

    // ---- and what this face's neighbours make of the same two questions ------------------------
    //
    // R5a, and it is HERE rather than at the end of the pass for a reason that is about the shape of
    // this function rather than about the filter: the ambient block below returns early in four
    // places, and a filter placed after any of them would silently stop running for exactly the
    // faces that had converged -- which is every face on a settled camera, and trap 7's shape in a
    // denoiser. Above them it runs on every invocation that gets this far, which is every on-screen
    // face at least once per `face_stride`.
    //
    // What that costs is one visit of latency: it filters the record as this face left it last time
    // rather than as it will leave it in a moment. On a quantity that takes hundreds of frames to
    // move, that is nothing, and it buys the guarantee that a converged face's filtered answer keeps
    // being refreshed as its neighbours converge around it.
    //
    // It is placed after the reset and seed block deliberately: a slot the store has just handed out
    // has had its words zeroed and re-seeded from its ancestor by then, so the very first invocation
    // of a new face writes a filtered answer rather than leaving four words of the previous
    // occupant's light for the composite to read.
    // ---- R9f's fold, before the filter reads the record ---------------------------------------
    //
    // Above `face_denoise` because the filter is a display of an estimate and this CHANGES the
    // estimate: folding after it would leave the composite reading a blend of the old answer for a
    // visit. Below the reset and seed for the same reason those are below each other -- a slot just
    // handed out has been zeroed, and folding into words that are about to be overwritten is a
    // write nobody reads.
    //
    // The face is NOT marked finished when it folds, and that was tried. Marking it stops it being
    // visited, which stops it folding again -- so it freezes on whatever its children happened to
    // hold the first time, which is the state that measured as worth nothing. It keeps what it
    // folded when the children are evicted anyway, because nothing overwrites it: that is R9f's
    // outlive half doing exactly what it was built for, without a flag.
    face_fold(slot, light_at, ivec3(face.x, face.y, face.z), level, direction);
    face_denoise(light_at, ivec3(face.x, face.y, face.z), level, direction);

    // A finished face touches NONE of this, and the flag that says so is the one already in hand.
    //
    // This gate is worth 0.89 ms a frame on the facility and it was measured rather than reasoned
    // about, because the first version of this block did the arithmetic below unconditionally and
    // wrote word 8 back at the end of it. That is a scattered four-byte read and a scattered
    // four-byte write per face per visit across half a million faces, on a term whose answer had
    // stopped changing -- and it read as 3.02 ms against a control's 2.13 with `lamps on the card:
    // 498,404 of 498,440 cast no more rays at all` printed beside it. Thirty-six faces were casting
    // rays and the other half million were paying for the bookkeeping that said they were not.
    //
    // kFaceAmbientDone's comment makes exactly this argument and this block did not follow it: the
    // flag lives in `photons` PRECISELY so that a converged face never reaches the face light at
    // all. `lamp_idle` already folds in the two things that reopen a face -- the host's one-frame
    // announcement and an edit -- so there is nothing left for the record to say.
    if (!lamp_idle) {
        uint lamp_word = face_light.words[light_at + 8u];
        uint lamp_n = lamp_word & 0xFFFFu;
        const uint now_version = node_push.light_version & 0xFFFFu;
        vec3 lamp_sum = vec3(uintBitsToFloat(face_light.words[light_at + 5u]),
                             uintBitsToFloat(face_light.words[light_at + 6u]),
                             uintBitsToFloat(face_light.words[light_at + 7u]));

        // A lamp was placed, deleted, moved or dimmed. Everything measured under the old list is a
        // measurement of a world that no longer exists.
        if (((lamp_word >> 16) & 0xFFFFu) != now_version) {
            if (node_push.light_count == 0u) {
                // The last lamp in the scene went out. There is no prior worth keeping and nothing
                // left to measure, so this is the one case that goes straight to nought -- and it
                // has to, or a deleted lamp would go on lighting the room out of a stale mean.
                lamp_sum = vec3(0.0);
                lamp_n = 0u;
            } else if (lamp_n > kLampSeedSamples) {
                lamp_sum *= float(kLampSeedSamples) / float(lamp_n);
                lamp_n = kLampSeedSamples;
            }
            faces.items[slot].photons &= ~kFaceLampIdle;
        }

        // A stand-in the card claimed for itself cannot accumulate -- its record is rewritten on
        // every frame it is needed -- so it takes a fresh burst and reads it back the same frame.
        // That is what stops newly revealed geometry in a lamp-lit room from reading black while
        // its own faces converge, which is R9d's flash with the sign reversed.
        if (provisional_face) {
            lamp_sum = vec3(0.0);
            lamp_n = 0u;
        }

        // Held one short of converged because the last ray was stopped by a cell the world claims
        // and the pool has not built. That is a measurement of the tree, not of the light, and the
        // pool may build what it was guessing about -- so the face comes back, at ONE ray a visit
        // rather than a burst, which is the bound the ambient hold is built on for the same reason.
        const bool lamp_held = lamp_n == kLampConverged - 1u;
        const bool lamp_done = node_push.light_count == 0u || lamp_n >= kLampConverged;
        // ...and nothing at all for a face no pixel has read. The bookkeeping above it still runs,
        // so a face reopened by a lamp change while it was off screen has already dropped its
        // confidence and cleared its idle bit, and takes its burst on the frame it is next seen.
        const uint lamp_burst =
            !may_cast ? 0u : (lamp_done ? 0u : (lamp_held ? (sun_due ? 1u : 0u) : kLampBurst));

        if (lamp_burst > 0u) {
            // A rotation fixed for the life of the face and NOT including the frame: the samples
            // have to be one sequence for the stratification to be worth anything, and a rotation
            // that changes every visit throws it away. See node_r4.
            const uint rot = node_hash_mix(slot * 0x9E3779B9u ^ 0x7FEB352Du);
            const uint rot2 = node_hash_mix(rot ^ 0x846CA68Bu);
            g_sky_rotation = vec4(float(rot & 0xFFFFu), float((rot >> 16) & 0xFFFFu),
                                  float(rot2 & 0xFFFFu), float((rot2 >> 16) & 0xFFFFu)) / 65536.0;
            g_lamp_state = node_hash_mix((slot ^ node_push.frame) * 0x9E3779B9u + lamp_n);

            bool ignorance = false;
            uint lamp_dir = face_light.words[light_at + kFaceLampDir];
            for (uint i = 0u; i < lamp_burst; ++i) {
                bool unknown = false;
                vec3 to_lamp = vec3(0.0);
                const vec3 delivered = lamp_cast(lamp_n + i, unknown, to_lamp);
                lamp_sum += delivered;
                ignorance = ignorance || unknown;

                // ...and which way it came from, as a running mean weighted by what it delivered.
                // The weight is the luminance the record already carries, so this accumulates
                // nothing of its own -- see kFaceLampDir.
                const float brought = lamp_luminance(delivered);
                if (brought > 0.0) {
                    const vec3 had = face_oct_known(lamp_dir) ? face_oct_unpack(lamp_dir) : to_lamp;
                    const float held = max(lamp_luminance(lamp_sum) - brought, 0.0);
                    lamp_dir = face_oct_pack(
                        normalize(mix(had, to_lamp, brought / max(held + brought, 1e-6))));
                }
            }
            face_light.words[light_at + kFaceLampDir] = lamp_dir;
            lamp_n += lamp_burst;
            if (ignorance) lamp_n = min(lamp_n, kLampConverged - 1u);

            face_light.words[light_at + 5u] = floatBitsToUint(lamp_sum.r);
            face_light.words[light_at + 6u] = floatBitsToUint(lamp_sum.g);
            face_light.words[light_at + 7u] = floatBitsToUint(lamp_sum.b);
        }
        face_light.words[light_at + 8u] = (lamp_n & 0xFFFFu) | (now_version << 16);

        // Converged, and therefore silent for the rest of this face's life. This is the line that
        // pays for everything above it: a scene whose lamps are not being touched costs nothing at
        // all here, and a scene with no lamps in it never casts a single ray.
        if (node_push.light_count == 0u || lamp_n >= kLampConverged) {
            faces.items[slot].photons |= kFaceLampIdle;
        }
    }

    // ---- ambient occlusion (R10) ------------------------------------------------------------
    //
    // The same integral as the sun over a different domain: same face, same one writer, same
    // counts, same accumulation. What is NOT the same is the schedule, and that is deliberate --
    // see kSkyBurst in node.glsl. The sun watches something that moves and must be re-measured for
    // ever; ambient occlusion is a function of geometry, so a face measures it hard, once, and then
    // stops. The rays it saves by stopping are the rays the burst is spent out of.
    //
    // `resolve.comp` applies an ambient term to every surface in the frame with no visibility in
    // it at all -- how much sky a surface sees, decided from which way it points and from nothing
    // else -- so a wall at the back of a corridor receives the whole dome and the interior is lit
    // as though the building were a cut-out standing in the open. This is not an effect being
    // added. It is the missing visibility on a term that is already being applied.
    //
    // The record is already in hand and already reset: `light_at`, its bounds check and everything
    // an edit or a re-claimed slot throws away are handled once, above the lamps, because the seed
    // writes to all three terms and had to run before any of them cast a ray.
    uint counts = face_light.words[light_at];
    uint near_n = counts & 0xFFFFu;
    uint far_n = (counts >> 16) & 0xFFFFu;

    // Converged, and therefore silent for the rest of this face's life.
    //
    // This is the line that pays for everything above it. Ambient occlusion is a function of
    // geometry; the host says on the exact frame when geometry changes (`edit_min.w == 2`, which
    // resets the record through `samples == 0` above), and a face whose slot is re-claimed is
    // zeroed by the same path. So there is nothing left for a ray to discover here, and every ray
    // this used to cast was re-measuring a constant it already held -- one ray a visit, per face,
    // for the rest of the run.
    const bool near_done = near_n >= kSkyConverged;

    // The far field is finished when it has run out of variance, not when it has run out of a
    // budget. See kSkyFarMin: a face whose rays all agree has an error already at nought, and in
    // this building that is nearly every face.
    const uint far_open_now = face_light.words[light_at + 4u];
    const float far_p = far_n > 0u ? float(far_open_now) / float(far_n) : 1.0;
    // ...and the floor the BOUNCE puts under it, which is much higher and is not about the sky at
    // all. A sealed room's far field is unanimous after thirty-two rays and its bounce is thirty-two
    // samples of a colour, which is a mottle. See kBounceMin.
    const uint bounce_floor =
        node_push.bounce == 0u ? 0u
                               : (node_push.bounce_min != 0u ? node_push.bounce_min : kBounceMin);
    const bool far_settled = far_n >= max(kSkyFarMin, bounce_floor) &&
                             float(far_n) * kSkyFarEpsSq >= far_p * (1.0 - far_p);
    // ...and the cap the far field terminates on whatever it decides, which is the LARGER of the
    // sky's own and the bounce's floor.
    //
    // It used to be `kSkyFarConverged` flat, and that was right while the floor under it was 128:
    // the sky gave up at 256 and the bounce asked for less than that, so the cap bound only the face
    // that never made up its mind. With the floor at kBounceMin it binds every face, and a cap below
    // the floor is a floor that does not exist -- the face stops at 256 samples however many the
    // bounce was asking for, silently, and the only symptom is a term that stops short of its own
    // constant. `--no-bounce` leaves `bounce_floor` at nought and this at exactly what it was.
    const bool far_done = far_settled || far_n >= max(kSkyFarConverged, bounce_floor);

    // Nothing this face could do on a frame the sun is not due, which is five frames in six -- so
    // say so in the record and let those frames stop at the top.
    //
    // The test is NOT only "both fields have finished". The far field takes its one unbounded ray
    // on the sun's own schedule once it is past `kSkyFarEager`, so from that point a not-due frame
    // has nothing to do here whether the far field has finished or not, and it is the not-due
    // frames that are five sixths of the traffic. Waiting for full convergence to set this left
    // 415,000 faces a frame reading five words of face light to conclude that they had no work.
    if (near_done && (far_done || far_n >= kSkyFarEager)) {
        faces.items[slot].photons |= kFaceAmbientIdle;
    }

    if (near_done && far_done) {
        faces.items[slot].photons |= kFaceAmbientDone;
        return;
    }

    // Held one short of converged because the last burst was measuring IGNORANCE rather than
    // geometry: `occlude_unknown` counts a cell the world says is occupied and the pool has not
    // built as matter, which is correct for a picture and is not a fact about the world. Such a
    // face has to come back and look again, because the pool may build what it was guessing about.
    //
    // It comes back at the SUN's rate and with one BOUNDED ray, which is strictly less than the one
    // unbounded ray a visit this pass used to cast, and that bound is the whole design of the hold.
    // Retrying every frame instead was measured: pixel-driven residency means a hemisphere of rays
    // meets unbuilt cells somewhere almost everywhere indoors, so a large share of the store sits
    // held for ever -- and at one ray a FRAME rather than one a visit that is six times the ambient
    // traffic of the build this replaces, which showed up as the pass costing 2.16 ms against 1.75
    // at frame 1,200 with every face long since converged. A fallback that never resolves must cost
    // less than the thing it is a fallback for, or it is the steady state.
    const bool held = near_n == kSkyConverged - 1u;

    // Cosine-weighted about the normal, which is the weighting the integral carries, so every ray
    // counts the same and the average IS the answer. Malley's method: a disc sampled uniformly and
    // lifted onto the hemisphere.
    //
    // Stratified over the face's OWN samples, not random per frame. Each face used to draw fresh
    // white-noise numbers every time it was shaded, so its samples were independent draws and the
    // error fell as one over the square root of them. They are one sequence instead, indexed by how
    // many samples this face has already taken, which spreads them evenly rather than in clumps and
    // gaps. Same ray, same cost, less variance.
    //
    // Rotated by a per-FACE constant, and the constant must not include the frame. Without the
    // rotation every face walks the identical sequence and their errors line up into something
    // structured, which is worse than noise because the eye finds it. With the frame in it the
    // rotation changes every sample and the stratification is thrown away again -- the sequence
    // has to be a sequence, so the offset is fixed for the life of the face.
    // The rest of the face's frame is set once for the whole pass, above the lamps. Only the
    // rotation belongs to this term: it indexes a different sequence, over a different count, and
    // the lamp burst above may have written its own into the same global.
    const uint sky_rot = node_hash_mix(slot * 0x9E3779B9u ^ 0xC2B2AE35u);
    const uint sky_rot2 = node_hash_mix(sky_rot ^ 0x27D4EB2Fu);
    g_sky_rotation = vec4(float(sky_rot & 0xFFFFu), float((sky_rot >> 16) & 0xFFFFu),
                          float(sky_rot2 & 0xFFFFu), float((sky_rot2 >> 16) & 0xFFFFu)) / 65536.0;

    // How many rays this visit, and of which kind.
    //
    // The near field takes a burst of BOUNDED rays and takes it every frame, because a bounded ray
    // is cheap and because the near field is the term that carries every crease in the building.
    // The far field takes at most one UNBOUNDED ray and takes it on the sun's own schedule once it
    // has the coarse shape -- so the count of expensive rays this pass casts is what it always was,
    // and then falls to nothing. `kSkyFarEager` is the exception: the first sixty-four far samples
    // are worth more than all the rest put together, since they are what moves `open_sky` off its
    // starting value at all.
    //
    // A stand-in the card claimed for itself is the exception, and it takes the one unbounded ray
    // this pass has always cast and nothing else. Its record is zeroed again on the next frame it
    // is needed -- `node_face_claim` re-takes the bucket and `visibility.comp` rewrites the
    // record -- so it can never accumulate, and thirty-two rays into a record that is discarded
    // before it is read again is the one place a burst buys strictly nothing. Missing this is what
    // would have made the cheapest faces in the frame the most expensive.
    const uint burst =
        (provisional_face || !may_cast)
            ? 0u
            : (near_n >= kSkyConverged ? 0u : (held ? (sun_due ? 1u : 0u) : kSkyBurst));
    // The far ray, and how often it is owed.
    //
    // It used to be "on the sun's schedule once past `kSkyFarEager`", because the only thing it
    // answered was a proportion that had already stopped moving. It answers the BOUNCE now, which
    // needs `kBounceMin` samples rather than thirty-two — and one ray every `face_stride` frames is
    // **thirteen seconds** of a room visibly filling with light at the enclosed camera. The same
    // argument D394 settled for the near field applies here and it is the whole reason the burst
    // exists: what this pass spends on an unconverged face is mostly the FACE, not the ray, so the
    // cheapest thing to do with a face that has to measure is to let it measure and be finished.
    //
    // ...and the answer is that `kSkyFarEager` was already the right rule and did not need changing.
    //
    // The first thirty-two samples come every visit and the rest ride the sun's schedule, which is
    // what that constant has always said. Extending the eager phase to the whole of `kBounceMin` was
    // tried first, because a bounce that takes thirteen seconds to arrive is not a bounce anybody
    // will see: it converges in about two seconds instead, and it costs **the faces pass 2.2 → 4.6
    // ms while flying**, which is over its 4.40 ms budget for the first time since D416. It is not
    // needed, because `kBounceBelieve` in the composite is thirty-two — the face is believed
    // outright at the end of the eager phase, and the samples after it only take noise out. Fast to
    // right, slow to quiet, and the expensive half is the one nobody is waiting on.
    const bool far_due =
        may_cast && (provisional_face || (!far_done && (sun_due || far_n < kSkyFarEager)));
    if (burst == 0u && !far_due) return;

    uint near_sum = face_light.words[light_at + 1u];
    int grad_u = int(face_light.words[light_at + 2u]);
    int grad_w = int(face_light.words[light_at + 3u]);
    uint far_open = face_light.words[light_at + 4u];
    vec3 bounce_mean = vec3(uintBitsToFloat(face_light.words[light_at + 9u]),
                            uintBitsToFloat(face_light.words[light_at + 10u]),
                            uintBitsToFloat(face_light.words[light_at + 11u]));
    bool measured_ignorance = false;

    // The bounded burst, and it is a loop the far ray is deliberately NOT part of.
    //
    // Folding the two into one loop over `burst + 1` reads better and measured worse: the far ray
    // then sits inside a loop with a run-time trip count, the compiler cannot straighten it, and
    // the register pressure of holding the loop state across a full march costs the pass about
    // 0.4 ms on frames where the burst is empty and the far ray is all there is -- which is most
    // frames, for the whole life of the build. Two shapes of ray, two pieces of control flow, one
    // body (`sky_cast`), and the body is where the drift would have been.
    // The bounded rays never name a face, and that is a rule and not a saving. A near ray stops
    // after a metre, so the faces it lands on are the ones under this face's own nose -- the crease
    // it is standing in -- and they are on screen already if anything is. What the off-screen set is
    // short of is the far half of the room, which is exactly what the unbounded ray finds.
    g_sky_report_face = false;
    g_sky_gather = false;
    for (uint i = 0u; i < burst; ++i) {
        const SkySample s = sky_cast(near_n, kContactVoxels);
        if (s.unknown) measured_ignorance = true;
        sky_accumulate(s, near_n, near_sum, grad_u, grad_w);
    }

    // And the one unbounded ray, which is a near ray that keeps going: it feeds BOTH counts, so the
    // near field gets a sample for nothing and the two fields can never disagree about what a ray
    // in that direction found.
    if (far_due) {
        // ...and this is the one ray in the renderer that may add to the face set. R9a.
        //
        // The throttle is a phase on the SLOT as well as a period, so the store's half a million
        // faces do not all become due on the same frame -- which is D431's fault exactly, and its
        // consequence is not a slow frame but a feedback buffer that overflows and drops the
        // streaming reports sharing it. A period rather than a switch: it is the whole trade this
        // rule makes, and `--secondary-period N` sweeps it. A power of two, as the other two periods
        // in this push block are, so the phase is a mask.
        //
        // It costs nothing when the far field has finished, because this ray is not cast then.
        g_sky_report_face =
            node_push.secondary_period != 0u && !provisional_face &&
            ((node_push.frame + slot) & (node_push.secondary_period - 1u)) == 0u;
        g_sky_gather = node_push.bounce != 0u;
        const SkySample s = sky_cast(near_n, kNodeUnbounded);
        g_sky_report_face = false;
        g_sky_gather = false;
        if (s.unknown) measured_ignorance = true;
        sky_accumulate(s, near_n, near_sum, grad_u, grad_w);
        far_n += 1u;
        far_open += s.sky ? 1u : 0u;
        // The same ray's other answer, folded into a mean that FORGETS. One ray, two questions, one
        // count -- and the count is used differently by each because the two questions are different
        // shapes: how much sky this face can see is a constant, so `far_open` is divided by the whole
        // of it; what the room is giving off is still climbing while every other face measures its
        // own, so the bounce averages only the most recent `kBounceMemory` of it.
        //
        // Written as an incremental mean rather than as a sum and a divide because a sum has nowhere
        // to put the forgetting: the update below is what makes the memory finite, and it is one
        // multiply-add. `min` rather than a branch. `bounce_memory` of 0 means the constant, as
        // `bounce_min` beside it does; the CONTROL ARM is a memory larger than `far_n` can ever
        // reach, which is the cumulative mean exactly rather than an approximation of it --
        // `--bounce-memory 4096`.
        const uint memory = node_push.bounce_memory != 0u ? node_push.bounce_memory : kBounceMemory;
        bounce_mean += (s.radiance - bounce_mean) / float(min(far_n, memory));

        // ...and the same ray's third answer, which is the one R4c is: not how much light came
        // back, but WHICH WAY it came from. One sample, sixteen weights, no extra ray. See
        // face_lobe_accumulate.
        //
        // Gated on the block and not on the material, because the material is what decided the
        // block: a face that asked and was declined has nowhere to put this and reads the
        // hemispherical mean above instead, which is the same lobe with one bin in it.
        // ...and the far ray's own contribution to the bins, which is now the CONTROL ARM and not
        // the mechanism.
        //
        // It was how the bins were filled in R4c, and D592 is the measurement that it cannot carry
        // a reflection: a cosine-weighted ray puts a sixth of its density where a reflection is
        // read from. With R4b's ray in, this is a hundred and twenty-eight GGX evaluations per far
        // ray to add one badly aimed sample to sixty-four bins — so it runs only in the arm where
        // the ray does not, which keeps `--no-lobe-ray` meaning "the bins as R4c filled them"
        // rather than "no bins at all", and takes its cost out of the shipped path entirely.
        if (lobe != kNoLobe && node_push.bounce != 0u && !probe_lobe_ray()) {
            face_lobe_accumulate(lobe, lobe_bins, lobe_side, s.dir, s.radiance);
        }
    }

    // A burst that was stopped by geometry the pool has not built has not measured this face; it
    // has measured how much of the tree is missing. Hold it one short of converged so it comes back
    // -- at one ray a visit, since it is the mean that is suspect and not the sample count.
    //
    // The counts used to halve at a window instead, so that a face could forget. Nothing here needs
    // to forget any more: an edit is announced and resets the record outright, and the only other
    // thing that can change the answer is the pool building or shedding what this ray crossed,
    // which is what the hold is for. A window that never fires is a branch that can only be wrong.
    if (measured_ignorance) near_n = min(near_n, kSkyConverged - 1u);

    face_light.words[light_at] = (near_n & 0xFFFFu) | ((far_n & 0xFFFFu) << 16);
    face_light.words[light_at + 1u] = near_sum;
    // Written back as unsigned and read back as signed: a corner's gradient is negative on one side
    // of the face, and the bit pattern is what carries it.
    face_light.words[light_at + 2u] = uint(grad_u);
    face_light.words[light_at + 3u] = uint(grad_w);
    face_light.words[light_at + 4u] = far_open;
    face_light.words[light_at + 9u] = floatBitsToUint(bounce_mean.r);
    face_light.words[light_at + 10u] = floatBitsToUint(bounce_mean.g);
    face_light.words[light_at + 11u] = floatBitsToUint(bounce_mean.b);
}
