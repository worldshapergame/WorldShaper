#version 450
// Primary visibility. The traversal itself lives in world.glsl, shared with the path tracer.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba32ui) uniform writeonly uimage2D out_visibility;
layout(binding = 1, r32f) uniform writeonly image2D out_depth;

#include "world.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(push.resolution.x) || pixel.y >= int(push.resolution.y)) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(push.resolution) * 2.0 - 1.0;
    float aspect = float(push.resolution.x) / float(push.resolution.y);
    vec3 dir = normalize(push.forward.xyz +
                         push.right.xyz * uv.x * push.lens.x * aspect -
                         push.up.xyz * uv.y * push.lens.x);

    // Voxels a pixel spans per unit of distance.
    float pixel_angle = 2.0 * push.lens.x / float(push.resolution.y);

    // One pixel in sixteen reports what it could not find. That is dense enough that no
    // chunk large enough to matter is missed, and sparse enough that the atomic is not a
    // bottleneck.
    // One pixel in sixty-four reports what it could not find. At one in sixteen the buffer
    // overflowed by 70% on a 800x600 frame â€” and the extra reports say nothing new, since
    // neighbouring rays want the same chunks. Anything large enough to matter still covers
    // many sample points.
    const bool report = ((pixel.x & 7) == 0) && ((pixel.y & 7) == 0);

    Hit hit = march(push.origin.xyz, dir, pixel_angle, bayer(pixel), report);

    // Packed visibility. Stage 7 reads this instead of a colour: the face cache is keyed
    // by (node, level, face), which is exactly what is stored here.
    uvec4 packed = uvec4(0xFFFFFFFFu, 0u, 0u, floatBitsToUint(hit.t));
    if (hit.hit) {
        uint face = 0u;
        if (hit.normal.x != 0) face = (hit.normal.x > 0) ? 0u : 1u;
        else if (hit.normal.y != 0) face = (hit.normal.y > 0) ? 2u : 3u;
        else face = (hit.normal.z > 0) ? 4u : 5u;
        // How much of the cell that was hit is actually matter. A voxel is all of it; a
        // coarse node carries its filtered coverage in the alpha of its colour. This is
        // what lets resolve soften a silhouette that is finer than a pixel instead of
        // drawing a hard stair-step.
        uint coverage = (hit.level == 0) ? 255u : ((hit.colour >> 24u) & 0xFFu);
        packed.x = face | (uint(hit.level) << 8u) | (min(hit.steps, 255u) << 16u) |
                   (coverage << 24u);
        packed.y = hit.type_id;
        packed.z = hit.colour;
    } else {
        packed.x = 0xFFFFFFFFu;
        packed.z = min(hit.steps, 255u);
    }

    imageStore(out_visibility, pixel, packed);
    imageStore(out_depth, pixel, vec4(hit.hit ? hit.t : push.lens.y, 0, 0, 0));
}
