#version 450
// Primary visibility against the node pool.
//
// The same pass shaders/visibility.comp performs, walking one sparse octree instead of four
// addressing schemes. It exists beside the old one rather than replacing it so the two can be
// rendered from the same camera and diffed: R1's claim is that the picture does not change and
// the cost falls, and both halves of that need measuring rather than asserting.
//
// The visibility buffer it writes is byte-for-byte the old format, so shaders/resolve.comp reads
// it unchanged.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba32ui) uniform writeonly uimage2D out_visibility;
layout(binding = 1, r32f) uniform writeonly image2D out_depth;

// Which face store slot this pixel's surface lives in, or kNoFace.
//
// Resolved here rather than in the composite because the key is already in hand: the marcher
// descended to that node and knows its coordinate, its level and the direction it was hit from.
// Making the composite rebuild the key from a depth and a normal would be a second piece of code
// that has to agree with this one about which face a pixel is on, and the two would eventually
// not -- which is the fault D133 and D147 both describe, arriving through a third door.
//
// One word a pixel. The alternative is carrying the whole key in the visibility buffer, which is
// four, and at 4K that is 265 MB a frame of extra traffic for something a single probe answers.
layout(binding = 11, r32ui) uniform writeonly uimage2D out_face;

// R4d's second layer: what the primary ray reached AFTER the glass let it past, packed the way
// this pass packs the surface in front of it and zero everywhere the ray met no glass at all.
//
// Sixteen bytes a pixel, and the reason it is worth them is that the alternative is worse in both
// directions: shading the far surface here would need the whole composite in this pass, and
// marching for it in the composite would need the whole node pool bound there. This carries the
// ANSWER across instead of the machinery. See resolve.comp for the unpacking.
layout(binding = 26, rgba32ui) uniform writeonly uimage2D out_behind;

// R7a: how far this pixel's tile may begin, one texel per tile CORNER. Written by shaders/beam.comp
// and read here by the four corners of the tile the pixel is in. See beam.glsl for why four corners
// is enough and shaders/beam.comp for what the number is.
layout(binding = 27, r32f) uniform readonly image2D in_beam;

#include "node.glsl"
#include "beam.glsl"

// The distance this pixel's ray is allowed to start at, in voxels from the eye.
//
// The smallest of the four corners of the pixel's own tile, and it has to be the smallest: a corner
// answer bounds only the rays that are on it, and the tile is bounded by whichever of its corners
// found something first. Taking anything but the minimum -- an average, a nearest, a bilinear tap --
// is a start past a surface for the pixels on the other side of the tile, which is a hole.
//
// Four loads of a texel that sixty-four pixels in the same tile all read, out of an image a
// sixty-fourth of the screen. It is in cache by the second pixel of the tile.
float beam_start_for(ivec2 pixel) {
    if (!beam_enabled()) return 0.0;
    const ivec2 tile = pixel >> 3;             // kBeamTile is 8; the shift is the divide
    const ivec2 last = beam_corners() - ivec2(1);
    const ivec2 a = clamp(tile, ivec2(0), last);
    const ivec2 b = clamp(tile + ivec2(1), ivec2(0), last);
    float start = imageLoad(in_beam, ivec2(a.x, a.y)).x;
    start = min(start, imageLoad(in_beam, ivec2(b.x, a.y)).x);
    start = min(start, imageLoad(in_beam, ivec2(a.x, b.y)).x);
    start = min(start, imageLoad(in_beam, ivec2(b.x, b.y)).x);
    return max(start, 0.0);
}

// The slot, looked up once, so every pixel on a face reads the same light -- or the slot of the
// coarse face standing in for it while it catches up. kNoFace if there is nothing to read.
//
// A face that has not been claimed yet and a face that has been claimed but not yet shaded are
// the same thing to the composite: both send it to its fallback, and its fallback is full sun.
// Indoors that is the most wrong answer available, and it is what a player sees as unshadowed
// patches behind things after the camera moves, filling in over the next second. The wait is
// real and it is structural: a face is claimed only when a primary ray lands on it, at one
// pixel in sixty-four, so a surface that was hidden and is now visible waits for the sampling
// lattice to reach its particular pixel, then two frames for the claim, then four samples.
//
// The stand-in three levels up does not wait, because five hundred and twelve faces share it
// and it covers about sixty-four times the screen area, so the lattice cannot miss it: it is
// claimed the frame the region appears and settled a few frames later. Reading it gives a
// blocky shadow that sharpens, rather than no shadow that appears. R9d; R2d says the same thing
// about colour, and this is that rule applied to light.
//
// Both halves are gated on being ANSWERABLE rather than merely present -- if the stand-in has
// not settled either, the fine face is kept, since the composite treats them identically and
// the fine one is the one that will settle first from here.
//
// The cost is one extra probe on a pixel whose own face is not ready, and that set empties as
// the store fills in. The sample count is read out of the record `node_face_lookup` has already
// loaded to compare the key against, so it costs no traffic of its own.
//
// A function rather than inline code because R4d asks the same question twice a pixel -- once of
// the window and once of whatever is behind it -- and two copies of this would eventually
// disagree about which face a pixel is on, which is the fault D133 describes.
uint visibility_face_slot(ivec3 face_node, uint face_level, uint face_dir) {
    uint face_slot = node_face_lookup(face_node, face_level, face_dir);
    // A pixel is reading this face, so it is worth lighting. Stamped whether or not the
    // composite ends up USING it: a face that is not answerable yet is precisely the one that
    // has to keep casting rays, and gating the stamp on answerability would be a face that can
    // never become answerable because it is never lit because it is not answerable.
    node_face_seen(face_slot);
    // ...and tell the HOST, at most once per face per window, because the store's residency
    // clock only ever heard from the request lattice and that is not what a screen is. See
    // node_face_report_read.
    node_face_report_read(face_slot);
    bool answerable = face_slot != kNoFace &&
                      face_samples_of(faces.items[face_slot].counters) >= kFaceSettled;
    if (answerable) return face_slot;

    const ivec3 coarse = ivec3(face_node.x >> kFaceAncestorStep, face_node.y >> kFaceAncestorStep,
                               face_node.z >> kFaceAncestorStep);
    const uint coarse_level = face_level + uint(kFaceAncestorStep);
    uint stand_in = node_face_lookup(coarse, coarse_level, face_dir);
    // And the coarse face standing over it, on the same argument. It is only looked up
    // when the fine face cannot answer, which is exactly when it is being read -- so a
    // stand-in whose children have all settled stops being stamped, stops casting, and
    // keeps the mean it had, which is all `face_light_seed` ever wanted of it.
    node_face_seen(stand_in);
    // The stand-in is being READ, so it is wanted, and a stand-in is claimed by the host
    // only once — when the face under it was new. Without this it is the one kind of face
    // whose residency clock never advances at all while it is on screen.
    node_face_report_read(stand_in);
    if (stand_in != kNoFace &&
        face_samples_of(faces.items[stand_in].counters) >= kFaceSettled) {
        return stand_in;
    }
    // Nothing in the store, so claim it here rather than waiting two frames for the
    // host to hear about it. R3e; see node_face_claim for why the claim is one atomic
    // and why the pixel that loses the race is served by the same one.
    //
    // The record is written by whichever pixel won. It is written HERE rather than in
    // the shading pass because the shading pass has no key to write -- and it is safe
    // to write from a pass that other pixels are still reading, because the only thing
    // they read of it this frame is the slot number, which the atomic gave them.
    bool claimed = false;
    const uint fresh = node_face_claim(coarse, coarse_level, face_dir, claimed);
    if (claimed) {
        faces.items[fresh].x = coarse.x;
        faces.items[fresh].y = coarse.y;
        faces.items[fresh].z = coarse.z;
        faces.items[fresh].packed = (coarse_level & 0xFFu) | (face_dir << 8) | (kFaceLive << 16);
        faces.items[fresh].counters = 0u;
        faces.items[fresh].irradiance = 0u;
        faces.items[fresh].photons = 0u;
        faces.items[fresh].bins = 0u;
    }
    return fresh != kNoFace ? fresh : face_slot;
}

// The second layer, written the way resolve.comp's `main` unpacks it.
//
// One function for R4d's glass and R5d's edge because the wire format is the same and the two
// halves live in different files: a second copy of this would eventually disagree with the reader
// about which bit means what, which is the fault D133 describes and is why `visibility_face_slot`
// above is a function too.
//
// `lets_past` is the share of this pixel that the FAR surface is responsible for, and `edge` says
// which of the two questions produced it -- a pane's transmission, which acts on the near surface's
// diffuse alone, or the share of the pixel the near surface does not occupy, which acts on all of
// it. The composite cannot tell those apart from the number, so it is told.
//
// `far_coverage` and `sky_beyond` are R5d's SECOND half and they are the whole of what the wire
// gained for it. 255 and false say "one layer behind this pixel and it is solid", which is what
// R4d's glass passes, what `--no-edge-layers` passes, and what every build before this packed --
// the composite's branch on them is then a no-op to the bit. Anything less than 255 with the flag
// set says the far surface is itself a part-covered coarse node with SKY beyond it, and the
// composite draws three layers. Nine bits of the thirteen `behind.z` had spare, against the sixteen
// bytes a third surface would have cost over the whole screen.
uvec4 visibility_pack_behind(NodeHit far, vec3 lets_past, bool edge, uint far_coverage,
                             bool sky_beyond) {
    uint far_slot = kNoFace;
    if (far.hit && far.face_level != kNoFaceLevel) {
        far_slot = visibility_face_slot(far.face_node, far.face_level, far.face_dir);
    }
    uint far_face = 0u;
    if (far.normal.x != 0) far_face = (far.normal.x > 0) ? 0u : 1u;
    else if (far.normal.y != 0) far_face = (far.normal.y > 0) ? 2u : 3u;
    else far_face = (far.normal.z > 0) ? 4u : 5u;
    // One payload field for two mutually exclusive readings, because the composite uses the type id
    // only at level 0 and the folded colour only above it. `type_id` needs 21 bits
    // (type_tables.hpp's kMaxTables is 2^21) and the colour needs 24, so 24 is the field and neither
    // is ever truncated.
    const uint payload = far.level == 0 ? min(far.type_id, 0xFFFFFFu) : (far.colour & 0xFFFFFFu);
    const uvec3 quantised = uvec3(round(clamp(lets_past, 0.0, 1.0) * 255.0));
    uvec4 behind;
    behind.x = min(far_slot, 0xFFFFFFu) | (far_face << 24u) | (uint(far.level) << 27u);
    behind.y = payload | (quantised.r << 24u);
    // Bit 17 says there IS a second layer, rather than leaving the composite to infer it from a
    // non-zero `through`: a transmission that quantises to zero in all three channels is vanishingly
    // rare but it is not impossible, and "no window here" and "a window that lets nothing past" want
    // the same answer by luck rather than by construction. Bit 16 says the far ray landed on
    // something rather than on sky. Bit 18 says which of the two stages asked.
    behind.z = quantised.g | (quantised.b << 8u) | (far.hit ? (1u << 16u) : 0u) | (1u << 17u) |
               (edge ? (1u << 18u) : 0u) | (min(far_coverage, 255u) << 19u) |
               (sky_beyond ? (1u << 27u) : 0u);
    behind.w = floatBitsToUint(far.hit ? far.t : push.lens.y);
    return behind;
}

void main() {
    // ---- R9c: the dispatch is the screen plus a margin, and the margin is not the screen --------
    //
    // The host sizes this dispatch to cover the screen grown by `probe_halo_margin()` pixels on
    // every side, so an invocation's coordinate is in EXTENDED space and the pixel is that minus the
    // margin. Standing still the margin is nought, the subtraction is nought, and this is exactly
    // the dispatch it has always been -- which is what makes the settled grid unable to see this
    // stage at all, correctly.
    //
    // A coordinate outside the screen is a real direction through the same lens: `uv` simply leaves
    // [-1, 1], which is a widened frustum and not a special case. What such an invocation does is
    // claim the face it lands on and stamp it seen, so the light pass starts measuring it while it
    // is still off screen; it writes no image, reports no node, and asks the world for nothing.
    const int halo_margin = int(probe_halo_margin());
    const ivec2 extended = ivec2(gl_GlobalInvocationID.xy);
    ivec2 pixel = extended - ivec2(halo_margin);
    if (extended.x >= int(push.resolution.x) + 2 * halo_margin ||
        extended.y >= int(push.resolution.y) + 2 * halo_margin) {
        return;
    }
    const bool on_screen = pixel.x >= 0 && pixel.y >= 0 && pixel.x < int(push.resolution.x) &&
                           pixel.y < int(push.resolution.y);
    if (!on_screen) {
        // Sparse, because a halo is a claim and not a picture. One sample in `halo_stride` each way
        // names nearly every face out there for the same reason one pixel in sixteen does on screen
        // (D205): a frame holds far fewer faces than pixels and the duplicates are the overwhelming
        // majority. The invocations that fall between are a return, and the alternative -- packing
        // the ring into a compact dispatch of its own -- is a second pipeline and a second barrier.
        //
        // The test is on the EXTENDED coordinate, which is never negative. `%` on a negative int is
        // not something to find out about from a picture.
        const int halo_stride = int(probe_halo_stride());
        if ((extended.x % halo_stride) != 0 || (extended.y % halo_stride) != 0) return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(push.resolution) * 2.0 - 1.0;
    float aspect = float(push.resolution.x) / float(push.resolution.y);
    vec3 dir = normalize(push.forward.xyz +
                         push.right.xyz * uv.x * push.lens.x * aspect -
                         push.up.xyz * uv.y * push.lens.x);

    // Voxels a pixel spans per unit of distance.
    float pixel_angle = 2.0 * push.lens.x / float(push.resolution.y);

    // One pixel in four, where the chunk marcher reported one in sixty-four.
    //
    // The sampling rate has to follow the unit being reported, and the unit changed. A chunk is
    // eight metres, so neighbouring rays wanted the same one and a sparse sample missed nothing.
    // A node at the level a pixel resolves is a brick - twenty-five centimetres, under two pixels
    // across at sixty metres - so one report in sixty-four asks for one path in sixty-four and
    // the other sixty-three are never built. Measured: the tree converged at 765 leaves for a
    // building needing hundreds of thousands, then went quiet, because the pixels that would have
    // asked for the rest were not allowed to speak.
    //
    // It costs nothing at rest: a report only happens on a miss, and misses go to zero as the
    // tree fills in.
    const bool report = ((pixel.x & 1) == 0) && ((pixel.y & 1) == 0);

    // One pixel in 256 says which root it read. Eviction releases a root with its whole subtree,
    // and a 512 m root covers the entire scene here, so the useful information is a handful of
    // distinct values and every pixel would repeat them. This is enough by a wide margin.
    // One pixel in 64. It was one in 256 while this only had to name the root a ray entered,
    // where a handful of distinct values repeat across the whole screen. Now it names the NODE,
    // and a node has to be read at least once inside cold_frames or it is dropped -- at one in
    // 256 a node covering a single pixel goes unsampled for 600 frames about one time in ten,
    // and the cost of being wrong is geometry that vanishes and comes back. At one in 64 it is
    // seven in a hundred thousand.
    //
    // Scaled with the resolution for the same reason the face stride is. A fixed one in sixty-four
    // is 129,600 reports at 4K, which very nearly fills the 131,072-entry buffer on its own and
    // then starves the face requests sharing it -- 94,905 dropped in a frame, measured. Aimed at
    // about sixteen thousand, which is far more than enough: a node has to be read once inside
    // `cold_frames`, and six hundred frames of sixteen thousand samples covers everything visible
    // many times over.
    uint used_stride = 8u;
    while ((push.resolution.x * push.resolution.y / (used_stride * used_stride)) > 16000u) {
        used_stride <<= 1u;
    }
    const uint used_mask = used_stride - 1u;
    const uvec2 used_phase = node_sample_phase(node_push.frame, used_stride);
    const bool report_used = (((uint(pixel.x) + used_phase.x) & used_mask) == 0u) &&
                             (((uint(pixel.y) + used_phase.y) & used_mask) == 0u);

    // One pixel in sixteen names the face it landed on.
    //
    // A face is what the light pass will shade, and the premise of the whole stage is that there
    // are far fewer of them than there are pixels: measured before any of it was built, a frame
    // holds 118,826 to 141,110 distinct faces while its pixel count goes up 8.1x (D205). So a
    // sparse sample names nearly all of them and the duplicates are the overwhelming majority.
    //
    // Sixteen rather than four because these share the feedback buffer with the node reports, and
    // its capacity is 131,072: one pixel in four at 1280x800 would be 256,000 requests and the
    // buffer would truncate, which costs convergence rather than correctness but silently.
    //
    // The stride follows the RESOLUTION, or the buffer truncates and the truncation looks like a
    // result. At a fixed one-in-sixteen, 4K asks for 518,400 faces against a capacity of 131,072,
    // so two thirds of them are dropped -- and the face pass then measures *faster* at 4K than at
    // 800p (0.038 ms against 0.195) purely because it was given a third of the work. That reads
    // exactly like the resolution independence this stage exists to demonstrate, which is the
    // worst way for a measurement to be wrong.
    //
    // A power of two so the test stays a mask. Aimed at about sixty thousand requests a frame,
    // which fits the buffer with room for the node reports beside it.
    uint pixels = push.resolution.x * push.resolution.y;
    uint stride = 4u;
    while ((pixels / (stride * stride)) > 60000u) stride <<= 1u;
    //
    // And the lattice MOVES, which is not a refinement of the sampling but the difference between
    // this converging and not. A fixed one-in-sixty-four grid does not sample one face in
    // sixty-four: it samples the same faces every frame and the other sixty-three never exist. At
    // this camera the store settled at 630 faces against about thirty thousand on screen, and
    // stayed there -- 278,195 claims of which 277,565 were for a face already claimed. Every
    // surface that happened to fall between the sample points was lit by the composite's fallback
    // forever, which looks like the face pass working on a few stripes of the building.
    //
    // Walking the phase visits every offset in stride^2 frames -- about a second at stride 8 --
    // and the store's cold window is 600, so nothing claimed goes stale waiting its turn.
    const uint face_mask = stride - 1u;
    const uvec2 face_phase = node_sample_phase(node_push.frame, stride);
    const bool report_face = (((uint(pixel.x) + face_phase.x) & face_mask) == 0u) &&
                             (((uint(pixel.y) + face_phase.y) & face_mask) == 0u);

    // ---- the halo's own ray, which ends here -----------------------------------------------
    //
    // Everything below this belongs to a pixel: a visibility word, a depth, a face slot image, a
    // stand-in claimed so the composite has something to read this frame. A halo sample has no
    // pixel and needs none of it. What it does is the two lines that make the light pass start
    // early -- name the face so the host claims it, and stamp it so `may_cast` is true.
    //
    // `report` and `report_used` are both OFF, deliberately, and that is the difference between a
    // margin and a wider screen. A halo ray that reported its misses would stream the world beside
    // the one you are looking at, which is unbounded in exactly the way this rewrite exists to
    // stop -- R9h's rule for light rays, arriving in the primary pass. So the halo claims faces out
    // of geometry the pool ALREADY holds, and where the pool holds nothing the halo finds nothing
    // and the face is claimed the ordinary way when a pixel lands on it.
    if (!on_screen) {
        // `see_through` is FALSE for the primary ray, and that is R4d's design rather than an
        // omission: a face is claimed where a pixel lands, so a window that a pixel passed through
        // would have no face, no light of its own and no reflection. See node_march.
        NodeHit halo = node_march(push.origin.xyz, dir, pixel_angle, node_bayer(pixel), false,
                                  false, true, true, false, kThroughStop, kNodeUnbounded, 0.0);
        if (halo.hit && halo.face_level != kNoFaceLevel) {
            node_face_seen(node_face_lookup(halo.face_node, halo.face_level, halo.face_dir));
        }
        return;
    }

    // ---- R7: and the only line of this pass that the whole stage is about ---------------------
    //
    // `start_t` rather than a moved origin, which is R5d's mechanism and node.glsl says at length
    // why it is not the same thing: the eye stays the origin, so the detail clock, the world clip,
    // the D156 nudge and the `t` that comes back are all still eye-relative and this pixel resolves
    // exactly the level it resolved before. Only the empty metres in front of it are not walked.
    //
    // Nought with `--no-beam`, which is this call byte for byte as it was.
    const float start_t = beam_start_for(pixel);
    NodeHit hit = node_march(push.origin.xyz, dir, pixel_angle, node_bayer(pixel), report,
                             report_used, report_face, true, false, kThroughStop, kNodeUnbounded,
                             start_t);

    uvec4 packed = uvec4(0xFFFFFFFFu, 0u, 0u, floatBitsToUint(hit.t));
    if (hit.hit) {
        uint face = 0u;
        if (hit.normal.x != 0) face = (hit.normal.x > 0) ? 0u : 1u;
        else if (hit.normal.y != 0) face = (hit.normal.y > 0) ? 2u : 3u;
        else face = (hit.normal.z > 0) ? 4u : 5u;
        // How much of the cell that was hit is actually matter. A voxel is all of it; a coarser
        // node carries its filtered coverage in the alpha of its colour.
        // From the node's own per-direction coverage, not from the alpha of its filtered colour.
        // See node_face_coverage: the alpha is a volumetric fill fraction and this is a projected
        // one, and only the second answers "how much of this pixel is matter".
        uint coverage = hit.coverage;
        packed.x = face | (uint(hit.level) << 8u) | (min(hit.steps, 255u) << 16u) |
                   (coverage << 24u);
        packed.y = hit.type_id;
        packed.z = hit.colour;
    } else {
        packed.x = 0xFFFFFFFFu;
        packed.z = min(hit.steps, 255u);
    }

    // The slot for the surface the pixel landed on. See visibility_face_slot for why it is resolved
    // here, why a coarse face stands in for one that has not settled, and what the stamps are for.
    uint face_slot = kNoFace;
    if (hit.hit && hit.face_level != kNoFaceLevel) {
        face_slot = visibility_face_slot(hit.face_node, hit.face_level, hit.face_dir);
    }
    imageStore(out_face, pixel, uvec4(face_slot, 0u, 0u, 0u));

    // ---- R4d: and what is behind it, when what it landed on was glass ---------------------------
    //
    // The primary march above stops on the pane, on purpose: a face is claimed where a pixel lands,
    // so a window a ray passed straight through would have no face, no light of its own and no
    // reflection in it. What it does not do is answer the other half of the question, which is what
    // a player actually looks at a window FOR. So the ray is cast again from the same eye, this time
    // with `see_through` on, and the far surface is packed beside the near one for the composite to
    // blend. Two marches through the same first metres is the price; only glass pixels pay it.
    //
    // Gated on the near hit being a LEAF, because node.glsl's see-through branch is gated on
    // `level == 0` -- a coarse hit does not transmit, so the second march would return the same
    // surface with nothing taken out of it and the composite would draw it twice at full strength.
    // What a coarse hit wants instead is R5d, in the `else` below, and the two are exclusive by that
    // same test rather than by agreement between two conditions.
    //
    // The `through` that comes back is the whole path's attenuation, not the material's, so the two
    // halves are exactly complementary: the composite scales the pane's diffuse by (1 - through)
    // and the far surface by `through`, and they sum to one. If the ray hit a second pane the
    // product covers both. If it dies inside thick glass, `through` is by then under the marcher's
    // own 0.02 continuation floor, so what is packed is weighted at 2% and the error is smaller
    // than the byte it is quantised into -- deliberately not branched on.
    uvec4 behind = uvec4(0u);
    if (hit.hit && hit.level == 0 && probe_see_through()) {
        const vec3 medium = node_medium_through(hit.type_id);
        if (medium.r + medium.g + medium.b > 0.0) {
            // ---- R4d's other half: the ray BENDS, twice ---------------------------------------
            //
            // The march above answers "what is behind the pane", drawn exactly where it would be if
            // the pane were not there. That is a hole in the wall, not a window: the whole of what
            // glass and water look like is that they put what is behind them somewhere else.
            //
            // So three segments instead of one. Into the medium at the face the pixel landed on,
            // through it to the face where it comes out -- which is what `kThroughExit` is for --
            // and on from there in the direction the second interface bends it to. Two interfaces
            // rather than one because a pane refracts twice and the second undoes most of the
            // first: a flat pane seen square on displaces nothing, seen at an angle it slides what
            // is behind it sideways, and that behaviour falls out of doing both rather than being
            // tuned in. A water surface is the case where they do not cancel, because the second
            // interface is the opaque bottom and the ray never reaches it -- which is why a basin
            // reads as shallower than it is, exactly as a real one does.
            //
            // What is deliberately NOT here: dispersion. It needs a march per wavelength, and the
            // plan's own note says a hero wavelength per face sample -- which belongs with the face
            // pass rather than with the primary ray. `ior` is one number here for all three
            // channels.
            NodeHit far;
            bool bent = false;
            vec3 refract_through = vec3(1.0);
            if (probe_refract()) {
                const float ior = node_medium_ior(hit.type_id);
                const vec3 face_normal = normalize(vec3(hit.normal));
                const vec3 into = refract(dir, face_normal, 1.0 / max(ior, 1.0));
                // A zero from `refract` is total internal reflection, which cannot happen entering a
                // denser medium and can happen leaving one. Both are handled the same way -- keep
                // the straight ray -- because the alternative at an entry face is a direction that
                // does not exist.
                if (dot(into, into) > 0.0) {
                    const vec3 entry = push.origin.xyz + dir * hit.t + into * 1e-3;
                    NodeHit inside = node_march(entry, into, pixel_angle, node_bayer(pixel), false,
                                                false, false, true, false, kThroughExit,
                                                kNodeUnbounded, 0.0);
                    if (inside.left_medium) {
                        const float path_m = inside.exit_t * (1.0 / kVoxelsPerMetreF);
                        const vec3 exit_normal = normalize(vec3(inside.exit_normal));
                        vec3 out_dir = refract(into, exit_normal, ior);
                        // Total internal reflection at the far face is a real answer and not an
                        // error: past the critical angle a water surface is a mirror from
                        // underneath. Reflecting keeps the ray in the world rather than dropping
                        // the pixel to the straight-through fallback.
                        if (dot(out_dir, out_dir) <= 0.0) out_dir = reflect(into, exit_normal);
                        // The LAST segment carries the reporting, and that is not a detail: this
                        // is the ray that lands on the surface a player is looking at through the
                        // window, so it is the one that has to claim that surface's face and tell
                        // residency about it. Cast it silently and the far surface has no face, no
                        // light of its own and nothing to stream it in -- which is D604's whole
                        // reason for reporting on the second march, arriving one segment later.
                        // The two segments before it say nothing: the pane's own face was claimed
                        // by the primary hit, and the glass is what they cross rather than land on.
                        //
                        // Both of these keep `start_t` at nought even though R5d has since given
                        // node_march a way to say "carry on from here", and that is deliberate. A
                        // bent segment does not continue the original ray -- it has its own origin
                        // and its own direction -- so the eye-relative t it would need is not a
                        // number this code has. What it loses is the detail clock, which restarts at
                        // the pane and so resolves what is behind a window a little finer than the
                        // pixel needs; a pane is centimetres from what it stands in front of, so the
                        // error is small, and the picture that WAS looked at (D652, D656) is the one
                        // with this behaviour in it. Not moved by a change about something else.
                        const vec3 leaving = entry + into * inside.exit_t + out_dir * 1e-3;
                        NodeHit beyond = node_march(leaving, out_dir, pixel_angle,
                                                    node_bayer(pixel), report, report_used,
                                                    report_face, true, false, kThroughPass,
                                                    kNodeUnbounded, 0.0);
                        // The distance the composite reads has to be the whole path, or a window
                        // fogs as though what is behind it were at the pane.
                        beyond.t += hit.t + inside.exit_t;
                        beyond.through *= inside.through;
                        far = beyond;
                        bent = true;
                        // Beer-Lambert over the TRUE path, which only a ray that knows where it
                        // entered and where it left can take. `node_medium_through` above is a
                        // product over voxels crossed -- exact along an axis and short on a
                        // diagonal -- and this is the term the plan asked for beside it. Materials
                        // that never wrote `absorb` come back at zero and this is exactly 1.0.
                        refract_through = exp(-node_medium_absorb(hit.type_id) * path_m);
                    }
                }
            }
            // The straight ray, which is what a pane with no index of refraction on it gets, what
            // `--no-refraction` gets, and what a ray that never found its way out of the medium
            // falls back to. One march either way: the bent path replaces this one rather than
            // being cast beside it, so a glass pixel pays for two segments or for one and never
            // for both. The fallback matters as much as the feature -- a body of glass whose far
            // side is a brick with nothing in it has no exit face to bend at, and drawing it as
            // D604 did is right where guessing a direction would not be.
            if (!bent) {
                far = node_march(push.origin.xyz, dir, pixel_angle, node_bayer(pixel), report,
                                 report_used, report_face, true, false, kThroughPass,
                                 kNodeUnbounded, 0.0);
            }
            // Refusing a march that came back unattenuated is the second half of the same guard:
            // whatever the reason, a far surface with nothing taken out of it is the near one.
            const vec3 lets_past = far.through * refract_through;
            if (max(max(lets_past.r, lets_past.g), lets_past.b) < 0.999) {
                // 255 and false: a pane's far surface is one layer and is drawn whole, which is what
                // R4d measured and what this packed before R5d's second half existed.
                behind = visibility_pack_behind(far, lets_past, false, 255u, false);
            }
        }
    } else if (hit.hit && hit.level > 0 && hit.coverage < kEdgeCoverageFull &&
               hit.coverage_exit_t > hit.t && probe_edge_aa()) {
        // ---- R5d: and what is behind it, when what it landed on was only PART matter -------------
        //
        // A node coarser than a voxel is drawn as a solid block, and most of them are not one. The
        // pool knows exactly how much of each is matter as seen along each of the six directions --
        // `NodePool::build_leaf` counts the 8x8 face-on projection and `fold_children` carries it up
        // -- and until now nothing read the byte. So a distant railing was a solid bar, a window
        // frame was a solid slab, and every silhouette against the sky was a stair-step that crawled
        // as the camera turned.
        //
        // The mechanism is R4d's, deliberately, rather than a second one: cast the ray again, pack
        // the surface it finds into the same slot, and let the composite blend. What differs is only
        // what the ray is asked and what the blend means.
        //
        //   The ray BEGINS past the node instead of at the eye. Glass transmits, so R4d re-marches
        //   the whole path with `see_through` on and the pane attenuates it on the way; a coarse
        //   node transmits nothing at all, so the same march would stop on the same node again and
        //   pack the near surface as its own background. Starting at the far side of the cell the
        //   pixel landed in is the only way to ask the question, and it is why `coverage_exit_t`
        //   exists.
        //
        //   `through` is 1 - coverage, in all three channels. It is not a colour here: a share of a
        //   pixel has no tint, where a pane's transmission has one.
        //
        // The NEAR march above is untouched, and that is a rule rather than an oversight. A face is
        // claimed where a pixel lands (R3e), so moving where the primary ray stops would move which
        // faces exist and cost the near surface its own light -- which is the same reason R4d's
        // primary ray stops on the pane.
        //
        // What is deliberately NOT done: level 0. A voxel is the whole of itself and reports 255, so
        // the branch cannot fire there, and the near march is bit for bit what it was for every
        // pixel inside about twenty metres.
        //
        // And ONE further SURFACE, not three -- but three LAYERS, which is R5d's second half and is
        // the block after the march below. The plan asks for up to three partial hits composited and
        // what stopped it was the wire: `out_behind` is one surface a pixel and a third surface is
        // another sixteen bytes of traffic over the whole screen. What is affordable is nine BITS,
        // and nine bits are enough whenever the third layer is the SKY -- the composite already has
        // the direction, so the sky needs no slot, no face and no distance, only the share. So the
        // far node's own coverage byte and a bit saying "sky beyond" go into `behind.z`'s spare, and
        // the composite draws near, far and sky in proportion. Where the third layer is not sky the
        // far surface is still drawn opaque, which errs towards the picture this stage replaces
        // rather than away from it, exactly as it did before.
        //
        // The nudge past the boundary scales with distance for D156's reason: a 32-bit float's own
        // step at t = 96,000 voxels is 0.0156, so a fixed 1e-3 rounds straight back to the boundary
        // and the second march begins inside the cell it was meant to clear.
        const float past = hit.coverage_exit_t + max(1e-3, hit.coverage_exit_t * 1e-5);
        // The EYE is still the origin and `start_t` carries the skip, which is not the same thing as
        // launching from the far side of the node and matters more than it looks -- see node_march.
        // A ray launched from the silhouette has a detail clock that starts at nought there, so it
        // would resolve the landscape behind it in bricks and ask the pool to build them.
        //
        // Reporting is ON, and it is the same argument D604 makes for the segment behind the glass:
        // this is the ray that lands on the surface a player can see a share of, so it is the one
        // that has to claim that surface's face and tell residency about it. Cast it silently and
        // the far half of every edge pixel is lit by the composite's fallback -- full sun -- which
        // indoors is the most wrong answer available.
        NodeHit far = node_march(push.origin.xyz, dir, pixel_angle, node_bayer(pixel), report,
                                 report_used, report_face, true, false, kThroughStop,
                                 kNodeUnbounded, past);
        const float covered = float(hit.coverage) * (1.0 / 255.0);

        // ---- R5d's SECOND half: is the far surface an edge too, and is the sky beyond it? --------
        //
        // The march above stops on the first thing it meets, and that thing can be another coarse
        // node only part of which is matter -- which is not a corner case, it is the ordinary shape
        // of open structure seen from a distance. `clips/edge_aa_test.clip` is two railings and a
        // lattice at thirty, forty and fifty metres precisely so that a ray through the first one
        // lands on the second, and until now the second was drawn solid.
        //
        // The guard is the same one the near hit passed, term for term, and it has to be: a coverage
        // byte is only usable where it was read off the cell the ray actually stopped in, which is
        // exactly what `coverage_exit_t > t` says (D663 -- the two other places `coverage` is set
        // read the byte off a node coarser than the cell they draw, and blending a pixel by a
        // fraction measured over eight times its footprint is trap 6 at a different scale).
        //
        // The third march is a pure visibility question: it reports nothing, claims no face and asks
        // residency for nothing, because the only thing taken off it is whether it reached the sky.
        // `stand_in` is false for the same reason -- that flag is "this ray's colour will be drawn",
        // and this one's is not, so it must not pay R5c's blend either. It runs only on a pixel that
        // is an edge behind an edge, which is a small share of a set that is already only the
        // silhouettes.
        uint far_coverage = 255u;
        bool sky_beyond = false;
        if (push.r5.y != 0.0 && far.hit && far.level > 0 && far.coverage < kEdgeCoverageFull &&
            far.coverage_exit_t > far.t) {
            const float past_far = far.coverage_exit_t + max(1e-3, far.coverage_exit_t * 1e-5);
            const NodeHit third = node_march(push.origin.xyz, dir, pixel_angle, node_bayer(pixel),
                                             false, false, false, false, false, kThroughStop,
                                             kNodeUnbounded, past_far);
            if (!third.hit) {
                far_coverage = far.coverage;
                sky_beyond = true;
            }
        }
        behind = visibility_pack_behind(far, vec3(1.0 - covered), true, far_coverage, sky_beyond);
    }
    imageStore(out_behind, pixel, behind);

    imageStore(out_visibility, pixel, packed);
    imageStore(out_depth, pixel, vec4(hit.hit ? hit.t : push.lens.y, 0, 0, 0));
}
