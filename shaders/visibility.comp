#version 450
// Primary visibility against the node pool.
//
// The same pass shaders/visibility.comp performs, walking one sparse octree instead of four
// addressing schemes. It exists beside the old one rather than replacing it so the two can be
// rendered from the same camera and diffed: R1's claim is that the picture does not change and
// the cost falls, and both halves of that need measuring rather than asserting.
//
// The visibility buffer it writes is byte-for-byte the old format, so shaders/resolve.comp reads
// it unchanged.
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba32ui) uniform writeonly uimage2D out_visibility;
layout(binding = 1, r32f) uniform writeonly image2D out_depth;

// Which face store slot this pixel's surface lives in, or kNoFace.
//
// Resolved here rather than in the composite because the key is already in hand: the marcher
// descended to that node and knows its coordinate, its level and the direction it was hit from.
// Making the composite rebuild the key from a depth and a normal would be a second piece of code
// that has to agree with this one about which face a pixel is on, and the two would eventually
// not -- which is the fault D133 and D147 both describe, arriving through a third door.
//
// One word a pixel. The alternative is carrying the whole key in the visibility buffer, which is
// four, and at 4K that is 265 MB a frame of extra traffic for something a single probe answers.
layout(binding = 11, r32ui) uniform writeonly uimage2D out_face;

#include "node.glsl"

void main() {
    // ---- R9c: the dispatch is the screen plus a margin, and the margin is not the screen --------
    //
    // The host sizes this dispatch to cover the screen grown by `probe_halo_margin()` pixels on
    // every side, so an invocation's coordinate is in EXTENDED space and the pixel is that minus the
    // margin. Standing still the margin is nought, the subtraction is nought, and this is exactly
    // the dispatch it has always been -- which is what makes the settled grid unable to see this
    // stage at all, correctly.
    //
    // A coordinate outside the screen is a real direction through the same lens: `uv` simply leaves
    // [-1, 1], which is a widened frustum and not a special case. What such an invocation does is
    // claim the face it lands on and stamp it seen, so the light pass starts measuring it while it
    // is still off screen; it writes no image, reports no node, and asks the world for nothing.
    const int halo_margin = int(probe_halo_margin());
    const ivec2 extended = ivec2(gl_GlobalInvocationID.xy);
    ivec2 pixel = extended - ivec2(halo_margin);
    if (extended.x >= int(push.resolution.x) + 2 * halo_margin ||
        extended.y >= int(push.resolution.y) + 2 * halo_margin) {
        return;
    }
    const bool on_screen = pixel.x >= 0 && pixel.y >= 0 && pixel.x < int(push.resolution.x) &&
                           pixel.y < int(push.resolution.y);
    if (!on_screen) {
        // Sparse, because a halo is a claim and not a picture. One sample in `halo_stride` each way
        // names nearly every face out there for the same reason one pixel in sixteen does on screen
        // (D205): a frame holds far fewer faces than pixels and the duplicates are the overwhelming
        // majority. The invocations that fall between are a return, and the alternative -- packing
        // the ring into a compact dispatch of its own -- is a second pipeline and a second barrier.
        //
        // The test is on the EXTENDED coordinate, which is never negative. `%` on a negative int is
        // not something to find out about from a picture.
        const int halo_stride = int(probe_halo_stride());
        if ((extended.x % halo_stride) != 0 || (extended.y % halo_stride) != 0) return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(push.resolution) * 2.0 - 1.0;
    float aspect = float(push.resolution.x) / float(push.resolution.y);
    vec3 dir = normalize(push.forward.xyz +
                         push.right.xyz * uv.x * push.lens.x * aspect -
                         push.up.xyz * uv.y * push.lens.x);

    // Voxels a pixel spans per unit of distance.
    float pixel_angle = 2.0 * push.lens.x / float(push.resolution.y);

    // One pixel in four, where the chunk marcher reported one in sixty-four.
    //
    // The sampling rate has to follow the unit being reported, and the unit changed. A chunk is
    // eight metres, so neighbouring rays wanted the same one and a sparse sample missed nothing.
    // A node at the level a pixel resolves is a brick - twenty-five centimetres, under two pixels
    // across at sixty metres - so one report in sixty-four asks for one path in sixty-four and
    // the other sixty-three are never built. Measured: the tree converged at 765 leaves for a
    // building needing hundreds of thousands, then went quiet, because the pixels that would have
    // asked for the rest were not allowed to speak.
    //
    // It costs nothing at rest: a report only happens on a miss, and misses go to zero as the
    // tree fills in.
    const bool report = ((pixel.x & 1) == 0) && ((pixel.y & 1) == 0);

    // One pixel in 256 says which root it read. Eviction releases a root with its whole subtree,
    // and a 512 m root covers the entire scene here, so the useful information is a handful of
    // distinct values and every pixel would repeat them. This is enough by a wide margin.
    // One pixel in 64. It was one in 256 while this only had to name the root a ray entered,
    // where a handful of distinct values repeat across the whole screen. Now it names the NODE,
    // and a node has to be read at least once inside cold_frames or it is dropped -- at one in
    // 256 a node covering a single pixel goes unsampled for 600 frames about one time in ten,
    // and the cost of being wrong is geometry that vanishes and comes back. At one in 64 it is
    // seven in a hundred thousand.
    //
    // Scaled with the resolution for the same reason the face stride is. A fixed one in sixty-four
    // is 129,600 reports at 4K, which very nearly fills the 131,072-entry buffer on its own and
    // then starves the face requests sharing it -- 94,905 dropped in a frame, measured. Aimed at
    // about sixteen thousand, which is far more than enough: a node has to be read once inside
    // `cold_frames`, and six hundred frames of sixteen thousand samples covers everything visible
    // many times over.
    uint used_stride = 8u;
    while ((push.resolution.x * push.resolution.y / (used_stride * used_stride)) > 16000u) {
        used_stride <<= 1u;
    }
    const uint used_mask = used_stride - 1u;
    const uvec2 used_phase = node_sample_phase(node_push.frame, used_stride);
    const bool report_used = (((uint(pixel.x) + used_phase.x) & used_mask) == 0u) &&
                             (((uint(pixel.y) + used_phase.y) & used_mask) == 0u);

    // One pixel in sixteen names the face it landed on.
    //
    // A face is what the light pass will shade, and the premise of the whole stage is that there
    // are far fewer of them than there are pixels: measured before any of it was built, a frame
    // holds 118,826 to 141,110 distinct faces while its pixel count goes up 8.1x (D205). So a
    // sparse sample names nearly all of them and the duplicates are the overwhelming majority.
    //
    // Sixteen rather than four because these share the feedback buffer with the node reports, and
    // its capacity is 131,072: one pixel in four at 1280x800 would be 256,000 requests and the
    // buffer would truncate, which costs convergence rather than correctness but silently.
    //
    // The stride follows the RESOLUTION, or the buffer truncates and the truncation looks like a
    // result. At a fixed one-in-sixteen, 4K asks for 518,400 faces against a capacity of 131,072,
    // so two thirds of them are dropped -- and the face pass then measures *faster* at 4K than at
    // 800p (0.038 ms against 0.195) purely because it was given a third of the work. That reads
    // exactly like the resolution independence this stage exists to demonstrate, which is the
    // worst way for a measurement to be wrong.
    //
    // A power of two so the test stays a mask. Aimed at about sixty thousand requests a frame,
    // which fits the buffer with room for the node reports beside it.
    uint pixels = push.resolution.x * push.resolution.y;
    uint stride = 4u;
    while ((pixels / (stride * stride)) > 60000u) stride <<= 1u;
    //
    // And the lattice MOVES, which is not a refinement of the sampling but the difference between
    // this converging and not. A fixed one-in-sixty-four grid does not sample one face in
    // sixty-four: it samples the same faces every frame and the other sixty-three never exist. At
    // this camera the store settled at 630 faces against about thirty thousand on screen, and
    // stayed there -- 278,195 claims of which 277,565 were for a face already claimed. Every
    // surface that happened to fall between the sample points was lit by the composite's fallback
    // forever, which looks like the face pass working on a few stripes of the building.
    //
    // Walking the phase visits every offset in stride^2 frames -- about a second at stride 8 --
    // and the store's cold window is 600, so nothing claimed goes stale waiting its turn.
    const uint face_mask = stride - 1u;
    const uvec2 face_phase = node_sample_phase(node_push.frame, stride);
    const bool report_face = (((uint(pixel.x) + face_phase.x) & face_mask) == 0u) &&
                             (((uint(pixel.y) + face_phase.y) & face_mask) == 0u);

    // ---- the halo's own ray, which ends here -----------------------------------------------
    //
    // Everything below this belongs to a pixel: a visibility word, a depth, a face slot image, a
    // stand-in claimed so the composite has something to read this frame. A halo sample has no
    // pixel and needs none of it. What it does is the two lines that make the light pass start
    // early -- name the face so the host claims it, and stamp it so `may_cast` is true.
    //
    // `report` and `report_used` are both OFF, deliberately, and that is the difference between a
    // margin and a wider screen. A halo ray that reported its misses would stream the world beside
    // the one you are looking at, which is unbounded in exactly the way this rewrite exists to
    // stop -- R9h's rule for light rays, arriving in the primary pass. So the halo claims faces out
    // of geometry the pool ALREADY holds, and where the pool holds nothing the halo finds nothing
    // and the face is claimed the ordinary way when a pixel lands on it.
    if (!on_screen) {
        // `see_through` is FALSE for the primary ray, and that is R4d's design rather than an
        // omission: a face is claimed where a pixel lands, so a window that a pixel passed through
        // would have no face, no light of its own and no reflection. See node_march.
        NodeHit halo = node_march(push.origin.xyz, dir, pixel_angle, node_bayer(pixel), false,
                                  false, true, true, false, false, kNodeUnbounded);
        if (halo.hit && halo.face_level != kNoFaceLevel) {
            node_face_seen(node_face_lookup(halo.face_node, halo.face_level, halo.face_dir));
        }
        return;
    }

    NodeHit hit = node_march(push.origin.xyz, dir, pixel_angle, node_bayer(pixel), report,
                             report_used, report_face, true, false, false, kNodeUnbounded);

    uvec4 packed = uvec4(0xFFFFFFFFu, 0u, 0u, floatBitsToUint(hit.t));
    if (hit.hit) {
        uint face = 0u;
        if (hit.normal.x != 0) face = (hit.normal.x > 0) ? 0u : 1u;
        else if (hit.normal.y != 0) face = (hit.normal.y > 0) ? 2u : 3u;
        else face = (hit.normal.z > 0) ? 4u : 5u;
        // How much of the cell that was hit is actually matter. A voxel is all of it; a coarser
        // node carries its filtered coverage in the alpha of its colour.
        // From the node's own per-direction coverage, not from the alpha of its filtered colour.
        // See node_face_coverage: the alpha is a volumetric fill fraction and this is a projected
        // one, and only the second answers "how much of this pixel is matter".
        uint coverage = hit.coverage;
        packed.x = face | (uint(hit.level) << 8u) | (min(hit.steps, 255u) << 16u) |
                   (coverage << 24u);
        packed.y = hit.type_id;
        packed.z = hit.colour;
    } else {
        packed.x = 0xFFFFFFFFu;
        packed.z = min(hit.steps, 255u);
    }

    // The slot, looked up once here, so every pixel on a face reads the same light -- or the slot
    // of the coarse face standing in for it while it catches up.
    //
    // A face that has not been claimed yet and a face that has been claimed but not yet shaded are
    // the same thing to the composite: both send it to its fallback, and its fallback is full sun.
    // Indoors that is the most wrong answer available, and it is what a player sees as unshadowed
    // patches behind things after the camera moves, filling in over the next second. The wait is
    // real and it is structural: a face is claimed only when a primary ray lands on it, at one
    // pixel in sixty-four, so a surface that was hidden and is now visible waits for the sampling
    // lattice to reach its particular pixel, then two frames for the claim, then four samples.
    //
    // The stand-in three levels up does not wait, because five hundred and twelve faces share it
    // and it covers about sixty-four times the screen area, so the lattice cannot miss it: it is
    // claimed the frame the region appears and settled a few frames later. Reading it gives a
    // blocky shadow that sharpens, rather than no shadow that appears. R9d; R2d says the same thing
    // about colour, and this is that rule applied to light.
    //
    // Both halves are gated on being ANSWERABLE rather than merely present -- if the stand-in has
    // not settled either, the fine face is kept, since the composite treats them identically and
    // the fine one is the one that will settle first from here.
    //
    // The cost is one extra probe on a pixel whose own face is not ready, and that set empties as
    // the store fills in. The sample count is read out of the record `node_face_lookup` has already
    // loaded to compare the key against, so it costs no traffic of its own.
    uint face_slot = kNoFace;
    if (hit.hit && hit.face_level != kNoFaceLevel) {
        face_slot = node_face_lookup(hit.face_node, hit.face_level, hit.face_dir);
        // A pixel is reading this face, so it is worth lighting. Stamped whether or not the
        // composite ends up USING it: a face that is not answerable yet is precisely the one that
        // has to keep casting rays, and gating the stamp on answerability would be a face that can
        // never become answerable because it is never lit because it is not answerable.
        node_face_seen(face_slot);
        // ...and tell the HOST, at most once per face per window, because the store's residency
        // clock only ever heard from the request lattice and that is not what a screen is. See
        // node_face_report_read.
        node_face_report_read(face_slot);
        bool answerable = face_slot != kNoFace &&
                          face_samples_of(faces.items[face_slot].counters) >= kFaceSettled;
        if (!answerable) {
            const ivec3 coarse = ivec3(hit.face_node.x >> kFaceAncestorStep,
                                       hit.face_node.y >> kFaceAncestorStep,
                                       hit.face_node.z >> kFaceAncestorStep);
            const uint coarse_level = hit.face_level + uint(kFaceAncestorStep);
            uint stand_in = node_face_lookup(coarse, coarse_level, hit.face_dir);
            // And the coarse face standing over it, on the same argument. It is only looked up
            // when the fine face cannot answer, which is exactly when it is being read -- so a
            // stand-in whose children have all settled stops being stamped, stops casting, and
            // keeps the mean it had, which is all `face_light_seed` ever wanted of it.
            node_face_seen(stand_in);
            // The stand-in is being READ, so it is wanted, and a stand-in is claimed by the host
            // only once — when the face under it was new. Without this it is the one kind of face
            // whose residency clock never advances at all while it is on screen.
            node_face_report_read(stand_in);
            if (stand_in != kNoFace &&
                face_samples_of(faces.items[stand_in].counters) >= kFaceSettled) {
                face_slot = stand_in;
            } else {
                // Nothing in the store, so claim it here rather than waiting two frames for the
                // host to hear about it. R3e; see node_face_claim for why the claim is one atomic
                // and why the pixel that loses the race is served by the same one.
                //
                // The record is written by whichever pixel won. It is written HERE rather than in
                // the shading pass because the shading pass has no key to write -- and it is safe
                // to write from a pass that other pixels are still reading, because the only thing
                // they read of it this frame is the slot number, which the atomic gave them.
                bool claimed = false;
                const uint fresh = node_face_claim(coarse, coarse_level, hit.face_dir, claimed);
                if (claimed) {
                    faces.items[fresh].x = coarse.x;
                    faces.items[fresh].y = coarse.y;
                    faces.items[fresh].z = coarse.z;
                    faces.items[fresh].packed =
                        (coarse_level & 0xFFu) | (hit.face_dir << 8) | (kFaceLive << 16);
                    faces.items[fresh].counters = 0u;
                    faces.items[fresh].irradiance = 0u;
                    faces.items[fresh].photons = 0u;
                    faces.items[fresh].bins = 0u;
                }
                if (fresh != kNoFace) face_slot = fresh;
            }
        }
    }
    imageStore(out_face, pixel, uvec4(face_slot, 0u, 0u, 0u));

    imageStore(out_visibility, pixel, packed);
    imageStore(out_depth, pixel, vec4(hit.hit ? hit.t : push.lens.y, 0, 0, 0));
}
