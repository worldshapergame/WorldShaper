#version 450
// Resolve: turn the visibility buffer into pixels.
//
// The split matters more than it looks. Visibility answers "which face is here"; resolve
// answers "what colour is that face". Stage 7 replaces the body of this shader with a
// lookup into the face radiance cache â€” the same visibility buffer, shaded properly â€”
// without touching the marcher at all. Deferring the shading is also what keeps the
// marcher's inner loop free of material fetches, which on a bandwidth-bound GPU is worth
// more than the extra pass costs.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba32ui) uniform readonly uimage2D in_visibility;
layout(binding = 1, rgba8) uniform writeonly image2D out_colour;

layout(std430, binding = 2) readonly buffer Types { uvec2 items[]; } types;
layout(std430, binding = 3) readonly buffer Visuals { uvec4 items[]; } visuals;

#extension GL_GOOGLE_include_directive : require

// The same block the marcher uses. One declaration of the fields, so a shader can never again
// drift out of step with the buffer it is reading.
layout(std140, binding = 4) uniform Params {
#include "params.glsl"
} push;

// The clipboard's held clip: one cell per voxel, holding the type id plus one so that zero
// can mean "outside the clip". See gpu/render_params.hpp.
layout(std430, binding = 5) readonly buffer ClipCells { uint items[]; } clip;

// The face store, and the slot this pixel's surface lives in.
//
// This is the whole point of the stage arriving in the pass that draws: light is worked out once
// per face, on the surface, and a pixel READS it. Nothing is traced here and nothing scales with
// the size of the window.
//
// Only what a face knows is read. Everything a face does not know yet -- sky, bounce, the
// directional bins -- stays where it is until the pass that fills them exists, so this changes
// what the picture is lit BY without changing what it is made of.
struct Face {
    int x;
    int y;
    int z;
    uint packed;
    uint irradiance;
    uint photons;
    uint counters;
    uint bins;
};
layout(std430, binding = 6) readonly buffer Faces { Face items[]; } faces;
layout(binding = 7, r32ui) uniform readonly uimage2D in_face;
// The card's own light, which the host never touches. See src/gpu/face_light.hpp.
layout(std430, binding = 8) readonly buffer FaceLight { uint words[]; } face_light;
// Nine, and the layout is documented once in shaders/node.glsl beside the pass that writes it.
// Word 0 holds two counts -- near-field rays low, far-field rays high -- because the two halves of
// the ambient integral stopped sharing a ray when the near field's was bounded at a metre. Words
// 5-7 are the lamps' accumulated irradiance and word 8 their sample count and list version.
const uint kFaceLightWords = 9u;
// Must match kSkyConverged in shaders/node.glsl. Read by debug view 19 only -- the shaded path
// never asks whether a face has finished, it asks what the face says.
const uint kSkyConverged = 2048u;

const uint kNoFace = 0xFFFFFFFFu;

// How many samples a face needs before its shadow is worth showing. Must match kFaceSettled in
// shaders/node.glsl, which is where the reasoning for the number is.
//
// It was four, on the argument that one sample is not a penumbra but a coin toss, and that showing
// it makes an edge crawl while the average settles. Both halves of that are true. What the argument
// left out is what is shown INSTEAD, which is full sun -- so the choice was never "noisy or clean",
// it was "wrong by a coin toss on one face in twenty" against "wrong on every face, in the same
// direction, for four frames". Below this the face still reports fully lit; there are simply far
// fewer frames in which it does.
const uint kShadowSettled = 1u;

// The cloud volume the cloud pass keeps, at full resolution. Two images alternating; the parity
// arrives in the push constant, the same as in the path tracer.
layout(binding = 20, rgba16f) uniform readonly image2D in_cloud[2];

// The same push constant the tracer and the cloud pass receive. This pass had NONE before, which is
// why it could not see the sun, the weather or the air: three of the four things a sky is made of.
layout(push_constant) uniform Trace {
    vec4 sun;
    vec4 sun_colour;
    uvec4 control;
    uvec4 quality;
    vec4 fog;
    vec4 fog_shape;
} trace;

const float kPi = 3.14159265358979;
const int kChunkEdge = 256;

// pt_sky.glsl and pt_clouds.glsl want this. Defined here rather than pulled in with a header,
// because that header brings a second kPi and a hundred functions this pass never calls.
uint hash_u32(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

#include "pt_sky.glsl"
#include "pt_clouds.glsl"
#include "pt_media.glsl"

// The real sky, the same one the path tracer draws.
//
// What was here was a three-colour vertical gradient with the numbers written into it. That is why
// none of the sky work of the last while appeared in the game: this is the pass that runs by
// default -- path tracing is off unless --pathtrace is passed or F4 is pressed -- and it shared no
// code at all with the renderer the work went into. Clouds, atmosphere, sun colour, time of day:
// none of it could reach the screen a player actually looks at.
vec3 sky_colour(vec3 dir) {
    return sky_radiance(dir);
}

// Physical radiance out, display value in.
//
// This pass had nothing to tone map before, because everything in it was authored in display units
// already: a voxel's colour is its ALBEDO, a number between nought and one, flat shaded by face.
// The sky and the cloud are not — they are radiance, and the sun in them is thousands of times
// brighter than a lit wall.
//
// Tone mapping the whole frame the first time round therefore darkened every surface in the world,
// because x/(x+1) applied to a value already in nought-to-one halves it: an albedo of 0.5 came out
// at 0.33. Reported as everything being slightly darker, and that is exactly what it was.
//
// So the surfaces are lifted INTO radiance first, and then the whole frame is tone mapped once from
// a single consistent space. Multiplying an albedo by an illuminance is what shading is; this pass
// simply has one number for the illuminance instead of computing it.
// The same curve the path tracer uses.
//
// Reinhard was here first and it is why this pass came back grey. x/(x+1) never reaches one and
// never has a shoulder, so it lifts the darks and flattens the brights towards the same middle: the
// whole picture converges on the average. ACES has a toe and a shoulder, which is what keeps a lit
// wall bright and a shaded one dark.
vec3 tonemap_aces(vec3 colour) {
    const mat3 to_working = mat3(0.59719, 0.07600, 0.02840,
                                 0.35458, 0.90834, 0.13383,
                                 0.04823, 0.01566, 0.83777);
    const mat3 from_working = mat3( 1.60475, -0.10208, -0.00327,
                                   -0.53108,  1.10813, -0.07276,
                                   -0.07367, -0.00605,  1.07602);
    vec3 v = to_working * colour;
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return clamp(from_working * (a / b), 0.0, 1.0);
}

// Fixed rather than measured. The tracer's frame_exposure() reads the frame statistics buffer it
// fills itself, which this pass has no binding for and no business writing.
const float kPreviewExposure = 3.2;

vec3 to_display(vec3 radiance) {
    // GAMMA, and leaving it out is most of why the first attempt came out nearly black. The
    // swapchain is UNORM and expects an encoded value; a linear one written straight in reads about
    // a third as bright.
    return pow(tonemap_aces(radiance * kPreviewExposure), vec3(1.0 / 2.2));
}

// How much of the sky a surface sees, with nothing traced to find out.
//
// An up-facing surface sees the whole dome, a down-facing one sees only what bounces off the
// ground. Without a term like this every face not pointing at the sun is lit identically, and the
// building reads as a paper model.
const float kSkyAmbient = 0.55;
const float kGroundBounce = 0.12;
// What is left of the ambient term where no sky reaches at all. Not an occlusion parameter: it is
// the share of `kSkyAmbient` that was always standing in for light bounced off other surfaces, and
// it goes to zero when R3c and R9 compute that light instead of assuming it.
// Its value is chosen, not tuned: the orientation heuristic it replaces averaged 0.5 over a
// surface whose normals point every way, so a floor of 0.5 leaves the enclosed room at the mean
// brightness it already had. That matters because of what this stage is FOR. Indoors every surface
// is occluded, so any floor below that darkens the whole room uniformly — and a uniform darkening
// is indistinguishable from a lower exposure, which is the one failure the R10 gate calls out by
// name. At 0.5 the mean is held and the occlusion spends itself on contrast instead: creases,
// soffits and alcove interiors go dark against walls that do not.
const float kIndirectFloor = 0.5;

vec3 unpack_rgb(uint packed) {
    return vec3(float(packed & 0xFFu), float((packed >> 8u) & 0xFFu),
                float((packed >> 16u) & 0xFFu)) / 255.0;
}

#include "preview.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(push.resolution.x) || pixel.y >= int(push.resolution.y)) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(push.resolution) * 2.0 - 1.0;
    float aspect = float(push.resolution.x) / float(push.resolution.y);
    vec3 dir = normalize(push.forward.xyz +
                         push.right.xyz * uv.x * push.lens.x * aspect -
                         push.up.xyz * uv.y * push.lens.x);

    uvec4 packed = imageLoad(in_visibility, pixel);

    // Debug views 12-15: one word of the visibility buffer, written out as four exact bytes.
    //
    // These exist because an argument about which marcher is right cannot be settled by looking at
    // the picture. Two marchers were producing images that differed on 83% of a sky camera, where
    // there is no geometry to disagree about, and four separate changes inside the traversal moved
    // the difference by less than a hundredth. At that point the useful question stops being "what
    // else might the marcher do differently" and becomes "which of these four words is not what I
    // think it is" - and that is a readback, not a hypothesis.
    //
    // Four channels carry thirty-two bits exactly: the screenshot path writes four channels
    // through stbi_write_png, PNG is lossless, and a unorm8 channel returns exactly what
    // `byte / 255.0` put into it. So the image IS the buffer.
    if (push.resolution.z >= 12u && push.resolution.z <= 15u) {
        uint word = (push.resolution.z == 12u)   ? packed.x
                    : (push.resolution.z == 13u) ? packed.y
                    : (push.resolution.z == 14u) ? packed.z
                                                 : packed.w;
        imageStore(out_colour, pixel,
                   vec4(float(word & 0xFFu), float((word >> 8u) & 0xFFu),
                        float((word >> 16u) & 0xFFu), float((word >> 24u) & 0xFFu)) / 255.0);
        return;
    }

    bool hit = packed.x != 0xFFFFFFFFu;
    float t = uintBitsToFloat(packed.w);
    uint face = packed.x & 0xFFu;
    uint level = (packed.x >> 8u) & 0xFFu;
    uint steps = hit ? ((packed.x >> 16u) & 0xFFu) : packed.z;

    vec3 colour;
    // What this surface gives off itself, which is not light it received and is therefore not
    // shaded, occluded or divided by pi. A lamp that lights the room and does not itself glow reads
    // as a grey block with a halo round it, which is the one thing about lamps a player notices
    // before any of the shading.
    //
    // A material read, not a light calculation: no ray, no accumulation, nothing per pixel that
    // scales with the window -- the same lookup the albedo on the line above already is. Emission
    // is a property of the voxel, so it is available wherever the voxel is, and it is available at
    // level 0 only for the same reason the albedo is: a coarse node carries a folded colour and no
    // material. R9f's fold is where a distant fitting's glow will come from.
    vec3 emission = vec3(0.0);
    if (hit) {
        if (level == 0u) {
            // Clamped, because an out-of-range index into an SSBO is not a wrong colour -- it is
            // whatever the driver decides out-of-bounds means, and this pass has already cost one
            // device loss to exactly that (see material_of in pt_material.glsl).
            uint type_id = min(packed.y, uint(types.items.length()) - 1u);
            uint visual_id = min(types.items[type_id].x, uint(visuals.items.length()) - 1u);
            uvec4 visual = visuals.items[visual_id];
            colour = unpack_rgb(visual.x);
            // The same unpacking as material_of: the scale is byte 3 of word 1 and the tint is
            // RGB565 in the low half of word 3, squared and scaled by 64 so a torch and a furnace
            // are not one step apart on a linear ramp. Two places computing this differently would
            // light the scene one way and draw the lamp another.
            float emissive = float((visual.y >> 24u) & 0xFFu) / 255.0;
            if (emissive > 0.0) {
                uint tint = visual.w & 0xFFFFu;
                emission = vec3(float((tint >> 11u) & 0x1Fu) / 31.0,
                                float((tint >> 5u) & 0x3Fu) / 63.0,
                                float(tint & 0x1Fu) / 31.0) * (emissive * emissive * 64.0);
            }
        } else {
            colour = unpack_rgb(packed.z);
        }

        vec3 normal = vec3(0.0);
        if (face == 0u) normal = vec3(1, 0, 0);
        else if (face == 1u) normal = vec3(-1, 0, 0);
        else if (face == 2u) normal = vec3(0, 1, 0);
        else if (face == 3u) normal = vec3(0, -1, 0);
        else if (face == 4u) normal = vec3(0, 0, 1);
        else normal = vec3(0, 0, -1);

        // Sun and sky, in RADIANCE, rather than a tint between 0.55 and 1.0.
        //
        // That tint is why this pass looked grey however it was tone mapped. Its darkest face was
        // barely half the brightness of its brightest, so there was no contrast in the frame for a
        // curve to work with -- a building lit that way is a flat grey cutout of a building. The
        // fault was never the tone mapping; it was that there was nothing to map.
        //
        // Two terms, which is the least that reads as light: the sun, hard and directional, and the
        // sky, which is broad and comes mostly from above. A north wall now sits at a fraction of a
        // south one instead of at nine tenths of it.
        float lambert = max(dot(normal, trace.sun.xyz), 0.0);

        // The sun's visibility, from the face rather than from a ray traced here.
        //
        // The real-time path has never had a shadow: every surface facing the sun was lit by it,
        // whatever stood in the way. This is where that changes, and it costs one buffer read.
        //
        // Bounded against the buffer as well as against kNoFace. The slot came from an image the
        // marcher wrote on some earlier frame, and the store it indexes can be rebuilt smaller
        // between then and now; an unchecked index into an SSBO is not a wrong colour, it is
        // whatever the driver decides out-of-bounds means.
        float sun_visible = 1.0;
        uint face_slot = imageLoad(in_face, pixel).x;
        if (face_slot < faces.items.length()) {
            uint counters = faces.items[face_slot].counters;
            uint samples = counters & 0xFFFFu;
            if (samples >= kShadowSettled) {
                sun_visible = float((counters >> 16u) & 0xFFFFu) / float(samples);
            }
        }
        lambert *= sun_visible;

        // How much sky this surface can actually see, measured on the face (R10a).
        //
        // What was here decided it from which way the surface points and from nothing else:
        //
        //     kSkyAmbient * (0.5 + 0.5 * normal.y) + kGroundBounce
        //
        // A wall at the back of a corridor, a floor under a ceiling, the whole inside of the
        // building -- every one of them received the entire dome. That is why the interior read as
        // a model of a room rather than as a room even once the sun cast real shadows, and it is
        // the single largest thing left wrong with the picture. The occlusion was never missing
        // because it was hard; it was missing because visibility used to mean a per-pixel gather,
        // which this renderer does not do.
        //
        // The face pass now measures it with one cosine-weighted hemisphere ray per face per
        // frame, so this is a lookup. The orientation term is gone rather than kept alongside:
        // it was standing in for exactly this quantity, and multiplying by both would darken every
        // crease twice -- the failure that looks like a taste problem rather than like a bug.
        //
        // One before any rays have landed, so a face nobody has shaded yet is lit as it was
        // before this stage existed. A new surface fades into its occlusion rather than flashing
        // dark, which is the same discipline the sun's own fallback follows.
        float open_sky = 1.0;
        float unoccluded = 1.0;
        // What the lamps deliver here, measured on the face by shade_faces.comp (R3c).
        //
        // IRRADIANCE, already carrying the cosine and already divided by the density that chose
        // each fitting, so it goes into the same bracket as the sun and the sky and is divided by
        // pi with them. Nothing is traced here, nothing is looped over, and a hall with a thousand
        // sconces costs this pass exactly what a hall with one costs -- which is the whole of why
        // lamps moved onto the face.
        //
        // Nought before any samples, and that direction is deliberate. An unsampled face reading
        // full sun is the sun's worst answer because the sun is bright everywhere; an unsampled
        // face reading no lamp is merely a surface not yet lit by a lamp, and the stand-in three
        // levels above it (kLampSeedMin) is what covers the frames in between.
        vec3 lamp = vec3(0.0);
        if (face_slot < faces.items.length()) {
            uint lamp_n = face_light.words[face_slot * kFaceLightWords + 8u] & 0xFFFFu;
            if (lamp_n > 0u) {
                lamp = vec3(uintBitsToFloat(face_light.words[face_slot * kFaceLightWords + 5u]),
                            uintBitsToFloat(face_light.words[face_slot * kFaceLightWords + 6u]),
                            uintBitsToFloat(face_light.words[face_slot * kFaceLightWords + 7u])) /
                       float(lamp_n);
            }
            uint sky_counters = face_light.words[face_slot * kFaceLightWords];
            uint sky_samples = sky_counters & 0xFFFFu;          // near-field rays
            uint far_samples = (sky_counters >> 16u) & 0xFFFFu;  // far-field rays
            if (sky_samples >= kShadowSettled) {
                // The far field has its own count and its own ray, and the near field converges
                // far faster, so the two are gated separately. A face with contact measured and no
                // sky ray yet keeps `open_sky` at one, which is what it read before this term
                // existed -- the near field is already darkening it correctly in the meantime.
                if (far_samples > 0u) {
                    open_sky = float(face_light.words[face_slot * kFaceLightWords + 4u]) /
                               float(far_samples);
                }
                // And the near field, which is the term that actually carries shape. Indoors the
                // far field is nought on every surface in the room -- measured, 1,619 of 1,671
                // pixels in the lowest tenth -- so on its own it shifts the whole interior by a
                // constant and changes nothing anybody can see. This is how close the nearest
                // thing is, and it varies across every crease and alcove in the building.
                float inv = 1.0 / (float(sky_samples) * 255.0);
                float mean = float(face_light.words[face_slot * kFaceLightWords + 1u]) * inv;

                // And where on the face THIS pixel is, so the occlusion varies under the voxel
                // instead of being flat across it.
                //
                // Without this a face is one number however close you stand, and AO gets blockier
                // the nearer you get -- the exact failure D298 fixed for shadows, arriving again
                // through a different door. The coefficients are first moments of the same samples
                // the mean is made of, so this costs two multiply-adds and no extra fetch: the
                // record is the one already being read.
                Face f = faces.items[face_slot];
                float extent = float(1u << (f.packed & 0xFFu));
                vec3 fcorner = vec3(ivec3(f.x, f.y, f.z)) * extent -
                               vec3(push.camera_chunk.xyz * kChunkEdge);
                vec3 offset = (push.origin.xyz + dir * t) - (fcorner + vec3(extent * 0.5));

                // The same two axes shade_faces.comp spreads its samples along, chosen the same
                // way from the same normal, or the gradient is read against the wrong axis.
                vec3 across = abs(normal.x) != 0.0 ? vec3(0, 1, 0) : vec3(1, 0, 0);
                vec3 down = abs(normal.z) != 0.0 ? vec3(0, 1, 0) : vec3(0, 0, 1);
                // Against a quarter of the face, because the samples span half of it. Clamped
                // because a pixel near the rim is outside the sampled span, and a linear fit
                // extrapolated a little is what darkens an edge that meets a wall.
                float inv_half = 4.0 / extent;
                float fu = clamp(dot(offset, across) * inv_half, -1.0, 1.0);
                float fw = clamp(dot(offset, down) * inv_half, -1.0, 1.0);

                // Legendre P1 on [-1,1] has <P1 P1> = 1/3, so the coefficient is three times the
                // first moment. Nothing here solves anything: the basis is orthogonal under the
                // sampling distribution, which is the whole reason this is affordable.
                float cu = float(int(face_light.words[face_slot * kFaceLightWords + 2u])) * inv;
                float cw = float(int(face_light.words[face_slot * kFaceLightWords + 3u])) * inv;

                // Believe a gradient only as far as it stands clear of its own error.
                //
                // A first moment is much noisier than the mean it rides on. The mean of N samples
                // has a standard error of sqrt(0.25/N); a moment against u, which runs over
                // [-1, 1] with an average of nought, has about sqrt(1/3N) and is then multiplied
                // by three -- some three and a half times the mean's error, and it lands as a TILT
                // across the face rather than as a level. On a flat wall, where the true gradient
                // is nought, that tilt is pure invention: each face leans a different way and
                // neighbours disagree at their shared edge. Measured by turning the term off, it
                // was **71%** of all the roughness left in the picture (3.752 of 255 against
                // 1.076).
                //
                // So each coefficient is shrunk by how much of it survives its own variance --
                // the positive part of one minus the noise power over the signal power, which is
                // the standard estimator for exactly this question. A flat wall measures a
                // gradient the size of its error and keeps none of it. A crease measures one far
                // larger and keeps nearly all of it. Nothing here knows which it is looking at,
                // which is the same property the fit itself has.
                // Smoothly, and that is not a detail. The positive-part form -- one minus noise
                // over signal, floored at nought -- was tried first and made the picture three
                // times rougher than leaving the gradient alone: it is a threshold, so two
                // neighbouring faces whose coefficients straddle it keep wildly different amounts
                // and disagree at their shared edge by more than the noise ever did. A hard
                // decision taken per face is a new discontinuity per face. This form is continuous
                // in the coefficient, so a face near the threshold is near its neighbour.
                float noise_power = 1.0 / (3.0 * float(sky_samples));
                float keep_u = (cu * cu) / (cu * cu + noise_power);
                float keep_w = (cw * cw) / (cw * cw + noise_power);
                float occluded = mean + 3.0 * (cu * keep_u * fu + cw * keep_w * fw);
                unoccluded = 1.0 - clamp(occluded, 0.0, 1.0);
            }
        }
        // The sky term is occluded; the bounce term is not, because it is not the sky.
        //
        // `kSkyAmbient` was standing in for two different things at once: light arriving from the
        // dome, and light that has bounced off something else in the room. Occlusion applies to
        // the first and emphatically not to the second — a windowless room gets no sky and is
        // still not black, because its walls light each other. Multiplying the whole constant by
        // measured sky visibility takes both away, and the enclosed camera goes to near black:
        // correct about the sky, wrong about the room, and wrong in the direction that looks like
        // the feature is broken.
        //
        // So `kIndirectFloor` is the part of that constant which was never sky. It is a stand-in
        // with a name and an expiry rather than a fudge: R3c's lamps and R9's bounce replace it
        // with light that is actually computed, and when they do this term goes to zero and the
        // line above it stops needing a comment this long.
        // Multiplied, not averaged, and each appears exactly once. The far field says how much of
        // the dome is there to be seen; the near field says how much of what is left is shut out
        // by whatever is within a metre. Applying either twice double-darkens every crease, and
        // that failure looks like a taste problem rather than like a bug.
        float sees_sky = kSkyAmbient * mix(kIndirectFloor, 1.0, open_sky) * unoccluded +
                         kGroundBounce * unoccluded;
        // Over PI, and leaving it out is what blew the building white while the sky stayed dark.
        //
        // A Lambertian surface lit by an irradiance E reflects albedo * E / PI as RADIANCE. Dropping
        // the divide makes every lit surface three times brighter than it should be relative to the
        // sky, which is already radiance and needs no such conversion. The exposure then has to be
        // pulled down to stop the walls saturating, and pulling it down is what left the sky navy.
        // The two are the same fault seen twice.
        colour *= (sun_radiance() * lambert + sky_radiance(normal) * sees_sky + lamp) * (1.0 / kPi);

        // And what the surface gives off, added AFTER the albedo multiply because emission is not
        // reflected light: a lamp's own face is bright whether or not anything is shining on it.
        colour += emission;

        // The distance fade that used to be here is gone. It mixed towards the sky by a hand-picked
        // curve over four thousand voxels, which is aerial perspective done by eye -- and the air
        // below does it from the medium's own extinction, over the distance the ray actually
        // travelled. Keeping both would apply it twice.

        // The visibility buffer carries the node's coverage â€” what fraction of it is
        // matter â€” and it is deliberately NOT used as an alpha here.
        //
        // That was tried and it is wrong. Coverage is a *volumetric fill fraction*, not a
        // screen-space one. A brick on the surface of the ground is about an eighth full
        // and completely opaque when you look at it; blending by fill made distant crates
        // and window frames dither into the sky. The two quantities only coincide for a
        // node seen edge-on.
        //
        // Correct edge anti-aliasing needs either an opacity per face direction, or the
        // ray to continue past a partial hit and composite what is behind. The second
        // falls out naturally once shading is deferred to the face cache in Stage 7, so
        // the data stays in the buffer waiting for it.
    } else {
        colour = sky_colour(dir);
    }

    // ---- the air, then the cloud, then the preview ------------------------------------------
    //
    // Order matters and it is the same order the path tracer uses. Air first, because it acts on
    // whatever the ray reached; cloud second, because the deck is in front of the air for anything
    // beyond it; the preview last, because it is a tool overlay and belongs in front of the world.
    if (push.resolution.z == 0u) {
        colour = apply_media(colour, push.origin.xyz, dir, hit ? t : 0.0);

        // Cloud, from the full-resolution history the cloud pass keeps. Gated by the same slab
        // arithmetic the tracer uses, so a near wall is never painted over by a deck behind it.
        if (push.sky_cloud.x > 0.0) {
            float eye_height = world_height_metres(world_position(push.origin.xyz));
            float begins_m = 0.0;
            bool crossed = true;
            if (abs(dir.y) < 1e-4) {
                crossed = eye_height >= kLowBase && eye_height <= kHighTop;
            } else {
                float to_base = (kLowBase - eye_height) / dir.y;
                float to_roof = (kHighTop - eye_height) / dir.y;
                begins_m = max(min(to_base, to_roof), 0.0);
                crossed = max(to_base, to_roof) > 0.0;
            }
            float reached_m = (hit ? t : push.lens.y) / kVoxelsPerMetre;
            if (crossed && reached_m > begins_m) {
                vec4 cloud = imageLoad(in_cloud[push.motion.z > 0.5 ? 1 : 0], pixel);
                colour = cloud.rgb + cloud.a * colour;
            }
        }

        colour = to_display(colour);
    }

    if (push.resolution.z == 1u) {
        float load = float(steps) / 128.0;
        colour = vec3(clamp(load, 0.0, 1.0), clamp(1.0 - load, 0.0, 1.0), 0.0);
    } else if (push.resolution.z == 2u) {
        colour = hit ? (vec3(face == 0u ? 1.0 : (face == 1u ? 0.5 : 0.0),
                             face == 2u ? 1.0 : (face == 3u ? 0.5 : 0.0),
                             face == 4u ? 1.0 : (face == 5u ? 0.5 : 0.0)))
                     : vec3(0.0);
    } else if (push.resolution.z == 3u) {
        // Detail level: which granularity this pixel was resolved at. Green is full voxel
        // detail, shading toward red as cells get coarser.
        float l = hit ? float(level) / 7.0 : 0.0;
        colour = hit ? mix(vec3(0.1, 0.9, 0.2), vec3(0.9, 0.2, 0.1), l) : vec3(0.0);
    } else if (push.resolution.z == 17u || push.resolution.z == 18u) {
        // Sky visibility on its own, which is the quantity R10 gates on and the one a shaded
        // picture cannot show: darker AO and a lower exposure look identical through a tone curve,
        // so "the room got darker" is not evidence that anything was measured. Grey is the
        // fraction of the hemisphere that reaches sky. Magenta is a pixel with no face, blue one
        // whose face has not been sampled enough to be believed.
        colour = vec3(0.0);
        if (hit) {
            uint slot = imageLoad(in_face, pixel).x;
            if (slot >= faces.items.length()) {
                colour = vec3(1.0, 0.0, 1.0);
            } else {
                uint counters = face_light.words[slot * kFaceLightWords];
                uint samples = counters & 0xFFFFu;
                uint far_samples = (counters >> 16u) & 0xFFFFu;
                if (samples < kShadowSettled) {
                    colour = vec3(0.0, 0.3, 1.0);
                } else if (push.resolution.z == 18u) {
                    // The near field on its own. White is unoccluded; the gate for this term is
                    // that a flat wall in the open reads white everywhere, because a falloff that
                    // darkens a plane against itself is the classic self-occlusion bug and it is
                    // invisible once the two terms are multiplied together.
                    float near_sum = float(face_light.words[slot * kFaceLightWords + 1u]);
                    colour = vec3(1.0 - clamp(near_sum / (float(samples) * 255.0), 0.0, 1.0));
                } else if (far_samples == 0u) {
                    // Blue for the far field too, and it means the same thing it means for the sun:
                    // this pixel is being lit by the fallback. Painting it white would make "fully
                    // open sky" and "no sky ray yet" the same colour, which is trap 10.
                    colour = vec3(0.0, 0.3, 1.0);
                } else {
                    colour = vec3(float(face_light.words[slot * kFaceLightWords + 4u]) /
                                  float(far_samples));
                }
            }
        }
    } else if (push.resolution.z == 19u) {
        // How far through its ambient rays each face is, which is the instrument for the one
        // question a picture of ambient occlusion cannot answer: is this face still costing rays?
        //
        // The pass's cost is a function of how many faces have NOT converged, and a converged face
        // and a face that is one sample short look identical in every shaded view -- so without
        // this, "the pass costs more than it should" and "the answer is wrong" are the same
        // symptom, which is trap 10 exactly. GREEN is converged and silent. RED is held short of
        // convergence because its rays were stopped by geometry the pool has not built, which is
        // the one state that can cost rays for ever. Grey is progress towards kSkyConverged.
        // MAGENTA is a pixel with no face, and BLUE a face with no ambient samples at all.
        colour = vec3(0.0);
        if (hit) {
            uint slot = imageLoad(in_face, pixel).x;
            if (slot >= faces.items.length()) {
                colour = vec3(1.0, 0.0, 1.0);
            } else {
                uint near_n = face_light.words[slot * kFaceLightWords] & 0xFFFFu;
                if (near_n == 0u) {
                    colour = vec3(0.0, 0.3, 1.0);
                } else if (near_n >= kSkyConverged) {
                    colour = vec3(0.0, 1.0, 0.0);
                } else if (near_n == kSkyConverged - 1u) {
                    colour = vec3(1.0, 0.0, 0.0);
                } else {
                    colour = vec3(clamp(float(near_n) / float(kSkyConverged), 0.02, 1.0));
                }
            }
        }
    } else if (push.resolution.z == 20u) {
        // The lamp term on its own, and it exists for the reason every other view in this list
        // does: a shaded picture cannot tell "this surface is not lit by a lamp" from "this surface
        // has not been asked yet", and only the second is a bug. MAGENTA is a pixel with no face,
        // BLUE a face with no lamp samples at all, GREEN no geometry -- black is a legitimate
        // answer here and must not be shared with any of the three.
        //
        // The irradiance itself is tone mapped rather than scaled by a number picked to make this
        // scene look right: a lamp's contribution spans several orders of magnitude between
        // standing under a sconce and standing across a hall from one, and a linear ramp shows one
        // of those and clips the other.
        colour = vec3(0.0, 0.35, 0.0);
        if (hit) {
            uint slot = imageLoad(in_face, pixel).x;
            if (slot >= faces.items.length()) {
                colour = vec3(1.0, 0.0, 1.0);
            } else {
                uint lamp_n = face_light.words[slot * kFaceLightWords + 8u] & 0xFFFFu;
                if (lamp_n == 0u) {
                    colour = vec3(0.0, 0.3, 1.0);
                } else {
                    vec3 e = vec3(uintBitsToFloat(face_light.words[slot * kFaceLightWords + 5u]),
                                  uintBitsToFloat(face_light.words[slot * kFaceLightWords + 6u]),
                                  uintBitsToFloat(face_light.words[slot * kFaceLightWords + 7u])) /
                             float(lamp_n);
                    colour = pow(tonemap_aces(e * (1.0 / kPi)), vec3(1.0 / 2.2));
                }
            }
        }
    } else if (push.resolution.z == 16u) {
        // The sun term on its own, with nothing else in the frame.
        //
        // This view exists because a shaded picture cannot answer the question that matters when
        // shadows look wrong: is this surface mottled because its LIGHT is mottled, or because its
        // colour and its detail level are? Both look identical through albedo and tone mapping,
        // and the first is a shadow bug while the second is the voxel geometry doing what it does.
        //
        // Grey is the visibility fraction. MAGENTA is a pixel whose face the composite could not
        // find, and BLUE is one whose face has not been shaded enough times to be believed -- both
        // of those fall back to full sun, so both look like "no shadow here" in the real picture
        // and neither is distinguishable from a face that is genuinely lit.
        //
        // GREEN is no geometry, and it is green rather than black because black is what a fully
        // shadowed face reads as. Indoors that is nearly every face, so "the sun cannot reach here"
        // and "there is nothing here" were the same pixel -- and counting either of them off this
        // view counted both. Trap 7 in the handover, in the one place built to answer questions.
        colour = vec3(0.0, 0.35, 0.0);
        if (hit) {
            uint slot = imageLoad(in_face, pixel).x;
            if (slot >= faces.items.length()) {
                colour = vec3(1.0, 0.0, 1.0);
            } else {
                uint counters = faces.items[slot].counters;
                uint samples = counters & 0xFFFFu;
                if (samples < kShadowSettled) {
                    colour = vec3(0.0, 0.3, 1.0);
                } else {
                    colour = vec3(float((counters >> 16u) & 0xFFFFu) / float(samples));
                    // RED where the last shadow ray was stopped by a cell the pool has not built
                    // rather than by matter. A grey shadow and a shadow cast by ignorance are the
                    // same picture, and only one of the two is a bug.
                    // Gated on the face actually being dark, not merely on its last ray having
                    // been blocked. Without that a face lit nine times in ten paints red on the
                    // one frame its ray happened to be stopped, and the view reports the whole
                    // frame as broken -- which is what it did, and it is the same over-reading
                    // that a mean hid in D329.
                    float lit_fraction = float((counters >> 16u) & 0xFFFFu) / float(samples);
                    if (lit_fraction < 0.03 && (faces.items[slot].photons & 0x80000000u) != 0u) {
                        colour = vec3(1.0, 0.1, 0.1);
                    }
                }
            }
        }
    }

    // After the debug views, so the preview stays visible in all of them â€” the tool is what
    // you are looking at when you use one.
    colour = draw_preview(colour, push.origin.xyz, dir, hit ? t : push.lens.y);

    if (push.resolution.z == 4u) {
        // Ghost diagnosis: is a clip loaded at all, is the ray reaching a ghost box, is it
        // getting inside one, and is the march finding anything in it.
        colour = vec3(0.0);
        if (push.clip_slot[0].y != 0u) colour.b = 0.35;
        if (g_ghost_boxes > 0) colour.r = 0.6;
        if (g_ghost_entered > 0) colour.b = 1.0;
        if (g_ghost_hit) colour = vec3(0.0, 1.0, 0.0);
    }

    imageStore(out_colour, pixel, vec4(colour, 1.0));
}
