#version 450
// Resolve: turn the visibility buffer into pixels.
//
// The split matters more than it looks. Visibility answers "which face is here"; resolve
// answers "what colour is that face". Stage 7 replaces the body of this shader with a
// lookup into the face radiance cache â€” the same visibility buffer, shaded properly â€”
// without touching the marcher at all. Deferring the shading is also what keeps the
// marcher's inner loop free of material fetches, which on a bandwidth-bound GPU is worth
// more than the extra pass costs.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba32ui) uniform readonly uimage2D in_visibility;
layout(binding = 1, rgba8) uniform writeonly image2D out_colour;

layout(std430, binding = 2) readonly buffer Types { uvec2 items[]; } types;
layout(std430, binding = 3) readonly buffer Visuals { uvec4 items[]; } visuals;

#extension GL_GOOGLE_include_directive : require

// The same block the marcher uses. One declaration of the fields, so a shader can never again
// drift out of step with the buffer it is reading.
layout(std140, binding = 4) uniform Params {
#include "params.glsl"
} push;

// The clipboard's held clip: one cell per voxel, holding the type id plus one so that zero
// can mean "outside the clip". See gpu/render_params.hpp.
layout(std430, binding = 5) readonly buffer ClipCells { uint items[]; } clip;

// The cloud volume the cloud pass keeps, at full resolution. Two images alternating; the parity
// arrives in the push constant, the same as in the path tracer.
layout(binding = 20, rgba16f) uniform readonly image2D in_cloud[2];

// The same push constant the tracer and the cloud pass receive. This pass had NONE before, which is
// why it could not see the sun, the weather or the air: three of the four things a sky is made of.
layout(push_constant) uniform Trace {
    vec4 sun;
    vec4 sun_colour;
    uvec4 control;
    uvec4 quality;
    vec4 fog;
    vec4 fog_shape;
} trace;

const float kPi = 3.14159265358979;
const int kChunkEdge = 256;

// pt_sky.glsl and pt_clouds.glsl want this. Defined here rather than pulled in with a header,
// because that header brings a second kPi and a hundred functions this pass never calls.
uint hash_u32(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

#include "pt_sky.glsl"
#include "pt_clouds.glsl"
#include "pt_media.glsl"

// The real sky, the same one the path tracer draws.
//
// What was here was a three-colour vertical gradient with the numbers written into it. That is why
// none of the sky work of the last while appeared in the game: this is the pass that runs by
// default -- path tracing is off unless --pathtrace is passed or F4 is pressed -- and it shared no
// code at all with the renderer the work went into. Clouds, atmosphere, sun colour, time of day:
// none of it could reach the screen a player actually looks at.
vec3 sky_colour(vec3 dir) {
    return sky_radiance(dir);
}

// Physical radiance out, display value in.
//
// This pass had nothing to tone map before, because everything in it was authored in display units
// already: a voxel's colour is its ALBEDO, a number between nought and one, flat shaded by face.
// The sky and the cloud are not — they are radiance, and the sun in them is thousands of times
// brighter than a lit wall.
//
// Tone mapping the whole frame the first time round therefore darkened every surface in the world,
// because x/(x+1) applied to a value already in nought-to-one halves it: an albedo of 0.5 came out
// at 0.33. Reported as everything being slightly darker, and that is exactly what it was.
//
// So the surfaces are lifted INTO radiance first, and then the whole frame is tone mapped once from
// a single consistent space. Multiplying an albedo by an illuminance is what shading is; this pass
// simply has one number for the illuminance instead of computing it.
// Fixed rather than measured. The tracer's frame_exposure() reads the frame statistics buffer it
// fills itself, which this pass has no binding for and no business writing.
const float kPreviewExposure = 0.5;

vec3 to_display(vec3 radiance) {
    vec3 mapped = radiance * kPreviewExposure;
    mapped = mapped / (mapped + vec3(1.0));
    // GAMMA, and leaving it out is most of why the first attempt came out nearly black. The tracer
    // encodes with pow(1/2.2) after tone mapping because the swapchain is UNORM and expects an
    // encoded value; a linear one written straight into it reads about a third as bright.
    return pow(clamp(mapped, 0.0, 1.0), vec3(1.0 / 2.2));
}

// Albedo into radiance. Set so a mid-grey wall comes back out mid-grey through the curve above,
// which keeps this preview looking like it did before it learned about the sky.
const float kPreviewLight = 1.1;

vec3 unpack_rgb(uint packed) {
    return vec3(float(packed & 0xFFu), float((packed >> 8u) & 0xFFu),
                float((packed >> 16u) & 0xFFu)) / 255.0;
}

#include "preview.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(push.resolution.x) || pixel.y >= int(push.resolution.y)) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(push.resolution) * 2.0 - 1.0;
    float aspect = float(push.resolution.x) / float(push.resolution.y);
    vec3 dir = normalize(push.forward.xyz +
                         push.right.xyz * uv.x * push.lens.x * aspect -
                         push.up.xyz * uv.y * push.lens.x);

    uvec4 packed = imageLoad(in_visibility, pixel);
    bool hit = packed.x != 0xFFFFFFFFu;
    float t = uintBitsToFloat(packed.w);
    uint face = packed.x & 0xFFu;
    uint level = (packed.x >> 8u) & 0xFFu;
    uint steps = hit ? ((packed.x >> 16u) & 0xFFu) : packed.z;

    vec3 colour;
    if (hit) {
        if (level == 0u) {
            uint visual_id = types.items[packed.y].x;
            colour = unpack_rgb(visuals.items[visual_id].x);
        } else {
            colour = unpack_rgb(packed.z);
        }

        // Flat shading by face direction. No lighting yet â€” Stage 7 replaces this with
        // the face radiance cache. It exists so geometry is legible.
        vec3 normal = vec3(0.0);
        if (face == 0u) normal = vec3(1, 0, 0);
        else if (face == 1u) normal = vec3(-1, 0, 0);
        else if (face == 2u) normal = vec3(0, 1, 0);
        else if (face == 3u) normal = vec3(0, -1, 0);
        else if (face == 4u) normal = vec3(0, 0, 1);
        else normal = vec3(0, 0, -1);

        colour *= 0.55 + 0.45 * clamp(dot(normal, normalize(vec3(0.4, 0.85, 0.3))), 0.0, 1.0);

        float fade = clamp(t / 4000.0, 0.0, 1.0);
        colour = mix(colour, sky_colour(dir), fade * fade * 0.5);

        // The visibility buffer carries the node's coverage â€” what fraction of it is
        // matter â€” and it is deliberately NOT used as an alpha here.
        //
        // That was tried and it is wrong. Coverage is a *volumetric fill fraction*, not a
        // screen-space one. A brick on the surface of the ground is about an eighth full
        // and completely opaque when you look at it; blending by fill made distant crates
        // and window frames dither into the sky. The two quantities only coincide for a
        // node seen edge-on.
        //
        // Correct edge anti-aliasing needs either an opacity per face direction, or the
        // ray to continue past a partial hit and composite what is behind. The second
        // falls out naturally once shading is deferred to the face cache in Stage 7, so
        // the data stays in the buffer waiting for it.
    } else {
        colour = sky_colour(dir);
    }

    // ---- the air, then the cloud, then the preview ------------------------------------------
    //
    // Order matters and it is the same order the path tracer uses. Air first, because it acts on
    // whatever the ray reached; cloud second, because the deck is in front of the air for anything
    // beyond it; the preview last, because it is a tool overlay and belongs in front of the world.
    if (push.resolution.z == 0u) {
        // Albedo into radiance, so that everything from here down is in one space. The sky already
        // is; only what the geometry produced needs lifting.
        if (hit) colour *= kPreviewLight;

        colour = apply_media(colour, push.origin.xyz, dir, hit ? t : 0.0);

        // Cloud, from the full-resolution history the cloud pass keeps. Gated by the same slab
        // arithmetic the tracer uses, so a near wall is never painted over by a deck behind it.
        if (push.sky_cloud.x > 0.0) {
            float eye_height = world_height_metres(world_position(push.origin.xyz));
            float begins_m = 0.0;
            bool crossed = true;
            if (abs(dir.y) < 1e-4) {
                crossed = eye_height >= kLowBase && eye_height <= kHighTop;
            } else {
                float to_base = (kLowBase - eye_height) / dir.y;
                float to_roof = (kHighTop - eye_height) / dir.y;
                begins_m = max(min(to_base, to_roof), 0.0);
                crossed = max(to_base, to_roof) > 0.0;
            }
            float reached_m = (hit ? t : push.lens.y) / kVoxelsPerMetre;
            if (crossed && reached_m > begins_m) {
                vec4 cloud = imageLoad(in_cloud[push.motion.z > 0.5 ? 1 : 0], pixel);
                colour = cloud.rgb + cloud.a * colour;
            }
        }

        colour = to_display(colour);
    }

    if (push.resolution.z == 1u) {
        float load = float(steps) / 128.0;
        colour = vec3(clamp(load, 0.0, 1.0), clamp(1.0 - load, 0.0, 1.0), 0.0);
    } else if (push.resolution.z == 2u) {
        colour = hit ? (vec3(face == 0u ? 1.0 : (face == 1u ? 0.5 : 0.0),
                             face == 2u ? 1.0 : (face == 3u ? 0.5 : 0.0),
                             face == 4u ? 1.0 : (face == 5u ? 0.5 : 0.0)))
                     : vec3(0.0);
    } else if (push.resolution.z == 3u) {
        // Detail level: which granularity this pixel was resolved at. Green is full voxel
        // detail, shading toward red as cells get coarser.
        float l = hit ? float(level) / 7.0 : 0.0;
        colour = hit ? mix(vec3(0.1, 0.9, 0.2), vec3(0.9, 0.2, 0.1), l) : vec3(0.0);
    }

    // After the debug views, so the preview stays visible in all of them â€” the tool is what
    // you are looking at when you use one.
    colour = draw_preview(colour, push.origin.xyz, dir, hit ? t : push.lens.y);

    if (push.resolution.z == 4u) {
        // Ghost diagnosis: is a clip loaded at all, is the ray reaching a ghost box, is it
        // getting inside one, and is the march finding anything in it.
        colour = vec3(0.0);
        if (push.clip_slot[0].y != 0u) colour.b = 0.35;
        if (g_ghost_boxes > 0) colour.r = 0.6;
        if (g_ghost_entered > 0) colour.b = 1.0;
        if (g_ghost_hit) colour = vec3(0.0, 1.0, 0.0);
    }

    imageStore(out_colour, pixel, vec4(colour, 1.0));
}
