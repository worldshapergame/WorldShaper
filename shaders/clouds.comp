#version 450
// The cloud volume, marched once for every sixteen pixels.
//
// # Why a pass of its own
//
// Cloud costs what its march costs, and its march costs what its steps cost. Measured on the
// facility's sky view: sixteen steps is 2.77 ms, thirty-two is 5.00, seventy-two is 6.09. Linear,
// and then saturating as rays start finishing early. There is no arrangement of the inner loop
// that changes that by an order of magnitude — reaching a tenth by cutting steps would mean about
// five of them, which is not a cloud.
//
// So the saving has to come from marching fewer PIXELS, and cloud is the one thing in the picture
// that can afford it. A cumulus is a thousand metres across and its softest edge is tens of metres
// wide; at a kilometre away that edge covers many pixels, so the field genuinely carries no
// detail at the pixel level to lose. Everything else on screen does — which is exactly why this is
// a separate pass rather than a lower resolution for the whole renderer.
//
// One march per four-by-four block, bilinearly interpolated on the way out. Sixteen times fewer
// marches, and the budget that frees is spent on more steps per march, so the clouds come out
// BETTER as well as cheaper.
//
// # Why it cannot be done inside the path tracer
//
// The obvious version shares one march across a workgroup through `shared` memory and a barrier.
// It is not available here: pathtrace.comp returns early from `main` in several places — a summary
// hit, a pixel not refining this frame, each debug view — and a barrier that only some invocations
// of a workgroup reach is undefined behaviour. A separate dispatch has no such problem because
// every invocation of it does the same work.
//
// # What it stores
//
// rgb is the light scattered towards the eye along the ray, already including the aerial
// perspective. The alpha is the transmittance: what fraction of whatever is behind survives. The
// consumer composites `cloud.rgb + cloud.a * behind`, which is the same arithmetic the march used
// to do inline.

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;

// Binding 20 of the path tracer's own set, which this pass borrows whole: it needs the parameter
// block and the sun, and both are already in it. Sharing the layout is why this costs one binding
// and one dispatch rather than a set of its own.
layout(binding = 20, rgba16f) uniform writeonly image2D out_cloud;

layout(std140, binding = 13) uniform Params {
#include "params.glsl"
} push;

layout(push_constant) uniform Trace {
    vec4 sun;
    vec4 sun_colour;
    uvec4 control;
    uvec4 quality;
    vec4 fog;
    vec4 fog_shape;
} trace;

const float kPi = 3.14159265358979;
const int kChunkEdge = 256;

// The sky's own noise wants this. It is defined in pathtrace.comp rather than in a shared file,
// and copying four lines is better than including the whole sampling header for them — that header
// brings a second definition of kPi and a dozen functions this pass never calls.
uint hash_u32(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

#include "pt_sky.glsl"
#include "pt_clouds.glsl"

void main() {
    ivec2 low = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_cloud);
    if (low.x >= size.x || low.y >= size.y) return;

    // The full-resolution pixel this block stands for, JITTERED within the block each frame.
    //
    // A quarter-resolution sample cannot hold detail finer than four pixels, and near the horizon
    // the deck is seen edge-on and genuinely does carry it — so a fixed sample point puts visible
    // stair-steps along the skyline where a bilinear read cannot invent what was never sampled.
    //
    // Moving the sample point around inside its block each frame turns that into something the
    // accumulator can dissolve: over a few dozen frames every part of the block gets marched, and
    // the running mean converges on the answer a full-resolution march would have given. It is the
    // same trade the path tracer already makes everywhere else — spread the error over time rather
    // than over space — and it costs one addition.
    //
    // A golden-ratio pair rather than a hash, so successive frames land far apart instead of
    // clumping, and the sequence covers the block evenly at any number of frames.
    float n = float(trace.control.z);
    vec2 jitter = vec2(fract(n * 0.61803399), fract(n * 0.38196601)) - 0.5;
    vec2 full = (vec2(low) + 0.5 + jitter) * float(kCloudScale);
    vec2 uv = full / vec2(push.resolution.xy) * 2.0 - 1.0;
    float aspect = float(push.resolution.x) / float(push.resolution.y);
    vec3 dir = normalize(push.forward.xyz +
                         push.right.xyz * uv.x * push.lens.x * aspect -
                         push.up.xyz * uv.y * push.lens.x);

    vec3 from = world_position(push.origin.xyz);
    float through = 1.0;
    vec3 scattered = vec3(0.0);
    if (push.sky_cloud.x > 0.0) {
        scattered = cloud_march(from, dir, world_height_metres(from), kCloudFarMetres, through);
        // A mean that has had a NaN added to it is a NaN for ever, and this one is read by
        // sixteen pixels rather than one.
        if (any(isnan(scattered)) || any(isinf(scattered))) scattered = vec3(0.0);
        if (isnan(through) || isinf(through)) through = 1.0;
    }
    imageStore(out_cloud, low, vec4(scattered, through));
}
