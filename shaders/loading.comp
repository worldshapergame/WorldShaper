#version 450
// What the game shows while it is building the world.
//
// This is the first piece of the interface, so it is also where the ink rule stops being a
// document and starts being something you can look at. documentation/14-ui-style.md is the
// specification and shaders/ui.glsl is its implementation; everything below only arranges things
// and lets that decide what colour they come out.
//
// # Why the bar is drawn as ink
//
// The obvious way to draw a progress bar is a dark track and a bright fill in the accent colour.
// That is a bar with a colour of its own, which is the one thing the style forbids, and it fails
// in the ordinary way the moment you put the percentage on top of it: black text vanishes into the
// filled part, white text vanishes into the empty part, and the usual fix is to move the number
// off the bar entirely.
//
// So the fill IS ink — the same function every mark uses, given the backdrop under the bar. And
// then the percentage is ink over whatever is under IT, which is the fill on the left of the head
// and the track on the right. The number inverts as the bar passes under it, per pixel, with no
// branch and nothing to configure. It is the smallest thing on screen that shows the rule paying
// for itself.
//
// # Why there is a backdrop at all
//
// A panel's backdrop is normally the world behind it, blurred. Here there is no world yet: that is
// the entire point of the screen. So it makes its own — a dark drift that moves slowly enough to
// read as depth rather than as animation — and the rule governs everything on top of it exactly as
// it will over a sunset later.
//
// # The strings come from the CPU
//
// A shader with a table of stage names in it is a second place for them to be wrong. `stage_name`
// in src/app/loading.hpp is the only list; the words arrive packed four to a uint. Nothing here
// knows what a stage is called, and adding one costs nothing on this side.

#extension GL_GOOGLE_include_directive : require
#include "ui.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform writeonly image2D out_image;

// Three text slots, packed four characters to a uint, zero-terminated: the stage, the quantity,
// and the time remaining. Twenty-four characters each is what the font's line length already is.
const uint kSlotStage = 0u;     // uints 0..5
const uint kSlotCount = 6u;     // uints 6..11
const uint kSlotLeft = 12u;     // uints 12..17

layout(push_constant) uniform Push {
    vec2 resolution;
    float time;             // seconds since the load began, for the animation
    float fraction;         // 0 to 1, of the whole load

    float scale;            // device pixels per interface pixel
    uint stage;             // which animated mark to draw
    uint button;            // 0 no way in yet, 1 offered, 2 under the pointer, 3 taken
    uint button_chars;      // how long the label is; the eight bytes carry no terminator

    vec3 accent;            // the player's colour, used only where inversion is blind
    float pad2;

    uint text[18];
    uint button_text[2];    // eight characters, four to a uint -- see src/gpu/loading_screen.cpp
} push;

// --- the strings ------------------------------------------------------------------------------

uint text_char(uint slot, uint index) {
    return (push.text[slot + (index >> 2u)] >> ((index & 3u) * 8u)) & 0xFFu;
}

uint text_length(uint slot) {
    for (uint i = 0u; i < 24u; ++i) {
        if (text_char(slot, i) == 0u) return i;
    }
    return 24u;
}

// Interface pixels per glyph pixel.
//
// The typeface is three by five, which is the smallest a letter can be drawn and still be read at
// one pixel per pixel — and one pixel per pixel is not what a loading screen is. On the machine
// this has to work on at all (1280×800, where `push.scale` comes out as one) a capital would be
// five device pixels tall, so the words are set at two: ten pixels of capital, against the seven
// the old five-by-seven face gave at the same place, in two thirds of the ink.
const float kTextPixels = 2.0;

// How much ink a slot puts at a point, `at` measured in glyph pixels from the string's left edge
// and its capitals' top. Same geometry as ui_text, reading from the packed slot instead of an
// array, and with no length limit of its own. The walk is a loop rather than a divide because the
// face is proportional: an `i` is one pixel wide and an `m` is five.
float slot_ink(uint slot, uint length, vec2 at) {
    if (at.y < 0.0 || at.y >= float(kUiRows + 1)) return 0.0;
    float pen = 0.0;
    for (uint i = 0u; i < length; ++i) {
        uvec2 glyph = ui_glyph(text_char(slot, i));
        float step = ui_step(glyph, kUiPlain);
        if (at.x >= pen && at.x < pen + step) {
            return ui_ink_at(glyph, vec2(at.x - pen, at.y), kUiPlain, max(kUiBoldReach, 1.0 / kTextPixels));
        }
        pen += step;
    }
    return 0.0;
}

float slot_width(uint slot, uint length) {
    float pen = 0.0;
    for (uint i = 0u; i < length; ++i) pen += ui_step(ui_glyph(text_char(slot, i)), kUiPlain);
    return max(pen - 1.0, 0.0);
}

// A string centred on a point, in interface pixels. Returns coverage.
float centred_text(uint slot, vec2 at, vec2 centre_top) {
    uint length = text_length(slot);
    if (length == 0u) return 0.0;
    vec2 local = (at - centre_top) / kTextPixels;
    return slot_ink(slot, length, local + vec2(slot_width(slot, length) * 0.5, 0.0));
}

// The percentage, drawn from the same number that drives the bar so the two can never disagree.
float percent_ink(vec2 at, vec2 centre_top, float fraction) {
    int whole = int(floor(clamp(fraction, 0.0, 1.0) * 100.0 + 0.5));
    uint digits[4];
    uint count = 0u;
    if (whole >= 100) { digits[count++] = 49u; digits[count++] = 48u; digits[count++] = 48u; }
    else if (whole >= 10) { digits[count++] = 48u + uint(whole / 10); digits[count++] = 48u + uint(whole % 10); }
    else { digits[count++] = 48u + uint(whole); }
    digits[count++] = 37u;   // %

    float width = 0.0;
    for (uint i = 0u; i < count; ++i) width += ui_step(ui_glyph(digits[i]), kUiPlain);
    width = max(width - 1.0, 0.0);

    vec2 local = (at - centre_top) / kTextPixels + vec2(width * 0.5, 0.0);
    if (local.y < 0.0 || local.y >= float(kUiRows + 1)) return 0.0;
    float pen = 0.0;
    for (uint i = 0u; i < count; ++i) {
        uvec2 glyph = ui_glyph(digits[i]);
        float step = ui_step(glyph, kUiPlain);
        if (local.x >= pen && local.x < pen + step) {
            return ui_ink_at(glyph, vec2(local.x - pen, local.y), kUiPlain, max(kUiBoldReach, 1.0 / kTextPixels));
        }
        pen += step;
    }
    return 0.0;
}

// --- the way in -------------------------------------------------------------------------------
//
// The label is its own tiny slot rather than a fourth line of `text`, because the push block is
// exactly 128 bytes and a fourth line is 24. Eight characters, no terminator, with the length in
// `button_chars`.
uint button_char(uint index) {
    return (push.button_text[index >> 2u] >> ((index & 3u) * 8u)) & 0xFFu;
}

float button_label_ink(vec2 local) {
    if (local.y < 0.0 || local.y >= float(kUiRows + 1)) return 0.0;
    float pen = 0.0;
    for (uint i = 0u; i < push.button_chars && i < 8u; ++i) {
        uvec2 glyph = ui_glyph(button_char(i));
        float step = ui_step(glyph, kUiPlain);
        if (local.x >= pen && local.x < pen + step) {
            return ui_ink_at(glyph, vec2(local.x - pen, local.y), kUiPlain,
                             max(kUiBoldReach, 1.0 / kTextPixels));
        }
        pen += step;
    }
    return 0.0;
}

float button_label_width() {
    float pen = 0.0;
    for (uint i = 0u; i < push.button_chars && i < 8u; ++i) {
        pen += ui_step(ui_glyph(button_char(i)), kUiPlain);
    }
    return max(pen - 1.0, 0.0);
}

// The same rectangle `loading_button_rect` in src/app/loading.hpp hands the hit test, in the same
// units: interface pixels from the centre of the column. Written twice and only twice, and the
// bar's own kBarWidth below is written the same way for the same reason -- a shader cannot include
// a C++ header, and a push constant for three constants that never change is a worse trade.
// **If one of these three moves, move the three in src/app/loading.hpp with it.**
const float kButtonHalfWidth = 46.0;
const float kButtonTop = 54.0;
const float kButtonBottom = 76.0;

// --- the animated marks -----------------------------------------------------------------------
//
// One per stage, drawn as pixels in a thirteen by thirteen cell so they belong to the same
// alphabet as the letters beside them. They exist because a bar that has not moved for four
// seconds is indistinguishable from a game that has died, and a mark that is still moving is the
// cheapest possible answer to that. Each one is a picture of what the stage actually does, which
// is the only reason to have seven rather than one spinner.

float hash11(float n) { return fract(sin(n) * 43758.5453123); }
float hash21(ivec2 c) { return hash11(float(c.x) * 12.9898 + float(c.y) * 78.233); }

bool mark_reading(ivec2 c, float t) {
    // Lines of text scrolling up under a fixed margin, the way a file goes past.
    int row = int(mod(float(c.y) + floor(t * 5.0), 13.0));
    if (c.x == 0 || c.x == 12) return false;
    if ((row % 3) != 0) return false;
    int length = 3 + int(hash11(float(row) * 3.7 + floor(t * 5.0 / 13.0)) * 8.0);
    return c.x >= 1 && c.x <= length;
}

bool mark_sampling(ivec2 c, float t) {
    // A grid of matter with an edge cutting across it: the sampler deciding, cell by cell, which
    // side of the shape it is on.
    float sweep = mod(t * 9.0, 26.0) - 6.0;
    float across = float(c.x + c.y) * 0.5;
    if (across > sweep) return ((c.x & 1) == 0) && ((c.y & 1) == 0);
    return abs(across - sweep) < 1.2 ? true : ((c.x & 1) == 0 && (c.y & 1) == 0 && hash21(c) > 0.45);
}

bool mark_varying(ivec2 c, float t) {
    // Every cell on its own clock, because that is exactly what variation is: no two voxels of the
    // same material coming out alike.
    float own = hash21(c);
    return fract(t * 0.7 + own) > 0.55;
}

bool mark_stamping(ivec2 c, float t) {
    // Blocks falling into a stack, one column at a time.
    float phase = mod(t * 2.2, 13.0);
    int settled = int(phase);
    if (c.y >= 12 - settled) return true;
    int falling = int(mod(floor(phase * 3.0), 13.0));
    return c.y == falling && c.x >= 5 && c.x <= 7;
}

bool mark_caching(ivec2 c, float t) {
    // Something going down into a box that keeps it.
    bool box = (c.y >= 8) && (c.x == 1 || c.x == 11 || c.y == 12);
    float drop = mod(t * 4.0, 9.0);
    bool arrow = (c.x >= 5 && c.x <= 7) && (float(c.y) < drop) && c.y < 8;
    bool head = (abs(float(c.y) - drop) < 1.0) && abs(c.x - 6) <= int(2.0 - abs(float(c.y) - drop) * 2.0);
    return box || arrow || head;
}

bool mark_uploading(ivec2 c, float t) {
    // Chevrons crossing to the right: bricks going to the card.
    float shift = mod(t * 11.0, 6.0);
    float x = mod(float(c.x) - shift + 12.0, 6.0);
    return abs(x - abs(float(c.y) - 6.0) * 0.6) < 1.1;
}

bool mark_settling(ivec2 c, float t) {
    // A ring closing, which is what the last stage is: everything already there, being tied off.
    vec2 p = vec2(c) - vec2(6.0);
    float r = length(p);
    if (r < 4.0 || r > 6.0) return false;
    float angle = atan(p.y, p.x) + 3.14159265;
    float gap = mod(t * 3.0, 6.2831853);
    return mod(angle - gap + 6.2831853, 6.2831853) > 1.1;
}

bool mark_filling(ivec2 c, float t) {
    // A grid filling in from the middle outwards: the ladder sharpening the world one node at a
    // time, from where you are standing to the far side of it. Every other mark on this screen is
    // about something passing through; this one is about something being COMPLETED, so it grows
    // and starts again rather than scrolling.
    vec2 p = vec2(c) - vec2(6.0);
    float ring = max(abs(p.x), abs(p.y));           // square rings, because the world is boxes
    float front = mod(t * 3.5, 8.0);
    if (ring > front) return false;                  // not reached yet
    if (ring > front - 1.2) return true;             // the edge that is arriving, solid
    return ((c.x & 1) == 0) == ((c.y & 1) == 0);     // and behind it, filled in
}

bool mark_on(uint stage, ivec2 c, float t) {
    if (c.x < 0 || c.x > 12 || c.y < 0 || c.y > 12) return false;
    if (stage == 0u) return mark_reading(c, t);
    if (stage == 1u) return mark_sampling(c, t);
    if (stage == 2u) return mark_varying(c, t);
    if (stage == 3u) return mark_stamping(c, t);
    if (stage == 4u) return mark_caching(c, t);
    if (stage == 5u) return mark_uploading(c, t);
    if (stage == 6u) return mark_settling(c, t);
    return mark_filling(c, t);
}

// --- the screen -------------------------------------------------------------------------------

// The backdrop this screen makes for itself, since there is no world behind it yet. Dark, so the
// ink comes out bright, and drifting slowly so the eye reads depth rather than a flat fill.
vec3 backdrop_at(vec2 uv, float t) {
    float down = uv.y;
    float corner = length(uv - vec2(0.5, 0.42));
    float drift = 0.5 + 0.5 * sin(t * 0.15 + uv.x * 1.7 + uv.y * 0.9);
    float value = 0.055 + 0.045 * down + 0.02 * drift - 0.035 * corner;
    return vec3(max(value, 0.02));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(out_image);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    float t = push.time;

    vec3 colour = backdrop_at(uv, t);

    // Everything below is in interface pixels measured from the centre of the column, so the
    // layout is written once and holds at any window size.
    vec2 at = (vec2(pixel) + 0.5 - vec2(size) * 0.5) / max(push.scale, 1.0);

    const float kBarWidth = 300.0;
    const float kBarHeight = 12.0;
    const float kHalf = kBarWidth * 0.5;

    // --- the bar ------------------------------------------------------------------------
    //
    // Drawn before anything else, because it becomes the backdrop for the number on top of it.
    bool in_bar = abs(at.x) <= kHalf && at.y >= -kBarHeight * 0.5 && at.y <= kBarHeight * 0.5;
    if (in_bar) {
        float head = -kHalf + kBarWidth * clamp(push.fraction, 0.0, 1.0);
        vec3 ink = ui_ink(colour, push.accent);
        if (at.x <= head) {
            colour = ink;
        } else {
            // The empty track is the same ink at a whisper, so the bar's full length is legible
            // before it has filled any of it — otherwise a bar at two per cent is a dash floating
            // in the dark with no indication of how far it has to go.
            colour = mix(colour, ink, 0.10);
        }
    }
    // A hairline edge, so the track's end is exact rather than approximately where the whisper
    // fades out.
    {
        float edge_x = abs(abs(at.x) - kHalf);
        float edge_y = abs(abs(at.y) - kBarHeight * 0.5);
        bool on_edge = (edge_x < 1.0 && abs(at.y) <= kBarHeight * 0.5 + 1.0) ||
                       (edge_y < 1.0 && abs(at.x) <= kHalf + 1.0);
        if (on_edge) colour = mix(colour, ui_ink(colour, push.accent), 0.35);
    }

    // --- the marks ----------------------------------------------------------------------
    //
    // Each one asks the ink rule what colour it has to be against whatever it is standing on,
    // which for the percentage is the bar and for everything else is the backdrop.
    float coverage = 0.0;

    // The stage's own icon, above the words.
    {
        vec2 cell = at - vec2(-6.5, -52.0);
        if (mark_on(push.stage, ivec2(floor(cell)), t)) coverage = 1.0;
    }

    // The capitals are ten interface pixels tall now (five glyph pixels at kTextPixels), so the
    // rows below the bar sit at 18 and 32 rather than 16 and 28: two lines of ten with room to
    // breathe, rather than two lines of seven that happened to fit twelve apart.
    coverage = max(coverage, centred_text(kSlotStage, at, vec2(0.0, -32.0)));
    coverage = max(coverage, percent_ink(at, vec2(0.0, -5.0), push.fraction));
    coverage = max(coverage, centred_text(kSlotCount, at, vec2(0.0, 18.0)));
    coverage = max(coverage, centred_text(kSlotLeft, at, vec2(0.0, 32.0)));

    if (coverage > 0.0) colour = mix(colour, ui_ink(colour, push.accent), coverage);

    // --- the way in ---------------------------------------------------------------------
    //
    // Drawn last and over its own backdrop, for the same reason the percentage is drawn over the
    // bar: a filled button is a backdrop, and the label on it has to be ink against THAT rather
    // than against the drift behind it. So the fill goes down first and `ui_ink` is asked a second
    // time with the new colour under it — which is how the label stays legible whether the button
    // is a hairline outline or a solid block, with no second colour anywhere.
    if (push.button != 0u) {
        bool inside = abs(at.x) <= kButtonHalfWidth && at.y >= kButtonTop && at.y <= kButtonBottom;
        float edge_x = abs(abs(at.x) - kButtonHalfWidth);
        float edge_y = min(abs(at.y - kButtonTop), abs(at.y - kButtonBottom));
        bool on_edge = inside && (edge_x < 1.0 || edge_y < 1.0);

        if (inside) {
            vec3 ink = ui_ink(colour, push.accent);
            // Offered: a whisper, so it reads as available without competing with the bar.
            // Under the pointer: brighter. Taken: solid, and it stays solid for the frame or two
            // between the press and the world appearing, which is the only acknowledgement there
            // is room for.
            float fill = (push.button >= 3u) ? 1.0 : ((push.button == 2u) ? 0.30 : 0.10);
            colour = mix(colour, ink, fill);
            if (on_edge) colour = mix(colour, ink, 0.55);
        }

        float centre = (kButtonTop + kButtonBottom) * 0.5;
        // Capitals are kUiRows glyph pixels tall at kTextPixels interface pixels each.
        float half_text = float(kUiRows) * kTextPixels * 0.5;
        vec2 local = (at - vec2(0.0, centre - half_text)) / kTextPixels
                     + vec2(button_label_width() * 0.5, 0.0);
        float label = button_label_ink(local);
        if (label > 0.0) colour = mix(colour, ui_ink(colour, push.accent), label);
    }

    imageStore(out_image, pixel, vec4(colour, 1.0));
}
