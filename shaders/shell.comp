#version 450
// The interface, drawn.
//
// documentation/14-ui-style.md is the specification, shaders/ui.glsl is the ink rule and the
// typeface, and src/ui/draw.hpp is the list this reads. Everything here is *shapes*: what colour
// each one comes out is decided by `ui_ink` against whatever is already behind it, and nothing in
// this file names a colour except the five the style permits.
//
// # Why a pixel walks a list instead of the list being drawn
//
// The style prices the ink at about forty-six nanoseconds a pixel and the interface's whole budget
// at 0.6 ms (documentation/09-performance-budgets.md), so running it over 1440p would spend six
// milliseconds deciding that nothing is there. The rule it states is *run the ink only over panel
// rectangles, never the full screen*. So the host bins every mark into sixteen-pixel tiles, the
// dispatch covers only the rectangle those tiles occupy, and each pixel walks its own tile's short
// list — which for a docked window is a handful of entries and for the world in the middle is none
// at all, because the dispatch never reaches it.
//
// # Why the order is the compositing order
//
// A pixel evaluates its tile's marks in the order the host added them, accumulating colour as it
// goes. So a label added after the glass it sits on reads the GLASS as its backdrop and inverts
// against that, rather than against the world two layers down. That is the same mechanism that
// makes the loading bar's percentage invert per pixel as the fill passes under it, and it is why
// nothing in this interface needs to know what is behind it.

#extension GL_GOOGLE_include_directive : require
#include "ui.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D target;
layout(binding = 1, rgba16f) uniform readonly image2D blurred;   // quarter resolution

// One instruction. The layout is duplicated field for field from src/ui/draw.hpp, and a
// disagreement is a picture that is wrong in a way no compiler can see — so the struct there
// carries the same comment and a static assertion on its size.
struct Command {
    vec4 rect;    // x0, y0, x1, y1 in device pixels
    vec4 clip;    // and the window it is inside
    uint kind;
    uint a;       // Text: the first character.  Icon: which.  Hue/Logo: 0xRRGGBB
    uint b;       // Text: how many.  Logo: the seed
    uint style;   // Text: the style bits.  Logo: the seed before this one
    float f0;     // coverage
    float f1;     // Text: the pen's x.   Icon: the animation's phase.
                  // Logo: where its two frames start in `characters`
    float f2;     // Text: the capitals' top y.  Logo: seconds since the seed was chosen
    float f3;     // Text: device pixels per glyph pixel.  Edge: its thickness.
                  // Logo: how far through the morph out of the seed before it, 1 when settled
};

layout(std430, binding = 2) readonly buffer Commands { Command commands[]; };
layout(std430, binding = 3) readonly buffer Characters { uint characters[]; };
layout(std430, binding = 4) readonly buffer Tiles { uvec2 tiles[]; };        // first, count
layout(std430, binding = 5) readonly buffer TileIndices { uint tile_indices[]; };

layout(push_constant) uniform Push {
    vec2 resolution;
    vec2 origin;          // the top-left of the dispatch, in device pixels

    uvec2 tile_counts;    // across, down
    float seconds;
    float pad0;

    vec3 accent;          // the player's colour, used only where inversion is blind
    float pad1;

    // The three hues the interface is allowed, worked out ONCE on the host by `ui::tint_of` and
    // handed over rather than rotated here. Two of `14-ui-style.md`'s five permitted colours are
    // these same three — a node-graph wire, and a part of a command line — and a wire drawn from
    // host RGB beside a word coloured from a shader's own rotation is one place for the two to
    // disagree about what "a shape" looks like.
    vec4 tints[3];
} push;

// The mark, its drawing, its animations, its patterns, its palettes, the folds it arranges itself
// into and the transitions between two of them. It is a file of its own because none of it is shared
// with anything else here: every other shape in this shader is a thirteen-cell icon that answers a
// press, and the logo is a picture that answers a clock.
//
// It goes BELOW the buffers on purpose: it reads `characters` — the same buffer the text runs out of
// — because the host sorts the mark's slices and a hundred and sixty words does not deserve an
// upload of its own. See `src/ui/logo.hpp` for why the sort cannot be on this side of the line.
#include "logo.glsl"

const uint kGlass = 0u;
const uint kInk = 1u;
const uint kText = 2u;
const uint kIcon = 3u;
const uint kHue = 4u;
const uint kEdge = 5u;
const uint kLogo = 6u;

// --- the drawings -------------------------------------------------------------------------------
//
// An icon is the control and the label is the fallback, so this is the interface's actual
// vocabulary. Each is a picture of what the thing DOES, and each ANIMATES to say it did it, never
// to say a pointer is over it.
//
// # Why these are distance fields and not a grid of cells
//
// They were a thirteen-by-thirteen grid of booleans, and a grid is a resolution: at the size a row
// sets an icon — sixteen interface pixels, which on a Steam Deck is sixteen DEVICE pixels — a cell
// is one and a quarter pixels. So every diagonal was a staircase, every circle a lump, nothing
// could be drawn finer than a cell however good the screen was, and there was no antialiasing
// anywhere because a boolean has no edge to soften. A signed distance has no resolution at all:
// the drawing is stated in continuous coordinates and sampled at whatever the screen has, so one
// source is a clean shape at sixteen pixels and a detailed one at ninety-six, and the coverage of
// an edge is the distance to it measured in device pixels — which is the one number the grid could
// never know.
//
// # The rules the set is drawn to
//
//   **A stroke is a letter's stroke.** The cell below is 64 units across and an icon is nominally
//   16 interface pixels wide against text set at 2 device pixels per glyph pixel, so a letter's
//   stroke is 8 units and `kIconStroke` is a shade under it. An icon that is lighter or heavier
//   than the word beside it reads as a different interface.
//   **No stroke is ever thinner than a pixel and a bit.** `w` is floored against the sampling, so
//   an icon shrunk to 0.55 of nominal on a small window gets a heavier drawing rather than a
//   fainter one — which is the opposite of what happens when a fixed width is scaled down.
//   **Outlines for things, fills for figures and for what is solid.** A pupil, a nib, a person and
//   a book are masses; a folder, a page and a bin are containers. Filling a container closes the
//   inside that says what it is.
//
// The cell runs 0 to 64 on each axis, y down. `aa` is one device pixel measured in those units,
// `w` is the stroke, and `m` is the motion: **1 on the press, 0 at rest**, and briefly NEGATIVE on
// the way home because `Ui`'s press curve overshoots (src/ui/widgets.cpp) so a drawing settles
// rather than stops. Every function here is written so that a small negative `m` is a small
// counter-swing rather than a shape turning inside out.
//
// Adding an icon is a function here and a name in src/ui/draw.hpp.

const float kIconStroke = 7.0;

// --- the primitives ---
//
// All exact except the ellipse, whose error is a scale factor on the distance and therefore
// invisible on a stroke of constant width.

float sd_circle(vec2 p, vec2 c, float r) { return length(p - c) - r; }

float sd_ellipse(vec2 p, vec2 c, vec2 r) {
    vec2 q = (p - c) / max(r, vec2(0.001));
    return (length(q) - 1.0) * min(r.x, r.y);
}

float sd_box(vec2 p, vec2 c, vec2 extent) {
    vec2 d = abs(p - c) - extent;
    return length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0);
}

float sd_round_box(vec2 p, vec2 c, vec2 extent, float r) {
    r = min(r, min(extent.x, extent.y));
    return sd_box(p, c, extent - vec2(r)) - r;
}

// Unsigned: a line of width `t` is `sd_line(...) - t * 0.5`, which is a capsule and therefore
// joins the next one without a notch at the corner.
float sd_line(vec2 p, vec2 a, vec2 b) {
    vec2 pa = p - a;
    vec2 ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-5), 0.0, 1.0);
    return length(pa - ba * h);
}

float sd_triangle(vec2 p, vec2 p0, vec2 p1, vec2 p2) {
    vec2 e0 = p1 - p0, e1 = p2 - p1, e2 = p0 - p2;
    vec2 v0 = p - p0, v1 = p - p1, v2 = p - p2;
    vec2 q0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
    vec2 q1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
    vec2 q2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);
    float s = sign(e0.x * e2.y - e0.y * e2.x);
    vec2 d = min(min(vec2(dot(q0, q0), s * (v0.x * e0.y - v0.y * e0.x)),
                     vec2(dot(q1, q1), s * (v1.x * e1.y - v1.y * e1.x))),
                 vec2(dot(q2, q2), s * (v2.x * e2.y - v2.y * e2.x)));
    return -sqrt(d.x) * sign(d.y);
}

// The outline of a shape, which is what most of these are made of.
float sd_edge(float d, float w) { return abs(d) - w * 0.5; }
// Take `b` out of `a`, and keep only the part of `a` that is inside `b`.
float sd_cut(float a, float b) { return max(a, -b); }
float sd_keep(float a, float b) { return max(a, b); }
// The half-plane above `y` and the half-plane below it, y being DOWN. `sd_keep(shape, sd_below(y))`
// is the part of the shape under the line; that is worth spelling out because getting it backwards
// draws the other half of the shape, which is a picture rather than an error.
float sd_below(float y, vec2 p) { return y - p.y; }
float sd_above(float y, vec2 p) { return p.y - y; }

// Rotating the POINT by +a draws the shape turned by -a, which on a y-down screen is
// anticlockwise: a lid whose right end lifts.
vec2 sd_turn(vec2 p, vec2 about, float a) {
    vec2 q = p - about;
    float s = sin(a);
    float c = cos(a);
    return about + vec2(q.x * c - q.y * s, q.x * s + q.y * c);
}

// --- the drawings ---

float icon_world(vec2 p, float m, float w) {
    // A wireframe globe that TURNS on its axis, and turning is a thing a drawing has to earn.
    //
    // The first version swept whole ellipses across the disc. A whole ellipse is a meridian's near
    // half and its far half drawn as one shape, and that shape is symmetrical about the axis — so
    // it has no front and no back, and what it reads as is two lines breathing in and out. Nothing
    // in it goes anywhere.
    //
    // A sphere is not symmetrical about its axis: half of it is facing you. So each meridian is
    // drawn as HALF an ellipse — the half on its own side of the pole — and only while it is on the
    // near side at all. Now the thing an eye is given is an arc that comes into view at one rim,
    // travels across the face, and leaves at the other, which is what horizontal rotation looks
    // like and is the only thing that does.
    //
    // The latitudes do not move, because on a sphere spun about its poles they do not: they are
    // exactly horizontal lines at every moment of the turn. That is the other half of reading as a
    // rotation — something has to be standing still for the rest of it to be turning against.
    //
    // A quarter turn is a whole revolution here. Four meridians a quarter turn apart are the same
    // four meridians after a quarter turn, so the picture at the end is the picture at the start
    // and the animation closes instead of snapping back.
    // The inside is drawn lighter than the rim and spread as wide as it will go. Three latitudes
    // and two arcs inside a circle is five strokes across twenty-five units, and at the smallest
    // size — where the stroke has a floor and the drawing does not — five strokes at full weight
    // close the gaps between themselves and the globe comes out as a disc.
    float thin = w * 0.52;
    float d = sd_edge(sd_circle(p, vec2(32.0), 25.0), w);
    d = min(d, sd_line(p, vec2(7.4, 32.0), vec2(56.6, 32.0)) - thin * 0.5);
    d = min(d, sd_line(p, vec2(11.5, 18.0), vec2(52.5, 18.0)) - thin * 0.5);
    d = min(d, sd_line(p, vec2(11.5, 46.0), vec2(52.5, 46.0)) - thin * 0.5);

    const float kQuarter = 1.5708;
    float turn = (1.0 - m) * kQuarter + 0.35;
    for (int i = 0; i < 4; ++i) {
        float lon = turn + float(i) * kQuarter;
        // Round the back, and therefore not drawn. Every pixel of the icon agrees about this, so
        // it costs a branch and no divergence.
        if (cos(lon) <= 0.0) continue;
        // Where it projects to: signed, because the sign is which side of the pole it is on. The
        // ellipse field degrades to the distance from the polar axis as this goes to nought, which
        // is exactly what a meridian looks like when it is facing you, so no special case is needed
        // for the one that is.
        float rx = 25.0 * sin(lon);
        // Just inside the rim, so a meridian meeting the pole does not put a spike through it.
        float arc = sd_edge(sd_ellipse(p, vec2(32.0), vec2(max(abs(rx), 0.5), 24.2)), w * 0.62);
        d = min(d, sd_keep(arc, (rx >= 0.0) ? (32.0 - p.x) : (p.x - 32.0)));
    }
    return d;
}

float icon_settings(vec2 p, float m, float w) {
    // Three values at three settings, and the handles slide when it is pressed — which is exactly
    // what pressing this leads to. The track is CUT where its handle sits, so a handle reads as a
    // handle rather than as a bulge in the line.
    float rest[3] = float[3](22.0, 42.0, 30.0);
    float moved[3] = float[3](42.0, 20.0, 47.0);
    float d = 1e9;
    for (int i = 0; i < 3; ++i) {
        float y = 12.0 + float(i) * 20.0;
        float at = mix(rest[i], moved[i], clamp(m, -0.15, 1.0));
        float track = sd_line(p, vec2(7.0, y), vec2(57.0, y)) - w * 0.32;
        track = sd_cut(track, sd_round_box(p, vec2(at, y), vec2(w * 0.98, w * 1.5), w * 0.4));
        float knob = sd_round_box(p, vec2(at, y), vec2(w * 0.62, w * 1.12), w * 0.36);
        d = min(d, min(track, knob));
    }
    return d;
}

float icon_library(vec2 p, float m, float w) {
    // A shelf of upright things and the one being taken off it. Filled and separated, because the
    // GAPS are what say "several things side by side" and an outline spends every one of them on
    // its own two edges.
    //
    // THREE of them, not five. At the size a row sets an icon — sixteen device pixels, which is
    // what a small desktop gives every row — five uprights are three pixels apart including their
    // gaps, and five bars of five heights read as a bar chart. Three at eleven units across, with
    // six between, is two and a half pixels of book and one and a half of gap, and that is a shelf.
    float d = sd_round_box(p, vec2(32.0, 55.0), vec2(26.0, 3.4), 1.6);
    float at[3] = float[3](15.0, 32.0, 49.0);
    float top[3] = float[3](17.0, 10.0, 20.0);
    for (int i = 0; i < 3; ++i) {
        float lift = (i == 1) ? max(m, -0.2) * 13.0 : 0.0;
        float t = top[i] - lift;
        float b = 51.0 - lift;
        float book = sd_round_box(p, vec2(at[i], (t + b) * 0.5), vec2(5.5, (b - t) * 0.5), 1.8);
        // A band across the spine, which is the detail the larger sizes get and the smallest one
        // simply loses — a cut narrower than a pixel is a cut that costs nothing.
        book = sd_cut(book, sd_box(p, vec2(at[i], t + 8.0), vec2(3.8, 1.3)));
        d = min(d, book);
    }
    return d;
}

// A person, measured from the NECK: the head above it, the shoulders below. Two figures at two
// sizes therefore stand on the same line whatever their sizes are, which is what makes one read as
// further away rather than as smaller.
float icon_person(vec2 p, vec2 neck, float s) {
    float head = sd_circle(p, neck - vec2(0.0, 10.0 * s), 7.6 * s);
    float body = sd_round_box(p, neck + vec2(0.0, 11.0 * s), vec2(12.5 * s, 13.0 * s), 9.5 * s);
    return min(head, sd_keep(body, sd_below(neck.y, p)));
}

float icon_community(vec2 p, float m, float w) {
    // The people you can reach.
    //
    // TWO of them, and it was three. Three is what the word means and three is what a tab called
    // *community* is drawn as everywhere — but at sixteen device pixels each figure had eleven of
    // the sixty-four units to be drawn in, and three figures came out as three dots in a row. Two
    // are a group as plainly as three are, at half again the size each. The number was never the
    // meaning; several-of-them-and-not-one is, and two says that.
    //
    // The one behind is CUT where the one in front is, so two overlapping bodies read as two rather
    // than as one wide one — and it steps in when the tab is pressed, which is what the tab does.
    float front = icon_person(p, vec2(25.0, 30.0), 1.05);
    float back = icon_person(p, vec2(45.0 - m * 6.0, 26.0), 0.85);
    return min(front, sd_cut(back, front - w * 0.55));
}

float icon_editor(vec2 p, float m, float w) {
    // Lines of text, and a caret on the one being written. The press writes the line rather than
    // blinking the caret: a blink says "here", and this has to say "this is where writing happens".
    float len[3] = float[3](50.0, 38.0, 46.0);
    float d = 1e9;
    for (int i = 0; i < 3; ++i) {
        float y = 12.0 + float(i) * 13.5;
        d = min(d, sd_line(p, vec2(7.0, y), vec2(7.0 + len[i], y)) - w * 0.42);
    }
    float run = mix(26.0, 6.0, clamp(m, 0.0, 1.0));
    float y = 52.5;
    d = min(d, sd_line(p, vec2(7.0, y), vec2(7.0 + run, y)) - w * 0.42);
    d = min(d, sd_round_box(p, vec2(11.0 + run + w * 0.4, y), vec2(w * 0.30, 6.5), w * 0.22));
    return d;
}

float icon_folder(vec2 p, float m, float w) {
    // A folder, and its front OPENS when it is entered — leaning away from its own bottom edge
    // rather than sliding, because a lid that slides is a drawer.
    float back = sd_round_box(p, vec2(32.0, 35.0), vec2(26.0, 20.0), 3.0);
    back = min(back, sd_round_box(p, vec2(19.5, 16.0), vec2(13.5, 5.5), 2.5));
    vec2 q = sd_turn(p, vec2(8.0, 54.0), 0.30 * m);
    float front = sd_round_box(q, vec2(32.0, 43.0), vec2(24.0, 11.0), 3.0);
    // The back is drawn only where the front is not over it.
    float d = sd_cut(sd_edge(back, w), front - w * 0.9);
    return min(d, sd_edge(front, w));
}

float icon_up(vec2 p, float m, float w) {
    // Out of this folder and into the one above: the ceiling stays put, and the arrow goes to it.
    float d = sd_line(p, vec2(12.0, 9.0), vec2(52.0, 9.0)) - w * 0.5;
    vec2 q = p + vec2(0.0, m * 8.0);
    d = min(d, sd_line(q, vec2(32.0, 56.0), vec2(32.0, 23.0)) - w * 0.5);
    d = min(d, sd_line(q, vec2(32.0, 21.0), vec2(18.5, 34.5)) - w * 0.5);
    d = min(d, sd_line(q, vec2(32.0, 21.0), vec2(45.5, 34.5)) - w * 0.5);
    return d;
}

float icon_new(vec2 p, float m, float w) {
    // A plus, which grows and leans a little when it is pressed. A QUARTER of a radian and not a
    // half: a plus turned far enough is a cross, and a cross means close two cells away.
    vec2 q = sd_turn(p, vec2(32.0), 0.24 * m);
    float arm = 20.0 + 3.0 * m;
    float d = sd_line(q, vec2(32.0 - arm, 32.0), vec2(32.0 + arm, 32.0)) - w * 0.5;
    return min(d, sd_line(q, vec2(32.0, 32.0 - arm), vec2(32.0, 32.0 + arm)) - w * 0.5);
}

float icon_rename(vec2 p, float m, float w) {
    // A pen over a line, and it travels back along the line when it is pressed. The nib is FILLED
    // and the barrel is not: the point is where the ink is, and that is the part that has to be
    // unmistakable at eight pixels.
    float d = sd_line(p, vec2(8.0, 57.0), vec2(56.0, 57.0)) - w * 0.42;
    vec2 q = sd_turn(p - vec2(mix(4.0, -14.0, clamp(m, -0.15, 1.0)), 0.0), vec2(32.0, 30.0), -0.40);
    float barrel = sd_round_box(q, vec2(32.0, 24.0), vec2(6.4, 17.0), 2.0);
    barrel = sd_cut(barrel, sd_box(q, vec2(32.0, 33.5), vec2(7.5, 1.3)));
    d = min(d, sd_edge(barrel, w * 0.85));
    d = min(d, sd_triangle(q, vec2(26.0, 42.0), vec2(38.0, 42.0), vec2(32.0, 52.5)));
    return d;
}

float icon_duplicate(vec2 p, float m, float w) {
    // One square splitting into two. The animation IS the split, and the one behind is cut where
    // the one in front covers it so that two squares read as two.
    float apart = m * 7.0;
    float front = sd_round_box(p, vec2(38.0 + apart), vec2(15.0), 4.0);
    float back = sd_round_box(p, vec2(26.0 - apart), vec2(15.0), 4.0);
    return min(sd_edge(front, w), sd_cut(sd_edge(back, w), front - w * 1.2));
}

float icon_bin(vec2 p, float w) {
    // The body both bins share: tapering, because a straight-sided box is a box.
    float d = min(sd_line(p, vec2(17.0, 26.0), vec2(21.5, 55.0)),
                  sd_line(p, vec2(47.0, 26.0), vec2(42.5, 55.0)));
    d = min(d, sd_line(p, vec2(21.5, 55.0), vec2(42.5, 55.0)));
    return d - w * 0.5;
}

float icon_delete(vec2 p, float m, float w) {
    // A lid OPENING over a bin. The lid is the whole statement: the thing is not gone, it is
    // somewhere with a lid on it, which is what `trash\` on the disk actually is.
    float d = icon_bin(p, w);
    d = min(d, min(sd_line(p, vec2(27.5, 33.0), vec2(28.5, 48.0)),
                   sd_line(p, vec2(36.5, 33.0), vec2(35.5, 48.0))) - w * 0.32);
    vec2 q = sd_turn(p, vec2(13.0, 21.0), 0.5 * m);
    float lid = sd_line(q, vec2(12.0, 21.0), vec2(52.0, 21.0)) - w * 0.5;
    lid = min(lid, sd_line(q, vec2(26.0, 12.0), vec2(38.0, 12.0)) - w * 0.42);
    lid = min(lid, sd_line(q, vec2(26.5, 13.0), vec2(26.5, 20.0)) - w * 0.28);
    lid = min(lid, sd_line(q, vec2(37.5, 13.0), vec2(37.5, 20.0)) - w * 0.28);
    return min(d, lid);
}

float icon_trash(vec2 p, float m, float w) {
    // Where a delete GOES, as a shelf of its own: the same bin, shut, with something in it. The
    // contents settle when the shelf is opened, which is the only motion a place is entitled to.
    float d = icon_bin(p, w);
    d = min(d, sd_line(p, vec2(12.0, 21.0), vec2(52.0, 21.0)) - w * 0.5);
    d = min(d, sd_line(p, vec2(26.0, 12.0), vec2(38.0, 12.0)) - w * 0.42);
    float settle = m * 2.5;
    d = min(d, sd_round_box(p, vec2(27.5, 38.0 + settle), vec2(4.6, 4.6), 1.6));
    d = min(d, sd_round_box(p, vec2(37.5, 45.0 - settle), vec2(4.0, 4.0), 1.4));
    return d;
}

float icon_sort(vec2 p, float m, float w) {
    // Three bars, longest first, and the order turns over when it is pressed — with the arrow
    // that says which way turning over with them, or the drawing would claim a sort it did not do.
    float lo[3] = float[3](55.0, 43.0, 31.0);
    float hi[3] = float[3](31.0, 43.0, 55.0);
    float d = 1e9;
    for (int i = 0; i < 3; ++i) {
        float y = 14.0 + float(i) * 18.0;
        d = min(d, sd_line(p, vec2(23.0, y), vec2(mix(lo[i], hi[i], clamp(m, 0.0, 1.0)), y)) -
                       w * 0.5);
    }
    vec2 q = sd_turn(p, vec2(12.0, 32.0), 3.14159 * clamp(m, 0.0, 1.0));
    d = min(d, sd_line(q, vec2(12.0, 12.0), vec2(12.0, 49.0)) - w * 0.4);
    d = min(d, sd_line(q, vec2(12.0, 52.0), vec2(5.5, 44.0)) - w * 0.4);
    d = min(d, sd_line(q, vec2(12.0, 52.0), vec2(18.5, 44.0)) - w * 0.4);
    return d;
}

float icon_search(vec2 p, float m, float w) {
    // A lens, and it moves when it is pressed, because looking for something is not standing still.
    vec2 at = vec2(27.0) + vec2(5.0, -3.5) * m;
    float d = sd_edge(sd_circle(p, at, 16.0 - m * 1.5), w);
    vec2 dir = vec2(0.70711);
    return min(d, sd_line(p, at + dir * 15.0, at + dir * 29.0) - w * 0.62);
}

float icon_private(vec2 p, float m, float w) {
    // An eye, shut, with lashes — because a bare curve is a smile. The lid presses further down on
    // a press, which is the shape of the word: this one is not offered to anybody.
    float dip = m * 4.0;
    float d = sd_edge(sd_circle(p, vec2(32.0, 12.0 - dip), 26.0), w);
    d = sd_keep(d, sd_below(30.0 - dip * 0.5, p));   // the BOTTOM of that circle, which is the lid
    float thin = w * 0.36;
    d = min(d, sd_line(p, vec2(14.5, 31.0 - dip * 0.3), vec2(8.5, 40.0)) - thin);
    d = min(d, sd_line(p, vec2(32.0, 39.5 - dip), vec2(32.0, 49.0 - dip)) - thin);
    d = min(d, sd_line(p, vec2(49.5, 31.0 - dip * 0.3), vec2(55.5, 40.0)) - thin);
    return d;
}

float icon_shared(vec2 p, float m, float w) {
    // An eye, open, and a blink answers the press. The two lids are arcs of two circles chosen so
    // that they meet at the corners; the pupil is the one part of this drawing that is solid,
    // because it is the one part of an eye that is.
    float blink = clamp(m, 0.0, 1.0) * 15.0;
    float up = sd_edge(sd_circle(p, vec2(32.0, 44.8 + blink), 30.8), w);
    up = sd_keep(up, sd_above(33.0, p));
    float lo = sd_edge(sd_circle(p, vec2(32.0, 19.2 - blink), 30.8), w);
    lo = sd_keep(lo, sd_below(31.0, p));
    float d = min(up, lo);
    d = min(d, sd_edge(sd_circle(p, vec2(32.0), max(10.5 - blink * 0.55, 1.5)), w * 0.85));
    return min(d, sd_circle(p, vec2(32.0), max(4.6 - blink * 0.26, 0.8)));
}

float icon_close(vec2 p, float m, float w) {
    vec2 q = sd_turn(p, vec2(32.0), 0.5 * m);
    float arm = 16.0 + 3.0 * m;
    float d = sd_line(q, vec2(32.0 - arm, 32.0 - arm), vec2(32.0 + arm, 32.0 + arm)) - w * 0.5;
    return min(d, sd_line(q, vec2(32.0 - arm, 32.0 + arm), vec2(32.0 + arm, 32.0 - arm)) - w * 0.5);
}

float icon_clip(vec2 p, float m, float w) {
    // A small solid seen as a solid: six edges and the three that meet in the middle, which is the
    // one drawing of a cube that cannot be read as a hexagon. The TOP face comes off when it is
    // pressed, and the gap it leaves is what says the thing is made of parts.
    const vec2 t = vec2(32.0, 9.0);
    const vec2 ur = vec2(56.0, 22.0);
    const vec2 lr = vec2(56.0, 45.0);
    const vec2 b = vec2(32.0, 58.0);
    const vec2 ll = vec2(8.0, 45.0);
    const vec2 ul = vec2(8.0, 22.0);
    const vec2 c = vec2(32.0, 35.0);
    float half_w = w * 0.5;
    float d = sd_line(p, ul, ll);
    d = min(d, sd_line(p, ll, b));
    d = min(d, sd_line(p, b, lr));
    d = min(d, sd_line(p, lr, ur));
    d = min(d, sd_line(p, c, b));
    vec2 q = p + vec2(0.0, max(m, -0.2) * 5.5);
    d = min(d, sd_line(q, t, ur));
    d = min(d, sd_line(q, ur, c));
    d = min(d, sd_line(q, c, ul));
    d = min(d, sd_line(q, ul, t));
    return d - half_w;
}

float icon_material(vec2 p, float m, float w) {
    // A swatch of pattern, and the pattern ROLLS when it is pressed — because what a material is
    // is a rule that generates, not a colour that sits there.
    float frame = sd_round_box(p, vec2(32.0), vec2(25.0), 4.0);
    float d = sd_edge(frame, w);
    float s = (p.x + p.y) * 0.70711 + m * 13.0;
    float stripe = abs(mod(s, 19.5) - 9.75) - 4.8;
    return min(d, sd_keep(stripe, frame + w * 1.35));
}

float icon_mod(vec2 p, float m, float w) {
    // A wrench. A mod is the thing a player reaches for when the game as shipped is not the game
    // they want, and that is what a wrench means everywhere without anybody having to be told.
    //
    // It was a block with a socket, and before that a puzzle piece. Both of them said "this fits
    // into something", which is true about a mod and is also true about a clip, a material and a
    // character — a drawing whose statement is *belongs with the others* has not said which one it
    // is. A wrench says the other half: it is the thing you change the machine with.
    //
    // Two ends, because one end and a stick is a magnifying glass with its lens knocked out, and
    // `search` is two cells away on the same sheet. It TURNS when it is pressed, which is the only
    // thing a wrench does — a tool that answers a press by sliding sideways is a tool being dragged.
    vec2 q = sd_turn(p, vec2(32.0), 0.45 * m);
    float d = sd_line(q, vec2(40.0, 24.0), vec2(23.0, 41.0)) - w * 0.55;
    // The open end, its jaws pointing outward along the shaft: a ring with a slot cut through it.
    float head = sd_edge(sd_circle(q, vec2(44.0, 20.0), 10.0), w);
    vec2 jaw = sd_turn(q, vec2(44.0, 20.0), -0.7854);
    head = sd_cut(head, sd_box(jaw, vec2(44.0, 9.0), vec2(4.6, 12.0)));
    d = min(d, head);
    // And the closed end, which is what makes it a wrench rather than a spanner-shaped hook.
    return min(d, sd_edge(sd_circle(q, vec2(19.0, 45.0), 6.5), w * 0.9));
}

float icon_character(vec2 p, float m, float w) {
    // A standing figure, and it strides when it is pressed.
    float swing = m * 6.0;
    float d = sd_edge(sd_circle(p, vec2(32.0, 13.0), 8.0), w * 0.9);
    d = min(d, sd_line(p, vec2(32.0, 22.0), vec2(32.0, 40.0)) - w * 0.5);
    d = min(d, sd_line(p, vec2(32.0, 27.0), vec2(17.5 - swing, 36.5 + swing * 0.4)) - w * 0.44);
    d = min(d, sd_line(p, vec2(32.0, 27.0), vec2(46.5 + swing, 36.5 - swing * 0.4)) - w * 0.44);
    d = min(d, sd_line(p, vec2(32.0, 40.0), vec2(21.5 - swing, 57.0)) - w * 0.5);
    return min(d, sd_line(p, vec2(32.0, 40.0), vec2(42.5 + swing, 57.0)) - w * 0.5);
}

float icon_script(vec2 p, float m, float w) {
    // A page with a prompt on it: the script view, which is text that RUNS. The chevron advances
    // and the line it is waiting on comes with it.
    float d = sd_edge(sd_round_box(p, vec2(32.0), vec2(22.0, 26.0), 3.5), w);
    float run = m * 5.0;
    float thin = w * 0.42;
    d = min(d, sd_line(p, vec2(17.5 + run, 21.0), vec2(28.0 + run, 30.5)) - thin);
    d = min(d, sd_line(p, vec2(28.0 + run, 30.5), vec2(17.5 + run, 40.0)) - thin);
    return min(d, sd_line(p, vec2(33.0 + run, 44.0), vec2(46.5, 44.0)) - thin);
}

float icon_tick(vec2 p, float m, float w) {
    // The mark a switch makes when it is on, and a press DRAWS it rather than showing it: the one
    // animation in the set that is the making of the mark and not a movement of it.
    float d = min(sd_line(p, vec2(11.0, 34.0), vec2(25.0, 48.0)),
                  sd_line(p, vec2(25.0, 48.0), vec2(54.0, 16.0))) - w * 0.5;
    return sd_keep(d, p.x - mix(54.0, 11.0, clamp(m, 0.0, 1.0)) - w * 0.5);
}

float icon_play(vec2 p, float m, float w) {
    // Enter this world. Solid, because it is the one button on a row that is a departure.
    float go = m * 5.0;
    return sd_triangle(p, vec2(19.0 + go, 10.0), vec2(19.0 + go, 54.0), vec2(53.0 + go, 32.0)) -
           w * 0.22;
}

float icon_reset(vec2 p, float m, float w) {
    // An arrow that goes back round: put this value where it was. It TURNS BACK when pressed —
    // anticlockwise, the way it is pointing — because the one thing this control must not look like
    // is a refresh that fetches something.
    vec2 q = sd_turn(p, vec2(32.0), 1.5 * m);
    // A smaller ring than the cell allows, because the head is what carries the meaning and at the
    // size a row sets this it needs room to be a triangle rather than a thickening of the stroke.
    float ring = sd_edge(sd_circle(q, vec2(33.0, 34.0), 15.0), w);
    // Open at the upper right, so the circle is a stroke that ended rather than a circle.
    ring = sd_cut(ring, sd_box(q, vec2(46.0, 14.0), vec2(16.0, 14.0)));
    float head = sd_triangle(q, vec2(35.0, 5.0), vec2(35.0, 27.0), vec2(15.0, 16.0));
    return min(ring, head);
}

float icon_collapsed(vec2 p, float m, float w) {
    // Folded away, pointing at where its contents would go. Pressing it turns it toward open,
    // which is the animation saying what the press is about to do.
    vec2 q = sd_turn(p, vec2(30.0, 32.0), -1.4 * m);
    return sd_triangle(q, vec2(21.0, 17.0), vec2(21.0, 47.0), vec2(43.0, 32.0)) - w * 0.2;
}

float icon_expanded(vec2 p, float m, float w) {
    vec2 q = sd_turn(p, vec2(32.0, 30.0), 1.4 * m);
    return sd_triangle(q, vec2(17.0, 21.0), vec2(47.0, 21.0), vec2(32.0, 43.0)) - w * 0.2;
}

// The distance to the nearest ink of one drawing. Names match Icon in src/ui/draw.hpp value for
// value; anything unknown is drawn as nothing, which is the failure a reader can see.
float icon_pattern(vec2 p, float m, float w) {
    // A wave. A pattern is a field read for its VALUE rather than its sign — a grain, a checker, a
    // set of stripes — and a wave is the one picture all of those are. A crest, a trough and a
    // crest: three features across, inside the four the style allows at sixteen device pixels,
    // where a fourth turns it into a comb.
    //
    // It TRAVELS when it is pressed, because that is what a wave does. Growing or flattening it
    // instead would be the drawing saying something about amplitude, which is not what the control
    // under it means.
    float shift = m * 11.0;
    float d = 1e9;
    for (int i = 0; i < 16; ++i) {
        float x0 = 8.0 + float(i) * 3.0;
        float x1 = x0 + 3.0;
        vec2 a = vec2(x0, 32.0 - 13.0 * sin((x0 - 8.0 + shift) * 0.19635));
        vec2 b = vec2(x1, 32.0 - 13.0 * sin((x1 - 8.0 + shift) * 0.19635));
        d = min(d, sd_line(p, a, b));
    }
    return d - w * 0.5;
}

float icon_graph(vec2 p, float m, float w) {
    // Two nodes and the wire between them: the visual view of a document, said in one cell. The
    // boxes are OUTLINES because they are containers and the style draws a container as its edge;
    // the wire is a stroke, because a wire is not a container.
    //
    // The WIRE is what answers a press — it retracts to the first node and runs back out to the
    // second — rather than the boxes moving. What this view does is join things up.
    float d = sd_edge(sd_round_box(p, vec2(16.0, 20.0), vec2(11.0, 8.0), 2.5), w);
    d = min(d, sd_edge(sd_round_box(p, vec2(47.0, 44.0), vec2(11.0, 8.0), 2.5), w));

    float run = clamp(1.0 - m, 0.0, 1.0);        // 1 at rest, 0 fully pressed
    float along = min(run * 2.0, 1.0);
    float down = clamp(run * 2.0 - 1.0, 0.0, 1.0);
    float wire = sd_line(p, vec2(27.0, 20.0), vec2(mix(27.0, 36.0, along), 20.0));
    wire = min(wire, sd_line(p, vec2(36.0, 20.0), vec2(36.0, mix(20.0, 44.0, down))));
    return min(d, wire - w * 0.42);
}

float icon_inside(vec2 p, float m, float w) {
    // A box with a way in, and an arrow going through it. *This one has something inside it, and
    // this is how you get there.*
    //
    // It was the play triangle, borrowed from *enter this world* on a shelf row — and a triangle on
    // its own says GO rather than *go in*, which is a different statement and the wrong one on a
    // box that is a container. Reported as looking like a play button, which it was.
    //
    // The box is drawn as three sides with the left one OPEN, because a container you can enter is
    // one with a way in, and the arrow comes through the gap. It travels on a press, which is what
    // going in is.
    float d = 1e9;
    d = min(d, sd_line(p, vec2(26.0, 12.0), vec2(52.0, 12.0)));
    d = min(d, sd_line(p, vec2(52.0, 12.0), vec2(52.0, 52.0)));
    d = min(d, sd_line(p, vec2(52.0, 52.0), vec2(26.0, 52.0)));
    d = d - w * 0.5;
    // The arrow, through the open side. It goes further in when it is pressed.
    float run = m * 7.0;
    vec2 tip = vec2(36.0 + run, 32.0);
    float arrow = sd_line(p, vec2(8.0 + run, 32.0), tip);
    arrow = min(arrow, sd_line(p, tip, tip - vec2(9.0, 9.0)));
    arrow = min(arrow, sd_line(p, tip, tip - vec2(9.0, -9.0)));
    return min(d, arrow - w * 0.5);
}

float icon_field(uint which, vec2 p, float m, float w) {
    switch (which) {
        case 1u:  return icon_world(p, m, w);
        case 2u:  return icon_settings(p, m, w);
        case 3u:  return icon_library(p, m, w);
        case 4u:  return icon_community(p, m, w);
        case 5u:  return icon_editor(p, m, w);
        case 6u:  return icon_folder(p, m, w);
        case 7u:  return icon_up(p, m, w);
        case 8u:  return icon_new(p, m, w);
        case 9u:  return icon_rename(p, m, w);
        case 10u: return icon_duplicate(p, m, w);
        case 11u: return icon_delete(p, m, w);
        case 12u: return icon_trash(p, m, w);
        case 13u: return icon_sort(p, m, w);
        case 14u: return icon_search(p, m, w);
        case 15u: return icon_private(p, m, w);
        case 16u: return icon_shared(p, m, w);
        case 17u: return icon_close(p, m, w);
        case 18u: return icon_clip(p, m, w);
        case 19u: return icon_material(p, m, w);
        case 20u: return icon_mod(p, m, w);
        case 21u: return icon_character(p, m, w);
        case 22u: return icon_script(p, m, w);
        case 23u: return icon_tick(p, m, w);
        case 24u: return icon_play(p, m, w);
        case 25u: return icon_reset(p, m, w);
        case 26u: return icon_collapsed(p, m, w);
        case 27u: return icon_expanded(p, m, w);
        case 28u: return icon_pattern(p, m, w);
        case 29u: return icon_graph(p, m, w);
        case 30u: return icon_inside(p, m, w);
        default:  return 1e9;
    }
}

// --- the marks ------------------------------------------------------------------------------------

vec3 blur_at(vec2 pixel) {
    ivec2 size = imageSize(blurred);
    ivec2 at = clamp(ivec2(pixel * 0.25), ivec2(0), size - ivec2(1));
    return imageLoad(blurred, at).rgb;
}

float text_ink(Command command, vec2 pixel) {
    // `at` is in glyph pixels from the string's left edge and its capitals' top, and `smear` is
    // one DEVICE pixel expressed in the same units — which is what bold is worth here. See
    // `ui_ink_at`: a whole cell of smear closes every counter the face has.
    float scale = max(command.f3, 0.0001);
    vec2 at = (pixel - vec2(command.f1, command.f2)) / scale;
    // Half a cell where there is half a cell to be had, and a whole one where there is not.
    const float smear = max(kUiBoldReach, 1.0 / scale);
    if (at.y < 0.0 || at.y >= float(kUiRows + 1)) return 0.0;
    float pen = 0.0;
    for (uint i = 0u; i < command.b; ++i) {
        uvec2 glyph = ui_glyph(characters[command.a + i]);
        float step = ui_step(glyph, command.style);
        if (at.x >= pen - 1.0 && at.x < pen + step + 1.0) {
            float ink = ui_ink_at(glyph, vec2(at.x - pen, at.y), command.style, smear);
            if (ink > 0.0) return ink;
        }
        pen += step;
    }
    return 0.0;
}

vec3 unpack(uint rgb) {
    return vec3(float((rgb >> 16) & 0xFFu), float((rgb >> 8) & 0xFFu), float(rgb & 0xFFu)) / 255.0;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + ivec2(push.origin);
    ivec2 size = imageSize(target);
    if (pixel.x >= size.x || pixel.y >= size.y || pixel.x < 0 || pixel.y < 0) return;

    uvec2 tile = uvec2(pixel) / 16u;
    if (tile.x >= push.tile_counts.x || tile.y >= push.tile_counts.y) return;
    uvec2 slice = tiles[tile.y * push.tile_counts.x + tile.x];
    if (slice.y == 0u) return;   // nothing reaches this pixel: the world underneath is untouched

    vec2 centre = vec2(pixel) + vec2(0.5);
    vec3 colour = imageLoad(target, pixel).rgb;

    for (uint n = 0u; n < slice.y; ++n) {
        Command command = commands[tile_indices[slice.x + n]];
        if (centre.x < command.clip.x || centre.x >= command.clip.z ||
            centre.y < command.clip.y || centre.y >= command.clip.w) {
            continue;
        }
        bool inside = centre.x >= command.rect.x && centre.x < command.rect.z &&
                      centre.y >= command.rect.y && centre.y < command.rect.w;

        if (command.kind == kGlass) {
            if (!inside) continue;
            // A panel's background is the world behind it, blurred. Nothing else: it has no
            // colour of its own to be made out of.
            colour = mix(colour, blur_at(centre), clamp(command.f0, 0.0, 1.0));
        } else if (command.kind == kInk) {
            if (!inside) continue;
            colour = mix(colour, ui_ink(colour, push.accent), clamp(command.f0, 0.0, 1.0));
        } else if (command.kind == kEdge) {
            if (!inside) continue;
            float thickness = max(command.f3, 1.0);
            bool on = centre.x < command.rect.x + thickness ||
                      centre.x >= command.rect.z - thickness ||
                      centre.y < command.rect.y + thickness ||
                      centre.y >= command.rect.w - thickness;
            if (on) colour = mix(colour, ui_ink(colour, push.accent), clamp(command.f0, 0.0, 1.0));
        } else if (command.kind == kText) {
            float coverage = text_ink(command, centre) * clamp(command.f0, 0.0, 1.0);
            if (coverage > 0.0) {
                // Bits five and six of the style are which of the three hues this run is STATED in,
                // and nought — which is almost everything — is the ordinary inverted ink with no
                // colour in it at all. See `ui::tinted` in src/ui/glyphs.hpp.
                uint tint = (command.style >> 5u) & 3u;
                vec3 want = (tint == 0u) ? ui_ink(colour, push.accent)
                                         : ui_ink_tinted(colour, push.tints[tint - 1u].rgb);
                colour = mix(colour, want, coverage);
            }
        } else if (command.kind == kIcon) {
            if (!inside) continue;
            // The cell, in the 64-unit frame the drawings are stated in, and how much of that one
            // device pixel is worth — which is the whole of the antialiasing and the reason the
            // stroke has a floor: an icon shrunk to 0.55 of nominal on a small window gets a
            // HEAVIER drawing rather than a fainter one.
            vec2 size = max(command.rect.zw - command.rect.xy, vec2(0.0001));
            vec2 cell = (centre - command.rect.xy) / size * 64.0;
            float aa = 64.0 / max(min(size.x, size.y), 1.0);
            float w = max(kIconStroke, aa * 1.35);
            // `f1` is the phase: 1 at rest, 0 on a press, and a little past 1 on the way home. The
            // drawings are written in terms of the motion, which is what is left of it.
            float d = icon_field(command.a, cell, 1.0 - command.f1, w);
            float coverage = clamp(0.5 - d / max(aa, 1e-4), 0.0, 1.0) * clamp(command.f0, 0.0, 1.0);
            if (coverage > 0.0) {
                colour = mix(colour, ui_ink(colour, push.accent), coverage);
            }
        } else if (command.kind == kHue) {
            if (!inside) continue;
            // One of the five permitted colours, STATED rather than inverted: a red that inverted
            // against what was behind it would be a red that is sometimes green.
            colour = mix(colour, unpack(command.a), clamp(command.f0, 0.0, 1.0));
        } else if (command.kind == kLogo) {
            if (!inside) continue;
            // The mark has no bounding box, so the rectangle this command covers is `kLogoReach`
            // times the square the DRAWING occupies (see `DrawList::logo`). Undoing that here is
            // what keeps the drawing its own size while everything it throws outward still lands:
            // `local` runs past 0 and 1 at the edges, `logo_mask` is nought out there, and a block
            // that flew that far is drawn instead of clipped.
            vec2 local = (centre - command.rect.xy) /
                         max(command.rect.zw - command.rect.xy, vec2(0.0001));
            local = (local - 0.5) * kLogoReach + 0.5;
            // The one mark that decides its own colour: `unpack(command.a)` is the player's chosen
            // logo hue and it goes in as a BIAS on the palette rather than as the answer, so the
            // seed still gets to choose and their setting still means something. See logo.glsl.
            // `f1` is where the host put what it worked out for these two seeds — the sorted order
            // of the mark's slices and the two weights — in the character buffer, and the clock comes
            // from the push block because it is the same clock for every mark on the screen.
            vec4 mark = logo_draw(local, command.b, command.style, command.f2, push.seconds,
                                  command.f3, unpack(command.a), uint(command.f1));
            float coverage = mark.a * clamp(command.f0, 0.0, 1.0);
            if (coverage > 0.0) colour = mix(colour, mark.rgb, coverage);
        }
    }

    imageStore(target, pixel, vec4(colour, 1.0));
}
