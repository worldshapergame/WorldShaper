# A sealed hall holding more fittings than the emitter list can carry, which is the scene R9g's cap
# needs and the one this engine did not have.
#
# D587 measured the facility at **21 emitters against a cap of 1,024** and concluded that a lamp
# blinking out past the cap could not happen in the only scene the engine is judged against. That is
# true of the facility, and it is not a reason to leave the mechanism untested: the fault is one clip
# away, and a mechanism with no scene that exercises it is a mechanism nobody can check. This clip
# reaches the cap — **1,296 fittings, of which 272 are dropped** — and says so in the log.
#
# Sealed, with no sky and no sun anywhere in it, for the reason clips/many_lamps.clip is sealed: with
# daylight in the picture the lamps carry almost none of the light and the frame stops being a
# measurement of them. The first version of this clip was an open field and photographed as a white
# floor under a bright sky, which is a picture of the sun.
#
# What the clip is for is the question of WHICH 272 go. Ranked from the camera, it is the 272
# furthest from wherever somebody is standing, so the far end of the hall has no fitting anything
# aims at and walking turns lamps on and off. Dealt round the world, it is the same 272 whatever the
# camera does, spread through the hall, and a lamp can only change when the world does.

metre 32
bounds -15 -0.5 -15   15 3.5 15

material lf_floor rgb=110,106,102 rough=225
material lf_wall  rgb=150,146,140 rough=210
material lf_lamp  rgb=255,228,180 rough=140 emit=200

# The shell, hollowed out. Nothing in it but the lamps.
let lf_shell = box -14.9 -0.5 -14.9   14.9 3.4 14.9
let lf_room  = box -14.5  0.0 -14.5   14.5 3.0 14.5
let lf_walls = difference { lf_shell lf_room }

# One fitting: five voxels a side at 32 to the metre. A cluster cell is four voxels and fittings
# merge when their cells touch face to face, so the 0.69 m of air between neighbours keeps all
# 1,296 of them separate — which is the whole point, since merging is what usually brings a scene
# back under the cap.
let lf_cube  = box -0.08 2.55 -0.08    0.08 2.71 0.08
let lf_grid  = translate { repeat { lf_cube } x=0.85 nx=34 z=0.85 nz=34 } -14.0 0 -14.0

let lf_all   = union { lf_walls lf_grid }

# The floor, so the eye has a surface reading the lamps rather than a wall edge-on to them.
let lf_floortop = box -14.5 -0.1 -14.5   14.5 0.02 14.5

paint lf_wall
paint lf_floor where=lf_floortop below=0.02
paint lf_lamp  where=lf_grid     below=0.02

solid lf_all
