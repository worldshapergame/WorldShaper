# sampler.clip — one of everything, so the vocabulary can be seen working.
#
# Not a pretty thing. It is the clip equivalent of a test card: a row of solids, a row of
# patterns cut into slabs, a stair, an arch and a shell, laid out on a plinth so each can be
# looked at on its own and measured against what it claims to be.
#
# Build and measure it:      WorldShaper.exe --clip-file clips/sampler.clip --clip-symmetry
# Look at a cross-section:   WorldShaper.exe --clip-file clips/sampler.clip --clip-slice 2,-1,2

metre 32
bounds -6 0 -3   6 4 3

# Numbers meant to be moved. Naming them is what lets a dial reach them later, and it also
# means the two places a wall thickness appears cannot drift apart.
param wall      0.12
param rise      0.18
param run       0.30
param grain     0.02

material stone   rgb=124,120,112 rough=210
material pale    rgb=196,192,182 rough=200
material metal   rgb=170,172,178 rough=60  metal=200
material moss    rgb=64,112,54   rough=240
material lamp    rgb=255,240,200 emit=200

# --- the plinth everything stands on -------------------------------------------------------
let plinth = box -6 0 -3   6 0.3 3 round=0.04

# --- a row of solids, one of each ------------------------------------------------------------
let s_sphere = sphere -5 0.9 0 r=0.55
let s_cube   = cube   -3.6 0.9 0 r=0.8
let s_octa   = octa   -2.2 0.9 0 r=0.75
let s_dodeca = dodeca -0.8 0.9 0 r=0.72
let s_icosa  = icosa   0.6 0.9 0 r=0.72
let s_hex    = prism   2.0 0.9 0 r=0.6 h=1.0 sides=6
let s_tri    = prism   3.4 0.9 0 r=0.6 h=1.0 sides=3
let s_torus  = torus   4.8 0.9 0 ring=0.5 tube=0.18 axis=y
let solids   = union { s_sphere s_cube s_octa s_dodeca s_icosa s_hex s_tri s_torus }

# --- patterns, cut into slabs so the displacement is the only difference ------------------
let grain_fine = fbm    size=0.10 octaves=4 seed=3
let grain_ridge = ridged size=0.25 octaves=3 seed=9
let scratch    = rasp   size=0.04 depth=1.0 seed=5
let ripple     = sine   axis=x period=0.35
let masonry    = bricks length=0.30 height=0.12 mortar=0.02 facing=z

let slab_a = box -5.6 2.1 -0.4  -3.8 3.0 0.4
let slab_b = box -3.4 2.1 -0.4  -1.6 3.0 0.4
let slab_c = box -1.2 2.1 -0.4   0.6 3.0 0.4
let slab_d = box  1.0 2.1 -0.4   2.8 3.0 0.4
let slab_e = box  3.2 2.1 -0.4   5.0 3.0 0.4

let slab_a = displace { slab_a grain_fine }  amount=0.04
let slab_b = displace { slab_b grain_ridge } amount=0.05
let slab_c = displace { slab_c scratch }     amount=0.06
let slab_d = displace { slab_d ripple }      amount=0.05
let slab_e = displace { slab_e masonry }     amount=0.03
let slabs  = union { slab_a slab_b slab_c slab_d slab_e }

# --- a stair, an arch and a shell -------------------------------------------------------------
let flight = stairs -6 0.3 -2.6   -4.2 1.6 -1.0 run=run rise=rise

# An arch is a box with a cylinder taken out of it — no special shape needed, which is the
# point of building everything out of the same few operations.
let pier   = box -1.0 0.3 -2.6   1.0 2.2 -1.4
let bore   = cylinder 0 1.2 -2.0 r=0.6 h=1.6 axis=z
let arch   = difference { pier bore }

let hut    = shell { box 3.0 0.3 -2.6   5.4 1.9 -1.0 } thickness=wall
let door   = box 3.9 0.3 -2.7   4.5 1.4 -1.3
let hut    = difference { hut door }

# --- everything, joined --------------------------------------------------------------------
let all = union { plinth solids slabs flight arch hut }

# --- paint, in coats ---------------------------------------------------------------------------
# The first is the undercoat and covers everything. Each one after paints over what it matches.
paint stone
paint pale  where=grain_fine above=0.15
paint moss  where=grain_ridge above=0.4 facing=y at=0.55
paint metal where=masonry above=0.0

solid all
