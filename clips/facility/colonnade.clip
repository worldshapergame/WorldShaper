    colon_stat_00 colon_stat_01 colon_stat_02 colon_stat_03
    colon_stat_04 colon_stat_05 colon_stat_06 colon_stat_07
    colon_stat_08 colon_stat_09 colon_stat_10 colon_stat_11
    colon_stat_12 colon_stat_13 colon_stat_14 colon_stat_15
    colon_stat_16 colon_stat_17 colon_stat_18 colon_stat_19
    colon_stat_20
}

# THE FOLD. Everything above is drawn on +x only and appears on both sides here. `mirror` folds
# the coordinate rather than copying, so it is exact and it costs one node; and it is bound per
# category rather than once for the whole arm so that every paint rule below can name one of them.
let colon_stylobate = mirror { colon_stylo_east } axis=x
let colon_stylobate_at = translate { colon_stylobate } 0 0 -29.00   # the twin the rules name
let colon_entab     = mirror { colon_entab_east } axis=x
let colon_entab_at = translate { colon_entab } 0 0 -29.00   # the twin the rules name
let colon_balus     = mirror { colon_balus_east } axis=x
let colon_balus_at = translate { colon_balus } 0 0 -29.00   # the twin the rules name
let colon_urns      = mirror { colon_urns_east } axis=x
let colon_urns_at = translate { colon_urns } 0 0 -29.00   # the twin the rules name
let colon_columns   = mirror { colon_cols_east } axis=x
let colon_columns_at = translate { colon_columns } 0 0 -29.00   # the twin the rules name
let colon_statues   = mirror { colon_stats_east } axis=x
let colon_statues_at = translate { colon_statues } 0 0 -29.00   # the twin the rules name

# ================================================================================================
# THE GROUND, THE PAVING AND THE RADIATING PATTERN
# ================================================================================================
#
# A slab of lawn under the whole box, 0.90 m thick — the same thickness and for the same reason as
# the facility's site, which shipped once with a ground thinner than the displacement applied to it
# and came out full of holes. Everything in this clip stands on it, which is what makes
# `components 1` mean something here.
#
# Over it: a gravel apron round the colonnade, and inside that the paved court, 21.60 m (48 M)
# across and FALLING 0.18 (0.4 M) TO A DRAIN AT THE CENTRE. The fall is struck with a sphere of
# radius 1296 whose lowest point sits at -0.18 and which passes through y = 0 at exactly 21.60 —
# 1296 is a construction, not a dimension: it is 21.60 squared over twice 0.18.
let colon_ground = box -26.55 -0.90 -16.65   26.55 0.00 14.85
let colon_ground_at = translate { colon_ground } 0 0 -29.00   # the twin the rules name
let colon_grav_out = cylinder 0 -0.14 0  r=27.90 h=0.32 axis=y
let colon_grav_in  = cylinder 0 -0.14 0  r=21.55 h=0.50 axis=y
let colon_gravel = difference { colon_grav_out colon_grav_in }
let colon_gravel_at = translate { colon_gravel } 0 0 -29.00   # the twin the rules name

let colon_pave_slab = cylinder 0 -0.27 0  r=21.60 h=0.60 axis=y
let colon_pave_dish = sphere 0 1295.82 0 r=1296

# FOUR DRAINS round the foot of the obelisk, where the dish is deepest: a recess cut out of the
# paving with an iron grating of five bars 0.045 across laid over it. Thin matter lying FLAT in the
# brightest part of the scene, which is the opposite lighting case from the gate.
let colon_drain_hole = box -0.36 -0.54 -0.36   0.36 -0.10 0.36
let colon_drain_holes = mirror { mirror { translate { colon_drain_hole } 2.70 0 2.70 } axis=x } axis=z
let colon_drain_bar = box -0.40 -0.24 -0.0225   0.40 -0.18 0.0225
let colon_drain_bars = repeat { colon_drain_bar } z=0.135 nz=2
let colon_drains = mirror { mirror { translate { colon_drain_bars } 2.70 0 2.70 } axis=x } axis=z
let colon_drains_at = translate { colon_drains } 0 0 -29.00   # the twin the rules name

let colon_paving = difference { colon_pave_slab colon_pave_dish colon_drain_holes }
let colon_paving_at = translate { colon_paving } 0 0 -29.00   # the twin the rules name

# THE RADIATING PATTERN, as geometry rather than as a pattern, because the language has no
# angular one: twenty-four sectors of 7.5 degrees each, on a pitch of 15, cut out of the paving.
# Seven of them are drawn from due east to due north and the other seventeen are the two mirrors
# of those, exactly the way _order.clip lays out twenty-four flutes and for the same reason — a
# `mirror` is a fold and is exact, and `around` would take the box off the clip.
#
# Each sector is the intersection of two half-spaces through the centre. They are infinite, so
# they are intersected with the paving before anything is painted with them: a paint rule must
# name a shape of MINE, and an unbounded half-space names everybody's.
let colon_sec_0 = intersection { plane -0.0654031 0 -0.9978589 at=0   plane -0.0654031 0 0.9978589 at=0 }
let colon_sec_1 = intersection { plane 0.1950903 0 -0.9807853 at=0   plane -0.3214395 0 0.9469301 at=0 }
let colon_sec_2 = intersection { plane 0.4422887 0 -0.8968727 at=0   plane -0.5555702 0 0.8314696 at=0 }
let colon_sec_3 = intersection { plane 0.6593458 0 -0.7518398 at=0   plane -0.7518398 0 0.6593458 at=0 }
let colon_sec_4 = intersection { plane 0.8314696 0 -0.5555702 at=0   plane -0.8968727 0 0.4422887 at=0 }
let colon_sec_5 = intersection { plane 0.9469301 0 -0.3214395 at=0   plane -0.9807853 0 0.1950903 at=0 }
let colon_sec_6 = intersection { plane 0.9978589 0 -0.0654031 at=0   plane -0.9978589 0 -0.0654031 at=0 }
let colon_sec_q = union { colon_sec_0 colon_sec_1 colon_sec_2 colon_sec_3 colon_sec_4 colon_sec_5 colon_sec_6 }
let colon_sectors = mirror { mirror { colon_sec_q } axis=x } axis=z
let colon_pave_rays = intersection { colon_sectors colon_paving }
let colon_pave_rays_at = translate { colon_pave_rays } 0 0 -29.00   # the twin the rules name

# Two bands of travertine across the rays, at 6.30 and 12.60 (14 M and 28 M) from the centre.
let colon_ring_a = difference { cylinder 0 -0.27 0 r=6.75 h=0.62 axis=y
                                cylinder 0 -0.27 0 r=6.30 h=0.80 axis=y }
let colon_ring_b = difference { cylinder 0 -0.27 0 r=13.05 h=0.62 axis=y
                                cylinder 0 -0.27 0 r=12.60 h=0.80 axis=y }
let colon_pave_rings = intersection { union { colon_ring_a colon_ring_b } colon_paving }
let colon_pave_rings_at = translate { colon_pave_rings } 0 0 -29.00   # the twin the rules name

# ================================================================================================
# THE OBELISK — 14.40 m (32 M) of porphyry on a granite plinth, with a gilt finial
# ================================================================================================
#
#   -0.18 - 0.27    first step      half-width 2.025 (4.5 M)
#    0.27 - 0.72    second step     half-width 1.575 (3.5 M)
#    0.72 - 1.62    the die         half-width 1.125 (2.5 M)
#    1.62 - 1.80    the cap         half-width 1.350 (3 M)
#    1.80 -14.40    the shaft       0.675 (1.5 M) at the foot, 0.450 (M) at the top
#   14.40 -16.20    the pyramidion  0.450 to a point
#
# The taper is four planes rather than a scale, because a non-uniform scale reports its distance
# short and field.cpp gives it no box at all. A plane is exact and free.
let colon_ob_s1 = box -2.025 -0.18 -2.025   2.025 0.27 2.025 round=0.015
let colon_ob_s2 = box -1.575 0.27 -1.575   1.575 0.72 1.575 round=0.015
let colon_ob_die = box -1.125 0.72 -1.125   1.125 1.62 1.125 round=0.015
let colon_ob_cap = box -1.350 1.62 -1.350   1.350 1.80 1.350 round=0.015
let colon_ob_plinth = union { colon_ob_s1 colon_ob_s2 colon_ob_die colon_ob_cap }
let colon_ob_plinth_at = translate { colon_ob_plinth } 0 0 -29.00   # the twin the rules name

let colon_ob_px = plane 0.9998406 0.0178543 0 at=0.7070301
let colon_ob_pz = plane 0 0.0178543 0.9998406 at=0.7070301
let colon_ob_taper = mirror { mirror { intersection { colon_ob_px colon_ob_pz } } axis=x } axis=z
let colon_ob_band = box -0.70 1.75 -0.70   0.70 14.40 0.70
let colon_ob_shaft = intersection { colon_ob_band colon_ob_taper }
let colon_ob_qx = plane 0.9701425 0.2425356 0 at=3.9290771
let colon_ob_qz = plane 0 0.2425356 0.9701425 at=3.9290771
let colon_ob_pyrm = mirror { mirror { intersection { colon_ob_qx colon_ob_qz } } axis=x } axis=z
let colon_ob_pband = box -0.50 14.35 -0.50   0.50 16.20 0.50
let colon_ob_pyr = intersection { colon_ob_pband colon_ob_pyrm }
let colon_obelisk = union { colon_ob_shaft colon_ob_pyr }
let colon_obelisk_at = translate { colon_obelisk } 0 0 -29.00   # the twin the rules name
let colon_ob_finial = union { sphere 0 16.20 0 r=0.180
                              capsule 0 16.33 0   0 16.56 0 r=0.055 }
let colon_ob_finial_at = translate { colon_ob_finial } 0 0 -29.00   # the twin the rules name

# ================================================================================================
# THE FOUNTAINS — two, on the cross axis of the oval, at x = +-13.50 (30 M)
# ================================================================================================
#
# A granite basin 3.15 m (7 M) across the rim with a moulded coping, brim-full; a baluster stem out
# of the middle of it carrying an upper bowl, and a jet. The water is the only transmissive
# horizontal surface in this clip and there are two of them, either side of the obelisk, so a ray
# leaving one at a grazing angle has the colonnade to reflect and the other has the sky.
let colon_ftn_out = cylinder 0 0.36 0  r=3.150 h=0.90 axis=y
let colon_ftn_in  = cylinder 0 0.45 0  r=2.700 h=0.90 axis=y
let colon_ftn_rim = cavetto 3.060 0.720   3.330 0.810
let colon_ftn_cop = revolve { colon_ftn_rim } axis=y
let colon_ftn_bwl = difference { colon_ftn_out colon_ftn_in }
# The stem is NOT a balustrade baluster. That was the first version and its neck is 0.060 across,
# which is half a voxel at metre 8 and one at metre 16, so the whole upper bowl came back as a
# 568-voxel floating component: the balustrade's thin matter is the right kind of thin matter on
# a balustrade and the wrong kind holding up a basin of water. This one is 0.27 across at its
# waist -- four voxels at metre 16 -- and it is a turned profile of its own.
let colon_ftn_sec = union { box 0 0.00 -1   0.135 0.66 1
                            bead 0.135 0.000   0.225 0.135
                            cyma 0.135 0.405   0.270 0.660 }
let colon_ftn_bal = revolve { colon_ftn_sec } axis=y
let colon_ftn_stm = union { cylinder 0 0.40 0 r=0.540 h=0.80 axis=y
                            translate { colon_ftn_bal } 0 0.72 0 }
let colon_ftn_uo  = cylinder 0 1.485 0 r=0.900 h=0.45 axis=y
let colon_ftn_ui  = cylinder 0 1.620 0 r=0.720 h=0.45 axis=y
let colon_ftn_up  = difference { colon_ftn_uo colon_ftn_ui }
let colon_ftn_jet = capsule 0 1.30 0   0 2.34 0 r=0.090
let colon_ftn_dry = union { colon_ftn_bwl colon_ftn_cop colon_ftn_stm colon_ftn_up colon_ftn_jet }
let colon_ftn_wet = union { cylinder 0 0.33 0 r=2.710 h=0.78 axis=y
                            cylinder 0 1.5375 0 r=0.715 h=0.285 axis=y }
let colon_ftn_base = cylinder 0 -0.20 0 r=3.150 h=0.60 axis=y
let colon_ftn_unit = union { colon_ftn_dry colon_ftn_base }

let colon_fount_e = translate { colon_ftn_unit } 13.50 0 0
let colon_fountains = mirror { colon_fount_e } axis=x
let colon_fountains_at = translate { colon_fountains } 0 0 -29.00   # the twin the rules name
let colon_water_e = translate { colon_ftn_wet } 13.50 0 0
let colon_water = mirror { colon_water_e } axis=x
let colon_water_at = translate { colon_water } 0 0 -29.00   # the twin the rules name

# ================================================================================================
# THE GATE — two rusticated granite piers and the thin matter of this building between them
# ================================================================================================
#
# The piers stand on the last ray of each arm, over the terminal column, 2.70 m (6 M) square and
# rusticated with a groove every 0.45 — a `displace` by a stripe pattern of my own, which is what
# rustication is. They rise 6.30 (the column's own height) to a cornice, and each carries a
# statue.
#
# Between them: 14.52 m of clear opening and an iron screen in it. The bars are 0.05 m square on a
# pitch of 0.225 (M/2), the scrollwork is a 0.05 m tube, the rails are 0.09, and every bar is
# tipped with a gilt spearhead. AT metre 16 A BAR IS FOUR FIFTHS OF A VOXEL. It is meant to be. It
# stands in an open gateway with the sky behind it and nothing else in this clip asks the sampler
# that question.
let colon_gp_core = box 7.2613 -0.10 -14.8155   9.9613 6.30 -12.1155 round=0.020
let colon_gp_rust = displace { colon_gp_core colon_rustic } amount=-0.075
let colon_gp_cap = box 7.0813 6.30 -14.9955   10.1413 6.75 -11.9355 round=0.015
let colon_gp_plin = box 8.2513 6.72 -13.8255   8.9713 7.02 -13.1055 round=0.012
let colon_gp_east = union { colon_gp_rust colon_gp_cap colon_gp_plin }
let colon_gate_piers = mirror { colon_gp_east } axis=x
let colon_gate_piers_at = translate { colon_gate_piers } 0 0 -29.00   # the twin the rules name
let colon_gp_stat_e = translate { rotate { colon_figure_a } y=0.5 } 8.6113 6.97 -13.4655
let colon_gate_statues = mirror { colon_gp_stat_e } axis=x
let colon_gate_statues_at = translate { colon_gate_statues } 0 0 -29.00   # the twin the rules name

# The screen, on z = -13.4655, from x = -7.4863 to 7.4863.
let colon_gt_sill = box -7.4863 -0.30 -13.9155   7.4863 0.18 -13.0155 round=0.015
let colon_gt_bar = box -0.025 0.135 -13.4905   0.025 4.05 -13.4405
let colon_gt_bars = repeat { colon_gt_bar } x=0.225 nx=32
let colon_gt_r1 = box -7.4863 0.135 -13.5105   7.4863 0.270 -13.4205
let colon_gt_r2 = box -7.4863 2.025 -13.5105   7.4863 2.160 -13.4205
let colon_gt_r3 = box -7.4863 2.970 -13.5105   7.4863 3.105 -13.4205
let colon_gt_r4 = box -7.4863 3.915 -13.5105   7.4863 4.050 -13.4205
let colon_gt_stile = box -0.045 0.135 -13.5105   0.045 4.50 -13.4205
let colon_gt_stiles = union { colon_gt_stile
                              translate { colon_gt_stile } 2.9250 0 0
                              translate { colon_gt_stile } -2.9250 0 0
                              translate { colon_gt_stile } 5.8500 0 0
                              translate { colon_gt_stile } -5.8500 0 0
                              translate { colon_gt_stile } 7.4863 0 0
                              translate { colon_gt_stile } -7.4863 0 0 }

# The scrollwork: a logarithmic spiral 0.05 m across — the same 0.05 as the bars — in two rows
# that each reach from one rail to the next, so the whole screen is one piece of iron rather than
# a raft of loose curls. Thirteen to a row, and each one is the same node repeated.
let colon_gt_scr = spiral 0 0 -13.4655  r=0.4725 tighten=0.42 tube=0.025 turns=2.0 axis=z
let colon_gt_scr_a = translate { colon_gt_scr } 0 2.5875 0
let colon_gt_scr_row = repeat { colon_gt_scr_a } x=1.125 nx=6
let colon_gt_scr_b = translate { colon_gt_scr } 0 3.5325 0
let colon_gt_scr_rowb = repeat { colon_gt_scr_b } x=1.125 nx=6
let colon_gt_scrolls = union { colon_gt_scr_row colon_gt_scr_rowb }

# The coat of arms over the meeting of the leaves: a shield on a cartouche, with a crown over it.
let colon_gt_shield = intersection { ellipsoid 0 4.86 -13.4655 rx=0.72 ry=0.90 rz=0.09
                                     box -0.72 4.14 -13.5855   0.72 5.31 -13.3455 }
let colon_gt_arms_bar = box -0.09 4.00 -13.5255   0.09 4.68 -13.4055
let colon_gt_crn_neck = box -0.18 5.10 -13.5405   0.18 5.34 -13.3905 round=0.010
let colon_gt_crn_core = cylinder 0 5.46 -13.4655 r=0.150 h=0.42 axis=y
let colon_gt_crown = union { colon_gt_crn_neck colon_gt_crn_core
                             revolve 0 5.26 -13.4655 { cavetto 0.135 0.00   0.45 0.41 } axis=y
                             sphere 0 5.76 -13.4655 r=0.150 }
let colon_gt_arms = union { colon_gt_shield colon_gt_arms_bar colon_gt_crown }

# The gilt: a spearhead on every bar, and the coat of arms.
let colon_gt_tip = cone 0 3.94 -13.4655  r=0.055 h=0.38 axis=y
let colon_gt_tips = repeat { colon_gt_tip } x=0.225 nx=32
let colon_gate_gilt = union { colon_gt_tips colon_gt_arms }
let colon_gate_gilt_at = translate { colon_gate_gilt } 0 0 -29.00   # the twin the rules name
let colon_gate_iron = union { colon_gt_bars colon_gt_r1 colon_gt_r2 colon_gt_r3 colon_gt_r4
                              colon_gt_stiles colon_gt_scrolls }
let colon_gate_iron_at = translate { colon_gate_iron } 0 0 -29.00   # the twin the rules name
let colon_gate_sill = colon_gt_sill
let colon_gate_sill_at = translate { colon_gate_sill } 0 0 -29.00   # the twin the rules name

# ================================================================================================
# THE PART
# ================================================================================================
#
# NO `displace` GRAIN OVER THE WHOLE OF IT, and that is a decision rather than an omission. The
# facility's manifest ends with `displace { hollowed grain_fine } amount=0.012`; at THIS clip's
# metre 16 that is 0.19 of a voxel, and the tool drops it and says so, because a displacement too
# small to move a surface is exactly large enough to dither one — the black-pepper speckle
# clip_script.cpp has a page about. Anything large enough to survive metre 16 (0.032 m) is over
# half the thickness of a baluster neck and would eat the balusters. So the surface here comes
# from `variation` and from the two weathering statements, whose own deformations (0.050 and
# 0.0405) are above the cutoff on purpose.
let colon_built = union {
    colon_ground colon_gravel colon_paving colon_drains
    colon_stylobate colon_columns colon_entab colon_balus colon_urns colon_statues
    colon_ob_plinth colon_obelisk colon_ob_finial
    colon_fountains colon_water
    colon_gate_piers colon_gate_statues colon_gate_sill colon_gate_iron colon_gate_gilt
}

let colon_assembly = colon_built
let part_colonnade = translate { colon_assembly } 0 0 -29.00


# ================================================================================================
# THE TWO WALKING PROBES — and this building is the tightest thing on the estate
# ================================================================================================
#
#     ./build/clipcheck clips/estate/colonnade.clip --metre 16 --part colon_probe_in
#     ./build/clipcheck clips/estate/colonnade.clip --metre 16 --part colon_probe_walk
#
# Neither is unioned into the part. Each is the volume a person sweeps — 0.60 m across, which is
# the player's own width, and 2.10 m of head starting 0.05 above the stylobate's top step — placed
# on the two routes this building has. They are taken against `part_colonnade` and not against the
# weathered solid, for the reason the campanile's probe gives: the two weathering coats move the
# surface by up to 0.05 and the clearances here are 0.02, so the geometry is the honest measure and
# the coats are inside the margin.
#
# WHAT THE NUMBERS ARE, because they are the answer to "can a person get in" and they are tighter
# than anything else on this estate. The shaft is 0.90 at the foot and swells to 0.926 at the
# entasis crown 1.95 m up, which is exactly chest height for somebody standing on the stylobate:
#
#   ALONG a walk, between two rows          1.80 centres  -  0.926  =  0.874 m clear
#   ACROSS the outer row, between two rays  2.025 centres -  0.926  =  1.099 m clear
#   ACROSS the INNER row, between two rays  1.573 centres -  0.926  =  0.647 m clear
#
# The last of those is the way IN from the court, and it is the tightest passage on the estate: a
# person 0.60 across gets through it with 23 mm either side. It is not a fault to be fixed by
# moving a column — the four rows at 4 M and the bay at 4.5 M of arc on the OUTER row are the
# module, and a radial layout on an oval shortens every inner bay by the ratio of the radii, which
# is what makes the rows shear and is the whole visual effect this part exists for. It is a fact
# about the building that belongs in writing, and the probe is what keeps it true.
#
# THE PROBE STARTS AT 1.00 AND NOT AT 0.59, AND THE FIRST DRAFT OF IT IS WHY. Written from 0.05
# over the stylobate it came back with 0.151 m3 in seven pieces, every one of them between y 0.538
# and 1.038 — which is not a wall, it is the COLUMN BASES. A Tuscan base is wider than its shaft
# by construction: the plinth is 1.26 SQUARE to 0.185, the torus 1.17 round to 0.36, the fillet
# 0.99 to 0.45. So the clear width between two rows is not one number, it is four, and only the
# last of them is what a body meets:
#
#   0.54 .. 0.73   between the plinths   1.80 - 1.26 = 0.54 m     (0.185 tall — a step, not a wall)
#   0.73 .. 0.90   between the tori      1.80 - 1.17 = 0.63 m
#   0.90 .. 0.99   between the fillets   1.80 - 0.99 = 0.81 m
#   0.99 and up    between the shafts    1.80 - 0.926 = 0.874 m
#
# Every one of those bases is under the 0.55 m riser a person climbs, so a person walking a colonnade
# walks OVER the bases and their body is in the 0.874 band. That is what the probe measures, and it
# is why its floor is at 1.00 — the honest question is whether a body passes, not whether a boot
# clears a plinth it is standing on.
#
# THE WAY IN, midway between the rays at stations 11 and 12, where the ray IS the ellipse's normal
# and the squeeze is therefore at its worst. The two midpoints are (24.174, 1.063) and
# (18.784, 0.825), and the line through them passes 3 mm from the centre of the oval — so the
# corridor is a box on +x turned by the mid-bearing, 2.524 degrees = 0.007011 turns, and `rotate`
# with a NEGATIVE turn carries +x toward +z.
let colon_probe_in = intersection {
    part_colonnade
    rotate { box 18.20 1.00 -0.30   24.90 3.10 0.30 } y=-0.007011
}

# THE WALK, between rows two and three at the same station, running along the arc for three bays.
# 21.60 is the mid radius between the columns at 22.50 and 20.70.
let colon_probe_walk = intersection {
    part_colonnade
    box 21.30 1.00 -1.30   21.90 3.10 1.30
}

# --- paint --------------------------------------------------------------------------------------
#
# Base coat first, then the ground, then everything standing on it, in the order a later coat
# should cover an earlier one. Every rule names one of MY OWN shapes and every one says
# `below=0.035`, never `below=0`. There is no manifest grain over this clip, but the two weathering
# statements below displace the surface by up to 0.050 m, and a test at zero misses every voxel
# that displacement made — which leaves a pale rind of the base coat over the weathered work and
# looks exactly like weathering rather than like the paint failing to reach the surface.
paint limestone

paint lawn       where=colon_ground_at      below=0.035
paint gravel     where=colon_gravel_at      below=0.035

paint travertine where=colon_paving_at      below=0.035
paint granite    where=colon_pave_rays_at   below=0.035
paint travertine where=colon_pave_rings_at  below=0.035
paint iron       where=colon_drains_at      below=0.035

paint granite    where=colon_stylobate_at   below=0.035
paint travertine where=colon_columns_at     below=0.035
paint travertine where=colon_entab_at       below=0.035
paint travertine where=colon_balus_at       below=0.035
paint limestone  where=colon_urns_at        below=0.035
paint limestone  where=colon_statues_at     below=0.035

paint granite    where=colon_ob_plinth_at   below=0.035
paint porphyry   where=colon_obelisk_at     below=0.035
paint gilt       where=colon_ob_finial_at   below=0.035

paint granite    where=colon_fountains_at   below=0.035
paint water      where=colon_water_at       below=0.035

paint granite    where=colon_gate_piers_at  below=0.035
paint granite    where=colon_gate_sill_at   below=0.035
paint limestone  where=colon_gate_statues_at below=0.035
paint iron       where=colon_gate_iron_at   below=0.035
paint gilt       where=colon_gate_gilt_at   below=0.035

# --- weather --------------------------------------------------------------------------------------
#
# This is the most exposed structure on the estate: a free-standing stone screen with weather on
# every side of every column and nothing over it but a balustrade. So it is weathered — LIGHTLY,
# and every statement names a shape OF MINE with `on=`, never bare. Without `on=` weathering works
# on the whole clip: it would bleach the lawn, scour the gate and sand the drain gratings along
# with whatever it was meant for, because the coats it adds are keyed on a value rather than on a
# place and they go on after everything painted above.
#
# TWO STATEMENTS AND NOT FIVE, AND THE REASON IS MEASURED. Weathering wraps the whole solid in a
# `displace` whose pattern asks the solid for its own curvature and occlusion, and each of those
# samples the field several times over. The statements CHAIN: the second one's shape is the first
# one's displaced solid, so the cost compounds. Five of them cost this clip 33.2 s of CPU at
# metre 4 against 2.8 s with the `weather` lines deleted — TWELVE TIMES, for the same geometry —
# and clip_script.cpp has the facility's own version of this number (2.4 s against 623 s). Two is
# what surface.clip uses on a bigger building, and two is what this uses.
#
# The DEFORMATION a weather statement applies is set by its `scale=` and not by its amount —
# desert scours by 0.05 x scale, overgrown swells by 0.045 x scale — and at metre 16 anything
# under 0.03125 m is dropped as dither with a warning. So the scales are 1.00 and 0.90: below
# about 0.7 the deformation vanishes, and much above 1.1 the scour starts taking the balusters,
# whose necks are 0.060.
weather desert    0.16 scale=1.00 seed=13 on=colon_entab_at
weather overgrown 0.14 scale=0.90 seed=59 on=colon_stylobate_at


# --- where the origin is ---------------------------------------------------------------------
#
# The player spawns at 0,0,0, and the middle of this clip is the inside of an obelisk's plinth.
# So the spawn is moved 7.20 m (16 M) north of the obelisk, standing on the paving looking down
# the court at the gate. `origin` and not a translate: it carries the paint rules and the bounds
# with the stone, which a translate round the solid does not.
