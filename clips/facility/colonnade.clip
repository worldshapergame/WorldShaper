    colon_c19_1 colon_c19_2 colon_c19_3 colon_c19_4
    colon_c20_1 colon_c20_2 colon_c20_3 colon_c20_4
}

# The statues, one on the station pier of every unit, dealt round the four types and each turned
# to face the middle of the court. `colon_fig_*` face +z, so the turn takes +z to the inward ray.
let colon_stat_00 = translate { rotate { colon_figure_a } y=-0.0397214 } 8.8002 9.6700 -14.2068
let colon_stat_01 = translate { rotate { colon_figure_b } y=-0.0493068 } 10.8064 9.6700 -13.6940
let colon_stat_02 = translate { rotate { colon_figure_c } y=-0.0597571 } 12.7820 9.6700 -13.0599
let colon_stat_03 = translate { rotate { colon_figure_d } y=-0.0713618 } 14.7166 9.6700 -12.2952
let colon_stat_04 = translate { rotate { colon_figure_a } y=-0.0845062 } 16.5966 9.6700 -11.3879
let colon_stat_05 = translate { rotate { colon_figure_b } y=-0.0997094 } 18.4033 9.6700 -10.3230
let colon_stat_06 = translate { rotate { colon_figure_c } y=-0.1176641 } 20.1098 9.6700 -9.0820
let colon_stat_07 = translate { rotate { colon_figure_d } y=-0.1392475 } 21.6768 9.6700 -7.6439
let colon_stat_08 = translate { rotate { colon_figure_a } y=-0.1654027 } 23.0460 9.6700 -5.9889
let colon_stat_09 = translate { rotate { colon_figure_b } y=-0.1966899 } 24.1341 9.6700 -4.1100
let colon_stat_10 = translate { rotate { colon_figure_c } y=-0.2323868 } 24.8367 9.6700 -2.0347
let colon_stat_11 = translate { rotate { colon_figure_d } y=-0.2698172 } 25.0592 9.6700 0.1529
let colon_stat_12 = translate { rotate { colon_figure_a } y=-0.3053080 } 24.7688 9.6700 2.3237
let colon_stat_13 = translate { rotate { colon_figure_b } y=-0.3362929 } 24.0165 9.6700 4.3590
let colon_stat_14 = translate { rotate { colon_figure_c } y=-0.3621535 } 22.9003 9.6700 6.1925
let colon_stat_15 = translate { rotate { colon_figure_d } y=-0.3834943 } 21.5181 9.6700 7.8075
let colon_stat_16 = translate { rotate { colon_figure_a } y=-0.4012628 } 19.9462 9.6700 9.2137
let colon_stat_17 = translate { rotate { colon_figure_b } y=-0.4163262 } 18.2383 9.6700 10.4298
let colon_stat_18 = translate { rotate { colon_figure_c } y=-0.4293662 } 16.4319 9.6700 11.4750
let colon_stat_19 = translate { rotate { colon_figure_d } y=-0.4408927 } 14.5526 9.6700 12.3662
let colon_stat_20 = translate { rotate { colon_figure_a } y=-0.4408927 } 12.6656 9.6700 13.1011
