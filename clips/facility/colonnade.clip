let colon_sty_24 = translate { rotate { colon_sty_unit } y=0.0591073 } 11.6542 0.0000 12.6741
let colon_sty_25 = translate { rotate { colon_sty_unit } y=0.0591073 } 10.8156 0.0000 13.0007
let colon_stylo_all = union {
    colon_sty_00 colon_sty_01 colon_sty_02 colon_sty_03
    colon_sty_04 colon_sty_05 colon_sty_06 colon_sty_07
    colon_sty_08 colon_sty_09 colon_sty_10 colon_sty_11
    colon_sty_12 colon_sty_13 colon_sty_14 colon_sty_15
    colon_sty_16 colon_sty_17 colon_sty_18 colon_sty_19
    colon_sty_20 colon_sty_21 colon_sty_22 colon_sty_23
    colon_sty_24 colon_sty_25
}
let colon_stylo_east = difference { colon_stylo_all colon_cut_n colon_cut_s }

