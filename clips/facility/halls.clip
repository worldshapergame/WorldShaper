# halls - the side halls east and west and their vaults
#
# PLACEHOLDER. Replace everything below with the real part.
# Read clips/facility/BRIEF.md first, then _contract.clip for every dimension.
#
# This file must define exactly one part named `part_halls`. Every other name it binds must
# start with `halls_` so nothing collides with another fragment.

let halls_placeholder = sphere 0 -1.30 0 r=0.25
let part_halls = halls_placeholder

# What this part removes from the building. Taken away in the manifest after everything is
# assembled, so nothing added later can be eaten by it. Must always be bound, even if empty.
let void_halls = sphere 0 -1.30 0 r=0.02
