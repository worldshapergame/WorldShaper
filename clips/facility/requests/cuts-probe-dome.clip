# cuts-probe.clip with the box cut down to the dome alone, so it can be sampled at the contract's
# own metre 32 without asking for 1.3 GB. NOT part of the building.
#
#   bash tools/clipcheck.sh clips/facility/requests/cuts-probe-dome.clip --metre 32 --slice x@0
#   bash tools/clipcheck.sh clips/facility/requests/cuts-probe-dome.clip --metre 32 --gap y@0,0
#
# 12.4 x 4.6 x 12.4 m is 23 million cells at metre 32; the wide box in cuts-probe.clip is 259
# million, which is where an `Exit code 144` comes from.

include "cuts-probe.clip"

bounds -6.2 15.2 -6.2   6.2 19.8 6.2

solid part_dome
