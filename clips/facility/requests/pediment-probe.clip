# pediment-probe — the whole building, sampled only in the gable over the portico.
#
# Same instrument as portico-probe.clip and entablature-probe.clip. The box is small enough that
# metre 32 is seconds, which is the only resolution at which a 0.045 m wreath or the knife edge of
# the raking cyma exists at all.
#
#   ./build/clipcheck clips/facility/requests/pediment-probe.clip --part probe_mitre_built --metre 32

include "../../facility.clip"

# The origin, cancelled — see portico-probe.clip.
origin 0 3.50 0

# --- what somebody else's cut takes out of mine -------------------------------------------------
let probe_bite_all = intersection {
    part_pediment
    union { void_doors void_windows void_vestibule void_rotunda void_halls void_stair
            void_crypt void_salon void_chapel void_ballroom void_library void_enfilade }
}

# --- the tympanum's recess ----------------------------------------------------------------------
#
# The face is set back onto z = -11.60 and the corona over it hangs out to -12.20, so the whole
# triangle is 0.60 m behind an overhang. That recess is the part's third load and it is exactly the
# kind of hollow another part's mass unions shut without a word. `mine` against `built` is the test.
let probe_recess_box   = box -8.10 11.90 -12.20   8.10 13.70 -11.55
let probe_recess_mine  = intersection { part_pediment probe_recess_box }
let probe_recess_built = intersection { built probe_recess_box }

# --- the mitre ----------------------------------------------------------------------------------
#
# The wedge of raking cyma that dies into the horizontal cornice at x = 8.10. Under two voxels
# thick for its first 0.20 m, and the one feature the whole part is written round.
let probe_mitre_box   = box 7.00 11.80 -12.50   8.30 12.30 -11.90
let probe_mitre_mine  = intersection { part_pediment probe_mitre_box }
let probe_mitre_built = intersection { built probe_mitre_box }

# The raking cornice on its own, and the horizontal one under it, so the two profiles can be read
# against each other at the mitre plane in a slice.
let probe_rake  = pediment_rakes
let probe_wreath_air = intersection {
    built  box -0.50 11.90 -11.70   0.50 12.80 -11.58
}

# `solid all`, so `--cuts` audits every subtraction in the building that reaches the gable, not only
# my own. `--part part_pediment` narrows it when the question is about my own geometry.
metre 32
bounds -8.70 11.70 -12.60   8.70 14.60 -10.50

solid all
