# WSauthor: worldshaper
# --- LESSON THREE: three kinds of thing, three colours -------------------------------------------
#
# Everything in a document is one of three kinds, and the colour says which:
#
#   a SHAPE    -- matter. A box, a sphere, a union of them.
#   a NUMBER   -- a field with a value everywhere. Every pattern is one of these.
#   a VOXEL TYPE -- what matter is made of. A colour and how it takes light.
#
# A wire is only allowed where the kind fits. Try dragging `stone` onto `all` and the editor
# will refuse and tell you what would work instead -- a union is made of shapes.
#
# TRY: drag `grain` onto `stone_coat`. A coat reads a pattern to decide WHERE it paints.

metre 32

material stone rgb=176,170,158 rough=232
material moss  rgb=78,106,52   rough=252

let grain = fbm size=0.35 octaves=4 seed=3

let wall  = box -3 0 -1   3 3 1 round=0.06
let plinth = box -3.4 0 -1.4   3.4 0.4 1.4
let all   = union { wall plinth }

paint stone
paint moss where=grain above=0.62

solid all
