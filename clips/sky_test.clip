# A scene for looking at the sky, and almost nothing else.
#
# A sky is judged on three things at once and no ordinary scene shows all three: the gradient
# from horizon to zenith, what the whole hemisphere looks like folded into one reflection, and
# whether anything standing in it still reads as a solid object rather than as a silhouette.
#
# So: a wide flat plain with a clean horizon on every side, a chrome ball that carries the whole
# sky in one image, a white matte ball that shows only what the sky *lights* it with, and a row
# of posts at increasing distance to give the light something to cast shadows across. Nothing
# reflective on the ground, because a mirrored floor would double the sky and hide a fault in it.

metre 32
bounds -14 -0.5 -14   14 6 14

material plain     rgb=150,146,138 rough=235
material chalk     rgb=228,226,222 rough=250
material chrome    rgb=232,232,238 rough=8   metal=250
material post_dark rgb=64,62,60    rough=220
material post_pale rgb=206,202,194 rough=215

# The plain. Wide enough that the horizon in every direction is sky rather than the edge of it.
let sk_plain = box -14 -0.5 -14   14 0 14 round=0.02

# One mirror and one matte ball, side by side: the sky as it is, and the sky as it lights.
let sk_mirror = sphere -1.8 1.0 -1.0 r=1.0
let sk_matte  = sphere  1.8 1.0 -1.0 r=1.0

# Posts across the plain, so a low sun has something long to throw shadows from and a night sky
# has something to stand a roofline against.
let sk_post   = cylinder 0 1.6 0 r=0.18 h=3.2 axis=y
let sk_p1 = translate { sk_post } -5.0 0 -4.5
let sk_p2 = translate { sk_post }  5.0 0 -7.5
let sk_p3 = translate { sk_post } -4.0 0 -10.5
let sk_p4 = translate { sk_post }  0.0 0  4.0
let sk_posts = union { sk_p1 sk_p2 sk_p3 sk_p4 }

# A low wall, for a hard edge against the sky at eye height.
let sk_wall = box -8 0 -13.4   8 2.2 -13.0 round=0.02

let grain = fbm size=0.06 octaves=3 seed=7
let sk_all = union { sk_plain sk_mirror sk_matte sk_posts sk_wall }
let sk_all = displace { sk_all grain } amount=0.004

# Widened past the 4 mm the grain displaces by, for the reason mirror_test.clip records: a voxel
# that exists only because the grain pushed the surface out sits outside the shape that names it.
paint plain
paint chrome     where=sk_mirror below=0.008
paint chalk      where=sk_matte  below=0.008
paint post_dark  where=sk_posts  below=0.008
paint post_pale  where=sk_wall   below=0.008

variation colour=0.018 rough=0.035 seed=3

solid sk_all
