let ct_a_c28 = ellipsoid  -0.446  1.816  -0.447  rx=0.281 ry=0.247 rz=0.281
let ct_a_c29 = ellipsoid   0.106  1.506  -0.068  rx=0.246 ry=0.227 rz=0.258
let ct_a_c30 = ellipsoid   0.243  1.736  -0.241  rx=0.262 ry=0.246 rz=0.263
let ct_a_c31 = ellipsoid   0.237  2.068  -0.315  rx=0.250 ry=0.223 rz=0.254
let ct_a_c32 = ellipsoid   0.241  2.258  -0.344  rx=0.266 ry=0.249 rz=0.285
let ct_a_c33 = ellipsoid   0.338  1.979  -0.327  rx=0.217 ry=0.180 rz=0.222
let ct_a_c34 = ellipsoid   0.406  2.087  -0.354  rx=0.285 ry=0.228 rz=0.241
let ct_a_c35 = ellipsoid   0.390  1.990  -0.234  rx=0.197 ry=0.187 rz=0.203
let ct_a_c36 = ellipsoid   0.493  2.126  -0.228  rx=0.177 ry=0.163 rz=0.189
let ct_a_clumps = union {
    ct_a_c00 ct_a_c01
    ct_a_c02 ct_a_c03
    ct_a_c04 ct_a_c05
