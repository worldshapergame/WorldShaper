# ================================================================================================
# WHAT A CALLER NAMES
# ================================================================================================

let ct_a_bark      = displace { ct_a_bole tree_bark } amount=0.032
let citrus_a_wood  = union { ct_a_bark ct_a_branches }
let citrus_a_leaf  = union { ct_a_clumps }
let citrus_a_fruit = union { ct_a_crop }
let citrus_a       = union { citrus_a_wood citrus_a_leaf citrus_a_fruit }

let ct_b_bark      = displace { ct_b_bole tree_bark } amount=0.032
let citrus_b_wood  = union { ct_b_bark ct_b_branches }
let citrus_b_leaf  = union { ct_b_clumps }
let citrus_b_fruit = union { ct_b_crop }
let citrus_b       = union { citrus_b_wood citrus_b_leaf citrus_b_fruit }
