    ct_a_g09 ct_a_g10
}

# ================================================================================================
# CITRUS B — squatter, four primaries, sweeping the other way, nine oranges
# ================================================================================================

# The bole: the stem and the first reach of every primary, the wood thick enough that
# ct_b can carry a bark displacement without the displacement eating it.
let ct_b_s00 = capsule   0.000 -0.100   0.000    -0.028  0.170  -0.013  r=0.123
let ct_b_s01 = capsule  -0.028  0.170  -0.013    -0.070  0.439  -0.006  r=0.113
let ct_b_s02 = capsule  -0.070  0.439  -0.006    -0.091  0.709   0.013  r=0.103
let ct_b_s03 = capsule  -0.091  0.709   0.013    -0.093  0.981   0.025  r=0.093
let ct_b_s04 = capsule  -0.093  0.981   0.025    -0.083  1.252   0.051  r=0.083
let ct_b_bole = union {
    ct_b_s00 ct_b_s01 ct_b_s02
    ct_b_s03 ct_b_s04
}

# The branches: primaries thinning into secondaries. NOT displaced -- see the header.
let ct_b_b00 = capsule  -0.083  1.252   0.051     0.030  1.617   0.168  r=0.043
let ct_b_b01 = capsule   0.030  1.617   0.168     0.116  1.985   0.299  r=0.035
let ct_b_b02 = capsule   0.116  1.985   0.299     0.221  2.514   0.307  r=0.023
let ct_b_b03 = capsule   0.116  1.985   0.299     0.175  2.464   0.345  r=0.023
let ct_b_b04 = capsule   0.116  1.985   0.299     0.144  2.555   0.621  r=0.023
