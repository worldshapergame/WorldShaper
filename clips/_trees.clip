# The crop: each orange set into the clump that carries it, 105 mm of it inside.
let ct_a_g00 = sphere   0.635  2.278   0.544 r=0.090
let ct_a_g01 = sphere  -0.637  1.870  -0.622 r=0.090
let ct_a_g02 = sphere  -0.698  1.810  -0.437 r=0.090
let ct_a_g03 = sphere   0.321  1.587   0.690 r=0.090
let ct_a_g04 = sphere  -0.769  1.921  -0.269 r=0.090
let ct_a_g05 = sphere   0.349  1.623   0.729 r=0.090
let ct_a_g06 = sphere   0.675  2.145   0.311 r=0.090
