# A room where the lamps are the only light, and most of them are round a corner.
#
# Direct light sampling draws a handful of candidates uniformly from the whole list and keeps
# the best. That is fine when every lamp in the list can be seen from every surface, and it is
# exactly wrong here: a face in one quarter of this hall can see five or six sconces and is
# walled off from the other thirty, so five draws in six score a lamp that turns out to be
# behind a partition and come back with nothing. Nothing in an unshaded score can know that.
#
# So: a sealed hall, no sky and no sun anywhere in it, a cross of partitions to cut the sight
# lines, and enough sconces that eight uniform candidates cannot cover them. The picture is lit
# by nothing but the lamps, which is what makes the noise in it a measurement of how well the
# lamps are being sampled rather than of anything else.

metre 32
bounds -7 -0.5 -7   7 4.4 7

material hallfloor rgb=116,112,108 rough=225
material hallwall  rgb=158,154,148 rough=210
material trim      rgb=88,84,80    rough=180
material sconce    rgb=255,224,178 rough=140 emit=200
material lantern   rgb=198,220,255 rough=140 emit=170

# The shell, hollowed out. Sealed on every side on purpose: with a window in it the sky would
# carry most of the light and the lamps would stop being what is being measured.
let ml_shell   = box -7 -0.5 -7    7 4.4 7
let ml_room    = box -6.6 0 -6.6   6.6 4.0 6.6
let ml_walls   = difference { ml_shell ml_room }

# A cross of partitions, stopping short of the middle so the hall is one space to walk through
# and four spaces as far as a shadow ray is concerned.
let ml_part_a  = box -0.22 0 -6.6   0.22 4.0 -1.7
let ml_part_b  = box -0.22 0  1.7   0.22 4.0  6.6
let ml_part_c  = box -6.6 0 -0.22  -1.7 4.0  0.22
let ml_part_d  = box  1.7 0 -0.22   6.6 4.0  0.22

# And a column in the middle, so the one place that can see into all four quarters still has
# something in the way of it.
let ml_column  = cylinder 0 2.0 0 r=0.42 h=4.0 axis=y

# The fittings. Small enough that a bounce would find one about once in a million tries, which
# is the whole reason direct sampling exists, and paired either side of every partition so that
# neighbouring faces disagree about which lamps are worth asking.
let ml_sc      = box -0.18 2.30 -0.12   0.18 2.72 0.12
let ml_north   = translate { repeat { ml_sc } x=1.7 nx=3 }  0 0 -6.5
let ml_south   = translate { repeat { ml_sc } x=1.7 nx=3 }  0 0  6.5
let ml_sc_z    = box -0.12 2.30 -0.18   0.12 2.72 0.18
let ml_west    = translate { repeat { ml_sc_z } z=1.7 nz=3 } -6.5 0 0
let ml_east    = translate { repeat { ml_sc_z } z=1.7 nz=3 }  6.5 0 0

# Fittings on the partitions themselves, which is where the occlusion actually bites: a lamp
# bolted to one side of a wall lights that side and nothing at all on the other.
let ml_pin_a   = translate { ml_sc }  0.30 0 -3.6
let ml_pin_b   = translate { ml_sc } -0.30 0 -3.6
let ml_pin_c   = translate { ml_sc }  0.30 0  3.6
let ml_pin_d   = translate { ml_sc } -0.30 0  3.6
let ml_pin_e   = translate { ml_sc_z } -3.6 0  0.30
let ml_pin_f   = translate { ml_sc_z } -3.6 0 -0.30
let ml_pin_g   = translate { ml_sc_z }  3.6 0  0.30
let ml_pin_h   = translate { ml_sc_z }  3.6 0 -0.30

# One large fitting, because a small source and a large one are different problems: the small
# ones test which lamp gets asked, this one tests whether the cone drawn round it is wide enough
# and whether its penumbra resolves.
let ml_lantern = box -0.55 3.10 -0.55   0.55 3.55 0.55

let ml_lamps   = union { ml_north ml_south ml_west ml_east
                         ml_pin_a ml_pin_b ml_pin_c ml_pin_d
                         ml_pin_e ml_pin_f ml_pin_g ml_pin_h }

# A kerb along the foot of the walls, so there is a surface at a grazing angle to the lamps as
# well as one square on to them.
let ml_kerb    = difference { box -6.6 0 -6.6  6.6 0.28 6.6
                              box -6.2 0 -6.2  6.2 0.28 6.2 }

let ml_all = union { ml_walls ml_part_a ml_part_b ml_part_c ml_part_d ml_column
                     ml_kerb ml_lamps ml_lantern }

let ml_floortop = box -6.6 -0.12 -6.6   6.6 0.0 6.6

paint hallwall
paint hallfloor where=ml_floortop below=0.01
paint trim      where=ml_kerb below=0.02
paint sconce    where=ml_lamps below=0.02
paint lantern   where=ml_lantern below=0.02

variation colour=0.016 rough=0.030 seed=7

solid ml_all
